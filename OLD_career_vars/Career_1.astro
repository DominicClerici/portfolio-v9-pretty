---
// Variant 1 — "The Index Spine"
// V3's instrument crossed with V4's dossier. The left rail fuses a vertical
// time spine — employment bars drawn to scale on a year ruler, oldest at the
// top — with the employer tab list. The selected role's bar fills solid lime
// and doubles as the tab indicator; hovering a bar highlights its tab and
// vice versa. The right side stays a full dossier panel with a ghost year
// watermark. Dot-grid canvas carries over from the instrument.
const RANGE_START = 2019
const RANGE_END = 2027
const SPAN = RANGE_END - RANGE_START

const entries = [
  {
    period: "2025 — Now",
    year: "2025",
    start: 2025,
    end: 2026.5,
    lane: 0,
    now: true,
    company: "Rumor",
    title: "Full Stack Developer",
    description:
      "Building the platform behind Rumor — a private network connecting people to exclusive cultural events. Most of my time goes toward the host dashboard and mobile apps, everything from event creation and guest management to real-time analytics. Small team, so I touch most of the stack, from the database layer up to what users see on their phones.",
    skills: ["Full Stack", "Mobile", "Cloud Infrastructure"],
    tags: [
      "TypeScript",
      "PostgreSQL",
      "AWS Lambda",
      "Next.js",
      "React Native",
      "Swift",
    ],
    url: "https://www.therumor.com/",
  },
  {
    period: "2024 — 2026",
    year: "2024",
    start: 2024,
    end: 2026,
    lane: 1,
    now: false,
    company: "Squib",
    title: "Founding Engineer",
    description:
      "First engineer at an AI research lab building autonomous agents that model human behavior. I helped build Persona, a product that creates AI-powered social profiles — digital twins that grow audiences and predict how communities will respond before a campaign launches. Early-stage startup, so I had my hands in everything from agent architecture to the product interface.",
    skills: ["AI/ML", "Autonomous Agents", "Growth Engineering"],
    tags: ["Go", "TypeScript", "Python", "PostgreSQL"],
    url: "https://www.heysquib.com/",
  },
  {
    period: "2021 — 2022",
    year: "2021",
    start: 2021,
    end: 2022,
    lane: 0,
    now: false,
    company: "Artesian Builds",
    title: "Full Stack Developer",
    description:
      "Helped overhaul the company website — better design, tighter SEO, load times dropped about 40%. Also built internal tools for tracking sponsorship metrics and Twitch creator stats, which gave management real numbers instead of gut feelings. Small team, learned a lot about wearing different hats and shipping quickly.",
    skills: ["Full Stack", "Internal Tooling", "SEO", "Data Analysis"],
    tags: ["WordPress", "Elementor", "Electron", "Python", "PostgreSQL"],
    url: "https://en.wikipedia.org/wiki/Artesian_Builds",
  },
  {
    period: "2019",
    year: "2019",
    start: 2019.05,
    end: 2019.85,
    lane: 0,
    now: false,
    company: "McDonald's",
    title: "Crew Member",
    description:
      "Got me my first car at 16 — a '93 Miata with 220k miles on it. I still think about that car more than I probably should.",
    skills: ["Deep Fryer", "Cash Register", "Drive-Thru", "Customer Service"],
    tags: ["Ice Cream Machine (Broken)", "McFlurry Assembly", "Headset Comms"],
    url: "https://www.mcdonalds.com/us/en-us.html",
  },
]

// Vertical axis: oldest at the top, so a year maps to distance from RANGE_START
const yPct = (v: number) => ((v - RANGE_START) / SPAN) * 100
const years = Array.from({ length: SPAN }, (_, i) => RANGE_START + i)

// Render order oldest-first while keeping each entry's original index for
// selection/hover-sync wiring (data-select/data-i key off the original i).
const orderedEntries = entries
  .map((entry, i) => ({ entry, i }))
  .slice()
  .reverse()
---

<section
  class="career-v1 relative bg-[#0a0a0a] overflow-hidden"
  aria-label="Career"
>
  <div class="v1-dots absolute inset-0 pointer-events-none" aria-hidden="true">
  </div>

  <div
    class="relative max-w-[1524px] mx-auto px-6 lg:px-12 py-[clamp(96px,14vh,180px)]"
  >
    <div class="flex items-center gap-4 mb-10 lg:mb-14">
      <span
        class="font-mono text-[13px] leading-none tracking-[-0.02em] text-white/55 border border-white/20 rounded-full px-3.5 py-2"
      >
        02&hairsp;/&hairsp;04
      </span>
      <span
        class="font-mono text-[13px] leading-none tracking-[-0.02em] uppercase text-white/55"
      >
        Career
      </span>
    </div>

    <p
      class="font-display font-normal text-[#f5f5f5] leading-[1.2] tracking-[-0.006em] max-w-[880px] text-[clamp(1.625rem,calc(1.625rem+(100vw-27.5rem)*0.02),2.625rem)] mb-14 lg:mb-20"
    >
      Time on one axis,
      <span class="text-white/45">the story on the other.</span>
    </p>

    <div class="grid lg:grid-cols-[360px_1fr] gap-8 lg:gap-14 items-start">
      <!-- Rail: time spine + employer tabs -->
      <div class="lg:sticky lg:top-24 lg:grid lg:grid-cols-[66px_1fr] lg:gap-5">
        <!-- The spine — V3's chart, rotated vertical -->
        <div class="v1-spine relative hidden lg:block">
          <div class="absolute inset-x-0 top-2 bottom-2">
            {
              years.map((y) => (
                <div
                  class="absolute inset-x-0"
                  style={`top: ${yPct(y)}%`}
                  aria-hidden="true"
                >
                  <span class="absolute left-0 top-0 -translate-y-1/2 font-mono text-[10px] leading-none tracking-[-0.02em] text-[#4d4d4d]">
                    {`'${String(y).slice(2)}`}
                  </span>
                  <span class="absolute left-7 right-0 top-0 border-t border-[#1b1b1b]" />
                </div>
              ))
            }
            {
              orderedEntries.map(({ entry, i }) => (
                <button
                  type="button"
                  class="v1-bar absolute w-[14px] rounded-full border border-[#333333]"
                  style={`top: ${yPct(entry.start)}%; height: ${yPct(entry.end) - yPct(entry.start)}%; left: ${30 + entry.lane * 20}px; --d: ${i * 120}ms`}
                  data-select={i}
                  data-i={i}
                  data-on={i === 0 ? "true" : "false"}
                  aria-label={`${entry.company}, ${entry.period}`}
                >
                  {entry.now && (
                    <span
                      class="absolute -bottom-[2px] left-1/2 -translate-x-1/2 flex w-[7px] h-[7px]"
                      aria-hidden="true"
                    >
                      <span class="v1-ping absolute inline-flex h-full w-full rounded-full bg-bio-lime opacity-70" />
                      <span class="relative inline-flex rounded-full h-[7px] w-[7px] bg-bio-lime" />
                    </span>
                  )}
                </button>
              ))
            }
          </div>
        </div>

        <!-- Tabs — list rows on desktop, chip strip on mobile -->
        <div
          class="flex lg:flex-col overflow-x-auto lg:overflow-visible gap-2 lg:gap-0 -mx-6 px-6 lg:mx-0 lg:px-0 pb-1 lg:pb-0"
          role="tablist"
          aria-label="Employers"
        >
          {
            orderedEntries.map(({ entry, i }) => (
              <button
                type="button"
                class="v1-tab group shrink-0 lg:w-full text-left"
                role="tab"
                aria-selected={i === 0 ? "true" : "false"}
                data-select={i}
                data-i={i}
              >
                <span class="block">
                  <span class="font-mono text-[11px] leading-none tracking-[-0.02em] text-[#5f5f5f] block">
                    {entry.period}
                  </span>
                  <span class="v1-tab-name font-display font-normal leading-tight tracking-[-0.012em] text-[20px] lg:text-[24px] mt-1.5 inline-flex items-center gap-2.5">
                    <span
                      class="v1-tab-dot w-[6px] h-[6px] rounded-full bg-bio-lime shrink-0"
                      aria-hidden="true"
                    />
                    {entry.company}
                  </span>
                </span>
              </button>
            ))
          }
        </div>
      </div>

      <!-- The dossier panel -->
      <div
        class="relative rounded-[20px] border border-[#232323] bg-[#0f0f0f] min-h-[520px] overflow-hidden"
      >
        {
          entries.map((entry, i) => (
            <div
              class="v1-panel relative p-7 sm:p-10 lg:p-14"
              role="tabpanel"
              data-panel={i}
              hidden={i !== 0}
            >
              {/* Ghost year watermark */}
              <span
                class="absolute -top-8 right-2 font-display leading-none tracking-[-0.04em] text-white/[0.035] select-none pointer-events-none text-[clamp(9rem,18vw,15rem)]"
                aria-hidden="true"
              >
                {entry.year}
              </span>

              <div class="relative v1-enter">
                <div class="flex items-center gap-2.5">
                  <span
                    class:list={[
                      "w-[6px] h-[6px] rounded-full",
                      entry.now ? "bg-bio-lime" : "bg-[#4a4a4a]",
                    ]}
                    aria-hidden="true"
                  />
                  <span class="font-mono text-[13px] leading-none tracking-[-0.02em] uppercase text-[#8a8a8a]">
                    {entry.period}&ensp;·&ensp;{entry.title}
                  </span>
                </div>

                <h3 class="font-display font-normal leading-[0.95] tracking-[-0.02em] text-[#f5f5f5] mt-6 text-[clamp(2.75rem,calc(2.75rem+(100vw-27.5rem)*0.03),5rem)]">
                  {entry.company}
                </h3>

                <p class="font-display text-[16px] lg:text-[17px] leading-[1.6] text-[#a8a8a8] max-w-[640px] mt-8">
                  {entry.description}
                </p>

                <div class="flex flex-wrap gap-x-6 gap-y-3 mt-10">
                  {entry.skills.map((skill) => (
                    <span class="inline-flex items-center gap-2">
                      <span
                        class="w-[6px] h-[6px] rounded-full bg-bio-lime"
                        aria-hidden="true"
                      />
                      <span class="font-mono text-[12px] leading-none tracking-[-0.02em] uppercase text-[#c9c9c9]">
                        {skill}
                      </span>
                    </span>
                  ))}
                </div>
                <div class="flex flex-wrap gap-x-4 gap-y-2 mt-5">
                  {entry.tags.map((tag) => (
                    <span class="font-mono text-[12px] leading-none tracking-[-0.02em] text-[#616161]">
                      {tag}
                    </span>
                  ))}
                </div>

                <div class="flex items-center gap-3 mt-12">
                  <a
                    href={entry.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-mono text-[13px] tracking-[-0.008em] text-[#f5f5f5] border border-[#3a3a3a] rounded-lg h-10 px-4 inline-flex items-center hover:border-[#8a8a8a] transition-colors duration-200"
                  >
                    Visit {entry.company}
                  </a>
                  <a
                    href={entry.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Open ${entry.company} in a new tab`}
                    class="w-10 h-10 rounded-lg bg-bio-lime text-ink inline-flex items-center justify-center hover:-translate-y-0.5 transition-transform duration-200"
                  >
                    <svg
                      width="14"
                      height="14"
                      viewBox="0 0 14 14"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        d="M2 12 12 2M4.5 2H12v7.5"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .v1-dots {
    background-image: radial-gradient(
      circle,
      rgba(255, 255, 255, 0.05) 1px,
      transparent 1px
    );
    background-size: 26px 26px;
  }

  /* Spine bars */
  .v1-bar {
    background: #191919;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .v1-bar:hover,
  .v1-bar.hl {
    border-color: rgba(206, 247, 158, 0.5);
    background: #232323;
  }

  .v1-bar[data-on="true"] {
    background: #cef79e;
    border-color: #cef79e;
  }

  /* Tabs */
  .v1-tab-name {
    color: #6e6e6e;
    transition: color 0.2s ease;
  }

  .v1-tab:hover .v1-tab-name,
  .v1-tab.hl .v1-tab-name {
    color: #bdbdbd;
  }

  .v1-tab[aria-selected="true"] .v1-tab-name {
    color: #f5f5f5;
  }

  .v1-tab-dot {
    opacity: 0;
    transform: scale(0.4);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }

  .v1-tab[aria-selected="true"] .v1-tab-dot {
    opacity: 1;
    transform: scale(1);
  }

  @media (min-width: 1024px) {
    .v1-tab {
      padding: 20px 0;
      border-top: 1px solid #222222;
      cursor: pointer;
    }

    .v1-tab:last-child {
      border-bottom: 1px solid #222222;
    }
  }

  @media (max-width: 1023px) {
    .v1-tab {
      border: 1px solid #2a2a2a;
      border-radius: 14px;
      padding: 12px 18px;
      background: #111111;
      cursor: pointer;
      white-space: nowrap;
    }

    .v1-tab[aria-selected="true"] {
      border-color: #4a4a4a;
      background: #191919;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Bars grow down the spine when it scrolls into view */
    .v1-bar {
      transform: scaleY(0);
      transform-origin: top center;
      transition:
        transform 0.9s cubic-bezier(0.33, 1, 0.68, 1) var(--d, 0ms),
        background-color 0.2s ease,
        border-color 0.2s ease;
    }

    .v1-spine.in .v1-bar {
      transform: scaleY(1);
    }

    .v1-ping {
      animation: v1-ping 2.2s cubic-bezier(0, 0, 0.2, 1) infinite;
    }

    @keyframes v1-ping {
      0% {
        transform: scale(1);
        opacity: 0.7;
      }
      75%,
      100% {
        transform: scale(3);
        opacity: 0;
      }
    }

    /* Panel content entrance on tab switch */
    .v1-enter {
      animation: v1-rise 0.5s cubic-bezier(0.33, 1, 0.68, 1) both;
    }

    @keyframes v1-rise {
      from {
        opacity: 0;
        transform: translateY(16px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
</style>

<script>
  {
    const section = document.querySelector<HTMLElement>(".career-v1")
    if (section) {
      const tabs = section.querySelectorAll<HTMLButtonElement>("[role='tab']")
      const bars = section.querySelectorAll<HTMLButtonElement>(".v1-bar")
      const panels = section.querySelectorAll<HTMLElement>("[data-panel]")

      const select = (id: string | undefined) => {
        if (!id) return
        tabs.forEach((t) =>
          t.setAttribute("aria-selected", String(t.dataset.select === id)),
        )
        bars.forEach((b) =>
          b.setAttribute("data-on", String(b.dataset.select === id)),
        )
        panels.forEach((panel) => {
          const show = panel.dataset.panel === id
          panel.hidden = !show
          if (show) {
            // retrigger the entrance animation
            const inner = panel.querySelector<HTMLElement>(".v1-enter")
            if (inner) {
              inner.style.animation = "none"
              void inner.offsetWidth
              inner.style.animation = ""
            }
          }
        })
      }

      section.querySelectorAll<HTMLElement>("[data-select]").forEach((el) => {
        el.addEventListener("click", () => select(el.dataset.select))
      })

      // Hover sync between spine bars and tab rows
      const groups = new Map<string, HTMLElement[]>()
      section.querySelectorAll<HTMLElement>("[data-i]").forEach((el) => {
        const key = el.dataset.i!
        if (!groups.has(key)) groups.set(key, [])
        groups.get(key)!.push(el)
      })
      groups.forEach((els) => {
        const toggle = (on: boolean) => () =>
          els.forEach((el) => el.classList.toggle("hl", on))
        els.forEach((el) => {
          el.addEventListener("mouseenter", toggle(true))
          el.addEventListener("mouseleave", toggle(false))
        })
      })

      // Grow-in trigger
      const spine = section.querySelector<HTMLElement>(".v1-spine")
      if (spine) {
        const io = new IntersectionObserver(
          (obs) => {
            obs.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("in")
                io.unobserve(e.target)
              }
            })
          },
          { threshold: 0.25 },
        )
        io.observe(spine)
      }
    }
  }
</script>
