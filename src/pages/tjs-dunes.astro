---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Three.js Dunes — demo" description="Three.js sand-dune heightfield demo">
  <div id="dune-scope" class="relative bg-bone">
    <!-- Pinned canvas — sticky for the whole scope, same pattern as the hero:
         content scrolls over it, and the background leaves with the flow at
         the end of the scope. -->
    <div class="dune-bg" aria-hidden="true">
      <canvas id="dune-canvas"></canvas>
      <div
        id="webgl-fallback"
        class="hidden absolute inset-0 z-10 flex-col items-center justify-center gap-3 text-center px-6"
      >
        <p class="font-display text-paper text-xl">WebGL is unavailable in this browser.</p>
        <p class="font-mono text-[13px] uppercase tracking-[-0.02em] text-paper/60">
          GPU acceleration appears to be disabled — see
          <a href="/cpu-dunes" class="underline text-bio-lime">/cpu-dunes</a> for the CPU version.
        </p>
      </div>
    </div>

    <div class="dune-content">
      <section class="relative z-10 h-svh min-h-[560px] flex flex-col justify-between max-w-[1524px] mx-auto px-6 lg:px-12 pt-[128px] pb-10">
        <h1 class="font-display font-normal text-paper leading-none tracking-[-0.03em] text-[clamp(3rem,6vw,6rem)]">
          Three.js dunes.
        </h1>
        <div class="flex items-center gap-2.5">
          <span class="w-[6px] h-[6px] rounded-full bg-bio-lime" aria-hidden="true"></span>
          <span class="font-mono text-[13px] leading-none tracking-[-0.02em] uppercase text-paper/60">
            WebGL displaced plane&ensp;·&ensp;scroll to flatten the camera
          </span>
        </div>
      </section>

      <section class="relative z-10 min-h-[150vh] pt-28 pb-40">
        <div class="max-w-[560px] mx-6 md:mx-auto bg-bone/95 rounded-xl p-8">
          <p class="font-display text-ink leading-[1.35] text-lg">
            This panel scrolls over the pinned dunes. From the top of the page to the
            point where the background starts leaving the viewport, the camera pitch
            eases from 50° (looking down) to 30° (flatter, toward the horizon).
          </p>
        </div>
      </section>
    </div>
  </div>

  <section class="h-svh bg-bone flex items-center justify-center">
    <p class="font-mono text-[13px] uppercase tracking-[-0.02em] text-ink/50">end of dune scope</p>
  </section>

  <div
    id="pitch-readout"
    class="fixed bottom-3 right-4 z-50 font-mono text-[12px] text-paper/70 bg-ink/60 rounded px-2 py-1 pointer-events-none"
  >
    pitch 50.0°
  </div>
</Layout>

<style>
  .dune-bg {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    background-color: #0c0f0d;
  }

  .dune-bg canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Content rides above the sticky background, pulled up by exactly the
     background's height so the first section starts at the top of the page. */
  .dune-content {
    position: relative;
    z-index: 10;
    margin-top: calc(-1 * max(100svh, 560px));
  }
</style>

<script>
  {
    const scope = document.getElementById("dune-scope")!;
    const bg = scope.querySelector<HTMLElement>(".dune-bg")!;
    const canvas = document.getElementById("dune-canvas") as HTMLCanvasElement;
    const fallback = document.getElementById("webgl-fallback")!;
    const readout = document.getElementById("pitch-readout")!;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    /* Camera + world tuning (shared spec with /cpu-dunes) */
    const FOVY = 60;
    const AMP = 14; // dune amplitude: heights span ±AMP around the mean plane
    const CAM_H = 32; // camera height above the mean plane
    const SPEED = 10; // forward flight, world units / sec
    // Base dune wavelengths (world units) — anisotropic so dunes elongate
    // across the direction of travel. Matches /cpu-dunes (120-unit tile,
    // x scaled 0.62, z scaled 1.2).
    const WAVE_X = 120 / (2 * 0.62);
    const WAVE_Z = 120 / (2 * 1.2);
    const PITCH_TOP = 50; // degrees, at the top of the page
    const PITCH_END = 30; // degrees, when the background starts leaving

    /* Scroll → camera pitch. Progress 0 at the top of the page, 1 when the
       sticky background reaches the end of its scope and starts to leave. */
    let pitchDeg = PITCH_TOP;
    function updatePitch() {
      const range = Math.max(1, scope.offsetHeight - bg.offsetHeight);
      const p = Math.min(1, Math.max(0, window.scrollY / range));
      pitchDeg = PITCH_TOP + (PITCH_END - PITCH_TOP) * p;
      readout.textContent = `pitch ${pitchDeg.toFixed(1)}°`;
    }
    updatePitch();

    // Probe before pulling in three: in a GPU-disabled browser the module
    // (~150 kB gz) would be dead weight under a black canvas.
    const probe = document.createElement("canvas");
    const gl = probe.getContext("webgl2") || probe.getContext("webgl");

    if (!gl) {
      fallback.classList.remove("hidden");
      fallback.classList.add("flex");
      readout.textContent = "webgl unavailable";
    } else {
      init();
    }

    async function init() {
      const THREE = await import("three");

      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.75));

      const scene = new THREE.Scene();
      scene.background = new THREE.Color(0x0a0d0b);

      const camera = new THREE.PerspectiveCamera(FOVY, 1, 0.5, 800);
      camera.position.set(0, CAM_H, 0);

      /* The dune surface: a static plane displaced in the vertex shader by
         3-octave value noise over world xz. Forward motion translates the
         noise domain (uOff) rather than the mesh, so the plane never runs
         out of ground. Palette / lighting / fog mirror /cpu-dunes. */
      const uniforms = {
        uOff: { value: new THREE.Vector2(0, 0) },
        uAmp: { value: AMP },
        uCamPos: { value: camera.position },
      };

      const material = new THREE.ShaderMaterial({
        uniforms,
        vertexShader: /* glsl */ `
          uniform vec2 uOff;
          uniform float uAmp;
          varying vec3 vWorld;
          varying vec3 vNormal;
          varying float vT; // normalized height 0..1

          float hash(vec2 p) {
            p = fract(p * vec2(123.34, 456.21));
            p += dot(p, p + 45.32);
            return fract(p.x * p.y);
          }
          float vnoise(vec2 p) {
            vec2 i = floor(p);
            vec2 f = fract(p);
            f = f * f * (3.0 - 2.0 * f);
            float a = hash(i);
            float b = hash(i + vec2(1.0, 0.0));
            float c = hash(i + vec2(0.0, 1.0));
            float d = hash(i + vec2(1.0, 1.0));
            return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
          }
          // 3 octaves of long smooth swells, matching the CPU field's
          // character. The mid-heavy fbm is contrast-stretched then s-curved
          // so valleys/crests span the full range with a dune profile.
          float hgt(vec2 xz) {
            vec2 p = xz * vec2(${(1 / WAVE_X).toFixed(6)}, ${(1 / WAVE_Z).toFixed(6)});
            float v = vnoise(p) + vnoise(p * 2.0 + 13.1) * 0.45 + vnoise(p * 4.0 + 71.7) * 0.2025;
            float n = smoothstep(0.0, 1.0, clamp((v / 1.6525 - 0.28) / 0.44, 0.0, 1.0));
            return (n - 0.5) * 2.0 * uAmp;
          }

          void main() {
            vec3 wp = (modelMatrix * vec4(position, 1.0)).xyz;
            vec2 s = wp.xz + uOff;
            float h = hgt(s);
            wp.y = h;
            // finite-difference normal in world space
            float e = 2.0;
            float hx = hgt(s + vec2(e, 0.0)) - hgt(s - vec2(e, 0.0));
            float hz = hgt(s + vec2(0.0, e)) - hgt(s - vec2(0.0, e));
            vNormal = normalize(vec3(-hx, 2.0 * e, -hz));
            vWorld = wp;
            vT = clamp(h / (2.0 * uAmp) + 0.5, 0.0, 1.0);
            gl_Position = projectionMatrix * viewMatrix * vec4(wp, 1.0);
          }
        `,
        fragmentShader: /* glsl */ `
          uniform vec3 uCamPos;
          varying vec3 vWorld;
          varying vec3 vNormal;
          varying float vT;

          // hero palette: abyss → pine → forest → green → sage → mint → bone
          vec3 palette(float t) {
            vec3 c = vec3(0.02, 0.045, 0.032);
            c = mix(c, vec3(0.05, 0.13, 0.09), smoothstep(0.0, 0.18, t));
            c = mix(c, vec3(0.09, 0.24, 0.16), smoothstep(0.18, 0.36, t));
            c = mix(c, vec3(0.19, 0.42, 0.29), smoothstep(0.36, 0.55, t));
            c = mix(c, vec3(0.38, 0.63, 0.46), smoothstep(0.55, 0.72, t));
            c = mix(c, vec3(0.6, 0.83, 0.62), smoothstep(0.72, 0.87, t));
            c = mix(c, vec3(0.8, 0.87, 0.75), smoothstep(0.87, 1.0, t));
            return c;
          }

          void main() {
            vec3 n = normalize(vNormal);
            // sun low in the front-left, same heading as the CPU version
            vec3 sun = normalize(vec3(-0.66, 0.55, 0.75));
            float diff = clamp(dot(n, sun), 0.0, 1.0);
            float light = 0.35 + 0.85 * diff;
            vec3 col = palette(vT) * light;
            // bio-lime glint on sunlit crests only
            float sp = pow(diff, 6.0) * vT * vT * 0.5;
            col += vec3(0.808, 0.969, 0.62) * sp;
            // exponential distance fog into the dark ink horizon
            float dist = length(vWorld - uCamPos);
            float fog = 1.0 - exp(-dist * 0.008);
            col = mix(col, vec3(0.055, 0.1, 0.075), fog);
            gl_FragColor = vec4(col, 1.0);
          }
        `,
      });

      // 900×520 units, far edge fully fogged before the plane runs out
      const geometry = new THREE.PlaneGeometry(900, 520, 300, 190);
      geometry.rotateX(-Math.PI / 2);
      const plane = new THREE.Mesh(geometry, material);
      plane.position.set(0, 0, -245);
      plane.frustumCulled = false; // vertex displacement breaks the static bounds
      scene.add(plane);

      function render(tSec: number) {
        // forward flight: translate the noise domain toward the camera
        uniforms.uOff.value.set(8 * Math.sin(tSec * 0.05), -tSec * SPEED);
        camera.rotation.x = (-pitchDeg * Math.PI) / 180;
        renderer.render(scene, camera);
      }

      function resize() {
        const rect = bg.getBoundingClientRect();
        renderer.setSize(rect.width, rect.height, false);
        camera.aspect = rect.width / Math.max(rect.height, 1);
        camera.updateProjectionMatrix();
        updatePitch();
        if (reducedMotion || !running) render(reducedMotion ? 40 : lastT);
      }

      let rafId: number | null = null;
      let running = false;
      let lastT = 0;
      function loop(ms: number) {
        if (!running) return;
        lastT = ms / 1000;
        render(lastT);
        rafId = requestAnimationFrame(loop);
      }
      function start() {
        if (running || reducedMotion) return;
        running = true;
        rafId = requestAnimationFrame(loop);
      }
      function stop() {
        running = false;
        if (rafId !== null) cancelAnimationFrame(rafId);
        rafId = null;
      }

      let scrollQueued = false;
      window.addEventListener(
        "scroll",
        () => {
          if (!scrollQueued) {
            scrollQueued = true;
            requestAnimationFrame(() => {
              scrollQueued = false;
              updatePitch();
              // keep the pitch live while paused (reduced motion / offscreen)
              if (!running) render(reducedMotion ? 40 : lastT);
            });
          }
        },
        { passive: true }
      );

      let resizeTimer: number | undefined;
      new ResizeObserver(() => {
        clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(resize, 120);
      }).observe(bg);
      resize();

      if (reducedMotion) {
        render(40);
      } else {
        new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              entry.isIntersecting ? start() : stop();
            }
          },
          { threshold: 0 }
        ).observe(scope);
        document.addEventListener("visibilitychange", () => {
          document.hidden ? stop() : start();
        });
        start();
      }
    }
  }
</script>
