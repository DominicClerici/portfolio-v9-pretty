---
import Layout from "../layouts/Layout.astro"
---

<Layout
  title="CPU Dunes — demo"
  description="Dependency-free WebGL sand-dune demo with a Canvas2D fallback"
>
  <div id="dune-scope" class="relative bg-bone">
    <!-- Pinned canvas — sticky for the whole scope, same pattern as the hero:
         content scrolls over it, and the background leaves with the flow at
         the end of the scope. -->
    <div class="dune-bg" aria-hidden="true">
      <canvas id="dune-canvas"></canvas>
    </div>

    <div class="dune-content">
      <section
        class="relative z-10 h-svh min-h-[560px] flex flex-col justify-between max-w-[1524px] mx-auto px-6 lg:px-12 pt-[128px] pb-10"
      >
        <h1
          class="font-display font-normal text-paper leading-none tracking-[-0.03em] text-[clamp(3rem,6vw,6rem)]"
        >
          CPU dunes.
        </h1>
        <div class="flex items-center gap-2.5">
          <span
            class="w-[6px] h-[6px] rounded-full bg-bio-lime"
            aria-hidden="true"></span>
          <span
            id="dune-mode"
            class="font-mono text-[13px] leading-none tracking-[-0.02em] uppercase text-paper/60"
          >
            Canvas2D heightfield raymarch&ensp;·&ensp;scroll to flatten the
            camera
          </span>
        </div>
      </section>

      <section class="relative z-10 min-h-[150vh] pt-28 pb-40">
        <div class="max-w-[560px] mx-6 md:mx-auto bg-bone/95 rounded-xl p-8">
          <p class="font-display text-ink leading-[1.35] text-lg">
            This panel scrolls over the pinned dunes. From the top of the page
            to the point where the background starts leaving the viewport, the
            camera pitch eases from 50° (looking down) to 30° (flatter, toward
            the horizon).
          </p>
        </div>
      </section>
    </div>
  </div>

  <section class="h-svh bg-bone flex items-center justify-center">
    <p class="font-mono text-[13px] uppercase tracking-[-0.02em] text-ink/50">
      end of dune scope
    </p>
  </section>

  <div
    id="pitch-readout"
    class="fixed bottom-3 right-4 z-50 font-mono text-[12px] text-paper/70 bg-ink/60 rounded px-2 py-1 pointer-events-none"
  >
    pitch 50.0°
  </div>
</Layout>

<style>
  .dune-bg {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    background-color: #081417;
  }

  .dune-bg canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* Content rides above the sticky background, pulled up by exactly the
     background's height so the first section starts at the top of the page. */
  .dune-content {
    position: relative;
    z-index: 10;
    margin-top: calc(-1 * max(100svh, 560px));
  }
</style>

<script>
  {
    const scope = document.getElementById("dune-scope")!
    const bg = scope.querySelector<HTMLElement>(".dune-bg")!
    let canvas = document.getElementById("dune-canvas") as HTMLCanvasElement
    const readout = document.getElementById("pitch-readout")!
    const modeLabel = document.getElementById("dune-mode")!
    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches

    /* ── Dunes without the three.js bundle ──
       Primary path is raw WebGL: the exact displaced-plane shaders from
       /tjs-dunes, driven by ~150 lines of hand-rolled GL setup (one grid
       mesh, one program, one view-projection matrix). Full-resolution,
       hardware-accelerated, zero dependencies. When WebGL is unavailable
       (or the context dies), it falls back to the original Canvas2D
       heightfield raymarch at reduced resolution. */

    /* Feature flags */
    // Dune bob: crests gently rise as nearby troughs sink while the field
    // drifts past. Set false to freeze the heightfield vertically.
    const DUNE_BOB = true
    const BOB_AMP = 0.07 // fraction of local height the bob adds/removes
    const BOB_SPEED = 0.6 // radians / sec

    /* Camera + world tuning (shared spec with /tjs-dunes) */
    const FOVY = (60 * Math.PI) / 180
    const AMP = 14 // dune amplitude scale: heights span −1.05·AMP … +1.45·AMP
    const SPEED = 10 // forward flight, world units / sec
    const CAM_H_TOP = 128 // camera height above the mean plane, at the top of the page
    const CAM_H_END = 32 // camera height, when the background starts leaving
    const PITCH_TOP = 50 // degrees, at the top of the page
    const PITCH_END = 35 // degrees, when the background starts leaving
    // Base dune wavelengths (world units) — anisotropic so dunes elongate
    // across the direction of travel (120-unit tile, x scaled 0.5, z 0.9).
    // Long wavelengths relative to AMP keep the swells sparse and low-slope.
    const WAVE_X = 120 / (2 * 0.5)
    const WAVE_Z = 120 / (2 * 0.9)

    /* ── Lighting, material & color config ──
       Shared verbatim by the GL shaders (baked in at compile time) and the
       Canvas2D painter, so tweaks here stay in parity across both backends. */
    // Sun, in forward-relative coords (+x right, +y up, +z toward the
    // horizon). The GL path flips z internally — its camera looks down −z.
    const SUN_DIR = [-0.66, 0.48, 0.75]
    const SUN_COLOR = [1.35, 0.85, 0.72] // warm rose key light
    const DIFFUSE_WRAP = 2.8 // powder-diffuse exponent: higher = deeper shade
    // The long-wavelength swells are low-slope, so raw normals barely tilt;
    // exaggerating their xz for shading is what makes the light sculpt them
    const NORMAL_GAIN = 2.4
    const SKY_COLOR = [0.38, 0.52, 0.62] // violet-teal fill
    const SKY_FILL_FLOOR = 0.25 // fill = FLOOR + GAIN·n.y — low floor keeps
    const SKY_FILL_GAIN = 0.35 //   shaded faces genuinely dark
    const RIM_COLOR = [1.0, 0.7, 0.75] // rose rim on crest silhouettes
    const RIM_STRENGTH = 0.16
    const RIM_POW = 3.0
    // Grain sparkle (replaces the old broad specular glint)
    const SPARKLE = true
    const SPARKLE_COLOR = [1.35, 1.1, 1.15] // pink-white glints
    const SPARKLE_DENSITY = 0.01 // fraction of grain cells lit per twinkle tick
    const SPARKLE_STRENGTH = 3.0
    const SPARKLE_CELL = 3.0 // grain cells per world unit (GL path)
    const SPARKLE_HZ = 2.5 // twinkle re-roll rate, staggered per grain
    // Atmosphere
    const FOG_COLOR = [0.16, 0.2, 0.28] // dusk purple-teal haze
    const FOG_GLOW_COLOR = [0.42, 0.27, 0.3] // rose glow where the view runs sunward
    const FOG_GLOW_POW = 3.0
    const FOG_DENSITY = 0.0028
    const TONEMAP_EXPOSURE = 1.6 // soft-clip 1 − e^(−col·k): higher = brighter mids
    // Albedo ramp, elevation-keyed — desaturated so the light tints carry hue
    const ALBEDO_STOPS: [number, [number, number, number]][] = [
      [0.0, [0.1, 0.2, 0.22]], // deep sea teal — valley floors
      [0.18, [0.16, 0.33, 0.36]], // lighter teal
      [0.38, [0.18, 0.46, 0.34]], // sea green
      [0.56, [0.3, 0.6, 0.4]], // soft green
      [0.74, [0.52, 0.74, 0.48]], // sage
      [0.88, [0.76, 0.84, 0.66]], // pale lime
      [1.0, [0.93, 0.93, 0.82]], // sand cream — crests
    ]
    const SWING_WEIGHT = 0.08 // spot-to-spot hue shimmer (demoted from 0.65)
    const BREATH_AMP = 0.06 // slow global drift through the ramp

    // Derived: horizontal sun heading (unit), for the fog glow
    const SUN_H = (() => {
      const l = Math.hypot(SUN_DIR[0], SUN_DIR[2])
      return [SUN_DIR[0] / l, SUN_DIR[2] / l]
    })()
    // GLSL generated from the config so both backends share one source of truth
    const f1 = (x: number) => x.toFixed(3)
    const v3 = (c: number[]) => `vec3(${c.map(f1).join(", ")})`
    const albedoGLSL = ALBEDO_STOPS.slice(1)
      .map(
        ([p, c], i) =>
          `c = mix(c, ${v3(c)}, smoothstep(${f1(ALBEDO_STOPS[i][0])}, ${f1(p)}, t));`,
      )
      .join("\n          ")

    /* Scroll → camera pitch + height. Progress 0 at the top of the page, 1
       when the sticky background reaches the end of its scope and starts
       to leave. */
    let pitchDeg = PITCH_TOP
    let camH = CAM_H_TOP
    function updateCamera() {
      const range = Math.max(1, scope.offsetHeight - bg.offsetHeight)
      const p = Math.min(1, Math.max(0, window.scrollY / range))
      pitchDeg = PITCH_TOP + (PITCH_END - PITCH_TOP) * p
      camH = CAM_H_TOP + (CAM_H_END - CAM_H_TOP) * p
      readout.textContent = `pitch ${pitchDeg.toFixed(1)}° · height ${camH.toFixed(1)}`
    }

    type Impl = { render: (tSec: number) => void; resize: () => void }
    let impl: Impl

    /* ── Shared render-loop harness (raf, scroll, resize, visibility) ── */
    let rafId: number | null = null
    let running = false
    let lastT = 0
    function loop(ms: number) {
      if (!running) return
      lastT = ms / 1000
      impl.render(lastT)
      rafId = requestAnimationFrame(loop)
    }
    function start() {
      if (running || reducedMotion) return
      running = true
      rafId = requestAnimationFrame(loop)
    }
    function stop() {
      running = false
      if (rafId !== null) cancelAnimationFrame(rafId)
      rafId = null
    }

    /* ── Raw WebGL backend ── */
    // Set once a GL context has been requested on the canvas: the element is
    // then committed to WebGL, so the CPU fallback must swap in a fresh one.
    let glTouched = false

    function startGL(): Impl | null {
      const attrs: WebGLContextAttributes = {
        antialias: true,
        alpha: false,
        powerPreference: "low-power",
      }
      const gl = (canvas.getContext("webgl2", attrs) ||
        canvas.getContext("webgl", attrs)) as WebGLRenderingContext | null
      if (!gl) return null
      glTouched = true

      const vsSrc = `
        attribute vec2 aXZ;
        uniform mat4 uVP;
        uniform vec2 uOff;
        uniform float uAmp;
        uniform float uTime;
        varying vec3 vWorld;
        varying vec3 vNormal;
        varying float vT;

        float hash(vec2 p) {
          p = fract(p * vec2(123.34, 456.21));
          p += dot(p, p + 45.32);
          return fract(p.x * p.y);
        }
        float vnoise(vec2 p) {
          vec2 i = floor(p);
          vec2 f = fract(p);
          f = f * f * (3.0 - 2.0 * f);
          float a = hash(i);
          float b = hash(i + vec2(1.0, 0.0));
          float c = hash(i + vec2(0.0, 1.0));
          float d = hash(i + vec2(1.0, 1.0));
          return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
        }
        // 3 octaves of long smooth swells with the high frequencies kept
        // quiet, so the field reads as flowing spaced-out dunes instead of
        // clustered churn. The centred sum runs through a strictly-monotone
        // rational soft-clip (tanh approximation — its derivative only
        // reaches zero at |x| = 3, outside our ±2.1 range) rather than a
        // clamped smoothstep, so slope never dies: no plateaus, no flat
        // floors. A final asymmetric gain dips the floors slightly and
        // stretches the crests — heights span −1.05·uAmp … +1.45·uAmp.
        float hgt(vec2 xz) {
          vec2 p = xz * vec2(${(1 / WAVE_X).toFixed(6)}, ${(1 / WAVE_Z).toFixed(6)});
          float v = vnoise(p) - 0.5;
          v += (vnoise(p * 2.0 + 13.1) - 0.5) * 0.38;
          v += (vnoise(p * 4.0 + 71.7) - 0.5) * 0.10;
          float x = v * 2.84;
          float d = x * (27.0 + x * x) / (27.0 + 9.0 * x * x);
          // In-place bob: local height scales on a slow sine whose phase
          // varies across the field, so crests lift while nearby troughs
          // sink. Lives inside hgt so the finite-difference normals track
          // it. DUNE_BOB=false folds the amplitude to 0.0 at compile time.
          d *= 1.0 + ${(DUNE_BOB ? BOB_AMP : 0).toFixed(3)} * sin(uTime * ${BOB_SPEED.toFixed(3)} + xz.x * 0.045 + xz.y * 0.06);
          return uAmp * d * (1.25 + 0.2 * d);
        }

        void main() {
          vec2 s = aXZ + uOff;
          float h = hgt(s);
          vec3 wp = vec3(aXZ.x, h, aXZ.y);
          float e = 2.0;
          float hx = hgt(s + vec2(e, 0.0)) - hgt(s - vec2(e, 0.0));
          float hz = hgt(s + vec2(0.0, e)) - hgt(s - vec2(0.0, e));
          vNormal = normalize(vec3(-hx, 2.0 * e, -hz));
          vWorld = wp;
          // normalized against the realistic height span (extremes are rare
          // post-soft-clip) so the full palette actually gets used
          vT = clamp((h / uAmp + 0.95) * 0.45, 0.0, 1.0);
          gl_Position = uVP * vec4(wp, 1.0);
        }
      `

      const fsSrc = `
        #ifdef GL_FRAGMENT_PRECISION_HIGH
        precision highp float;
        #else
        precision mediump float;
        #endif
        uniform vec3 uCamPos;
        uniform float uTime;
        uniform vec2 uSpark;
        varying vec3 vWorld;
        varying vec3 vNormal;
        varying float vT;

        float hash(vec2 p) {
          p = fract(p * vec2(123.34, 456.21));
          p += dot(p, p + 45.32);
          return fract(p.x * p.y);
        }

        // elevation-keyed albedo, generated from ALBEDO_STOPS (shared with
        // the CPU LUT)
        vec3 albedo(float t) {
          vec3 c = ${v3(ALBEDO_STOPS[0][1])};
          ${albedoGLSL}
          return c;
        }

        void main() {
          vec3 n = normalize(vNormal * vec3(${f1(NORMAL_GAIN)}, 1.0, ${f1(NORMAL_GAIN)}));
          // SUN_DIR is forward-relative; this camera looks down -z, so z is
          // flipped to keep the sun in front, matching the CPU path
          vec3 sun = normalize(vec3(${f1(SUN_DIR[0])}, ${f1(SUN_DIR[1])}, ${f1(-SUN_DIR[2])}));
          vec3 V = normalize(uCamPos - vWorld);

          // sand material: wrapped powder diffuse — a long soft rolloff into
          // shade instead of a hard Lambert terminator — under a rose sun,
          // over a low violet-teal sky fill
          float lam = dot(n, sun);
          float diff = pow(clamp(lam * 0.5 + 0.5, 0.0, 1.0), ${f1(DIFFUSE_WRAP)});
          vec3 light = ${v3(SKY_COLOR)} * (${f1(SKY_FILL_FLOOR)} + ${f1(SKY_FILL_GAIN)} * n.y)
                     + ${v3(SUN_COLOR)} * diff;

          // albedo coordinate: elevation carries the structure, detuned by a
          // light spot-to-spot shimmer and a slow global breath
          float ang = uTime * 0.2;
          float swing = n.x * cos(ang) + n.z * sin(ang);
          float t = clamp(0.95 * vT + 0.02 + ${f1(SWING_WEIGHT)} * swing + ${f1(BREATH_AMP)} * sin(uTime * 0.09), 0.0, 1.0);
          vec3 col = albedo(t) * light;

          // rose rim where crests graze the view direction
          float rim = pow(1.0 - clamp(dot(n, V), 0.0, 1.0), ${f1(RIM_POW)});
          col += ${v3(RIM_COLOR)} * (rim * ${f1(RIM_STRENGTH)} * (0.4 + 0.6 * diff));

          // the length is computed on a scaled vector so mediump devices
          // don't overflow
          float dist = length((vWorld - uCamPos) * 0.02) * 50.0;
          float fog = 1.0 - exp(-dist * ${f1(FOG_DENSITY)});
${
  SPARKLE
    ? `
          // grain sparkle: world-anchored cells re-roll on staggered clocks;
          // survivors aligned with the sun/view half-vector spike pink-white,
          // gated to sunlit faces
          vec2 cell = floor((vWorld.xz + uSpark) * ${f1(SPARKLE_CELL)});
          float tick = floor(uTime * ${f1(SPARKLE_HZ)} + 7.0 * hash(cell));
          float rnd = hash(cell + vec2(tick * 0.37, tick * 0.11));
          float glint = step(${f1(1 - SPARKLE_DENSITY)}, rnd);
          float align = pow(clamp(dot(n, normalize(sun + V)), 0.0, 1.0), 6.0);
          // gate by how much the slope tilts toward the sun (flat ground →
          // zero) — n·sun alone is dominated by the uniform up-component on
          // this low-slope terrain and would pass everywhere
          float tilt = clamp((n.x * ${f1(SUN_H[0])} + n.z * ${f1(-SUN_H[1])}) * 3.0, 0.0, 1.0);
          // squared fog fade: distant grain cells alias below pixel size and
          // would otherwise carpet the midfield with glitter
          float sfade = (1.0 - fog) * (1.0 - fog);
          col += ${v3(SPARKLE_COLOR)} * (glint * align * tilt * tilt * sfade * ${f1(SPARKLE_STRENGTH)});
`
    : ""
}
          // soft tonemap: sun + sparkle saturate into rose-cream, never clip
          col = 1.0 - exp(-col * ${f1(TONEMAP_EXPOSURE)});

          // dusk haze, tinted rose where the view runs toward the sun (the
          // glow dot uses unnormalized horizontal V — no NaN when looking
          // straight down, and glow fades there naturally)
          float glow = pow(clamp(dot(vec3(-V.x, 0.0, -V.z), vec3(${f1(SUN_H[0])}, 0.0, ${f1(-SUN_H[1])})), 0.0, 1.0), ${f1(FOG_GLOW_POW)});
          col = mix(col, mix(${v3(FOG_COLOR)}, ${v3(FOG_GLOW_COLOR)}, glow), fog);
          gl_FragColor = vec4(col, 1.0);
        }
      `

      function compile(type: number, src: string) {
        const s = gl!.createShader(type)!
        gl!.shaderSource(s, src)
        gl!.compileShader(s)
        if (!gl!.getShaderParameter(s, gl!.COMPILE_STATUS)) {
          console.error("dune shader:", gl!.getShaderInfoLog(s))
          return null
        }
        return s
      }
      const vs = compile(gl.VERTEX_SHADER, vsSrc)
      const fs = compile(gl.FRAGMENT_SHADER, fsSrc)
      if (!vs || !fs) return null
      const prog = gl.createProgram()!
      gl.attachShader(prog, vs)
      gl.attachShader(prog, fs)
      gl.linkProgram(prog)
      if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) {
        console.error("dune program:", gl.getProgramInfoLog(prog))
        return null
      }
      gl.useProgram(prog)

      /* Grid mesh matching the tjs plane: 900×520 units at z ∈ [-505, 15],
         300×190 segments — 57k vertices, small enough for Uint16 indices. */
      const SX = 300
      const SZ = 190
      const verts = new Float32Array((SX + 1) * (SZ + 1) * 2)
      let vi = 0
      for (let iz = 0; iz <= SZ; iz++) {
        const z = -505 + (iz / SZ) * 520
        for (let ix = 0; ix <= SX; ix++) {
          verts[vi++] = -450 + (ix / SX) * 900
          verts[vi++] = z
        }
      }
      const idx = new Uint16Array(SX * SZ * 6)
      let ii = 0
      for (let iz = 0; iz < SZ; iz++) {
        for (let ix = 0; ix < SX; ix++) {
          const a = iz * (SX + 1) + ix
          const b = a + SX + 1
          idx[ii++] = a
          idx[ii++] = b
          idx[ii++] = a + 1
          idx[ii++] = a + 1
          idx[ii++] = b
          idx[ii++] = b + 1
        }
      }
      gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer())
      gl.bufferData(gl.ARRAY_BUFFER, verts, gl.STATIC_DRAW)
      gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, gl.createBuffer())
      gl.bufferData(gl.ELEMENT_ARRAY_BUFFER, idx, gl.STATIC_DRAW)
      const aXZ = gl.getAttribLocation(prog, "aXZ")
      gl.enableVertexAttribArray(aXZ)
      gl.vertexAttribPointer(aXZ, 2, gl.FLOAT, false, 0, 0)

      const uVP = gl.getUniformLocation(prog, "uVP")
      const uOff = gl.getUniformLocation(prog, "uOff")
      const uTime = gl.getUniformLocation(prog, "uTime")
      const uCamPos = gl.getUniformLocation(prog, "uCamPos")
      const uSpark = gl.getUniformLocation(prog, "uSpark")
      gl.uniform1f(gl.getUniformLocation(prog, "uAmp"), AMP)

      gl.enable(gl.DEPTH_TEST)
      // matches the fog haze at the horizon
      gl.clearColor(FOG_COLOR[0], FOG_COLOR[1], FOG_COLOR[2], 1)

      // If the GPU goes away mid-session, degrade to the CPU painter instead
      // of freezing on a dead canvas.
      canvas.addEventListener(
        "webglcontextlost",
        (e) => {
          e.preventDefault()
          stop()
          impl = startCPU()
          setModeLabel(false)
          impl.resize()
          start()
        },
        { once: true },
      )

      let aspect = 1
      const vp = new Float32Array(16)

      function render(tSec: number) {
        const p = (pitchDeg * Math.PI) / 180
        const c = Math.cos(p)
        const s = Math.sin(p)
        const f = 1 / Math.tan(FOVY / 2)
        const near = 0.5
        const far = 800
        const C = (far + near) / (near - far)
        const D = (2 * far * near) / (near - far)
        // VP = perspective(FOVY, aspect) · rotX(pitch) · translate(0, -camH, 0)
        // composed by hand (column-major); everything not set stays 0.
        vp[0] = f / aspect
        vp[5] = f * c
        vp[6] = C * s
        vp[7] = -s
        vp[9] = -f * s
        vp[10] = C * c
        vp[11] = -c
        vp[13] = -camH * f * c
        vp[14] = -camH * C * s + D
        vp[15] = camH * s
        gl!.uniformMatrix4fv(uVP, false, vp)
        gl!.uniform3f(uCamPos, 0, camH, 0)
        // forward flight: translate the noise domain toward the camera
        const offX = 8 * Math.sin(tSec * 0.05)
        const offZ = -tSec * SPEED
        gl!.uniform2f(uOff, offX, offZ)
        // sparkle-cell offset, wrapped so fragment-shader floats keep
        // precision as the flight distance grows (the wrap just reshuffles
        // all grains once every ~51s — invisible among constant twinkle)
        gl!.uniform2f(uSpark, offX % 512, offZ % 512)
        gl!.uniform1f(uTime, tSec)
        gl!.clear(gl!.COLOR_BUFFER_BIT | gl!.DEPTH_BUFFER_BIT)
        gl!.drawElements(gl!.TRIANGLES, idx.length, gl!.UNSIGNED_SHORT, 0)
      }

      function resize() {
        const rect = bg.getBoundingClientRect()
        const dpr = Math.min(window.devicePixelRatio || 1, 1.75)
        canvas.width = Math.max(1, Math.round(rect.width * dpr))
        canvas.height = Math.max(1, Math.round(rect.height * dpr))
        gl!.viewport(0, 0, canvas.width, canvas.height)
        aspect = canvas.width / Math.max(canvas.height, 1)
        updateCamera()
        if (reducedMotion || !running) render(reducedMotion ? 40 : lastT)
      }

      return { render, resize }
    }

    /* ── Canvas2D fallback backend ──
       Per screen column, a ray is marched across a tileable fbm heightfield;
       each terrain sample is perspective-projected (with real camera pitch)
       to a screen row and drawn as a vertical span, nearest-first. Runs at a
       tiny resolution (~240px wide) into ImageData and is upscaled by
       drawImage + CSS smoothing — same no-WebGL recipe as the hero. */
    function startCPU(): Impl {
      if (glTouched) {
        // the old canvas is committed to a (dead) WebGL context
        const fresh = document.createElement("canvas")
        fresh.id = "dune-canvas"
        canvas.replaceWith(fresh)
        canvas = fresh
        glTouched = false
      }
      const ctx = canvas.getContext("2d")!

      const NEAR = 2.5
      const FAR = 300
      const WORLD_PER_TILE = 120 // noise tile (256 texels) spans this many units
      // Normalized sun (forward-relative coords match this path's +z-ahead
      // march, so SUN_DIR is used as-is)
      const SL = Math.hypot(SUN_DIR[0], SUN_DIR[1], SUN_DIR[2])
      const sunX = SUN_DIR[0] / SL
      const sunY = SUN_DIR[1] / SL
      const sunZ = SUN_DIR[2] / SL

      /* Tileable fbm texture, computed once — 3 wrapped value-noise octaves.
         Fewer/larger octaves than the hero field: dunes want long smooth
         swells, not fine churn. */
      const TS = 256
      const TMASK = TS - 1
      const T = (() => {
        let s = 4243
        const rand = () => {
          s |= 0
          s = (s + 0x6d2b79f5) | 0
          let t = Math.imul(s ^ (s >>> 15), 1 | s)
          t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t
          return ((t ^ (t >>> 14)) >>> 0) / 4294967296
        }
        const out = new Float32Array(TS * TS)
        // high octaves kept quiet (matching the GL weights) so the field is
        // flowing spaced-out swells, not clustered churn
        for (const [L, amp] of [
          [2, 1],
          [4, 0.38],
          [8, 0.1],
        ]) {
          const lat = new Float32Array(L * L)
          for (let i = 0; i < L * L; i++) lat[i] = rand()
          for (let y = 0; y < TS; y++) {
            const gy = (y / TS) * L
            const y0 = Math.floor(gy)
            let fy = gy - y0
            fy = fy * fy * (3 - 2 * fy)
            const r0 = (y0 % L) * L
            const r1 = ((y0 + 1) % L) * L
            for (let x = 0; x < TS; x++) {
              const gx = (x / TS) * L
              const x0 = Math.floor(gx)
              let fx = gx - x0
              fx = fx * fx * (3 - 2 * fx)
              const x1 = (x0 + 1) % L
              const a = lat[r0 + x0]
              const b = lat[r0 + x1]
              const c = lat[r1 + x0]
              const d = lat[r1 + x1]
              const ab = a + (b - a) * fx
              out[y * TS + x] += amp * (ab + (c + (d - c) * fx - ab) * fy)
            }
          }
        }
        // Histogram-equalize: the low octave has only a handful of lattice
        // cells, so the raw distribution is heavily skewed per seed.
        // Rank-normalizing keeps every ridge line in place but spreads heights
        // uniformly over [0,1], so the full valley→crest palette appears.
        const order = Array.from(out.keys()).sort((a, b) => out[a] - out[b])
        const eq = new Float32Array(out.length)
        for (let r = 0; r < order.length; r++)
          eq[order[r]] = r / (order.length - 1)
        return eq
      })()

      const W2T = TS / WORLD_PER_TILE // world units → texels
      // Dunes elongate across the direction of travel: longer wavelength in x.
      // Scales match the GL WAVE_X/WAVE_Z — sparse, low-slope swells.
      const AX = 0.5
      const AZ = 0.9

      // dune-bob phase for this frame, advanced in paint(); matches the
      // GL vertex shader's uTime * BOB_SPEED term
      let bobT = 0
      const BOB_A = DUNE_BOB ? BOB_AMP : 0

      // Bilinear sample with wraparound, world coordinates → height in units
      function height(wx: number, wz: number) {
        const x = wx * W2T * AX
        const y = wz * W2T * AZ
        const xi = Math.floor(x)
        const yi = Math.floor(y)
        const fx = x - xi
        const fy = y - yi
        const x0 = xi & TMASK
        const x1 = (xi + 1) & TMASK
        const r0 = (yi & TMASK) * TS
        const r1 = ((yi + 1) & TMASK) * TS
        const ab = T[r0 + x0] + (T[r0 + x1] - T[r0 + x0]) * fx
        const v = ab + (T[r1 + x0] + (T[r1 + x1] - T[r1 + x0]) * fx - ab) * fy
        // The equalized field is uniform on [0,1]: recentre it and apply the
        // same asymmetric gain as the GL path — no clamp or smoothstep, so
        // slope never dies into a plateau; floors dip slightly below −AMP
        // and crests stretch to +1.45·AMP
        let c = (v - 0.5) * 2
        // in-place bob, same phase field as the GL shader — inside height()
        // so the finite-difference normals track it
        if (BOB_A) c *= 1 + BOB_A * Math.sin(bobT + wx * 0.045 + wz * 0.06)
        return AMP * c * (1.25 + 0.2 * c)
      }

      /* Elevation → albedo LUT, built from ALBEDO_STOPS — the same stops the
         GL ramp is generated from, so the surfaces match exactly. */
      const LUT_N = 512
      const lutR = new Float32Array(LUT_N)
      const lutG = new Float32Array(LUT_N)
      const lutB = new Float32Array(LUT_N)
      {
        const smooth = (e0: number, e1: number, v: number) => {
          const t = Math.min(1, Math.max(0, (v - e0) / (e1 - e0)))
          return t * t * (3 - 2 * t)
        }
        const stops = ALBEDO_STOPS
        for (let i = 0; i < LUT_N; i++) {
          const f = i / (LUT_N - 1)
          let s = 0
          while (s < stops.length - 2 && f > stops[s + 1][0]) s++
          const [p0, c0] = stops[s]
          const [p1, c1] = stops[s + 1]
          const m = smooth(p0, p1, f)
          lutR[i] = (c0[0] + (c1[0] - c0[0]) * m) * 255
          lutG[i] = (c0[1] + (c1[1] - c0[1]) * m) * 255
          lutB[i] = (c0[2] + (c1[2] - c0[2]) * m) * 255
        }
      }

      // Prescaled light/atmosphere colors from the shared config
      const FOG_R = FOG_COLOR[0] * 255,
        FOG_G = FOG_COLOR[1] * 255,
        FOG_B = FOG_COLOR[2] * 255
      const GLOW_R = FOG_GLOW_COLOR[0] * 255,
        GLOW_G = FOG_GLOW_COLOR[1] * 255,
        GLOW_B = FOG_GLOW_COLOR[2] * 255
      const RIM_R = RIM_COLOR[0] * 255,
        RIM_G = RIM_COLOR[1] * 255,
        RIM_B = RIM_COLOR[2] * 255

      // Soft tonemap as a LUT over 0..1023 of 255-scaled linear light —
      // same 1 − e^(−col·k) curve as the fragment shader, without per-sample exp
      const TONE = new Float32Array(1024)
      for (let i = 0; i < 1024; i++)
        TONE[i] = 255 * (1 - Math.exp((-i / 255) * TONEMAP_EXPOSURE))

      const off = document.createElement("canvas")
      const offCtx = off.getContext("2d")!
      let W = 0
      let H = 0
      let img: ImageData | null = null
      let blurTmp: Float32Array | null = null
      // per-pixel sparkle gate (sun-facing × fog), filled during the march
      let gate = new Float32Array(0)

      function paint(tSec: number) {
        if (!img) return
        const data = img.data
        const pitch = (pitchDeg * Math.PI) / 180
        const cosP = Math.cos(pitch)
        const sinP = Math.sin(pitch)
        const tanHalfY = Math.tan(FOVY / 2)
        const tanHalfX = tanHalfY * (W / H)
        const camX = 8 * Math.sin(tSec * 0.05)
        const camZ = tSec * SPEED // forward flight: +z is ahead
        // color-composite drivers, matched to the fragment shader: a slowly
        // spinning reference heading for the facing-direction term, plus a
        // global palette breath
        const rotC = Math.cos(tSec * 0.2)
        const rotS = Math.sin(tSec * 0.2)
        const breathe = 0.08 * Math.sin(tSec * 0.09)
        bobT = tSec * BOB_SPEED

        // Sky: only a thin band ever shows (horizon sits at/above the top edge
        // at 30–50° pitch with a 60° fov) — a dark dusk gradient into the haze.
        const skyR = new Float32Array(H)
        const skyG = new Float32Array(H)
        const skyB = new Float32Array(H)
        for (let y = 0; y < H; y++) {
          const t = y / H
          skyR[y] = (0.04 + (FOG_COLOR[0] - 0.04) * t) * 255
          skyG[y] = (0.05 + (FOG_COLOR[1] - 0.05) * t) * 255
          skyB[y] = (0.09 + (FOG_COLOR[2] - 0.09) * t) * 255
        }

        const NE = 3.0 // normal finite-difference epsilon

        for (let x = 0; x < W; x++) {
          const ndcX = ((x + 0.5) / W) * 2 - 1
          const lat = ndcX * tanHalfX // lateral offset per unit of forward dist
          // dusk haze tinted rose where this column's view runs toward the sun
          const invL = 1 / Math.sqrt(lat * lat + 1)
          let glow = (lat * SUN_H[0] + SUN_H[1]) * invL
          glow = glow < 0 ? 0 : Math.pow(glow, FOG_GLOW_POW)
          const fogCR = FOG_R + (GLOW_R - FOG_R) * glow
          const fogCG = FOG_G + (GLOW_G - FOG_G) * glow
          const fogCB = FOG_B + (GLOW_B - FOG_B) * glow
          let prevY = H // lowest unfilled row (fills bottom-up, near-to-far)
          // previous visible sample's shaded color, for Gouraud interpolation
          let pr = 0
          let pg = 0
          let pb = 0
          let pgat = 0
          let havePrev = false
          let f = NEAR
          let df = 0.25
          while (f < FAR && prevY > 0) {
            const wx = camX + lat * f
            const wz = camZ + f
            const h = height(wx, wz)
            const dh = h - camH
            // camera-space projection with real pitch (θ down):
            // y = dh·cosθ + f·sinθ, z = f·cosθ − dh·sinθ
            const zc = f * cosP - dh * sinP
            const yc = dh * cosP + f * sinP
            const sy = (0.5 - yc / zc / (2 * tanHalfY)) * H
            let yi = sy | 0
            if (yi < prevY) {
              // visible span — shade once per sample (hidden samples skip this)
              const t01 = Math.min(1, Math.max(0, (h / AMP + 0.95) * 0.45))
              // normal from forward differences, xz exaggerated by
              // NORMAL_GAIN — same sculpting as the fragment shader
              const nx = (-(height(wx + NE, wz) - h) / NE) * NORMAL_GAIN
              const nz = (-(height(wx, wz + NE) - h) / NE) * NORMAL_GAIN
              const inv = 1 / Math.sqrt(nx * nx + 1 + nz * nz)
              // albedo coordinate: elevation + light shimmer + breath
              const swing = (nx * rotC + nz * rotS) * inv
              let tc = 0.95 * t01 + 0.02 + SWING_WEIGHT * swing + breathe
              if (tc < 0) tc = 0
              else if (tc > 1) tc = 1
              const idx = (tc * (LUT_N - 1)) | 0
              // wrapped powder diffuse — soft rolloff into shade, matched to
              // the fragment shader's sand material
              const lam = (nx * sunX + sunY + nz * sunZ) * inv
              let ndl = lam * 0.5 + 0.5
              if (ndl < 0) ndl = 0
              else if (ndl > 1) ndl = 1
              const diff = Math.pow(ndl, DIFFUSE_WRAP)
              const fill = SKY_FILL_FLOOR + SKY_FILL_GAIN * inv
              const lr = SKY_COLOR[0] * fill + SUN_COLOR[0] * diff
              const lg = SKY_COLOR[1] * fill + SUN_COLOR[1] * diff
              const lb = SKY_COLOR[2] * fill + SUN_COLOR[2] * diff
              // rose rim where the surface grazes the view direction
              const vx = lat * f
              const invV = 1 / Math.sqrt(vx * vx + dh * dh + f * f)
              let ndv = -(nx * vx + dh + nz * f) * inv * invV
              if (ndv < 0) ndv = 0
              const rim =
                Math.pow(1 - ndv, RIM_POW) * RIM_STRENGTH * (0.4 + 0.6 * diff)
              // exponential distance fog into the dusk haze
              const fog = 1 - Math.exp(-f * FOG_DENSITY)
              // linear light → shared tonemap LUT, then fog blend
              const linR = lutR[idx] * lr + RIM_R * rim
              const linG = lutG[idx] * lg + RIM_G * rim
              const linB = lutB[idx] * lb + RIM_B * rim
              const r =
                TONE[linR < 1023 ? linR | 0 : 1023] * (1 - fog) + fogCR * fog
              const g =
                TONE[linG < 1023 ? linG | 0 : 1023] * (1 - fog) + fogCG * fog
              const b =
                TONE[linB < 1023 ? linB | 0 : 1023] * (1 - fog) + fogCB * fog
              // sparkle gate: how much the slope tilts toward the sun (flat
              // ground → zero, matching the shader), faded out with distance
              let tilt = (nx * SUN_H[0] + nz * SUN_H[1]) * inv * 3
              if (tilt < 0) tilt = 0
              else if (tilt > 1) tilt = 1
              const gat = tilt * tilt * (1 - fog)
              if (yi < 0) yi = 0
              // a long span means a new surface appearing from behind a ridge —
              // don't smear the occluded dune's color across the boundary
              const span = prevY - yi
              if (!havePrev || span > 8) {
                pr = r
                pg = g
                pb = b
                pgat = gat
                havePrev = true
              }
              // Gouraud span: lerp prev sample's color (at prevY) → this one (at yi)
              const istep = span > 0 ? 1 / span : 0
              let m = 0
              for (let y = prevY - 1; y >= yi; y--) {
                m += istep
                const k = (y * W + x) * 4
                data[k] = pr + (r - pr) * m
                data[k + 1] = pg + (g - pg) * m
                data[k + 2] = pb + (b - pb) * m
                data[k + 3] = 255
                gate[y * W + x] = pgat + (gat - pgat) * m
              }
              pr = r
              pg = g
              pb = b
              pgat = gat
              prevY = yi
            }
            df *= 1.009
            f += df
          }
          for (let y = 0; y < prevY; y++) {
            const k = (y * W + x) * 4
            // thin sky band, pulled toward the rose glow near the horizon
            const gm = (y / H) * glow
            data[k] = skyR[y] + (GLOW_R - skyR[y]) * gm
            data[k + 1] = skyG[y] + (GLOW_G - skyG[y]) * gm
            data[k + 2] = skyB[y] + (GLOW_B - skyB[y]) * gm
            data[k + 3] = 255
            gate[y * W + x] = 0
          }
        }

        // radius-1 box blur: anti-aliases ridge silhouettes (the per-column march
        // stair-steps them) at the cost of a touch of softness, which fits the look
        if (blurTmp) {
          const tmp = blurTmp
          for (let y = 0; y < H; y++) {
            const row = y * W
            for (let x = 0; x < W; x++) {
              const x0 = x > 0 ? x - 1 : 0
              const x1 = x < W - 1 ? x + 1 : W - 1
              const o = (row + x) * 3
              tmp[o] =
                (data[(row + x0) * 4] +
                  data[(row + x) * 4] +
                  data[(row + x1) * 4]) /
                3
              tmp[o + 1] =
                (data[(row + x0) * 4 + 1] +
                  data[(row + x) * 4 + 1] +
                  data[(row + x1) * 4 + 1]) /
                3
              tmp[o + 2] =
                (data[(row + x0) * 4 + 2] +
                  data[(row + x) * 4 + 2] +
                  data[(row + x1) * 4 + 2]) /
                3
            }
          }
          for (let x = 0; x < W; x++) {
            for (let y = 0; y < H; y++) {
              const y0 = y > 0 ? y - 1 : 0
              const y1 = y < H - 1 ? y + 1 : H - 1
              const o = (y * W + x) * 4
              data[o] =
                (tmp[(y0 * W + x) * 3] +
                  tmp[(y * W + x) * 3] +
                  tmp[(y1 * W + x) * 3]) /
                3
              data[o + 1] =
                (tmp[(y0 * W + x) * 3 + 1] +
                  tmp[(y * W + x) * 3 + 1] +
                  tmp[(y1 * W + x) * 3 + 1]) /
                3
              data[o + 2] =
                (tmp[(y0 * W + x) * 3 + 2] +
                  tmp[(y * W + x) * 3 + 2] +
                  tmp[(y1 * W + x) * 3 + 2]) /
                3
            }
          }
        }

        // sunlit grain sparkle: per-pixel twinkle on a staggered clock,
        // gated by the march's sun-facing/fog buffer. Applied after the AA
        // blur so glints stay single crisp pixels through the upscale
        // (Uint8Clamped saturates them toward white, echoing the GL tonemap).
        if (SPARKLE) {
          const fbase = tSec * SPARKLE_HZ
          const D = SPARKLE_DENSITY
          for (let i = 0, y = 0; y < H; y++) {
            for (let x = 0; x < W; x++, i++) {
              const gt = gate[i]
              if (gt < 0.1) continue
              let h1 = (Math.imul(x, 374761393) ^ Math.imul(y, 668265263)) | 0
              h1 = Math.imul(h1 ^ (h1 >>> 13), 1274126177)
              const stag = ((h1 >>> 16) & 0xffff) / 65536
              const tick = (fbase + stag * 7) | 0
              let h2 = (h1 ^ Math.imul(tick, 974634331)) | 0
              h2 = Math.imul(h2 ^ (h2 >>> 13), 1274126177)
              const rn = ((h2 >>> 16) & 0xffff) / 65536
              if (rn < 1 - D) continue
              const amt =
                Math.min(1, gt * ((rn - 1 + D) / D) * SPARKLE_STRENGTH * 0.5) *
                255
              const k = i * 4
              data[k] += SPARKLE_COLOR[0] * amt
              data[k + 1] += SPARKLE_COLOR[1] * amt
              data[k + 2] += SPARKLE_COLOR[2] * amt
            }
          }
        }

        // grain dither breaks the banding that smooth gradients + 8-bit quantize
        // would otherwise show through the upscale
        let seed = (tSec * 977) | 0
        for (let i = 0; i < W * H * 4; i += 4) {
          seed = (Math.imul(seed, 1664525) + 1013904223) | 0
          const grain = (((seed >>> 16) & 31) - 16) * 0.14
          data[i] += grain
          data[i + 1] += grain
          data[i + 2] += grain
        }

        offCtx.putImageData(img, 0, 0)
        ctx.drawImage(off, 0, 0, canvas.width, canvas.height)
      }

      function resize() {
        const rect = bg.getBoundingClientRect()
        // ~0.22 of display width: high enough that the Gouraud shading and AA
        // blur read as smooth surfaces after the upscale, still ~110k pixels max
        W = Math.min(460, Math.max(160, Math.round(rect.width * 0.22)))
        H = Math.max(
          96,
          Math.round(W * (rect.height / Math.max(rect.width, 1))),
        )
        off.width = W
        off.height = H
        canvas.width = W * 4
        canvas.height = H * 4
        ctx.imageSmoothingEnabled = true
        ctx.imageSmoothingQuality = "high"
        img = ctx.createImageData(W, H)
        blurTmp = new Float32Array(W * H * 3)
        gate = new Float32Array(W * H)
        updateCamera()
        if (reducedMotion || !running) paint(reducedMotion ? 40 : lastT)
      }

      // ~30fps is plenty at this drift speed and halves CPU cost; direct calls
      // while paused (scroll with reduced motion, resize) bypass the gate
      let lastPaintSec = -Infinity
      function render(tSec: number) {
        if (running && tSec - lastPaintSec < 0.028) return
        lastPaintSec = tSec
        paint(tSec)
      }

      return { render, resize }
    }

    function setModeLabel(glActive: boolean) {
      modeLabel.textContent = glActive
        ? "raw WebGL displaced plane · no bundle · scroll to flatten the camera"
        : "Canvas2D heightfield raymarch · scroll to flatten the camera"
    }

    const glImpl = startGL()
    impl = glImpl ?? startCPU()
    setModeLabel(glImpl !== null)

    let scrollQueued = false
    window.addEventListener(
      "scroll",
      () => {
        if (!scrollQueued) {
          scrollQueued = true
          requestAnimationFrame(() => {
            scrollQueued = false
            updateCamera()
            // keep the pitch/height live while paused (reduced motion / offscreen)
            if (!running) impl.render(reducedMotion ? 40 : lastT)
          })
        }
      },
      { passive: true },
    )

    let resizeTimer: number | undefined
    new ResizeObserver(() => {
      clearTimeout(resizeTimer)
      resizeTimer = window.setTimeout(() => impl.resize(), 120)
    }).observe(bg)
    impl.resize()

    if (reducedMotion) {
      impl.render(40)
    } else {
      new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            entry.isIntersecting ? start() : stop()
          }
        },
        { threshold: 0 },
      ).observe(scope)
      document.addEventListener("visibilitychange", () => {
        document.hidden ? stop() : start()
      })
      start()
    }
  }
</script>
