---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import PinnedCanvas from "../components/PinnedCanvas.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Career from "../components/Career.astro";
import Quote from "../components/Quote.astro";
import Work from "../components/Work.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import { projects } from "../data/projects";
import matcapUrl from "../assets/glass-matcap.avif?url";

// A visitor coming back from /projects/<slug> lands on /#from-<slug>, and the
// door that runs from full screen down into that edition's window (Work.astro's
// arrive()) has to be handed a page that already looks like the spread they
// just left — at the very first paint, before any module script has run.
//
// The page is already carrying one: every edition's spread is rendered into
// the front page as a hidden overlay, so the thing to show is not a painted
// stand-in but the spread itself. All the head needs is which one, hence a
// slug → index map and the inline script below.
const arrivals = Object.fromEntries(projects.map((p, i) => [p.slug, i]));
---

{/* Past the top, the hero's backdrop (BG in glass-scene.ts, the colour
    the glass sits on before the turn to dark); past the bottom, the casino
    drawer's peek (--peek-bg in Footer.astro), as on phones the page ends on the drawer peeking up from
    the foot of the footer, and past the end it carries on under Safari's
    toolbar. */}
<Layout edgeTop="#f4f3f1" edgeBottom="#0a0a0a">
  {/* The hero sphere's texture sits three hops deep — the page must first
      fetch and run PinnedCanvas, which statically imports glass-scene, which
      only then sets matcap.src. Until it lands the sphere renders with a flat
      placeholder. Preloading here starts the fetch off the HTML parse instead,
      collapsing two round trips. It lives on the page rather than in Layout
      because 404 has no canvas and would otherwise pay 21KB for nothing. */}
  <link
    slot="head"
    rel="preload"
    href={matcapUrl}
    as="image"
    type="image/avif"
  />

  {/* Opens the arriving edition's spread before first paint, so nothing of the
      page load shows through: not the hero at scroll 0, and not the jump down
      to the window the door is about to close into. A stylesheet rather than a
      class, because the elements it names are still unparsed — and CSS is the
      only thing that can reach them ahead of their own markup.

      Two declarations, both of which need the index and so cannot be written
      ahead of time: `display`, which outranks the overlay's `hidden` (and is
      !important because Tailwind's preflight hides [hidden] that way — it
      wins on specificity, not on being louder), and the transition name that
      pairs this spread with the one on the page just left (see global.css),
      making the two one object across the navigation. The third thing an
      arrival needs — settled body copy, since this spread is being resumed
      rather than entered — is the same for every edition and lives with the
      element instead, in ProjectSpread.astro.

      Scroll restoration goes manual for the same span: a reload of this URL
      would otherwise put the page back where it was mid-door, moving the
      window out from under the animation.

      The timer is the failsafe. Unlike the curtain it replaces, what outlives
      a broken script here is a readable spread with a working way back rather
      than a blank site — but it should still not outlive one, so it is torn
      down on the same schedule. arrive() cancels it once JS has the spread. */}
  <script slot="head" is:inline define:vars={{ arrivals }}>
    ;(function () {
      var m = /^#from-(.+)$/.exec(window.location.hash || "")
      if (!m) return
      var i = arrivals[decodeURIComponent(m[1])]
      if (i == null) return
      var el = document.documentElement
      el.setAttribute("data-we1-arrive", i)
      history.scrollRestoration = "manual"
      var sel = '[data-spread="' + i + '"]'
      var style = document.createElement("style")
      style.id = "we1-arrival"
      style.textContent =
        sel +
        "[hidden]{display:block!important}" +
        sel +
        "{view-transition-name:we1-spread}"
      document.head.appendChild(style)
      window.__we1ArrivalTimer = setTimeout(function () {
        el.removeAttribute("data-we1-arrive")
        style.remove()
        history.scrollRestoration = "auto"
      }, 2000)
    })()
  </script>

  <Header />
  <main>
    {/* One pinned glass background carries all four: the hero and About over
        bone, Career and Quote over near-black, and the turn between them is
        the background's own — see PinnedCanvas.astro. Career has to stay
        directly after About (the turn is measured from one to the other) and
        Quote last (the glass leaves with the flow at the end of the scope). */}
    <PinnedCanvas>
      <Hero />
      <About />
      <Career />
      <Quote />
    </PinnedCanvas>
    <Work />
    <Contact />
  </main>
  <Footer />
  <button
    type="button"
    data-terminal="scroll"
    data-casino-open
    aria-label="Open the /dev/null casino, a mini-game easter egg"
    aria-haspopup="dialog"
    class="term-float hidden md:inline-flex fixed z-30 bottom-[max(0.5rem,env(safe-area-inset-bottom))] left-[max(0.5rem,env(safe-area-inset-left))] font-mono pointer-events-none cursor-pointer"
    style="opacity: 0"
  >
    <span data-terminal-text>&gt;</span><span data-terminal-cursor>_</span>
  </button>
</Layout>
