---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import PinnedCanvas from "../components/PinnedCanvas.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Career from "../components/Career.astro";
import Quote from "../components/Quote.astro";
import Work from "../components/Work.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  {/* The hero sphere's texture sits three hops deep — the page must first
      fetch and run PinnedCanvas, which statically imports glass-scene, which
      only then sets matcap.src. Until it lands the sphere renders with a flat
      placeholder. Preloading here starts the fetch off the HTML parse instead,
      collapsing two round trips. It lives on the page rather than in Layout
      because 404 has no canvas and would otherwise pay 21KB for nothing. */}
  <link
    slot="head"
    rel="preload"
    href="/glass-matcap.avif"
    as="image"
    type="image/avif"
  />
  <Header />
  <main>
    <PinnedCanvas>
      <Hero />
      <About />
    </PinnedCanvas>
    <Career />
    <Quote />
    <Work />
    <Contact />
  </main>
  <Footer />
  <a
    href="https://dev.dominicclerici.com"
    target="_blank"
    rel="noopener noreferrer"
    data-terminal="scroll"
    aria-label="Open developer terminal"
    class="hidden md:inline-flex fixed bottom-2 left-2 font-mono text-white pointer-events-none transition-opacity duration-300"
    style="opacity: 0"
  >
    <span data-terminal-text>&gt;</span><span data-terminal-cursor>_</span>
  </a>
</Layout>
