---
// V3 — "Peer review": Alan Kay's line set like a document under review.
// "disastrous" gets a hand-drawn lime scribble, the closing phrase a
// squiggly underline, and Dominic's rebuttal lives in the margin as a
// review comment — changes requested.
---

<section
  class="qv3 relative bg-[#0a0a0a] overflow-hidden py-[clamp(110px,15vh,190px)] px-6 md:px-12"
  aria-label="Quote"
>
  <!-- Faint manuscript baseline rules -->
  <div class="qv3-rules absolute inset-0 pointer-events-none" aria-hidden="true"></div>

  <div class="relative max-w-6xl mx-auto grid lg:grid-cols-[1fr_280px] gap-12 lg:gap-16 items-center">
    <div>
      <div class="flex items-center gap-4 mb-10 md:mb-14">
        <span class="font-mono text-[11px] leading-none tracking-[-0.02em] text-white/55 border border-white/20 rounded-full px-3.5 py-2">
          quote.md
        </span>
        <span class="font-mono text-[11px] leading-none uppercase tracking-[0.2em] text-white/40">
          Review requested
        </span>
      </div>

      <blockquote class="font-headline text-[clamp(1.9rem,4.6vw,3.75rem)] leading-[1.28] text-white/90">
        The most
        <span class="qv3-circ relative inline-block px-[0.08em]">
          disastrous
          <svg
            class="absolute -left-[7%] -top-[26%] w-[114%] h-[152%] overflow-visible pointer-events-none"
            viewBox="0 0 100 60"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <path
              class="qv3-draw qv3-draw-circle"
              d="M12,32 C10,14 38,4 62,6 C88,8 98,20 96,33 C94,50 62,59 36,56 C14,53 5,44 9,29 C12,18 30,10 48,9"
              fill="none"
              stroke="var(--color-bio-lime)"
              stroke-width="2.5"
              stroke-linecap="round"
              vector-effect="non-scaling-stroke"
              pathLength="1"></path>
          </svg>
        </span>
        thing that you can ever learn is your
        <span class="qv3-ul relative inline">
          first programming language.
          <svg
            class="absolute left-0 right-0 -bottom-[0.22em] w-full h-[0.32em] overflow-visible pointer-events-none"
            viewBox="0 0 300 16"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <path
              class="qv3-draw qv3-draw-ul"
              d="M2,9 Q14,2 26,9 T50,9 T74,9 T98,9 T122,9 T146,9 T170,9 T194,9 T218,9 T242,9 T266,9 T290,9"
              fill="none"
              stroke="var(--color-bio-lime)"
              stroke-width="2"
              stroke-linecap="round"
              vector-effect="non-scaling-stroke"
              pathLength="1"></path>
          </svg>
        </span>
      </blockquote>

      <cite class="block mt-10 md:mt-12 font-mono not-italic text-[11px] md:text-sm uppercase tracking-[0.3em] text-white/50">
        &mdash; Alan Kay
      </cite>
    </div>

    <!-- Margin comment -->
    <div class="qv3-note relative lg:-rotate-[1.5deg]">
      <svg
        class="hidden lg:block absolute top-1/2 -left-24 w-24 h-16 -translate-y-full overflow-visible pointer-events-none"
        viewBox="0 0 96 64"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M92,58 C60,54 30,50 6,20"
          stroke="rgba(206,247,158,0.35)"
          stroke-width="1.5"
          stroke-dasharray="2 5"
          stroke-linecap="round"></path>
        <path
          d="M13,30 L5,18 L18,17"
          stroke="rgba(206,247,158,0.35)"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>

      <div class="rounded-lg border border-bio-lime/25 bg-[#101210] p-5 shadow-[0_24px_60px_rgba(0,0,0,0.55)]">
        <div class="flex items-center gap-2.5 mb-3.5">
          <span
            class="grid place-items-center w-6 h-6 rounded-full bg-bio-lime font-mono text-[10px] font-medium text-[#0a0a0a]"
            aria-hidden="true"
          >
            DC
          </span>
          <span class="font-mono text-[11px] text-white/45">dominic &middot; just now</span>
        </div>
        <p class="font-headline italic text-xl text-white/85 leading-snug">Eh, maybe...</p>
        <div class="mt-4 pt-3.5 border-t border-white/[0.07]">
          <span class="inline-block font-mono text-[9px] uppercase tracking-[0.18em] text-bio-lime border border-bio-lime/30 rounded-full px-2.5 py-1">
            Changes requested
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .qv3-rules {
    background: repeating-linear-gradient(
      to bottom,
      transparent,
      transparent 47px,
      rgba(255, 255, 255, 0.025) 47px,
      rgba(255, 255, 255, 0.025) 48px
    );
    mask-image: radial-gradient(ellipse 90% 80% at 50% 50%, black 30%, transparent 100%);
  }

  /* Annotations draw in on scroll; without JS or with reduced motion they
     are simply present (initial hidden states are gated on .qv3-js). */
  @media (prefers-reduced-motion: no-preference) {
    .qv3-js .qv3-draw {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }
    .qv3-js .qv3-note {
      opacity: 0;
      transform: translateY(14px) scale(0.97);
    }
    .qv3-js.qv3-in .qv3-draw-circle {
      transition: stroke-dashoffset 0.9s cubic-bezier(0.65, 0, 0.35, 1) 0.25s;
      stroke-dashoffset: 0;
    }
    .qv3-js.qv3-in .qv3-draw-ul {
      transition: stroke-dashoffset 0.8s cubic-bezier(0.65, 0, 0.35, 1) 0.85s;
      stroke-dashoffset: 0;
    }
    .qv3-js.qv3-in .qv3-note {
      transition:
        opacity 0.5s ease 1.5s,
        transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) 1.5s;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>(".qv3");

  if (section) {
    section.classList.add("qv3-js");
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries[0].isIntersecting) {
          section.classList.add("qv3-in");
          observer.disconnect();
        }
      },
      { threshold: 0.45 }
    );
    observer.observe(section);
  }
</script>
