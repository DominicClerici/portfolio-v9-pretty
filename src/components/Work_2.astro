---
// V2 — "The Strata": neumorphic, scroll-stacked. The three builds are
// full-width porcelain slabs that stick as you scroll — each new layer
// slides up and seats over the last while the buried one settles back
// into the slab. Giant gradient-clipped numerals and aurora-lit image
// wells carry V4's gradients; the stick comes from V3. No clicking at
// all — the pile files itself.
const projects = [
  {
    index: "01",
    title: "Dispatch",
    tech: "Astro · TypeScript · AI pipelines",
    fact: "writes itself every morning",
    description:
      "The last 24 hours of tech news, compressed into a 10 minute read. Two decoupled AI pipelines research, triage, and write it; GitHub Actions runs the whole thing while I sleep.",
    image: "/photos/dispatch.webp",
    alt: "Dispatch project screenshot",
    stack: ["Astro", "TypeScript", "OpenAI API", "Tailwind", "Vercel"],
    websiteUrl: "https://dispatch.dominicclerici.com/",
    githubUrl: "https://github.com/DominicClerici/dispatch",
  },
  {
    index: "02",
    title: "Meridian",
    tech: "Vanilla TypeScript · Extensions",
    fact: "0 npm dependencies",
    description:
      "A new-tab extension for Chrome and Firefox with zero npm dependencies. Eleven feature modules, a reactive storage layer, and a recommendation engine that never lets data leave the browser.",
    image: "/photos/meridian.webp",
    alt: "Meridian project screenshot",
    stack: ["TypeScript", "esbuild", "Chrome APIs", "Firefox Add-ons"],
    websiteUrl: "https://meridian.dominicclerici.com/",
    githubUrl: "https://github.com/DominicClerici/meridian",
  },
  {
    index: "03",
    title: "Fuzzbox",
    tech: "Next.js · React Native",
    fact: "design system: Neon Riff",
    featured: true,
    description:
      "The companion I wished I had when learning guitar. Place notes on an interactive fretboard and it explains the chord you found — the intervals, the theory, why it sounds the way it does.",
    image: "/photos/fuzzbox.webp",
    alt: "Fuzzbox project screenshot",
    stack: ["TypeScript", "Next.js", "React Native", "Prisma", "PostgreSQL"],
    websiteUrl: "https://fuzzbox.dominicclerici.com/",
    githubUrl: null,
  },
];

// Stair offset per layer — mirrored by STICK_TOP/STICK_STEP in the script
const STICK_TOP = 88;
const STICK_STEP = 26;
---

<section class="ws2 relative" aria-label="Selected work">
  <div class="max-w-[1524px] mx-auto px-6 lg:px-12 pt-[clamp(96px,14vh,180px)]">
    <div class="flex items-center justify-between gap-4 mb-10 lg:mb-14">
      <div class="flex items-center gap-4">
        <span class="ws2-pill font-mono text-[13px] leading-none tracking-[-0.02em] text-ink/60 rounded-full px-3.5 py-2">
          03&hairsp;/&hairsp;04
        </span>
        <span class="font-mono text-[13px] leading-none tracking-[-0.02em] uppercase text-ink/60">
          Selected Work
        </span>
      </div>
      <a
        href="https://github.com/DominicClerici"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex font-mono text-[13px] leading-none tracking-[-0.02em] text-ink/45 hover:text-ink transition-colors duration-200"
      >
        more on github&nbsp;&nearr;
      </a>
    </div>

    <p
      class="font-display font-normal text-ink leading-[1.2] tracking-[-0.006em] max-w-[880px] text-[clamp(1.625rem,calc(1.625rem+(100vw-27.5rem)*0.02),2.625rem)] mb-4 lg:mb-6"
    >
      Three builds, laid down in strata&nbsp;&mdash;
      <span class="text-ink/55">each new layer seats over the last.</span>
    </p>
  </div>

  <!-- Desktop: the sticky pile -->
  <div class="hidden lg:block max-w-[1524px] mx-auto px-12 pb-24" data-pile>
    {
      projects.map((project, i) => (
        <div class="ws2-layer" data-layer={i}>
          <article
            class="ws2-card relative rounded-[36px] p-8 xl:p-10 overflow-hidden"
            data-card={i}
            style={`--i: ${i}; top: ${STICK_TOP + i * STICK_STEP}px;`}
          >
            <span class="ws2-hair absolute top-0 left-[8%] right-[8%]" aria-hidden="true" />

            <div class="grid grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-14 items-center">
              <div class={i % 2 === 1 ? "order-last" : ""}>
                <span class="ws2-num font-display font-normal leading-[0.85] tracking-[-0.04em] block text-[clamp(5rem,8vw,8rem)]">
                  {project.index}
                </span>
                <div class="flex items-center gap-3 flex-wrap mt-5">
                  <h3 class="font-display font-normal leading-[0.98] tracking-[-0.02em] text-ink text-[clamp(2rem,2.6vw,2.75rem)]">
                    {project.title}
                  </h3>
                  {project.featured && (
                    <span class="ws2-feat font-mono text-[11px] leading-none tracking-[-0.02em] uppercase text-ink rounded-full px-2.5 py-1.5">
                      featured
                    </span>
                  )}
                </div>
                <p class="font-mono text-[12px] leading-none tracking-[-0.02em] uppercase text-ink/45 mt-4">
                  {project.tech}
                  <span class="text-ink/30 normal-case">&nbsp;&middot;&nbsp;{project.fact}</span>
                </p>
                <p class="font-display text-[15px] leading-[1.6] text-ink/60 max-w-[460px] mt-6">
                  {project.description}
                </p>

                <div class="flex flex-wrap gap-2.5 mt-7">
                  {project.stack.map((item) => (
                    <span class="ws2-chip font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/60 rounded-full px-3.5 py-2.5">
                      {item}
                    </span>
                  ))}
                </div>

                <div class="flex items-center gap-4 mt-9 max-w-[460px]">
                  <a
                    href={project.websiteUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="ws2-btn font-mono text-[13px] tracking-[-0.008em] text-ink rounded-[14px] h-11 px-5 inline-flex items-center"
                  >
                    Visit site
                  </a>
                  {project.githubUrl && (
                    <a
                      href={project.githubUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-mono text-[13px] tracking-[-0.008em] text-ink/55 h-11 px-2 inline-flex items-center hover:text-ink transition-colors duration-200"
                    >
                      GitHub
                    </a>
                  )}
                  <a
                    href={project.websiteUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Open ${project.title} in a new tab`}
                    class="ws2-btn ws2-btn-go w-11 h-11 rounded-[14px] text-ink inline-flex items-center justify-center ml-auto"
                  >
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                      <path
                        d="M2 12 12 2M4.5 2H12v7.5"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </a>
                </div>
              </div>

              <div class="ws2-well rounded-[24px] p-4">
                <img
                  src={project.image}
                  srcset={`${project.image} 1x, ${project.image.replace(".webp", "-2x.webp")} 2x`}
                  alt={project.alt}
                  class="w-full aspect-[16/9] object-cover object-top rounded-[14px]"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>

            <span class="ws2-veil absolute inset-0 rounded-[inherit]" aria-hidden="true" />
          </article>
        </div>
      ))
    }
  </div>

  <!-- Mobile: molded cards, no pile -->
  <div class="lg:hidden max-w-[1524px] mx-auto px-6 pb-[clamp(96px,14vh,180px)] pt-8">
    <div class="flex flex-col gap-10">
      {
        projects.map((project) => (
          <article class="ws2-card relative rounded-[26px] p-5 overflow-hidden">
            <span class="ws2-hair absolute top-0 left-[12%] right-[12%]" aria-hidden="true" />
            <div class="ws2-well rounded-[18px] p-2.5">
              <img
                src={project.image}
                srcset={`${project.image} 1x, ${project.image.replace(".webp", "-2x.webp")} 2x`}
                alt={project.alt}
                class="w-full aspect-[16/10] object-cover object-top rounded-[10px]"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="p-2 pt-6">
              <div class="flex items-center gap-3 flex-wrap">
                <span class="ws2-num font-display font-normal leading-none tracking-[-0.03em] text-[2.25rem]">
                  {project.index}
                </span>
                <h3 class="font-display font-normal leading-[1] tracking-[-0.018em] text-ink text-[clamp(1.75rem,calc(1.75rem+(100vw-27.5rem)*0.014),2.5rem)]">
                  {project.title}
                </h3>
                {project.featured && (
                  <span class="ws2-feat font-mono text-[11px] leading-none tracking-[-0.02em] uppercase text-ink rounded-full px-2.5 py-1.5">
                    featured
                  </span>
                )}
              </div>
              <p class="font-mono text-[12px] leading-none tracking-[-0.02em] uppercase text-ink/45 mt-3.5">
                {project.tech}
              </p>
              <p class="font-display text-[15px] leading-[1.6] text-ink/60 mt-5">{project.description}</p>

              <div class="flex flex-wrap gap-3 mt-6">
                {project.stack.map((item) => (
                  <span class="ws2-chip font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/60 rounded-full px-3.5 py-2.5">
                    {item}
                  </span>
                ))}
              </div>

              <div class="flex items-center gap-4 mt-8">
                <a
                  href={project.websiteUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="ws2-btn font-mono text-[13px] tracking-[-0.008em] text-ink rounded-[14px] h-11 px-5 inline-flex items-center"
                >
                  Visit site
                </a>
                {project.githubUrl && (
                  <a
                    href={project.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-mono text-[13px] tracking-[-0.008em] text-ink/55 h-11 px-2 inline-flex items-center hover:text-ink transition-colors duration-200"
                  >
                    GitHub
                  </a>
                )}
                <a
                  href={project.websiteUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Open ${project.title} in a new tab`}
                  class="ws2-btn ws2-btn-go w-11 h-11 rounded-[14px] text-ink inline-flex items-center justify-center ml-auto"
                >
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path
                      d="M2 12 12 2M4.5 2H12v7.5"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <p
    class="max-w-[1524px] mx-auto px-6 lg:px-12 pb-12 font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/35 text-right"
  >
    sedimentary, my dear &mdash; newest layer on top
  </p>
</section>

<style>
  /* Cool porcelain (V3's clean palette); the gradient is the mineral seam */
  .ws2 {
    --por: #eaedf1;
    --por-dark: rgba(151, 163, 180, 0.55);
    --por-darker: rgba(151, 163, 180, 0.72);
    --por-light: rgba(255, 255, 255, 0.95);
    --grad: linear-gradient(120deg, #cef79e, #9fe8cf 48%, #9cc2ff);
    background: var(--por);
  }

  .ws2-pill {
    box-shadow:
      inset 3px 3px 6px var(--por-dark),
      inset -3px -3px 6px var(--por-light);
  }

  /* ── Layers ── */
  .ws2-layer {
    min-height: 100vh;
    display: flex;
    align-items: flex-start;
  }

  /* --cover (0→1, set from scroll) is how far the next layer has seated
     over this one: the card scales back and its veil pushes it into the slab */
  .ws2-card {
    position: sticky;
    width: 100%;
    background: var(--por);
    box-shadow:
      14px 14px 34px var(--por-dark),
      -14px -14px 34px var(--por-light);
    transform: scale(calc(1 - var(--cover, 0) * 0.05));
    transform-origin: 50% 0;
  }

  /* Mobile cards reuse .ws2-card styling without the pile mechanics */
  @media (max-width: 1023px) {
    .ws2-card {
      position: relative;
      top: auto !important;
      transform: none;
    }
  }

  .ws2-veil {
    background: var(--por);
    opacity: calc(var(--cover, 0) * 0.55);
    pointer-events: none;
  }

  .ws2-hair {
    height: 2px;
    border-radius: 999px;
    background: var(--grad);
    opacity: 0.85;
  }

  /* Gradient-clipped numeral, dimmed toward engraving */
  .ws2-num {
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: saturate(0.9) brightness(0.74);
  }

  /* Aurora well: the gradient pooled behind the screenshot, showing
     through the gutter */
  .ws2-well {
    background:
      radial-gradient(120% 90% at 10% 6%, rgba(206, 247, 158, 0.5), transparent 55%),
      radial-gradient(110% 90% at 90% 94%, rgba(156, 194, 255, 0.45), transparent 55%),
      radial-gradient(90% 80% at 88% 8%, rgba(159, 232, 207, 0.4), transparent 55%),
      var(--por);
    box-shadow:
      inset 8px 8px 18px var(--por-dark),
      inset -8px -8px 18px var(--por-light);
  }

  .ws2-well img {
    box-shadow: 0 10px 26px -14px rgba(34, 47, 48, 0.45);
  }

  /* ── Fittings ── */
  .ws2-feat {
    background: var(--grad);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.6);
  }

  .ws2-chip {
    box-shadow:
      inset 3px 3px 7px var(--por-dark),
      inset -3px -3px 7px var(--por-light);
  }

  .ws2-btn {
    background: var(--por);
    box-shadow:
      6px 6px 14px var(--por-dark),
      -6px -6px 14px var(--por-light);
    transition:
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .ws2-btn:hover {
    transform: translateY(-1px);
  }

  .ws2-btn:active {
    transform: translateY(0);
    box-shadow:
      inset 4px 4px 10px var(--por-dark),
      inset -4px -4px 10px var(--por-light);
  }

  .ws2-btn:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }

  .ws2-btn-go {
    background: var(--grad);
    box-shadow:
      6px 6px 14px var(--por-dark),
      -6px -6px 14px var(--por-light),
      inset 0 1px 0 rgba(255, 255, 255, 0.6);
  }

  .ws2-btn-go:active {
    box-shadow:
      inset 4px 4px 10px rgba(110, 150, 120, 0.5),
      inset -2px -2px 6px rgba(255, 255, 255, 0.6);
  }
</style>

<script>
  {
    const section = document.querySelector<HTMLElement>(".ws2");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (section && !reducedMotion) {
      const cards = Array.from(section.querySelectorAll<HTMLElement>("[data-card]"));

      // Must track the inline sticky tops: 88px base, 26px stair
      const STICK_TOP = 88;
      const STICK_STEP = 26;

      let ticking = false;

      const update = () => {
        ticking = false;
        // i's cover is driven by how far card i+1 has climbed toward its
        // own sticky seat; the last card is never covered
        for (let i = 0; i < cards.length - 1; i++) {
          const next = cards[i + 1].getBoundingClientRect();
          // Hidden variant panel (display: none) — nothing to drive
          if (!next.height) return;
          const seat = STICK_TOP + (i + 1) * STICK_STEP;
          const p = Math.min(1, Math.max(0, 1 - (next.top - seat) / (window.innerHeight - seat)));
          cards[i].style.setProperty("--cover", p.toFixed(3));
        }
      };

      const onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      };

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
      update();
    }
  }
</script>
