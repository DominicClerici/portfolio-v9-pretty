---
// "Field Survey": Meridian is a line on a map, so the shelf becomes chart
// paper — a pale blue survey grid with three station cards pinned along a
// route. The route exists twice: a dotted planned line, and a solid
// expedition-red line drawn over it by scroll, with a position marker riding
// the tip (getPointAtLength). A sticky instrument dial in the top-right spins
// with progress. Cards sit slightly rotated, held by a single red pin.
const projects = [
  {
    index: "01",
    title: "Dispatch",
    fact: "24h cycle",
    description:
      "The last 24 hours of tech news, compressed into a 10 minute read. Two decoupled AI pipelines research, triage, and write it; GitHub Actions runs the whole thing while I sleep.",
    image: "/photos/dispatch.webp",
    alt: "Dispatch project screenshot",
    stack: ["Astro", "TypeScript", "OpenAI API", "Tailwind", "Vercel"],
    websiteUrl: "https://dispatch.dominicclerici.com/",
    githubUrl: "https://github.com/DominicClerici/dispatch",
    featured: false,
  },
  {
    index: "02",
    title: "Meridian",
    fact: "0 dependencies",
    description:
      "A new-tab extension for Chrome and Firefox with zero npm dependencies. Eleven feature modules, a reactive storage layer, and a recommendation engine that never lets data leave the browser.",
    image: "/photos/meridian.webp",
    alt: "Meridian project screenshot",
    stack: ["TypeScript", "esbuild", "Chrome APIs", "Firefox Add-ons"],
    websiteUrl: "https://meridian.dominicclerici.com/",
    githubUrl: "https://github.com/DominicClerici/meridian",
    featured: false,
  },
  {
    index: "03",
    title: "Fuzzbox",
    fact: "neon riff",
    description:
      "The companion I wished I had when learning guitar. Place notes on an interactive fretboard and it explains the chord you found — the intervals, the theory, why it sounds the way it does.",
    image: "/photos/fuzzbox.webp",
    alt: "Fuzzbox project screenshot",
    stack: ["TypeScript", "Next.js", "React Native", "Prisma", "PostgreSQL"],
    websiteUrl: "https://fuzzbox.dominicclerici.com/",
    githubUrl: null,
    featured: true,
  },
];
---

<section class="ws2 relative" aria-label="Selected work">
  <div class="max-w-[1140px] mx-auto px-6 lg:px-10 pt-[clamp(96px,14vh,180px)] relative z-10">
    <p class="font-mono text-[11px] leading-none tracking-[0.24em] uppercase text-ink/45">
      03&hairsp;/&hairsp;04 &middot; Selected Work
    </p>
    <h2
      class="font-label font-medium text-ink leading-[1.05] tracking-[-0.02em] mt-6 text-[clamp(2.25rem,5.5vw,4rem)] max-w-[16ch]"
    >
      Field survey: three stations.
    </h2>
    <p class="font-body text-[15px] leading-[1.7] text-ink/55 max-w-[480px] mt-6">
      A route through what I&rsquo;ve built &mdash; plotted, pinned, and logged. The solid line is how far
      you&rsquo;ve travelled.
    </p>
  </div>

  <div class="relative mt-16 lg:mt-20" data-zone>
    <!-- Sticky instrument: a survey dial that rotates with route progress -->
    <div class="ws2-instruments hidden lg:block sticky top-[72px] h-0 z-20 pointer-events-none" aria-hidden="true">
      <div class="ws2-dial ml-auto mr-[max(28px,calc((100vw-1240px)/2))] w-[92px]">
        <svg viewBox="0 0 100 100" class="w-full">
          <circle cx="50" cy="50" r="47" fill="#ffffff" stroke="rgba(34,47,48,0.25)" stroke-width="1.5"></circle>
          <circle
            cx="50"
            cy="50"
            r="40"
            fill="none"
            stroke="rgba(34,47,48,0.3)"
            stroke-width="1"
            stroke-dasharray="1 5.28"></circle>
          <g data-needle style="transform-box: fill-box; transform-origin: center;">
            <path d="M50 14 L54 50 L50 86 L46 50 Z" fill="#cf4a2f"></path>
            <circle cx="50" cy="50" r="4" fill="#ffffff" stroke="#cf4a2f" stroke-width="2"></circle>
          </g>
        </svg>
        <p class="font-mono text-[9px] leading-none tracking-[0.2em] uppercase text-ink/40 text-center mt-2">bearing</p>
      </div>
    </div>

    <p class="text-center font-mono text-[10px] leading-none tracking-[0.24em] uppercase text-ink/40 relative z-10">
      route begins
    </p>

    <!-- The route: dotted plan + scroll-drawn travelled line -->
    <div class="relative" data-route-zone>
      <svg
        class="absolute inset-0 w-full h-full z-0"
        viewBox="0 0 100 300"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <path
          d="M 50 0 C 50 18, 30 30, 30 50 C 30 70, 70 128, 70 150 C 70 172, 32 228, 32 250 C 32 272, 50 282, 50 300"
          fill="none"
          stroke="rgba(34,47,48,0.28)"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-dasharray="0.6 2.6"
          vector-effect="non-scaling-stroke"></path>
        <path
          data-travelled
          d="M 50 0 C 50 18, 30 30, 30 50 C 30 70, 70 128, 70 150 C 70 172, 32 228, 32 250 C 32 272, 50 282, 50 300"
          fill="none"
          stroke="#cf4a2f"
          stroke-width="2.5"
          stroke-linecap="round"
          pathLength="1"
          stroke-dasharray="1 1"
          vector-effect="non-scaling-stroke"
          style="stroke-dashoffset: 0;"></path>
        <circle
          data-marker
          cx="50"
          cy="0"
          r="0.55"
          fill="#ffffff"
          stroke="#cf4a2f"
          stroke-width="2.5"
          vector-effect="non-scaling-stroke"></circle>
      </svg>

      {
        projects.map((project, i) => (
          <div class="ws2-row min-h-[88vh] flex items-center relative z-10">
            <div class="max-w-[1140px] mx-auto w-full px-6 lg:px-10">
              <article
                class={`ws2-card relative bg-white max-w-[560px] ${i % 2 === 1 ? "ml-auto ws2-tilt-r" : "ws2-tilt-l"}`}
                data-station={i}
              >
                <span class="ws2-pin absolute" aria-hidden="true" />
                <header class="flex items-baseline justify-between gap-4 px-6 pt-6 pb-4">
                  <p class="font-mono text-[11px] leading-none tracking-[0.18em] uppercase text-ink">
                    Stn&nbsp;{project.index} &mdash; {project.title}
                    {project.featured && <span class="text-[#cf4a2f]">&nbsp;&middot;&nbsp;featured</span>}
                  </p>
                  <p class="font-mono text-[11px] leading-none tracking-[0.18em] uppercase text-ink/40">
                    {project.fact}
                  </p>
                </header>
                <div class="px-6">
                  <img
                    src={project.image}
                    srcset={`${project.image} 1x, ${project.image.replace(".webp", "-2x.webp")} 2x`}
                    alt={project.alt}
                    class="w-full aspect-[16/9] object-cover object-top border border-ink/20"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="px-6 pt-5">
                  <p class="font-body text-[14.5px] leading-[1.65] text-ink/65">{project.description}</p>
                  <p class="font-mono text-[10.5px] leading-[1.9] tracking-[0.12em] uppercase text-ink/45 mt-4">
                    payload: {project.stack.join(" / ")}
                  </p>
                </div>
                <div class="flex items-center gap-3 px-6 pt-5 pb-6">
                  <a
                    href={project.websiteUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="ws2-btn font-mono text-[11px] leading-none tracking-[0.14em] uppercase text-ink px-4 py-3"
                  >
                    Visit site&nbsp;&nearr;
                  </a>
                  {project.githubUrl && (
                    <a
                      href={project.githubUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="ws2-btn font-mono text-[11px] leading-none tracking-[0.14em] uppercase text-ink px-4 py-3"
                    >
                      Source
                    </a>
                  )}
                </div>
              </article>
            </div>
          </div>
        ))
      }
    </div>

    <p class="text-center font-mono text-[10px] leading-none tracking-[0.24em] uppercase text-ink/40 relative z-10">
      route ends &mdash; 3&hairsp;/&hairsp;3 logged
    </p>
  </div>

  <div
    class="max-w-[1140px] mx-auto px-6 lg:px-10 pt-20 pb-16 flex flex-wrap items-end justify-between gap-8 relative z-10"
  >
    <div class="ws2-legend bg-white px-5 py-4">
      <p class="font-mono text-[10px] leading-none tracking-[0.2em] uppercase text-ink/60 mb-3.5">
        Route log &mdash; scale 1:1
      </p>
      <p class="font-mono text-[10px] leading-none tracking-[0.12em] uppercase text-ink/45 flex items-center gap-2.5">
        <span class="ws2-swatch-dotted inline-block" aria-hidden="true"></span> planned
      </p>
      <p class="font-mono text-[10px] leading-none tracking-[0.12em] uppercase text-ink/45 flex items-center gap-2.5 mt-2.5">
        <span class="ws2-swatch-solid inline-block" aria-hidden="true"></span> travelled
      </p>
    </div>
    <a
      href="https://github.com/DominicClerici"
      target="_blank"
      rel="noopener noreferrer"
      class="font-mono text-[11px] leading-none tracking-[0.14em] uppercase text-ink/50 hover:text-ink transition-colors duration-200 ws2-focus"
    >
      further terrain on github&nbsp;&nearr;
    </a>
  </div>
</section>

<style>
  .ws2 {
    overflow-x: clip;
    background-color: #fbfcf9;
    /* Chart paper: minor grid every 28px, major every 140px */
    background-image:
      linear-gradient(to right, rgba(60, 98, 158, 0.14) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(60, 98, 158, 0.14) 1px, transparent 1px),
      linear-gradient(to right, rgba(60, 98, 158, 0.07) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(60, 98, 158, 0.07) 1px, transparent 1px);
    background-size:
      140px 140px,
      140px 140px,
      28px 28px,
      28px 28px;
  }

  .ws2-card {
    border: 1px solid rgba(34, 47, 48, 0.18);
    box-shadow: 0 22px 44px -26px rgba(34, 47, 48, 0.4);
  }

  .ws2-tilt-l {
    transform: rotate(-0.5deg);
  }

  .ws2-tilt-r {
    transform: rotate(0.5deg);
  }

  /* Reveal only applies once JS tags the section, so no-JS stays visible */
  .ws2.js .ws2-card {
    opacity: 0;
    transform: translateY(28px) rotate(0deg);
    transition:
      opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .ws2.js .ws2-card.is-in {
    opacity: 1;
  }

  .ws2.js .ws2-tilt-l.is-in {
    transform: translateY(0) rotate(-0.5deg);
  }

  .ws2.js .ws2-tilt-r.is-in {
    transform: translateY(0) rotate(0.5deg);
  }

  .ws2-pin {
    top: -9px;
    left: 30px;
    width: 18px;
    height: 18px;
    border-radius: 999px;
    background: #cf4a2f;
    box-shadow:
      0 2px 6px rgba(34, 47, 48, 0.35),
      inset -2px -2px 4px rgba(0, 0, 0, 0.25);
  }

  .ws2-pin::after {
    content: "";
    position: absolute;
    top: 5px;
    left: 5px;
    width: 4px;
    height: 4px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.85);
  }

  .ws2-btn {
    border: 1px solid rgba(34, 47, 48, 0.35);
    transition:
      background 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .ws2-btn:hover {
    background: #cf4a2f;
    border-color: #cf4a2f;
    color: #ffffff;
  }

  .ws2-btn:focus-visible,
  .ws2-focus:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }

  .ws2-legend {
    border: 1px solid rgba(34, 47, 48, 0.18);
  }

  .ws2-swatch-dotted {
    width: 34px;
    height: 0;
    border-top: 2px dotted rgba(34, 47, 48, 0.5);
  }

  .ws2-swatch-solid {
    width: 34px;
    height: 2px;
    background: #cf4a2f;
  }

  @media (max-width: 1023px) {
    .ws2-row {
      min-height: 0;
      padding: 8vh 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ws2.js .ws2-card {
      opacity: 1;
      transition: none;
    }
  }
</style>

<script>
  {
    const section = document.querySelector<HTMLElement>(".ws2");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (section && !reducedMotion) {
      section.classList.add("js");
      const zone = section.querySelector<HTMLElement>("[data-route-zone]");
      const travelled = section.querySelector<SVGPathElement>("[data-travelled]");
      const marker = section.querySelector<SVGCircleElement>("[data-marker]");
      const needle = section.querySelector<SVGGElement>("[data-needle]");
      const cards = Array.from(section.querySelectorAll<HTMLElement>("[data-station]"));

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-in");
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.2 },
      );
      cards.forEach((card) => observer.observe(card));

      const pathLength = travelled ? travelled.getTotalLength() : 0;
      let ticking = false;

      const update = () => {
        ticking = false;
        if (!zone || !travelled) return;
        const rect = zone.getBoundingClientRect();
        // Hidden variant panel (display: none) — nothing to drive
        if (!rect.height) return;
        const p = Math.min(1, Math.max(0, (window.innerHeight * 0.55 - rect.top) / rect.height));
        travelled.style.strokeDashoffset = (1 - p).toFixed(4);
        if (marker && pathLength > 0) {
          const pt = travelled.getPointAtLength(p * pathLength);
          marker.setAttribute("cx", pt.x.toFixed(2));
          marker.setAttribute("cy", pt.y.toFixed(2));
        }
        if (needle) needle.style.transform = `rotate(${(p * 360).toFixed(1)}deg)`;
      };

      const onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      };

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
      update();
    }
  }
</script>
