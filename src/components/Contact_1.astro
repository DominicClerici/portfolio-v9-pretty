---
// V1 — "The Guestbook": personal sites used to end with one, so this one
// does too. Bone paper cards pinned to the dark wall — Dominic signs the
// first entry (the quote), and the form is simply the next blank card,
// ruled lines and all. Cards hang slightly crooked and straighten when
// you start writing.
const links = [
  { label: "GitHub", handle: "@DominicClerici", href: "https://github.com/DominicClerici" },
  { label: "LinkedIn", handle: "in/dominic-clerici", href: "https://www.linkedin.com/in/dominic-clerici/" },
  { label: "Email", handle: "contact@dominicclerici.com", href: "mailto:contact@dominicclerici.com" },
];
---

<section class="cv1 relative bg-[#0a0a0a] overflow-hidden" aria-label="Contact">
  <div class="relative max-w-[1160px] mx-auto px-6 lg:px-12 py-[clamp(96px,14vh,180px)]">
    <h2 class="sr-only">Contact</h2>

    <div class="flex items-baseline justify-between gap-6 mb-16 lg:mb-24">
      <p class="font-mono text-[12px] leading-none tracking-[-0.02em] uppercase text-white/45">
        04&hairsp;/&hairsp;04 &middot; The guestbook
      </p>
      <p class="font-mono text-[12px] leading-none tracking-[-0.02em] text-white/30 hidden sm:block">
        sign it before you go
      </p>
    </div>

    <div class="grid lg:grid-cols-[minmax(0,400px)_minmax(0,1fr)] gap-14 lg:gap-20 items-start">
      <div>
        <!-- Entry № 001 — the owner's -->
        <article class="cv1-card cv1-card-host relative">
          <span class="cv1-pin" aria-hidden="true"></span>
          <p class="cv1-meta">Entry &numero;&thinsp;001 &middot; the owner</p>
          <p class="cv1-entry mt-6">
            The first language was a disaster. Everything since has been on&nbsp;purpose.
          </p>
          <p class="cv1-sign mt-7">&mdash; Dominic, wrote all of this</p>
        </article>

        <ul class="mt-14 lg:mt-16">
          <li class="font-mono text-[11px] tracking-[-0.02em] uppercase text-white/35 pb-4">
            Elsewhere, if forms aren&rsquo;t your thing
          </li>
          {
            links.map((link) => (
              <li>
                <a
                  href={link.href}
                  target={link.href.startsWith("mailto") ? undefined : "_blank"}
                  rel={link.href.startsWith("mailto") ? undefined : "noopener noreferrer"}
                  class="cv1-row group flex items-baseline justify-between gap-6 py-4 border-t border-[#1e1e1e] last:border-b"
                >
                  <span class="font-mono text-[13px] tracking-[-0.02em] text-[#bdbdbd] group-hover:text-bio-lime transition-colors duration-200">
                    {link.label}
                  </span>
                  <span class="font-mono text-[12px] tracking-[-0.02em] text-[#5f5f5f] group-hover:text-[#8a8a8a] transition-colors duration-200 truncate">
                    {link.handle}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Entry № 002 — yours -->
      <form class="cv1-card cv1-card-form relative" novalidate>
        <span class="cv1-pin" aria-hidden="true"></span>
        <p class="cv1-meta">Entry &numero;&thinsp;002 &middot; you</p>

        <label for="cv1-message" class="sr-only">Your entry (required)</label>
        <textarea
          id="cv1-message"
          name="message"
          rows="4"
          required
          placeholder="Anything counts. A hello, a hot take, a job, a bug you found…"
          class="cv1-entry cv1-paper mt-6"></textarea>

        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-4 mt-8">
          <label for="cv1-name" class="cv1-meta shrink-0">signed</label>
          <input
            id="cv1-name"
            name="name"
            type="text"
            autocomplete="name"
            placeholder="or stay anonymous"
            class="cv1-ink-input cv1-ink-name flex-1 min-w-[160px]"
          />
        </div>

        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-4 mt-4">
          <label for="cv1-email" class="cv1-meta shrink-0">reply&#8209;to</label>
          <input
            id="cv1-email"
            name="email"
            type="email"
            autocomplete="email"
            placeholder="only if you'd like a note back"
            class="cv1-ink-input flex-1 min-w-[160px]"
          />
        </div>

        <div class="flex items-center justify-between gap-4 mt-10 pt-6 border-t border-[#222f30]/15">
          <span class="font-mono text-[11px] tracking-[-0.02em] text-[#222f30]/55">
            I read every entry. Usually reply within 48h.
          </span>
          <button
            type="submit"
            class="cv1-btn shrink-0 inline-flex items-center gap-2.5 font-mono text-[13px] tracking-[-0.008em] bg-ink text-bone rounded-full h-11 px-5 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink"
          >
            Pin it to the wall
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <circle cx="6" cy="4" r="3" fill="currentColor"></circle>
              <path d="M6 7v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
            </svg>
          </button>
        </div>

        <p class="cv1-error hidden font-mono text-[11px] tracking-[-0.02em] text-[#a5503c] mt-4" role="alert">
          A blank entry is very mysterious — but write something.
        </p>
      </form>
    </div>
  </div>
</section>

<style>
  .cv1-card {
    background:
      linear-gradient(rgba(255, 255, 255, 0.35), rgba(255, 255, 255, 0) 40%),
      #f4f2ec;
    color: var(--color-ink);
    border-radius: 3px;
    padding: 2.25rem 2rem 1.75rem;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.07),
      0 18px 50px rgba(0, 0, 0, 0.55),
      0 2px 8px rgba(0, 0, 0, 0.4);
  }

  @media (min-width: 640px) {
    .cv1-card {
      padding: 2.5rem 2.5rem 2rem;
    }
  }

  .cv1-card-host {
    transform: rotate(-1.4deg);
  }

  .cv1-card-form {
    transform: rotate(0.9deg);
  }

  .cv1-pin {
    position: absolute;
    top: -9px;
    left: 50%;
    width: 18px;
    height: 18px;
    margin-left: -9px;
    border-radius: 9999px;
    background: radial-gradient(circle at 35% 30%, #e8ffc4, var(--color-bio-lime) 55%, #9cc46a);
    box-shadow:
      0 3px 6px rgba(0, 0, 0, 0.45),
      inset 0 -2px 3px rgba(34, 47, 48, 0.3);
  }

  .cv1-meta {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgba(34, 47, 48, 0.5);
  }

  /* Ruled paper — entry text and textarea share the same line metrics */
  .cv1-entry {
    font-family: var(--font-headline);
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    line-height: 36px;
    letter-spacing: -0.005em;
    color: var(--color-ink);
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 35px,
      rgba(34, 47, 48, 0.16) 35px,
      rgba(34, 47, 48, 0.16) 36px
    );
  }

  .cv1-paper {
    display: block;
    width: 100%;
    min-height: 144px;
    border: none;
    outline: none;
    resize: none;
    padding: 0;
    caret-color: var(--color-ink);
    background-color: transparent;
    background-attachment: local;
  }

  .cv1-paper::placeholder {
    color: rgba(34, 47, 48, 0.35);
    font-style: italic;
  }

  .cv1-ink-input {
    background: transparent;
    border: none;
    border-bottom: 1px dashed rgba(34, 47, 48, 0.35);
    border-radius: 0;
    outline: none;
    padding: 0 0.1em 0.2em;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: -0.008em;
    color: var(--color-ink);
    caret-color: var(--color-ink);
    transition: border-color 0.2s ease;
  }

  .cv1-ink-name {
    font-family: var(--font-headline);
    font-style: italic;
    font-size: 19px;
  }

  .cv1-ink-input::placeholder {
    color: rgba(34, 47, 48, 0.32);
  }

  .cv1-ink-input:focus {
    border-bottom-style: solid;
    border-bottom-color: var(--color-ink);
  }

  .cv1-row:focus-visible {
    outline: 2px solid var(--color-bio-lime);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .cv1-card {
      transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* The blank card straightens when you sit down to write */
    .cv1-card-form:hover,
    .cv1-card-form:focus-within {
      transform: rotate(0deg);
    }

    .cv1-btn {
      transition: transform 0.2s ease;
    }

    .cv1-btn:hover {
      transform: translateY(-2px);
    }
  }
</style>

<script>
  {
    const form = document.querySelector<HTMLFormElement>(".cv1-card-form");
    if (form) {
      const message = form.querySelector<HTMLTextAreaElement>("#cv1-message");
      const error = form.querySelector<HTMLElement>(".cv1-error");

      if (message) {
        message.addEventListener("input", () => {
          message.style.height = "auto";
          message.style.height = `${message.scrollHeight}px`;
          error?.classList.add("hidden");
        });
      }

      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const data = new FormData(form);
        const name = String(data.get("name") || "").trim();
        const email = String(data.get("email") || "").trim();
        const body = String(data.get("message") || "").trim();

        if (!body) {
          error?.classList.remove("hidden");
          message?.focus();
          return;
        }

        const subject = name ? `Guestbook entry from ${name}` : "A guestbook entry";
        const lines = [body, "", name ? `signed — ${name}` : "signed — anonymous", email ? `reply-to: ${email}` : ""].filter(Boolean);
        window.location.href = `mailto:contact@dominicclerici.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join("\n"))}`;
      });
    }
  }
</script>
