---
// Text CTA + icon blob as ONE anchor, with the interlocking silhouette and
// hover choreography adapted from integratedbio.com's hero button.
//
// Geometry is theirs: the label's tail wedge and the blob's bitten left edge
// are the paths their theme ships, authored against a 48px button. Ours is
// 40px, so everything is expressed as `N * --ab-s` off that 48px reference —
// the two SVGs keep their original viewBoxes and scale uniformly (18/48 and
// 51/48 are exactly 15/40 and 42.5/40), so the seam stays true at any height.
// Change --ab-s alone to resize the whole thing.
//
// The signature move is the seam swivelling: at rest the wedge is widest at
// y=14.91 and the blob's bite sits top-left, so the join slants one way; on
// hover both mirror about the horizontal centreline and the slant runs the
// other way, sweeping through vertical at the midpoint. Their site does this
// with GSAP's MorphSVGPlugin. We transition the CSS `d` property instead,
// which needs no library but only interpolates between paths with identical
// segment structures — so both states are normalised to all-cubic form and
// the flipped path is derived by reflecting the rest path's control points.
// That makes segment i morph into segment i by construction. (Their own two
// strings are the same shapes but with rotated point lists, which is why
// they need MorphSVG's point-matching and we can't just paste them in.)
//
// Underneath that: the halves trade colours, the label leans right into the
// seam, the blob retreats out of its socket, and the arrow slides off in the
// direction it points while a second, pre-tinted copy slides in behind it.
// The two copies are the point — a lone arrow cross-fading its own colour
// against an inverting fill passes through the same midpoint the fill does,
// and vanishes for a few frames.

// Slide vector per glyph — the arrow exits the way it points.
const ICONS = {
  down: { d: "M7 1v11M2 7.5 7 12.5 12 7.5", dx: "0px", dy: "30px" },
  right: { d: "M1 7h11M6.5 2 12 7l-5.5 5", dx: "30px", dy: "0px" },
  external: { d: "M2 12 12 2M4.5 2H12v7.5", dx: "21px", dy: "-21px" },
};

// Rest shapes carry the `d` attribute as well, so a browser without CSS `d`
// support renders the correct silhouette and simply skips the swivel.
const CORNER_FILL_REST =
  "M0 0C1.877 0 3.753 0 5.63 0C13.438 0 19.166 7.337 17.272 14.91C15.242 23.03 13.212 31.149 11.182 39.269C9.903 44.383 5.272 48 0 48C0 32 0 16 0 0Z";
// Reopened for the stroke: drops the x=0 edge so the line reads as a
// continuation of the label's own top and bottom borders.
const CORNER_LINE_REST =
  "M0 0C1.877 0 3.753 0 5.63 0C13.438 0 19.166 7.337 17.272 14.91C15.242 23.03 13.212 31.149 11.182 39.269C9.903 44.383 5.272 48 0 48";
const BLOB_REST =
  "M6.728 9.09C8.059 3.766 12.881 0 18.369 0C25.246 0 32.123 0 39 0C45.627 0 51 5.373 51 12C51 20 51 28 51 36C51 42.627 45.627 48 39 48C30.123 48 21.247 48 12.37 48C4.561 48 -1.167 40.663 0.727 33.09C2.727 25.09 4.727 17.09 6.727 9.09Z";

interface Props {
  href: string;
  icon: keyof typeof ICONS;
  variant?: "light" | "dark" | "solid";
  size?: "sm" | "md";
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  icon,
  variant = "light",
  size = "md",
  class: className = "",
  ...rest
} = Astro.props;

const { d, dx, dy } = ICONS[icon];
---

<a
  href={href}
  class:list={["ab", className]}
  data-variant={variant}
  data-size={size}
  style={`--ab-dx:${dx};--ab-dy:${dy}`}
  {...rest}
>
  <span class="ab-label">
    <slot />
    <span class="ab-corner">
      <svg viewBox="0 0 18 48" fill="none" aria-hidden="true">
        <path class="ab-corner-fill" d={CORNER_FILL_REST}></path>
        {/* Inset by half a stroke so the 1px line lands on the label's own
            border-box edge instead of straddling it. */}
        <path
          class="ab-corner-line"
          d={CORNER_LINE_REST}
          transform="translate(0.216 0.6) scale(0.975)"
          vector-effect="non-scaling-stroke"></path>
      </svg>
    </span>
  </span>

  <span class="ab-icon" aria-hidden="true">
    <svg class="ab-blob" viewBox="0 0 51 48" fill="none">
      <path d={BLOB_REST}></path>
    </svg>
    <span class="ab-glyph ab-glyph--out">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
        <path
          d={d}
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </span>
    <span class="ab-glyph ab-glyph--in">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
        <path
          d={d}
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </span>
  </span>
</a>

<style>
  .ab {
    /* 40px tall, drawn from a 48px reference (see the note above). */
    --ab-s: 0.8333;
    --ab-dur: 0.6s;
    --ab-ease: cubic-bezier(0.25, 1, 0.5, 1);
    /* The swivel runs faster than the colour inversion, as it does on their
       site: gsap.to(..., { duration: .3, ease: "power2.out" }). */
    --ab-morph-dur: 0.3s;
    --ab-morph-ease: cubic-bezier(0.215, 0.61, 0.355, 1);

    /* Each shape's two states, and the slot that selects between them. */
    --ab-corner-rest: path(
      "M0 0C1.877 0 3.753 0 5.63 0C13.438 0 19.166 7.337 17.272 14.91C15.242 23.03 13.212 31.149 11.182 39.269C9.903 44.383 5.272 48 0 48C0 32 0 16 0 0Z"
    );
    --ab-corner-flip: path(
      "M0 48C1.877 48 3.753 48 5.63 48C13.438 48 19.166 40.663 17.272 33.09C15.242 24.97 13.212 16.851 11.182 8.731C9.903 3.617 5.272 0 0 0C0 16 0 32 0 48Z"
    );
    --ab-line-rest: path(
      "M0 0C1.877 0 3.753 0 5.63 0C13.438 0 19.166 7.337 17.272 14.91C15.242 23.03 13.212 31.149 11.182 39.269C9.903 44.383 5.272 48 0 48"
    );
    --ab-line-flip: path(
      "M0 48C1.877 48 3.753 48 5.63 48C13.438 48 19.166 40.663 17.272 33.09C15.242 24.97 13.212 16.851 11.182 8.731C9.903 3.617 5.272 0 0 0"
    );
    --ab-blob-rest: path(
      "M6.728 9.09C8.059 3.766 12.881 0 18.369 0C25.246 0 32.123 0 39 0C45.627 0 51 5.373 51 12C51 20 51 28 51 36C51 42.627 45.627 48 39 48C30.123 48 21.247 48 12.37 48C4.561 48 -1.167 40.663 0.727 33.09C2.727 25.09 4.727 17.09 6.727 9.09Z"
    );
    --ab-blob-flip: path(
      "M6.728 38.91C8.059 44.234 12.881 48 18.369 48C25.246 48 32.123 48 39 48C45.627 48 51 42.627 51 36C51 28 51 20 51 12C51 5.373 45.627 0 39 0C30.123 0 21.247 0 12.37 0C4.561 0 -1.167 7.337 0.727 14.91C2.727 22.91 4.727 30.91 6.727 38.91Z"
    );
    --ab-corner-d: var(--ab-corner-rest);
    --ab-line-d: var(--ab-line-rest);
    --ab-blob-d: var(--ab-blob-rest);

    /* Animated state. Hover swaps these; every dependent property is a real
       transitionable property reading the var, so redefining them there is
       enough to drive the whole choreography from one block. */
    --ab-gap: calc(16px * var(--ab-s));
    --ab-pr: calc(8px * var(--ab-s));
    --ab-shrink: 0.875;
    --ab-scale: 1;
    --ab-out: translate(0, 0);
    --ab-in: translate(calc(-1 * var(--ab-dx)), calc(-1 * var(--ab-dy)));

    position: relative;
    display: inline-flex;
    align-items: stretch;
    width: fit-content;
    height: calc(48px * var(--ab-s));
    font-family: var(--font-mono);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .ab[data-size="sm"] {
    font-size: 13px;
  }
  .ab[data-size="md"] {
    font-size: 14px;
  }

  /* ── Label ── */

  .ab-label {
    position: relative;
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    line-height: 1;
    letter-spacing: -0.01em;
    padding: calc(8px * var(--ab-s)) var(--ab-pr) calc(8px * var(--ab-s))
      calc(20px * var(--ab-s));
    margin-right: var(--ab-gap);
    /* No right border: the wedge's stroke carries the outline across the gap. */
    border: 1px solid var(--ab-line);
    border-right: 0;
    border-radius: calc(12px * var(--ab-s)) 0 0 calc(12px * var(--ab-s));
    background-color: var(--ab-bg);
    color: var(--ab-fg);
    transition-property: background-color, border-color, color, margin-right,
      padding-right;
    transition-duration: var(--ab-dur);
    transition-timing-function: var(--ab-ease);
  }

  /* Overhangs the label by 2 reference units so fill meets fill with no seam. */
  .ab-corner {
    position: absolute;
    /* The label's own 1px border insets the padding box this resolves
       against; the wedge has to span the border box to line up with it. */
    top: -1px;
    bottom: -1px;
    right: calc(-1 * var(--ab-gap));
    width: calc(18px * var(--ab-s));
    transition: right var(--ab-dur) var(--ab-ease);
  }

  .ab-corner svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .ab-corner-fill {
    d: var(--ab-corner-d);
    fill: var(--ab-bg);
    transition:
      d var(--ab-morph-dur) var(--ab-morph-ease),
      fill var(--ab-dur) var(--ab-ease);
  }

  .ab-corner-line {
    d: var(--ab-line-d);
    fill: none;
    stroke: var(--ab-line);
    stroke-width: 1;
    transition:
      d var(--ab-morph-dur) var(--ab-morph-ease),
      stroke var(--ab-dur) var(--ab-ease);
  }

  /* ── Blob ── */

  .ab-icon {
    position: relative;
    flex: none;
    display: inline-flex;
    width: calc(51px * var(--ab-s));
    height: 100%;
    overflow: hidden;
    transform: scale(var(--ab-scale));
    transform-origin: center right;
    transition: transform var(--ab-dur) var(--ab-ease);
  }

  .ab-blob {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ab-blob path {
    d: var(--ab-blob-d);
    fill: var(--ab-blob-bg);
    transition:
      d var(--ab-morph-dur) var(--ab-morph-ease),
      fill var(--ab-dur) var(--ab-ease);
  }

  /* Centred on the blob's round lobe, not on its bitten left edge. */
  .ab-glyph {
    position: absolute;
    top: 0;
    left: calc(4px * var(--ab-s));
    width: calc(100% - 4px * var(--ab-s));
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition-property: transform, opacity;
    transition-duration: var(--ab-dur);
    transition-timing-function: var(--ab-ease);
  }

  .ab-glyph--out {
    color: var(--ab-blob-fg);
    transform: var(--ab-out);
  }

  .ab-glyph--in {
    color: var(--ab-blob-fg-h);
    transform: var(--ab-in);
  }

  /* ── Palettes ──
     Every variant is the same idea: at rest the accent sits in the blob, on
     hover it moves to the label and the blob takes the label's old weight.
     Only the blob's hover fill differs, because "dark plate" has to be read
     against three different backgrounds. */

  .ab[data-variant="light"] {
    --ab-bg: transparent;
    --ab-line: color-mix(in srgb, var(--color-ink) 35%, transparent);
    --ab-fg: var(--color-ink);
    --ab-bg-h: var(--color-bio-lime);
    --ab-line-h: var(--color-bio-lime);
    --ab-fg-h: var(--color-ink);
    --ab-blob-bg: var(--color-bio-lime);
    --ab-blob-bg-h: var(--color-ink);
    --ab-blob-fg: var(--color-ink);
    --ab-blob-fg-h: var(--color-bio-lime);
    --ab-focus: var(--color-ink);
  }

  /* On the n-900 card, ink is only 1.35:1 — the blob would disappear. n-700
     is the lightest step that still reads as the label's old outline weight. */
  .ab[data-variant="dark"] {
    --ab-bg: transparent;
    --ab-line: var(--color-n-700);
    --ab-fg: var(--color-n-100);
    --ab-bg-h: var(--color-bio-lime);
    --ab-line-h: var(--color-bio-lime);
    --ab-fg-h: var(--color-ink);
    --ab-blob-bg: var(--color-bio-lime);
    --ab-blob-bg-h: var(--color-n-700);
    --ab-blob-fg: var(--color-ink);
    --ab-blob-fg-h: var(--color-bio-lime);
    --ab-focus: var(--color-bio-lime);
  }

  .ab[data-variant="solid"] {
    --ab-bg: var(--color-ink);
    --ab-line: var(--color-ink);
    --ab-fg: var(--color-bone);
    --ab-bg-h: var(--color-bio-lime);
    --ab-line-h: var(--color-bio-lime);
    --ab-fg-h: var(--color-ink);
    --ab-blob-bg: var(--color-bio-lime);
    --ab-blob-bg-h: var(--color-ink);
    --ab-blob-fg: var(--color-ink);
    --ab-blob-fg-h: var(--color-bio-lime);
    --ab-focus: var(--color-ink);
  }

  /* ── Hover / focus ──
     Must follow the palettes: same specificity, later wins. Keyboard focus
     gets the motion too, not just the ring. */
  .ab:hover,
  .ab:focus-visible {
    --ab-corner-d: var(--ab-corner-flip);
    --ab-line-d: var(--ab-line-flip);
    --ab-blob-d: var(--ab-blob-flip);
    --ab-bg: var(--ab-bg-h);
    --ab-line: var(--ab-line-h);
    --ab-fg: var(--ab-fg-h);
    --ab-blob-bg: var(--ab-blob-bg-h);
    --ab-gap: calc(12px * var(--ab-s));
    --ab-pr: calc(14px * var(--ab-s));
    --ab-scale: var(--ab-shrink);
    --ab-out: translate(var(--ab-dx), var(--ab-dy));
    --ab-in: translate(0, 0);
  }

  .ab:focus-visible {
    outline: 2px solid var(--ab-focus);
    outline-offset: 4px;
    border-radius: calc(12px * var(--ab-s));
  }

  /* ── Reduced motion ──
     Nothing translates, resizes or swivels; aliasing each flip target back to
     its rest shape pins the silhouette without touching the hover block. The
     arrows cross-fade in place instead, which keeps the two-copy colour trick
     doing its job. */
  @media (prefers-reduced-motion: reduce) {
    .ab {
      --ab-corner-flip: var(--ab-corner-rest);
      --ab-line-flip: var(--ab-line-rest);
      --ab-blob-flip: var(--ab-blob-rest);
      --ab-shrink: 1;
      --ab-fade-out: 1;
      --ab-fade-in: 0;
    }

    .ab:hover,
    .ab:focus-visible {
      --ab-gap: calc(16px * var(--ab-s));
      --ab-pr: calc(8px * var(--ab-s));
      --ab-out: translate(0, 0);
      --ab-in: translate(0, 0);
      --ab-fade-out: 0;
      --ab-fade-in: 1;
    }

    .ab-glyph--out {
      opacity: var(--ab-fade-out);
    }

    .ab-glyph--in {
      opacity: var(--ab-fade-in);
    }
  }
</style>
