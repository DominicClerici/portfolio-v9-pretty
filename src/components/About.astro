---
import { conceptualSkills, technicalSkills } from "../data/about";

const figures = [
  { value: "4+", label: "Years shipping" },
  { value: "9+", label: "Years programming" },
  { value: "2004", label: "Established" },
];
---

<!-- Scrolls over the pinned hero canvas — no background of its own. One large
     paragraph, the skills running past as two bands, and the numbers set as
     figures. -->
<section id="about" class="relative">
  <div class="container-page pt-[clamp(120px,18vh,200px)]">
    <h2 class="sr-only">About</h2>
    <p
      id="about-intro"
      class="mx-auto text-center font-display text-ink leading-[1.1] tracking-[-0.022em] max-w-[1180px] text-[clamp(1.875rem,calc(1.875rem+(100vw-27.5rem)*0.031),3.875rem)]"
    >
      Full-stack engineer at Junior. I&rsquo;ve been programming since before
      I had any business doing so&nbsp;&mdash;
      <span class="text-ink/50">
        most of what I know came from building things badly the first time.
      </span>
    </p>
  </div>

  <!-- The bands are the same lists twice over so each can loop on itself;
       the copies are for the eye only, and the lists are read from here. -->
  <ul class="sr-only">
    {[...conceptualSkills, ...technicalSkills].map((s) => <li>{s}</li>)}
  </ul>
  <div class="about-bands mt-[clamp(72px,10vw,150px)]" aria-hidden="true">
    <div class="about-band about-band--focus font-display text-ink">
      {
        [0, 1].map(() => (
          <div class="about-run">
            {conceptualSkills.map((s) => (
              <span>
                {s}
                <i />
              </span>
            ))}
          </div>
        ))
      }
    </div>
    <div class="about-band about-band--stack font-mono">
      {
        [0, 1].map(() => (
          <div class="about-run">
            {technicalSkills.map((s) => <span>{s}</span>)}
          </div>
        ))
      }
    </div>
  </div>

  <!-- The foot of the section is left long and empty: PinnedCanvas starts
       the turn to dark once About's last quarter is on screen, and the
       figures should mostly have been read on paper by then. -->
  <div
    class="container-page pt-[clamp(72px,10vw,150px)] pb-[clamp(320px,50vh,520px)]"
  >
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-x-6 gap-y-10">
      {
        figures.map((f) => (
          <div class="about-figure" data-reveal-col>
            <div
              class="about-figure-value font-display text-ink"
              data-reveal="value"
            >
              {f.value}
            </div>
            <div
              class="font-mono text-[13px] leading-none uppercase text-ink mt-5"
              data-reveal="label"
            >
              {f.label}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .about-bands {
    display: grid;
    gap: clamp(18px, 2.2vw, 30px);
    overflow: hidden;
  }
  .about-band {
    display: flex;
    width: max-content;
  }
  .about-run {
    display: flex;
    align-items: center;
    flex: none;
  }
  .about-band--focus {
    font-size: clamp(2.25rem, 5.4vw, 5rem);
    line-height: 1.1;
    letter-spacing: -0.035em;
  }
  .about-band--focus span {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    letter-spacing: inherit;
  }
  .about-band--focus i {
    width: 0.2em;
    height: 0.2em;
    margin: 0 0.42em;
    border-radius: 50%;
    background: var(--color-ink);
    box-shadow: 0 0 0 0.09em var(--color-bio-lime);
  }
  .about-band--stack {
    font-size: 13px;
    line-height: 1;
    text-transform: uppercase;
  }
  .about-band--stack span {
    margin-right: 10px;
    padding: 11px 16px;
    border: 1px solid rgb(34 47 48 / 0.28);
    border-radius: 999px;
    color: var(--color-ink);
    white-space: nowrap;
    background: rgb(247 247 245 / 0.5);
  }
  /* Running only while they can be seen (.is-running, from the script): a
     transform animation left going off screen still costs the compositor a
     frame every frame. */
  @media (prefers-reduced-motion: no-preference) {
    .about-band {
      animation: about-run 46s linear infinite paused;
    }
    .about-band--stack {
      animation-duration: 58s;
      animation-direction: reverse;
    }
    .about-bands.is-running .about-band {
      animation-play-state: running;
    }
    @keyframes about-run {
      to {
        transform: translateX(-50%);
      }
    }
  }

  .about-figure {
    padding-top: 22px;
    border-top: 1px solid rgb(34 47 48 / 0.25);
  }
  .about-figure-value {
    font-size: clamp(4.5rem, 10.5vw, 10rem);
    line-height: 0.86;
    letter-spacing: -0.055em;
    font-variant-numeric: lining-nums;
  }
</style>

<!-- is:global because these spans are created by the script at runtime and so
     never carry Astro's scope attribute. Kept under #about to contain them. -->
<style is:global>
  /* Typewriter chunk: one span per few characters of the intro paragraph.
     The from-state and the transition live here so the script only toggles
     .on rather than writing four inline styles per span — which also means
     the duration and travel below are the knobs, not the script. */
  #about .chunk {
    display: inline-block;
    opacity: 0.1;
    transform: translateY(6px);
    transition:
      transform 0.25s var(--ease-rise),
      opacity 0.25s var(--ease-rise);
  }

  /* A word is split into several inline-block chunks, which the browser would
     otherwise treat as independent break opportunities — wrapping "University"
     as "Universi / ty". The wrapper keeps each word atomic; breaks happen at
     the whitespace text nodes between wrappers, as they would without the
     typewriter. */
  #about .word {
    display: inline-block;
    white-space: nowrap;
  }

  #about .chunk.on {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  import { docTop, onLayoutChange } from "../lib/layout-watch";

  {
    /* ══ Scroll-driven reveals ═════════════════════════════════════════════
       Three effects, one scroll listener and one reduced-motion check:

       1. The intro paragraph types itself in. Scroll only *triggers* each
          chunk — every character you scroll past costs PX_PER_CHAR pixels,
          and once a chunk's trigger point is reached it plays its own
          fixed-duration CSS transition. The scroll position does not scrub
          the motion, it just fires it. Scrolling back reverses it.

       2. The figures fade + rise into place, a column at a time, the
          moment its top scrolls past REVEAL_VP_FRACTION of the viewport.
          Within a column the label follows the value.

       3. The skill bands run only while they are on screen.

       Under prefers-reduced-motion none of them runs: no chunk spans are
       created, the figures are never primed, and the bands stand still.

       The typewriter's own duration and travel are CSS (.chunk, above); the
       knobs here are the ones the script owns. */

    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    // ── Typewriter knobs ──
    // Max characters per chunk. Chunks never span two words — a word longer
    // than this is split into pieces, and each word starts a fresh chunk, so
    // e.g. "…ing a…" reveals as "ing" then "a…", never "ing a".
    const CHUNK_SIZE = 4;
    // How far you scroll (px) to advance one character's worth of triggers —
    // the pacing knob. Larger = more scrolling between chunks firing.
    const PX_PER_CHAR = 3.5;
    // The typewriter starts once the top of the text crosses this fraction of
    // the viewport height (0.9 = the top edge of the bottom 10%).
    const TYPE_VP_FRACTION = 0.9;

    // ── Stats-reveal knobs ──
    const REVEAL_MS = 650; // duration — matches the hero line-rise
    // Trigger once a column's top crosses this fraction of the viewport
    // height (0.8 = the top edge of the bottom 20%).
    const REVEAL_VP_FRACTION = 0.8;
    const FROM_OPACITY = 0.1;
    // Per-role start offset (px) and stagger delay (s) within a column.
    const ROLE = {
      value: { y: 6, delay: 0 },
      label: { y: 4, delay: 0.08 },
    };

    const ease = getComputedStyle(document.documentElement)
      .getPropertyValue("--ease-rise")
      .trim();

    /* ── 1. Intro typewriter ── */
    const intro = document.getElementById("about-intro");

    if (intro && !reducedMotion) {
      /* Split the paragraph into chunk <span>s in place, preserving nested
         markup (e.g. the muted second-sentence span) and whitespace. Words
         become one-or-more chunk spans; whitespace stays as plain text nodes
         so line-wrapping and spacing behave normally. */
      const chunks: { node: HTMLSpanElement; trigger: number; on: boolean }[] =
        [];
      let cursor = 0;

      const textNodes: Text[] = [];
      const walker = document.createTreeWalker(intro, NodeFilter.SHOW_TEXT);
      while (walker.nextNode()) textNodes.push(walker.currentNode as Text);

      for (const node of textNodes) {
        const tokens = (node.textContent || "").match(/\S+|\s+/g);
        if (!tokens) continue;
        const frag = document.createDocumentFragment();
        for (const token of tokens) {
          if (/^\s+$/.test(token)) {
            frag.appendChild(document.createTextNode(token));
            continue;
          }
          const word = document.createElement("span");
          word.className = "word";
          for (let i = 0; i < token.length; i += CHUNK_SIZE) {
            const piece = token.slice(i, i + CHUNK_SIZE);
            const span = document.createElement("span");
            span.className = "chunk";
            span.textContent = piece;
            word.appendChild(span);
            chunks.push({ node: span, trigger: cursor, on: false });
            cursor += piece.length;
          }
          frag.appendChild(word);
        }
        node.parentNode!.replaceChild(frag, node);
      }

      // The paragraph moves only with the page: its document top is measured
      // on layout changes, not read back every frame (lib/layout-watch.ts).
      let introTop = 0;

      function update(y = window.scrollY) {
        const line = TYPE_VP_FRACTION * window.innerHeight;
        // Characters worth of scroll past the trigger line (0 until crossed).
        const revealed = Math.max(
          0,
          (line - (introTop - y)) / PX_PER_CHAR,
        );
        for (const c of chunks) {
          // Fire once scroll has advanced past this chunk's trigger point;
          // the CSS transition on .chunk animates the actual motion.
          const on = revealed > c.trigger;
          if (on === c.on) continue;
          c.on = on;
          c.node.classList.toggle("on", on);
        }
      }

      // Shared bus: engine tick under normal motion, native scroll under
      // reduced motion. Fires at most once per frame, so no local throttle.
      (window as any).__onSmoothScrollTick(update);
      onLayoutChange(() => {
        introTop = docTop(intro);
      }, update);
    }

    /* ── 2. Figures reveal ── */
    const cols = document.querySelectorAll<HTMLElement>("[data-reveal-col]");

    if (cols.length && !reducedMotion) {
      // Remember each element's from-state so we can animate it back out with
      // the same transition + delay when the column scrolls back off-threshold.
      const primed = new Map<Element, { node: HTMLElement; fromY: number }[]>();

      function prime(node: HTMLElement, fromY: number, delay: number) {
        node.style.opacity = String(FROM_OPACITY);
        node.style.transform = `translateY(${fromY}px)`;
        node.style.transition = `opacity ${REVEAL_MS}ms ${ease} ${delay}s, transform ${REVEAL_MS}ms ${ease} ${delay}s`;
      }

      for (const col of cols) {
        const targets: { node: HTMLElement; fromY: number }[] = [];
        col.querySelectorAll<HTMLElement>("[data-reveal]").forEach((node) => {
          const r = ROLE[node.dataset.reveal as keyof typeof ROLE] ?? ROLE.value;
          prime(node, r.y, r.delay);
          targets.push({ node, fromY: r.y });
        });
        primed.set(col, targets);
      }

      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            const on = entry.isIntersecting;
            for (const { node, fromY } of primed.get(entry.target) ?? []) {
              node.style.opacity = on ? "1" : String(FROM_OPACITY);
              node.style.transform = on
                ? "translateY(0)"
                : `translateY(${fromY}px)`;
            }
          }
        },
        {
          threshold: 0,
          rootMargin: `0px 0px -${Math.round((1 - REVEAL_VP_FRACTION) * 100)}% 0px`,
        },
      );
      for (const col of cols) io.observe(col);
    }

    /* ── 3. Skill bands ── */
    const bands = document.querySelector<HTMLElement>(".about-bands");
    if (bands && !reducedMotion) {
      new IntersectionObserver((entries) => {
        bands.classList.toggle("is-running", entries[0].isIntersecting);
      }).observe(bands);
    }
  }
</script>
