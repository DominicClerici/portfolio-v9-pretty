</style>

<script>
  {
    const section = document.querySelector<HTMLElement>(".wa4");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (section && !reducedMotion) {
      const zone = section.querySelector<HTMLElement>("[data-zone]");
      const cards = Array.from(section.querySelectorAll<HTMLElement>("[data-card]"));

      // Must track the inline sticky tops: 88px base, 26px stair
      const STICK_TOP = 88;
      const STICK_STEP = 26;

      let ticking = false;

      const update = () => {
        ticking = false;
        if (!zone) return;
        const rect = zone.getBoundingClientRect();
        // Hidden variant panel (display: none) or mobile layout — nothing to drive
        if (!rect.height) return;

        // Total pile progress, per-build blend weights, per-chapter fills
        const range = rect.height - window.innerHeight;
        if (range > 0) {
          const p = Math.min(1, Math.max(0, -rect.top / range));
          const s = p * (cards.length - 1);
          section.style.setProperty("--p", p.toFixed(4));
          for (let i = 0; i < cards.length; i++) {
            section.style.setProperty(`--w${i}`, Math.max(0, 1 - Math.abs(s - i)).toFixed(3));
            section.style.setProperty(`--f${i}`, Math.min(1, Math.max(0, p * cards.length - i)).toFixed(3));
          }
        }

        // i's cover is driven by how far card i+1 has climbed toward its
        // own sticky seat; the last card is never covered
        for (let i = 0; i < cards.length - 1; i++) {
          const next = cards[i + 1].getBoundingClientRect();
          const seat = STICK_TOP + (i + 1) * STICK_STEP;
          const cover = Math.min(1, Math.max(0, 1 - (next.top - seat) / (window.innerHeight - seat)));
          cards[i].style.setProperty("--cover", cover.toFixed(3));
        }
      };

      const onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      };

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
      update();
    }
  }
</script>
