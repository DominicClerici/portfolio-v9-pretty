---
// V4 — "The Aurora": V2's strata pile under moving weather. Everything V1's
// seam carries (the buried dial, the plumb line, the mineral glows) plus a
// full ambient aurora that cross-fades lime → indigo → neon as the layers
// seat, per-build gauge bars on the top shelf, a giant engraved counter
// drifting behind the pile, an orbit arc counter-rotating around the dial,
// and parallax pellets in the gutters. The porcelain stays light enough for
// the shadows to read — the sky does the talking.
const projects = [
  {
    index: "01",
    title: "Dispatch",
    tech: "Astro · TypeScript · AI pipelines",
    fact: "writes itself every morning",
    description:
      "The last 24 hours of tech news, compressed into a 10 minute read. Two decoupled AI pipelines research, triage, and write it; GitHub Actions runs the whole thing while I sleep.",
    image: "/photos/dispatch.webp",
    alt: "Dispatch project screenshot",
    stack: ["Astro", "TypeScript", "OpenAI API", "Tailwind", "Vercel"],
    websiteUrl: "https://dispatch.dominicclerici.com/",
    githubUrl: "https://github.com/DominicClerici/dispatch",
  },
  {
    index: "02",
    title: "Meridian",
    tech: "Vanilla TypeScript · Extensions",
    fact: "0 npm dependencies",
    description:
      "A new-tab extension for Chrome and Firefox with zero npm dependencies. Eleven feature modules, a reactive storage layer, and a recommendation engine that never lets data leave the browser.",
    image: "/photos/meridian.webp",
    alt: "Meridian project screenshot",
    stack: ["TypeScript", "esbuild", "Chrome APIs", "Firefox Add-ons"],
    websiteUrl: "https://meridian.dominicclerici.com/",
    githubUrl: "https://github.com/DominicClerici/meridian",
  },
  {
    index: "03",
    title: "Fuzzbox",
    tech: "Next.js · React Native",
    fact: "design system: Neon Riff",
    featured: true,
    description:
      "The companion I wished I had when learning guitar. Place notes on an interactive fretboard and it explains the chord you found — the intervals, the theory, why it sounds the way it does.",
    image: "/photos/fuzzbox.webp",
    alt: "Fuzzbox project screenshot",
    stack: ["TypeScript", "Next.js", "React Native", "Prisma", "PostgreSQL"],
    websiteUrl: "https://fuzzbox.dominicclerici.com/",
    githubUrl: null,
  },
];

// Stair offset per layer — mirrored by STICK_TOP/STICK_STEP in the script
const STICK_TOP = 88;
const STICK_STEP = 26;

// Parallax pellet scatter: two depth groups, positions in % of the pin
const PELLETS_A = [
  { x: 5, y: 30 },
  { x: 93, y: 24 },
  { x: 9, y: 80 },
  { x: 89, y: 68 },
];
const PELLETS_B = [
  { x: 3.5, y: 56 },
  { x: 95.5, y: 46 },
  { x: 7, y: 13 },
];
---

<section class="wa4 relative" aria-label="Selected work">
  <div class="max-w-[1524px] mx-auto px-6 lg:px-12 pt-[clamp(96px,14vh,180px)]">
    <div class="flex items-center justify-between gap-4 mb-10 lg:mb-14">
      <div class="flex items-center gap-4">
        <span class="wa4-pill font-mono text-[13px] leading-none tracking-[-0.02em] text-ink/60 rounded-full px-3.5 py-2">
          03&hairsp;/&hairsp;04
        </span>
        <span class="font-mono text-[13px] leading-none tracking-[-0.02em] uppercase text-ink/60">
          Selected Work
        </span>
      </div>
      <a
        href="https://github.com/DominicClerici"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex font-mono text-[13px] leading-none tracking-[-0.02em] text-ink/45 hover:text-ink transition-colors duration-200"
      >
        more on github&nbsp;&nearr;
      </a>
    </div>

    <p
      class="font-display font-normal text-ink leading-[1.2] tracking-[-0.006em] max-w-[880px] text-[clamp(1.625rem,calc(1.625rem+(100vw-27.5rem)*0.02),2.625rem)] mb-4 lg:mb-6"
    >
      Three builds under one sky&nbsp;&mdash;
      <span class="text-ink/55">the weather turns with every layer.</span>
    </p>
  </div>

  <!-- Desktop: the sticky pile under the aurora -->
  <div class="relative" data-zone>
    <!-- The sky: every scroll-lit accent lives on this pinned backdrop -->
    <div class="absolute inset-0 hidden lg:block pointer-events-none" aria-hidden="true">
      <div class="sticky top-0 h-screen overflow-hidden">
        <span class="wa4-aur wa4-aur-0 absolute"></span>
        <span class="wa4-aur wa4-aur-1 absolute"></span>
        <span class="wa4-aur wa4-aur-2 absolute"></span>

        <span class="wa4-glow wa4-glow-0 absolute inset-0"></span>
        <span class="wa4-glow wa4-glow-1 absolute inset-0"></span>
        <span class="wa4-glow wa4-glow-2 absolute inset-0"></span>

        <span class="wa4-count wa4-ct-0 font-display font-normal">01</span>
        <span class="wa4-count wa4-ct-1 font-display font-normal">02</span>
        <span class="wa4-count wa4-ct-2 font-display font-normal">03</span>

        <div class="wa4-pell wa4-pell-a absolute inset-0">
          {PELLETS_A.map((d) => <span style={`left: ${d.x}%; top: ${d.y}%;`} />)}
        </div>
        <div class="wa4-pell wa4-pell-b absolute inset-0">
          {PELLETS_B.map((d) => <span style={`left: ${d.x}%; top: ${d.y}%;`} />)}
        </div>

        <div class="wa4-dial absolute rounded-full">
          <span class="wa4-orbit absolute rounded-full"></span>
          <span class="wa4-arc wa4-arc-0 absolute rounded-full"></span>
          <span class="wa4-arc wa4-arc-1 absolute rounded-full"></span>
          <span class="wa4-arc wa4-arc-2 absolute rounded-full"></span>
        </div>

        <div class="wa4-plumb absolute rounded-full">
          <span class="wa4-plumb-fill absolute"></span>
          {
            projects.map((_, i) => (
              <span
                class={`wa4-plumb-dot wa4-pd-${i} absolute rounded-full`}
                style={`top: ${(((i + 0.5) / projects.length) * 100).toFixed(2)}%;`}
              />
            ))
          }
        </div>

        <!-- Chapter gauges on the top shelf: each bar fills during its own build -->
        <div class="wa4-gauges absolute flex flex-col gap-[7px]">
          {
            projects.map((project, i) => (
              <div class="flex items-center gap-2.5">
                <span class="wa4-engraved font-mono text-[10px] leading-none tracking-[0.08em]">{project.index}</span>
                <span class="wa4-groove relative block rounded-full">
                  <span class={`wa4-gfill wa4-gf-${i} absolute rounded-full`} />
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <div class="hidden lg:block max-w-[1360px] mx-auto px-16 xl:px-20 pb-24 relative z-[1]" data-pile>
      {
        projects.map((project, i) => (
          <div class="wa4-layer" data-layer={i}>
            <article
              class="wa4-card relative rounded-[36px] p-8 xl:p-10 overflow-hidden"
              data-card={i}
              style={`--i: ${i}; top: ${STICK_TOP + i * STICK_STEP}px;`}
            >
              <span class="wa4-hair absolute top-0 left-[8%] right-[8%]" aria-hidden="true" />
              <span class={`wa4-hairp wa4-hp-${i} absolute top-0 left-[8%] right-[8%]`} aria-hidden="true" />

              <div class="grid grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-14 items-center">
                <div class={i % 2 === 1 ? "order-last" : ""}>
                  <span
                    class={`wa4-num wa4-np-${i} font-display font-normal leading-[0.85] tracking-[-0.04em] block text-[clamp(5rem,8vw,8rem)]`}
                  >
                    {project.index}
                  </span>
                  <div class="flex items-center gap-3 flex-wrap mt-5">
                    <h3 class="font-display font-normal leading-[0.98] tracking-[-0.02em] text-ink text-[clamp(2rem,2.6vw,2.75rem)]">
                      {project.title}
                    </h3>
                    {project.featured && (
                      <span class="wa4-feat font-mono text-[11px] leading-none tracking-[-0.02em] uppercase text-ink rounded-full px-2.5 py-1.5">
                        featured
                      </span>
                    )}
                  </div>
                  <p class="font-mono text-[12px] leading-none tracking-[-0.02em] uppercase text-ink/45 mt-4">
                    {project.tech}
                    <span class="text-ink/30 normal-case">&nbsp;&middot;&nbsp;{project.fact}</span>
                  </p>
                  <p class="font-display text-[15px] leading-[1.6] text-ink/60 max-w-[460px] mt-6">
                    {project.description}
                  </p>

                  <div class="flex flex-wrap gap-2.5 mt-7">
                    {project.stack.map((item) => (
                      <span class="wa4-chip font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/60 rounded-full px-3.5 py-2.5">
                        {item}
                      </span>
                    ))}
                  </div>

                  <div class="flex items-center gap-4 mt-9 max-w-[460px]">
                    <a
                      href={project.websiteUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="wa4-btn font-mono text-[13px] tracking-[-0.008em] text-ink rounded-[14px] h-11 px-5 inline-flex items-center"
                    >
                      Visit site
                    </a>
                    {project.githubUrl && (
                      <a
                        href={project.githubUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="font-mono text-[13px] tracking-[-0.008em] text-ink/55 h-11 px-2 inline-flex items-center hover:text-ink transition-colors duration-200"
                      >
                        GitHub
                      </a>
                    )}
                    <a
                      href={project.websiteUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`Open ${project.title} in a new tab`}
                      class="wa4-btn wa4-btn-go w-11 h-11 rounded-[14px] text-ink inline-flex items-center justify-center ml-auto"
                    >
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                        <path
                          d="M2 12 12 2M4.5 2H12v7.5"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </a>
                  </div>
                </div>

                <div class={`wa4-well wa4-wp-${i} rounded-[24px] p-4`}>
                  <img
                    src={project.image}
                    srcset={`${project.image} 1x, ${project.image.replace(".webp", "-2x.webp")} 2x`}
                    alt={project.alt}
                    class="w-full aspect-[16/9] object-cover object-top rounded-[14px]"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </div>

              <span class="wa4-veil absolute inset-0 rounded-[inherit]" aria-hidden="true" />
            </article>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Mobile: molded cards with static weather, no pile -->
  <div class="lg:hidden max-w-[1524px] mx-auto px-6 pb-[clamp(96px,14vh,180px)] pt-8">
    <div class="flex flex-col gap-10">
      {
        projects.map((project, i) => (
          <article class="wa4-card relative rounded-[26px] p-5 overflow-hidden">
            <span class={`wa4-hairp wa4-hm-${i} absolute top-0 left-[12%] right-[12%]`} aria-hidden="true" />
            <div class={`wa4-well wa4-wp-${i} rounded-[18px] p-2.5`}>
              <img
                src={project.image}
                srcset={`${project.image} 1x, ${project.image.replace(".webp", "-2x.webp")} 2x`}
                alt={project.alt}
                class="w-full aspect-[16/10] object-cover object-top rounded-[10px]"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="p-2 pt-6">
              <div class="flex items-center gap-3 flex-wrap">
                <span class={`wa4-num wa4-np-${i} font-display font-normal leading-none tracking-[-0.03em] text-[2.25rem]`}>
                  {project.index}
                </span>
                <h3 class="font-display font-normal leading-[1] tracking-[-0.018em] text-ink text-[clamp(1.75rem,calc(1.75rem+(100vw-27.5rem)*0.014),2.5rem)]">
                  {project.title}
                </h3>
                {project.featured && (
                  <span class="wa4-feat font-mono text-[11px] leading-none tracking-[-0.02em] uppercase text-ink rounded-full px-2.5 py-1.5">
                    featured
                  </span>
                )}
              </div>
              <p class="font-mono text-[12px] leading-none tracking-[-0.02em] uppercase text-ink/45 mt-3.5">
                {project.tech}
              </p>
              <p class="font-display text-[15px] leading-[1.6] text-ink/60 mt-5">{project.description}</p>

              <div class="flex flex-wrap gap-3 mt-6">
                {project.stack.map((item) => (
                  <span class="wa4-chip font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/60 rounded-full px-3.5 py-2.5">
                    {item}
                  </span>
                ))}
              </div>

              <div class="flex items-center gap-4 mt-8">
                <a
                  href={project.websiteUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="wa4-btn font-mono text-[13px] tracking-[-0.008em] text-ink rounded-[14px] h-11 px-5 inline-flex items-center"
                >
                  Visit site
                </a>
                {project.githubUrl && (
                  <a
                    href={project.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-mono text-[13px] tracking-[-0.008em] text-ink/55 h-11 px-2 inline-flex items-center hover:text-ink transition-colors duration-200"
                  >
                    GitHub
                  </a>
                )}
                <a
                  href={project.websiteUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Open ${project.title} in a new tab`}
                  class="wa4-btn wa4-btn-go w-11 h-11 rounded-[14px] text-ink inline-flex items-center justify-center ml-auto"
                >
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path
                      d="M2 12 12 2M4.5 2H12v7.5"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <p
    class="max-w-[1524px] mx-auto px-6 lg:px-12 pb-12 font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/35 text-right"
  >
    forecast: lime, clearing to indigo &mdash; neon by nightfall
  </p>
</section>

<style>
  /* Cool porcelain under moving weather. --w0/--w1/--w2 are per-build blend
     weights, --f0/--f1/--f2 are per-chapter fills, --p is total pile
     progress — all set from scroll. Defaults read as "Dispatch seated,
     nothing scrolled" so the section renders sane without JS. */
  .wa4 {
    --por: #eaedf1;
    --por-dark: rgba(151, 163, 180, 0.55);
    --por-darker: rgba(151, 163, 180, 0.72);
    --por-light: rgba(255, 255, 255, 0.95);
    --grad: linear-gradient(120deg, #cef79e, #9fe8cf 48%, #9cc2ff);
    /* Weather systems: 0 dispatch lime, 1 meridian indigo, 2 fuzzbox neon */
    --pg0: linear-gradient(120deg, #d3f89f, #a5e85c);
    --pg1: linear-gradient(120deg, #7c8ff7, #a78bfa);
    --pg2: linear-gradient(120deg, #ff6ec7, #3ee8a7 52%, #4dc9ff);
    background: var(--por);
  }

  .wa4-pill {
    box-shadow:
      inset 3px 3px 6px var(--por-dark),
      inset -3px -3px 6px var(--por-light);
  }

  /* ── Layers (V2's pile, verbatim) ── */
  .wa4-layer {
    min-height: 100vh;
    display: flex;
    align-items: flex-start;
  }

  .wa4-card {
    position: sticky;
    width: 100%;
    background: var(--por);
    box-shadow:
      14px 14px 34px var(--por-dark),
      -14px -14px 34px var(--por-light);
    transform: scale(calc(1 - var(--cover, 0) * 0.05));
    transform-origin: 50% 0;
  }

  @media (max-width: 1023px) {
    .wa4-card {
      position: relative;
      top: auto !important;
      transform: none;
    }
  }

  .wa4-veil {
    background: var(--por);
    opacity: calc(var(--cover, 0) * 0.55);
    pointer-events: none;
  }

  /* ── The aurora: three weather systems cross-fading with the pile,
     each drifting on its own vector as the page scrolls ── */
  .wa4-aur {
    inset: -12%;
    will-change: transform, opacity;
  }

  .wa4-aur-0 {
    background:
      radial-gradient(52% 44% at 16% 18%, rgba(165, 232, 92, 0.4), transparent 68%),
      radial-gradient(46% 40% at 84% 76%, rgba(206, 247, 158, 0.34), transparent 66%);
    opacity: calc(var(--w0, 1) * 0.8);
    transform: translate3d(0, calc(var(--p, 0) * -4vh), 0);
  }

  .wa4-aur-1 {
    background:
      radial-gradient(50% 44% at 20% 78%, rgba(124, 143, 247, 0.36), transparent 68%),
      radial-gradient(46% 40% at 82% 22%, rgba(167, 139, 250, 0.32), transparent 66%);
    opacity: calc(var(--w1, 0) * 0.8);
    transform: translate3d(calc(var(--p, 0) * 3vw), calc(var(--p, 0) * -7vh), 0);
  }

  .wa4-aur-2 {
    background:
      radial-gradient(44% 40% at 14% 24%, rgba(255, 110, 199, 0.32), transparent 66%),
      radial-gradient(40% 36% at 52% 88%, rgba(62, 232, 167, 0.26), transparent 64%),
      radial-gradient(44% 40% at 88% 30%, rgba(77, 201, 255, 0.32), transparent 66%);
    opacity: calc(var(--w2, 0) * 0.85);
    transform: translate3d(calc(var(--p, 0) * -3vw), calc(var(--p, 0) * -9vh), 0);
  }

  /* Weather glow bleeding past the seated card's edges */
  .wa4-glow-0 {
    background: radial-gradient(58% 46% at 50% 56%, rgba(165, 232, 92, 0.32), transparent 72%);
    opacity: calc(var(--w0, 1) * 0.7);
  }

  .wa4-glow-1 {
    background: radial-gradient(58% 46% at 50% 56%, rgba(139, 124, 250, 0.3), transparent 72%);
    opacity: calc(var(--w1, 0) * 0.7);
  }

  .wa4-glow-2 {
    background:
      radial-gradient(44% 38% at 38% 60%, rgba(255, 110, 199, 0.26), transparent 70%),
      radial-gradient(44% 38% at 66% 48%, rgba(77, 201, 255, 0.26), transparent 70%);
    opacity: calc(var(--w2, 0) * 0.7);
  }

  /* ── The counter: a giant engraved numeral keeping count behind the
     pile's bottom-left shoulder ── */
  .wa4-count {
    position: absolute;
    left: -1vw;
    bottom: -3vh;
    font-size: clamp(240px, 26vw, 440px);
    line-height: 0.8;
    letter-spacing: -0.05em;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: saturate(0.85);
    transform: translate3d(0, calc(var(--p, 0) * -6vh), 0);
    will-change: transform, opacity;
  }

  .wa4-ct-0 {
    background-image: var(--pg0);
    opacity: calc(var(--w0, 1) * 0.5);
  }

  .wa4-ct-1 {
    background-image: var(--pg1);
    opacity: calc(var(--w1, 0) * 0.45);
  }

  .wa4-ct-2 {
    background-image: var(--pg2);
    opacity: calc(var(--w2, 0) * 0.5);
  }

  /* ── Parallax pellets: molded dimples drifting at two depths ── */
  .wa4-pell span {
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 999px;
    background: var(--por);
    box-shadow:
      inset 2px 2px 3px var(--por-darker),
      inset -2px -2px 3px var(--por-light);
  }

  .wa4-pell-b span {
    width: 7px;
    height: 7px;
  }

  .wa4-pell-a {
    transform: translate3d(0, calc(var(--p, 0) * -10vh), 0);
    will-change: transform;
  }

  .wa4-pell-b {
    transform: translate3d(0, calc(var(--p, 0) * -22vh), 0);
    will-change: transform;
  }

  /* ── The buried dial + counter-rotating orbit ── */
  .wa4-dial {
    --dial: 86vmin;
    width: var(--dial);
    height: var(--dial);
    top: calc(var(--dial) * -0.3);
    right: calc(var(--dial) * -0.3);
    background: var(--por);
    box-shadow:
      inset 10px 10px 26px var(--por-darker),
      inset -10px -10px 26px var(--por-light);
  }

  .wa4-orbit {
    inset: -3.5vmin;
    background: conic-gradient(from 0deg, #a5e85c 0deg, #7c8ff7 34deg, #ff6ec7 68deg, transparent 68deg);
    -webkit-mask: radial-gradient(closest-side, transparent calc(100% - 3px), #000 calc(100% - 2px));
    mask: radial-gradient(closest-side, transparent calc(100% - 3px), #000 calc(100% - 2px));
    transform: rotate(calc(var(--p, 0) * -200deg));
    opacity: 0.8;
    will-change: transform;
  }

  .wa4-arc {
    inset: 3.5vmin;
    -webkit-mask: radial-gradient(closest-side, transparent calc(100% - 30px), #000 calc(100% - 29px));
    mask: radial-gradient(closest-side, transparent calc(100% - 30px), #000 calc(100% - 29px));
  }

  .wa4-arc-0 {
    background: conic-gradient(
      from 135deg,
      #d3f89f 0deg,
      #a5e85c calc(var(--p, 0) * 300deg),
      transparent calc(var(--p, 0) * 300deg)
    );
    opacity: var(--w0, 1);
  }

  .wa4-arc-1 {
    background: conic-gradient(
      from 135deg,
      #7c8ff7 0deg,
      #a78bfa calc(var(--p, 0) * 300deg),
      transparent calc(var(--p, 0) * 300deg)
    );
    opacity: var(--w1, 0);
  }

  .wa4-arc-2 {
    background: conic-gradient(
      from 135deg,
      #ff6ec7 0deg,
      #3ee8a7 calc(var(--p, 0) * 150deg),
      #4dc9ff calc(var(--p, 0) * 300deg),
      transparent calc(var(--p, 0) * 300deg)
    );
    opacity: var(--w2, 0);
  }

  /* ── The plumb line: strata core sample down the left gutter ── */
  .wa4-plumb {
    left: max(15px, calc((100vw - 1524px) / 2 + 15px));
    top: 16vh;
    width: 6px;
    height: 68vh;
    background: var(--por);
    box-shadow:
      inset 2px 2px 4px var(--por-darker),
      inset -2px -2px 4px var(--por-light);
  }

  .wa4-plumb-fill {
    inset: 1px;
    border-radius: 999px;
    background: linear-gradient(
      to bottom,
      #a5e85c,
      #cef79e 20%,
      #7c8ff7 42%,
      #a78bfa 58%,
      #ff6ec7 82%,
      #4dc9ff
    );
    clip-path: inset(0 0 calc((1 - var(--p, 0)) * 100%) 0 round 999px);
  }

  .wa4-plumb-dot {
    left: 50%;
