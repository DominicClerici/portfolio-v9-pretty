---
// "The Index": pure white, ink, and one accent — the site's bio-lime — spent
// on a single gesture: hovering a row sweeps a marker-highlight "selection"
// across its giant Aspekta title, while a preview card chases the cursor with
// a lazy lerp and a touch of drag-rotation. Opening a row unfolds the full
// entry (0fr → 1fr grid rows, no measured heights). Everything else is
// disciplined: three rows, three hairlines, generous air.
const projects = [
  {
    index: "01",
    title: "Dispatch",
    tech: "Astro · TypeScript · AI pipelines",
    fact: "writes itself every morning",
    description:
      "The last 24 hours of tech news, compressed into a 10 minute read. Two decoupled AI pipelines research, triage, and write it; GitHub Actions runs the whole thing while I sleep.",
    image: "/photos/dispatch.webp",
    alt: "Dispatch project screenshot",
    stack: ["Astro", "TypeScript", "OpenAI API", "Tailwind", "Vercel"],
    websiteUrl: "https://dispatch.dominicclerici.com/",
    githubUrl: "https://github.com/DominicClerici/dispatch",
    featured: false,
  },
  {
    index: "02",
    title: "Meridian",
    tech: "Vanilla TypeScript · Extensions",
    fact: "0 npm dependencies",
    description:
      "A new-tab extension for Chrome and Firefox with zero npm dependencies. Eleven feature modules, a reactive storage layer, and a recommendation engine that never lets data leave the browser.",
    image: "/photos/meridian.webp",
    alt: "Meridian project screenshot",
    stack: ["TypeScript", "esbuild", "Chrome APIs", "Firefox Add-ons"],
    websiteUrl: "https://meridian.dominicclerici.com/",
    githubUrl: "https://github.com/DominicClerici/meridian",
    featured: false,
  },
  {
    index: "03",
    title: "Fuzzbox",
    tech: "Next.js · React Native",
    fact: "design system: Neon Riff",
    description:
      "The companion I wished I had when learning guitar. Place notes on an interactive fretboard and it explains the chord you found — the intervals, the theory, why it sounds the way it does.",
    image: "/photos/fuzzbox.webp",
    alt: "Fuzzbox project screenshot",
    stack: ["TypeScript", "Next.js", "React Native", "Prisma", "PostgreSQL"],
    websiteUrl: "https://fuzzbox.dominicclerici.com/",
    githubUrl: null,
    featured: true,
  },
];
---

<section class="wi4 relative bg-paper" aria-label="Selected work">
  <div class="max-w-[1280px] mx-auto px-6 lg:px-12 pt-[clamp(96px,14vh,180px)] pb-[clamp(80px,10vh,140px)]">
    <div class="flex items-baseline justify-between gap-4">
      <p class="font-mono text-[11px] leading-none tracking-[0.24em] uppercase text-ink/45">
        03&hairsp;/&hairsp;04 &middot; Selected Work
      </p>
      <a
        href="https://github.com/DominicClerici"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline font-mono text-[11px] leading-none tracking-[0.14em] uppercase text-ink/45 hover:text-ink transition-colors duration-200 wi4-focus"
      >
        more on github&nbsp;&nearr;
      </a>
    </div>
    <h2 class="font-display text-ink leading-[1.05] tracking-[-0.025em] mt-8 text-[clamp(2.25rem,5vw,4rem)]">
      Selected work, indexed.
    </h2>
    <p class="font-body text-[15px] leading-[1.7] text-ink/55 max-w-[460px] mt-5">
      Three entries. Hover to preview, open to inspect.
    </p>

    <div class="wi4-rows mt-[clamp(48px,7vh,88px)]" data-rows>
      {
        projects.map((project, i) => (
          <article class="wi4-row" data-row={i}>
            <h3 class="m-0">
              <button
                type="button"
                class="wi4-head w-full text-left grid grid-cols-[44px_minmax(0,1fr)_44px] lg:grid-cols-[90px_minmax(0,1fr)_240px_56px] items-center gap-x-5 lg:gap-x-8 py-[clamp(28px,4.5vh,44px)] cursor-pointer"
                aria-expanded="false"
                aria-controls={`wi4-panel-${i}`}
                data-toggle
              >
                <span class="wi4-idx font-mono text-[12px] leading-none tracking-[0.1em] text-ink/40">
                  {project.index}
                </span>
                <span class="wi4-title font-display text-ink leading-[0.98] tracking-[-0.03em] text-[clamp(2.5rem,7.5vw,6.25rem)]">
                  <span class="wi4-sweep">{project.title}</span>
                </span>
                <span class="wi4-meta hidden lg:block font-mono text-[11px] leading-[1.7] tracking-[0.08em] uppercase text-ink/45">
                  {project.tech}
                  <br />
                  <span class="text-ink/30 normal-case tracking-normal">{project.fact}</span>
                </span>
                <span class="wi4-plus font-display text-[28px] leading-none text-ink/50 text-center" aria-hidden="true">
                  +
                </span>
              </button>
            </h3>
            <div class="wi4-panel" id={`wi4-panel-${i}`} role="region" aria-label={`${project.title} details`}>
              <div class="wi4-panel-clip">
                <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-8 lg:gap-14 pt-2 pb-[clamp(36px,6vh,64px)] lg:pl-[90px]">
                  <div>
                    <p class="font-body text-[15.5px] leading-[1.7] text-ink/70 max-w-[46ch]">{project.description}</p>
                    <p class="lg:hidden font-mono text-[11px] leading-[1.7] tracking-[0.08em] uppercase text-ink/45 mt-5">
                      {project.tech} &middot; <span class="normal-case tracking-normal text-ink/35">{project.fact}</span>
                    </p>
                    <p class="font-mono text-[11px] leading-[1.9] tracking-[0.08em] uppercase text-ink/40 mt-6">
                      {project.stack.join(" / ")}
                    </p>
                    {project.featured && (
                      <p class="flex items-center gap-2 font-mono text-[11px] leading-none tracking-[0.14em] uppercase text-ink/60 mt-5">
                        <span class="wi4-dot" aria-hidden="true" /> featured build
                      </p>
                    )}
                    <div class="flex items-center gap-6 mt-9">
                      <a
                        href={project.websiteUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="wi4-btn font-mono text-[12px] leading-none tracking-[0.06em] text-paper bg-ink rounded-full px-6 h-11 inline-flex items-center"
                      >
                        Visit site&nbsp;&nearr;
                      </a>
                      {project.githubUrl && (
                        <a
                          href={project.githubUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="font-mono text-[12px] leading-none tracking-[0.06em] text-ink/55 hover:text-ink transition-colors duration-200 wi4-focus"
                        >
                          GitHub
                        </a>
                      )}
                    </div>
                  </div>
                  <img
                    src={project.image}
                    srcset={`${project.image} 1x, ${project.image.replace(".webp", "-2x.webp")} 2x`}
                    alt={project.alt}
                    class="w-full aspect-[16/9] object-cover object-top rounded-[14px] shadow-[0_24px_50px_-28px_rgba(34,47,48,0.5)]"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <p class="font-mono text-[11px] leading-none tracking-[0.14em] uppercase text-ink/35 text-right mt-10">
      3 entries &middot; end of index
    </p>
  </div>

  <!-- Cursor-chasing preview (desktop fine-pointer only) -->
  <div class="wi4-preview fixed pointer-events-none" data-preview aria-hidden="true">
    {
      projects.map((project, i) => (
        <img
          src={project.image}
          alt=""
          class="wi4-preview-img absolute inset-0 w-full h-full object-cover object-top"
          data-preview-img={i}
          loading="lazy"
          decoding="async"
        />
      ))
    }
  </div>
</section>

<style>
  .wi4-row {
    border-top: 1px solid rgba(34, 47, 48, 0.12);
  }

  .wi4-row:last-child {
    border-bottom: 1px solid rgba(34, 47, 48, 0.12);
  }

  /* The marker-highlight selection sweep, spent on the one accent */
  .wi4-sweep {
    background-image: linear-gradient(var(--color-bio-lime), var(--color-bio-lime));
    background-repeat: no-repeat;
    background-size: 0% 72%;
    background-position: 0 68%;
    transition: background-size 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    padding: 0 0.06em;
    margin: 0 -0.06em;
  }

  .wi4-head:hover .wi4-sweep,
  .wi4-head:focus-visible .wi4-sweep,
  .wi4-row.open .wi4-sweep {
    background-size: 100% 72%;
  }

  .wi4-head:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: -2px;
  }

  .wi4-plus {
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .wi4-row.open .wi4-plus {
    transform: rotate(45deg);
  }

  /* Height-free expand: grid rows 0fr → 1fr */
  .wi4-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .wi4-panel-clip {
    overflow: hidden;
    min-height: 0;
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
  }

  .wi4-row.open .wi4-panel {
    grid-template-rows: 1fr;
  }

  .wi4-row.open .wi4-panel-clip {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.15s;
  }

  .wi4-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--color-bio-lime);
    outline: 1px solid rgba(34, 47, 48, 0.25);
    outline-offset: 1px;
  }

  .wi4-btn {
    transition:
      transform 0.2s ease,
      opacity 0.2s ease;
  }

  .wi4-btn:hover {
    transform: translateY(-1px);
    opacity: 0.9;
  }

  .wi4-btn:focus-visible,
  .wi4-focus:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
    border-radius: 4px;
  }

  /* ── The chasing preview ── */
  .wi4-preview {
    top: 0;
    left: 0;
    width: min(360px, 30vw);
    aspect-ratio: 16 / 10;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 30px 70px -24px rgba(34, 47, 48, 0.55);
    opacity: 0;
    transition: opacity 0.25s ease;
    z-index: 40;
    visibility: hidden;
  }

  .wi4-preview.on {
    visibility: visible;
  }

  .wi4-preview-img {
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .wi4-preview-img.active {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .wi4-sweep,
    .wi4-panel,
    .wi4-panel-clip,
    .wi4-plus {
      transition: none;
    }

    .wi4-preview {
      display: none;
    }
  }
</style>

<script>
  {
    const section = document.querySelector<HTMLElement>(".wi4");
    if (section) {
      const rows = Array.from(section.querySelectorAll<HTMLElement>("[data-row]"));
      const rowsWrap = section.querySelector<HTMLElement>("[data-rows]");
      const preview = section.querySelector<HTMLElement>("[data-preview]");
      const previewImgs = Array.from(section.querySelectorAll<HTMLElement>("[data-preview-img]"));
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

      // ── Accordion ──
      const setOpen = (row: HTMLElement, open: boolean) => {
        row.classList.toggle("open", open);
        row.querySelector<HTMLButtonElement>("[data-toggle]")?.setAttribute("aria-expanded", String(open));
      };

      for (const row of rows) {
        row.querySelector<HTMLButtonElement>("[data-toggle]")?.addEventListener("click", () => {
          const willOpen = !row.classList.contains("open");
          for (const other of rows) setOpen(other, false);
          setOpen(row, willOpen);
          if (willOpen && preview) preview.classList.remove("on");
        });
      }

      // ── Cursor-chasing preview ──
      if (preview && rowsWrap && finePointer && !reducedMotion) {
        let targetX = 0;
        let targetY = 0;
        let curX = 0;
        let curY = 0;
        let visible = false;
        let raf = 0;

        const tick = () => {
          curX += (targetX - curX) * 0.14;
          curY += (targetY - curY) * 0.14;
          const drag = Math.max(-6, Math.min(6, (targetX - curX) * 0.05));
          preview.style.transform = `translate(${curX.toFixed(1)}px, ${curY.toFixed(1)}px) translate(-50%, -58%) rotate(${drag.toFixed(2)}deg)`;
          preview.style.opacity = visible ? "1" : "0";
          if (visible || Math.abs(targetX - curX) > 0.5) {
            raf = requestAnimationFrame(tick);
          } else {
            preview.classList.remove("on");
            raf = 0;
          }
        };

        const show = () => {
          visible = true;
          preview.classList.add("on");
          if (!raf) {
            curX = targetX;
            curY = targetY;
            raf = requestAnimationFrame(tick);
          }
        };

        rowsWrap.addEventListener("mousemove", (e) => {
          targetX = e.clientX;
          targetY = e.clientY;
          const head = (e.target as HTMLElement).closest<HTMLElement>("[data-toggle]");
          const row = head?.closest<HTMLElement>("[data-row]");
          if (row && !row.classList.contains("open")) {
            const idx = row.dataset.row;
            previewImgs.forEach((img) => img.classList.toggle("active", img.dataset.previewImg === idx));
            if (!visible) show();
          } else if (visible) {
            visible = false;
          }
        });

        rowsWrap.addEventListener("mouseleave", () => {
          visible = false;
        });
      }
    }
  }
</script>
