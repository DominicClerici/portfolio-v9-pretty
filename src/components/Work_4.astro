---
// V4 — "The Browser": everything here ships to a browser, so the section
// is one. Projects are literal tabs in a paper browser window — switching
// tabs types the URL out, sweeps a lime loading bar, and swaps the page.
// Favicons borrow each project's real brand color.
const projects = [
  {
    id: "dispatch",
    title: "Dispatch",
    tech: "Astro · AI pipelines",
    url: "dispatch.dominicclerici.com",
    fact: "writes itself every morning",
    description:
      "A daily snapshot of the tech industry — the last 24 hours of tech news, compressed into a 10 minute read. Two decoupled AI pipelines research, triage, and write it; GitHub Actions runs the whole thing while I sleep.",
    image: "/photos/dispatch.webp",
    alt: "Dispatch project screenshot",
    stack: ["Astro", "TypeScript", "OpenAI API", "Tailwind", "Vercel"],
    websiteUrl: "https://dispatch.dominicclerici.com/",
    githubUrl: "https://github.com/DominicClerici/dispatch",
    dot: "#00c853",
  },
  {
    id: "meridian",
    title: "Meridian",
    tech: "Vanilla TS · Extensions",
    url: "meridian.dominicclerici.com",
    fact: "0 npm dependencies",
    description:
      "A new-tab extension for Chrome and Firefox with zero npm dependencies. Eleven feature modules, a reactive storage layer, and a from-scratch component library — plus a recommendation engine that learns from your history without anything leaving the browser.",
    image: "/photos/meridian.webp",
    alt: "Meridian project screenshot",
    stack: ["TypeScript", "esbuild", "Chrome APIs", "Firefox Add-ons"],
    websiteUrl: "https://meridian.dominicclerici.com/",
    githubUrl: "https://github.com/DominicClerici/meridian",
    dot: "#2dd4bf",
  },
  {
    id: "fuzzbox",
    title: "Fuzzbox",
    tech: "Next.js · React Native",
    url: "fuzzbox.dominicclerici.com",
    fact: "design system: Neon Riff",
    featured: true,
    description:
      "The companion I wished I had when learning guitar. Place notes on an interactive fretboard and it explains the chord you found — the intervals, the theory, why it sounds the way it does. Backing track generation is next.",
    image: "/photos/fuzzbox.webp",
    alt: "Fuzzbox project screenshot",
    stack: ["TypeScript", "Next.js", "React Native", "Prisma", "PostgreSQL"],
    websiteUrl: "https://fuzzbox.dominicclerici.com/",
    githubUrl: null,
    dot: "#83fe56",
  },
];
---

<section class="wv4 relative bg-bone" aria-label="Selected work">
  <div class="max-w-[1524px] mx-auto px-6 lg:px-12 py-[clamp(96px,14vh,180px)]">
    <div class="flex items-center gap-4 mb-10 lg:mb-14">
      <span
        class="font-mono text-[13px] leading-none tracking-[-0.02em] text-ink/60 border border-ink/30 rounded-full px-3.5 py-2"
      >
        03&hairsp;/&hairsp;04
      </span>
      <span class="font-mono text-[13px] leading-none tracking-[-0.02em] uppercase text-ink/60">
        Selected Work
      </span>
    </div>

    <p
      class="font-display font-normal text-ink leading-[1.2] tracking-[-0.006em] max-w-[880px] text-[clamp(1.625rem,calc(1.625rem+(100vw-27.5rem)*0.02),2.625rem)] mb-12 lg:mb-16"
    >
      Everything I build ships to a browser&nbsp;&mdash;
      <span class="text-ink/55">so here, have one.</span>
    </p>

    <div class="wv4-window rounded-[20px] border border-ink/10 bg-paper overflow-hidden">
      <!-- Chrome: traffic lights + tab strip -->
      <div class="bg-[#eceae3] pt-3 px-3 sm:px-4">
        <div class="flex items-end gap-3 sm:gap-4">
          <div class="hidden sm:flex items-center gap-2 pb-3 pl-2 shrink-0" aria-hidden="true">
            <span class="w-3 h-3 rounded-full bg-ink/15"></span>
            <span class="w-3 h-3 rounded-full bg-ink/15"></span>
            <span class="w-3 h-3 rounded-full bg-bio-lime"></span>
          </div>
          <div
            class="flex gap-1 overflow-x-auto min-w-0 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
            role="tablist"
            aria-label="Projects"
          >
            {
              projects.map((project, i) => (
                <button
                  type="button"
                  class="wv4-tab group flex items-center gap-2.5 rounded-t-[10px] px-4 sm:px-5 h-10 shrink-0 cursor-pointer"
                  role="tab"
                  aria-selected={i === 0 ? "true" : "false"}
                  data-tab={i}
                >
                  <span
                    class="w-[8px] h-[8px] rounded-full shrink-0"
                    style={`background: ${project.dot}`}
                    aria-hidden="true"
                  />
                  <span class="font-mono text-[13px] leading-none tracking-[-0.02em] text-current whitespace-nowrap">
                    {project.title.toLowerCase()}
                  </span>
                  {project.featured && (
                    <span class="font-mono text-[9px] leading-none tracking-[-0.02em] uppercase text-ink bg-bio-lime rounded-full px-1.5 py-1 shrink-0">
                      ★
                    </span>
                  )}
                </button>
              ))
            }
            <span
              class="hidden sm:inline-flex items-center justify-center w-9 h-10 font-mono text-[15px] text-ink/30 shrink-0 select-none"
              aria-hidden="true"
            >
              +
            </span>
          </div>
        </div>
      </div>

      <!-- URL bar -->
      <div class="bg-paper border-b border-ink/10 px-3 sm:px-4 py-3 flex items-center gap-3">
        <div class="hidden sm:flex items-center gap-1 text-ink/30 shrink-0" aria-hidden="true">
          <span class="inline-flex w-8 h-8 rounded-md items-center justify-center">
            <svg width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M9 2 4 7l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <span class="inline-flex w-8 h-8 rounded-md items-center justify-center">
            <svg width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="m5 2 5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </div>
        <div class="flex-1 min-w-0 h-10 rounded-lg bg-bone border border-ink/10 flex items-center gap-2.5 px-4">
          <svg class="shrink-0 text-ink/40" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <rect x="2" y="5" width="8" height="6" rx="1.5" stroke="currentColor" stroke-width="1.3" />
            <path d="M4 5V3.5a2 2 0 0 1 4 0V5" stroke="currentColor" stroke-width="1.3" />
          </svg>
          <span class="font-mono text-[13px] leading-none tracking-[-0.02em] text-ink/70 truncate">
            <span data-url>dispatch.dominicclerici.com</span><span class="wv4-caret" aria-hidden="true">|</span>
          </span>
        </div>
        <a
          data-visit
          href={projects[0].websiteUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 w-10 h-10 rounded-lg bg-bio-lime text-ink inline-flex items-center justify-center hover:-translate-y-0.5 transition-transform duration-200"
          aria-label="Open the real site in a new tab"
        >
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 12 12 2M4.5 2H12v7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>

      <!-- Loading bar -->
      <div class="relative h-[2px] bg-transparent" aria-hidden="true">
        <div class="wv4-progress absolute inset-y-0 left-0 w-full bg-bio-lime"></div>
      </div>

      <!-- Page content -->
      {
        projects.map((project, i) => (
          <div class="wv4-panel" role="tabpanel" data-panel={i} hidden={i !== 0}>
            <div class="wv4-enter grid lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]">
              <div class="p-4 sm:p-6 lg:p-8 bg-bone/60 lg:border-r border-b lg:border-b-0 border-ink/10">
                <img
                  src={project.image}
                  srcset={`${project.image} 1x, ${project.image.replace(".webp", "-2x.webp")} 2x`}
                  alt={project.alt}
                  class="w-full aspect-[16/10] object-cover object-top rounded-[12px] border border-ink/10 shadow-[0_14px_30px_-18px_rgba(34,47,48,0.3)]"
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <div class="p-6 sm:p-8 lg:p-10 flex flex-col">
                <p class="font-mono text-[12px] leading-none tracking-[-0.02em] uppercase text-ink/45">
                  {project.tech}&ensp;·&ensp;{project.fact}
                </p>
                <h3 class="font-display font-normal leading-[1] tracking-[-0.015em] text-ink mt-5 text-[clamp(2rem,calc(2rem+(100vw-27.5rem)*0.012),2.75rem)]">
                  {project.title}
                </h3>
                <p class="font-display text-[15px] lg:text-[16px] leading-[1.6] text-ink/60 mt-5">
                  {project.description}
                </p>

                <div class="flex flex-wrap gap-2 mt-7">
                  {project.stack.map((item) => (
                    <span class="font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/55 border border-ink/15 rounded-full px-3 py-1.5">
                      {item}
                    </span>
                  ))}
                </div>

                <div class="flex items-center gap-3 mt-auto pt-9">
                  <a
                    href={project.websiteUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-mono text-[13px] tracking-[-0.008em] text-ink border border-ink/30 rounded-lg h-10 px-4 inline-flex items-center hover:border-ink transition-colors duration-200"
                  >
                    Visit site
                  </a>
                  {project.githubUrl && (
                    <a
                      href={project.githubUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-mono text-[13px] tracking-[-0.008em] text-ink/60 rounded-lg h-10 px-4 inline-flex items-center hover:text-ink transition-colors duration-200"
                    >
                      GitHub
                    </a>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))
      }

      <!-- Status bar -->
      <div class="border-t border-ink/10 px-5 py-2.5 flex items-center justify-between">
        <span class="font-mono text-[11px] leading-none tracking-[-0.02em] text-ink/35">
          3 tabs open&ensp;·&ensp;0 trackers
        </span>
        <span class="font-mono text-[11px] leading-none tracking-[-0.02em] text-ink/35">
          built by hand in new york
        </span>
      </div>
    </div>

    <p class="font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/35 text-right mt-8">
      the lime arrow opens the real thing
    </p>
  </div>
</section>

<style>
  .wv4-window {
    box-shadow: 0 30px 60px -30px rgba(34, 47, 48, 0.35);
  }

  .wv4-tab {
    background: transparent;
    color: rgba(34, 47, 48, 0.45);
    transition:
      color 0.2s ease,
      background-color 0.2s ease;
  }

  .wv4-tab:hover {
    color: rgba(34, 47, 48, 0.75);
    background: rgba(255, 255, 255, 0.45);
  }

  .wv4-tab[aria-selected="true"] {
    background: var(--color-paper);
    color: var(--color-ink);
  }

  .wv4-caret {
    color: rgba(34, 47, 48, 0.35);
    margin-left: 1px;
  }

  .wv4-progress {
    transform: scaleX(0);
    transform-origin: left center;
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .wv4-caret {
      animation: wv4-blink 1.1s step-end infinite;
    }

    @keyframes wv4-blink {
      50% {
        opacity: 0;
      }
    }

    .wv4-progress.go {
      animation: wv4-load 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    @keyframes wv4-load {
      0% {
        transform: scaleX(0);
        opacity: 1;
      }
      80% {
        transform: scaleX(1);
        opacity: 1;
      }
      100% {
        transform: scaleX(1);
        opacity: 0;
      }
    }

    .wv4-enter {
      animation: wv4-rise 0.45s cubic-bezier(0.33, 1, 0.68, 1) both;
    }

    @keyframes wv4-rise {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
</style>

<script>
  {
    const section = document.querySelector<HTMLElement>(".wv4");
    if (section) {
      const urls = [
        "dispatch.dominicclerici.com",
        "meridian.dominicclerici.com",
        "fuzzbox.dominicclerici.com",
      ];
      const hrefs = [
        "https://dispatch.dominicclerici.com/",
        "https://meridian.dominicclerici.com/",
        "https://fuzzbox.dominicclerici.com/",
      ];
      const tabs = section.querySelectorAll<HTMLButtonElement>("[data-tab]");
      const panels = section.querySelectorAll<HTMLElement>("[data-panel]");
      const urlEl = section.querySelector<HTMLElement>("[data-url]");
      const visitEl = section.querySelector<HTMLAnchorElement>("[data-visit]");
      const progress = section.querySelector<HTMLElement>(".wv4-progress");
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      let typeTimer: ReturnType<typeof setInterval> | undefined;

      const typeUrl = (text: string) => {
        if (typeTimer) clearInterval(typeTimer);
        if (!urlEl) return;
        if (reducedMotion) {
          urlEl.textContent = text;
          return;
        }
        let i = 0;
        urlEl.textContent = "";
        typeTimer = setInterval(() => {
          i += 1;
          urlEl.textContent = text.slice(0, i);
          if (i >= text.length && typeTimer) clearInterval(typeTimer);
        }, 16);
      };

      const select = (id: string | undefined) => {
        if (!id) return;
        const idx = Number(id);
        tabs.forEach((tab) => tab.setAttribute("aria-selected", String(tab.dataset.tab === id)));
        panels.forEach((panel) => {
          const show = panel.dataset.panel === id;
          panel.hidden = !show;
          if (show) {
            const inner = panel.querySelector<HTMLElement>(".wv4-enter");
            if (inner) {
              inner.style.animation = "none";
              void inner.offsetWidth;
              inner.style.animation = "";
            }
          }
        });
        typeUrl(urls[idx]);
        if (visitEl) visitEl.href = hrefs[idx];
        if (progress && !reducedMotion) {
          progress.classList.remove("go");
          void progress.offsetWidth;
          progress.classList.add("go");
        }
      };

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => select(tab.dataset.tab));
      });
    }
  }
</script>
