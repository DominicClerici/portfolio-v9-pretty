---
// V4 — "Exploded View": each project is drawn like an engineering teardown.
// The screenshot splits into three planes in real CSS 3D — interface, logic,
// data — annotated with leader lines. Hovering (or the assemble button)
// snaps the stack back together and faces it toward you.
const projects = [
  {
    index: "01",
    title: "Dispatch",
    tech: "Astro · TypeScript · AI pipelines",
    fact: "writes itself every morning",
    logicNote: "2 AI pipelines · cron @ 6am",
    dataNote: "24h of news, triaged",
    description:
      "A daily snapshot of the tech industry — the last 24 hours of tech news, compressed into a 10 minute read. Two decoupled AI pipelines research, triage, and write it; GitHub Actions runs the whole thing while I sleep.",
    image: "/photos/dispatch.webp",
    alt: "Dispatch project screenshot",
    stack: ["Astro", "TypeScript", "OpenAI API", "Tailwind", "Vercel"],
    websiteUrl: "https://dispatch.dominicclerici.com/",
    githubUrl: "https://github.com/DominicClerici/dispatch",
  },
  {
    index: "02",
    title: "Meridian",
    tech: "Vanilla TypeScript · Extensions",
    fact: "0 npm dependencies",
    logicNote: "11 modules, all hand-built",
    dataNote: "45 days of history, kept local",
    description:
      "A new-tab extension for Chrome and Firefox with zero npm dependencies. Eleven feature modules, a reactive storage layer, and a from-scratch component library — plus a recommendation engine that learns without anything leaving the browser.",
    image: "/photos/meridian.webp",
    alt: "Meridian project screenshot",
    stack: ["TypeScript", "esbuild", "Chrome APIs", "Firefox Add-ons"],
    websiteUrl: "https://meridian.dominicclerici.com/",
    githubUrl: "https://github.com/DominicClerici/meridian",
  },
  {
    index: "03",
    title: "Fuzzbox",
    tech: "Next.js · React Native",
    fact: "design system: Neon Riff",
    featured: true,
    logicNote: "music theory engine",
    dataNote: "chords, intervals, voicings",
    description:
      "The companion I wished I had when learning guitar. Place notes on an interactive fretboard and it explains the chord you found — the intervals, the theory, why it sounds the way it does. Backing track generation is next.",
    image: "/photos/fuzzbox.webp",
    alt: "Fuzzbox project screenshot",
    stack: ["TypeScript", "Next.js", "React Native", "Prisma", "PostgreSQL"],
    websiteUrl: "https://fuzzbox.dominicclerici.com/",
    githubUrl: null,
  },
];
---

<section class="xv4 relative bg-bone" aria-label="Selected work">
  <div class="max-w-[1524px] mx-auto px-6 lg:px-12 py-[clamp(96px,14vh,180px)]">
    <div class="flex items-center justify-between gap-4 mb-10 lg:mb-14">
      <div class="flex items-center gap-4">
        <span
          class="font-mono text-[13px] leading-none tracking-[-0.02em] text-ink/60 border border-ink/30 rounded-full px-3.5 py-2"
        >
          03&hairsp;/&hairsp;04
        </span>
        <span class="font-mono text-[13px] leading-none tracking-[-0.02em] uppercase text-ink/60">
          Selected Work
        </span>
      </div>
      <a
        href="https://github.com/DominicClerici"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex font-mono text-[13px] leading-none tracking-[-0.02em] text-ink/45 hover:text-ink transition-colors duration-200"
      >
        more on github&nbsp;&nearr;
      </a>
    </div>

    <p
      class="font-display font-normal text-ink leading-[1.2] tracking-[-0.006em] max-w-[880px] text-[clamp(1.625rem,calc(1.625rem+(100vw-27.5rem)*0.02),2.625rem)] mb-14 lg:mb-24"
    >
      Taken apart, layer by layer&nbsp;&mdash;
      <span class="text-ink/55">hover a teardown to put it back together.</span>
    </p>

    <div class="flex flex-col divide-y divide-ink/10 border-y border-ink/10">
      {
        projects.map((project, i) => (
          <article
            class="xv4-row py-14 lg:py-20 lg:grid lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)] lg:gap-16 lg:items-center"
            data-explode
          >
            <div class:list={["xv4-scene relative", i % 2 === 1 && "lg:order-last"]} data-scene>
              <div class="xv4-space">
                <div class="xv4-stack" aria-hidden="false">
                  <div class="xv4-plane xv4-plane-data" aria-hidden="true">
                    <span class="xv4-plane-tag font-mono">data · {project.dataNote}</span>
                  </div>
                  <div class="xv4-plane xv4-plane-logic" aria-hidden="true">
                    <span class="xv4-plane-tag font-mono">logic · {project.logicNote}</span>
                    <span class="xv4-node" style="left: 26%; top: 30%;" />
                    <span class="xv4-node" style="left: 62%; top: 58%;" />
                    <span class="xv4-node" style="left: 44%; top: 76%;" />
                  </div>
                  <div class="xv4-plane xv4-plane-ui">
                    <img
                      src={project.image}
                      srcset={`${project.image} 1x, ${project.image.replace(".webp", "-2x.webp")} 2x`}
                      alt={project.alt}
                      class="w-full h-full object-cover object-top"
                      loading="lazy"
                      decoding="async"
                    />
                    <span class="xv4-plane-tag xv4-plane-tag-ui font-mono">interface</span>
                  </div>
                </div>
              </div>

              <button
                type="button"
                class="xv4-toggle font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/55 bg-paper/90 border border-ink/15 rounded-full px-3.5 py-2 absolute bottom-2 right-2 cursor-pointer hover:text-ink transition-colors duration-200"
                data-toggle
                aria-pressed="false"
              >
                assemble
              </button>
            </div>

            <div class="mt-10 lg:mt-0">
              <div class="flex items-center gap-3 flex-wrap">
                <span class="font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/45 border border-ink/20 rounded-full px-3 py-1.5">
                  fig.&thinsp;{project.index}
                </span>
                {project.featured && (
                  <span class="font-mono text-[12px] leading-none tracking-[-0.02em] uppercase text-ink bg-bio-lime rounded-full px-3 py-1.5">
                    featured
                  </span>
                )}
                <span class="font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/40">{project.fact}</span>
              </div>

              <h3 class="font-display font-normal leading-[0.98] tracking-[-0.02em] text-ink mt-6 text-[clamp(2.25rem,calc(2.25rem+(100vw-27.5rem)*0.018),3.25rem)]">
                {project.title}
              </h3>
              <p class="font-mono text-[13px] leading-none tracking-[-0.02em] uppercase text-ink/45 mt-4">
                {project.tech}
              </p>

              <p class="font-display text-[16px] lg:text-[17px] leading-[1.6] text-ink/60 max-w-[520px] mt-6">
                {project.description}
              </p>

              <dl class="mt-8 border-t border-ink/10">
                <div class="flex items-baseline gap-6 py-3.5 border-b border-ink/10">
                  <dt class="font-mono text-[11px] leading-none tracking-[-0.02em] uppercase text-ink/40 w-[72px] shrink-0">
                    stack
                  </dt>
                  <dd class="flex flex-wrap gap-x-5 gap-y-2">
                    {project.stack.map((item) => (
                      <span class="inline-flex items-center gap-2">
                        <span class="w-[5px] h-[5px] rounded-full bg-bio-lime" aria-hidden="true" />
                        <span class="font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/55">{item}</span>
                      </span>
                    ))}
                  </dd>
                </div>
                <div class="flex items-baseline gap-6 py-3.5 border-b border-ink/10">
                  <dt class="font-mono text-[11px] leading-none tracking-[-0.02em] uppercase text-ink/40 w-[72px] shrink-0">
                    status
                  </dt>
                  <dd class="font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/55">
                    live · maintained
                  </dd>
                </div>
              </dl>

              <div class="flex items-center gap-3 mt-8">
                <a
                  href={project.websiteUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-mono text-[13px] tracking-[-0.008em] text-ink border border-ink/30 rounded-lg h-10 px-4 inline-flex items-center hover:border-ink transition-colors duration-200"
                >
                  Visit site
                </a>
                {project.githubUrl && (
                  <a
                    href={project.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-mono text-[13px] tracking-[-0.008em] text-ink/60 rounded-lg h-10 px-4 inline-flex items-center hover:text-ink transition-colors duration-200"
                  >
                    GitHub
                  </a>
                )}
                <a
                  href={project.websiteUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Open ${project.title} in a new tab`}
                  class="w-10 h-10 rounded-lg bg-bio-lime text-ink inline-flex items-center justify-center hover:-translate-y-0.5 transition-transform duration-200 ml-auto"
                >
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path
                      d="M2 12 12 2M4.5 2H12v7.5"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <p class="font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/35 text-right mt-10">
      no screws were lost during disassembly
    </p>
  </div>
</section>

<style>
  .xv4-scene {
    height: clamp(300px, 44vw, 460px);
  }

  .xv4-space {
    position: absolute;
    inset: 0;
    perspective: 1500px;
    display: grid;
    place-items: center;
  }

  .xv4-stack {
    position: relative;
    width: min(78%, 480px);
    aspect-ratio: 16 / 10;
    transform-style: preserve-3d;
    transform: rotateX(54deg) rotateZ(-32deg) scale(0.92);
  }

  .xv4-plane {
    position: absolute;
    inset: 0;
    border-radius: 14px;
    border: 1px solid rgba(34, 47, 48, 0.14);
    overflow: hidden;
    backface-visibility: hidden;
  }

  /* Bottom layer — the data bed */
  .xv4-plane-data {
    background-color: var(--color-bone);
    background-image: radial-gradient(circle, rgba(34, 47, 48, 0.22) 1px, transparent 1px);
    background-size: 22px 22px;
    transform: translateZ(calc(var(--spread, 0) * -86px));
    box-shadow: 0 30px 50px -30px rgba(34, 47, 48, 0.45);
  }

  /* Middle layer — the logic board */
  .xv4-plane-logic {
    background-color: var(--color-paper);
    background-image:
      linear-gradient(rgba(34, 47, 48, 0.09) 1px, transparent 1px),
      linear-gradient(90deg, rgba(34, 47, 48, 0.09) 1px, transparent 1px);
    background-size: 34px 34px;
    transform: translateZ(0px);
  }

  .xv4-node {
    position: absolute;
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--color-bio-lime);
    border: 1.5px solid var(--color-ink);
  }

  /* Top layer — the interface */
  .xv4-plane-ui {
    background: var(--color-paper);
    transform: translateZ(calc(var(--spread, 0) * 86px + 1px));
    box-shadow: 0 24px 48px -24px rgba(34, 47, 48, 0.5);
  }

  .xv4-plane-tag {
    position: absolute;
    left: 10px;
    bottom: 10px;
    font-size: 11px;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    background: rgba(247, 247, 245, 0.92);
    border: 1px solid rgba(34, 47, 48, 0.14);
    border-radius: 999px;
    padding: 6px 10px;
    white-space: nowrap;
  }

  .xv4-plane-tag-ui {
    background: var(--color-bio-lime);
    border-color: transparent;
  }

  /* Rest state: flat and modest. In view: the stack explodes. */
  .xv4-row.xv4-in .xv4-stack {
    --spread: 1;
  }

  /* Assembled: face the viewer, close the gap */
  @media (hover: hover) {
    .xv4-scene:hover .xv4-stack {
      transform: rotateX(6deg) rotateZ(0deg) scale(1);
      --spread: 0.04;
    }
  }

  .xv4-row.xv4-flat .xv4-stack {
    transform: rotateX(6deg) rotateZ(0deg) scale(1);
    --spread: 0.04;
  }

  @media (prefers-reduced-motion: no-preference) {
    .xv4-stack {
      transition: transform 0.8s cubic-bezier(0.65, 0, 0.35, 1);
    }

    .xv4-plane {
      transition: transform 0.8s cubic-bezier(0.65, 0, 0.35, 1);
    }

    .xv4-plane-data {
      transition-delay: 0.06s;
    }

    .xv4-plane-ui {
      transition-delay: 0.02s;
    }
  }

  .xv4-toggle:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }

  @media (min-width: 1024px) {
    .xv4-toggle {
      bottom: 8px;
      right: 8px;
    }
  }
</style>

<script>
  {
    const rows = document.querySelectorAll<HTMLElement>("[data-explode]");

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) entry.target.classList.add("xv4-in");
        });
      },
      { threshold: 0.35 },
    );

    rows.forEach((row) => {
      io.observe(row);
      const toggle = row.querySelector<HTMLButtonElement>("[data-toggle]");
      toggle?.addEventListener("click", () => {
        const flat = row.classList.toggle("xv4-flat");
        toggle.setAttribute("aria-pressed", String(flat));
        toggle.textContent = flat ? "explode" : "assemble";
      });
    });
  }
</script>
