---
/**
 * Pinned glass-canvas scope.
 *
 * The canvas is sticky for the full height of this component, so everything
 * passed in via <slot /> scrolls over a background that holds still, and at
 * the end of the scope the background leaves with the flow.
 *
 * Owns the canvas, the scene wiring, and the CPU-fallback notice. The
 * sections that scroll over it (Hero, About, Career, Quote) are just children.
 *
 * ── Light half, dark half ──
 * The scope spans both halves of the page's mood: it opens on bone under the
 * hero and ends on near-black under the quote. The glass does not stop at the
 * seam between them — the backdrop *behind* it turns over instead, the whole
 * plane at once, scrubbed by scroll across the hand-off from About to Career.
 * It starts when About's last quarter clears the bottom of the screen and is
 * complete on the frame Career's top edge reaches the top of it, which is the
 * frame its scroll-pin engages. Because the turn happens behind the cylinders
 * it arrives refracted — the ribs carry it, rather than a flat wash sliding
 * over the frame.
 *
 * The two sections either side of it cross-fade across it, because neither can
 * sit still while the ground moves under it: About is set in a dark ink for
 * bone, Career in near-white for black, and halfway through the turn the
 * backdrop is the value they both stand out against least. So About dissolves
 * as it leaves, Career surfaces as it arrives, and the glass carries the
 * middle alone (see paintTurn below). The quote, last, is only ever on black.
 *
 * Two sets of objects share the canvas across it. The hero's three dissolve
 * into the dark; a second, larger set of orbs fades up out of it and drifts
 * past for the length of the pinned career section. The engine
 * (src/scripts/glass-scene.ts) owns the cross-fade — here we only say how far
 * the turn has come and how far each set has climbed.
 */
---

<!-- The negative bottom margin is the pin's runway, not spacing: sticky stops
     at the padding box, and the pin is lifted by one overhang, so without it
     the glass would come to rest an overhang short of the scope's end and
     leave a gap before the next section.

     The scope's own background is what shows if the canvas never paints at
     all — no WebGL *and* no 2D context. global.css leaves it bone; the script
     below repaints it from the same numbers the shader uses as the turn runs,
     so that last-resort page darkens with the rest. -->
<div
  id="hero-scope"
  class="relative mb-[calc(var(--bg-overhang)*-1)]"
>
  <div data-canvas-bg class="sticky top-0 h-[var(--bg-h)]" aria-hidden="true">
    <!-- Full-bleed clipping container; isolated so the inner clip-path
         animation composites onto its own layer. -->
    <div class="absolute inset-0 overflow-hidden isolate transform-gpu">
      <div class="hero-canvas-wrap absolute inset-0">
        <canvas id="hero-canvas" class="absolute inset-0 w-full h-full"
        ></canvas>
      </div>
    </div>
  </div>

  <div class="hero-scope-content relative z-10">
    <slot />
  </div>

  <!-- Shown only when the WebGL scene can't run and the CPU fallback takes
       over. Fixed to the bottom-right; JS reveals it while the scope is in
       view, so it reads as pinned to the sections above. -->
  <div
    id="hero-gpu-warning"
    role="status"
    class="hidden fixed bottom-4 right-4 z-50 items-center gap-2 rounded-lg border border-ink/15 bg-white/70 backdrop-blur-md px-3 h-9 shadow-sm"
  >
    <svg
      width="15"
      height="15"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      class="shrink-0 text-amber-500"
      aria-hidden="true"
    >
      <path
        d="M12 4 2.5 20.5h19L12 4Z"
        stroke-width="1.6"
        stroke-linejoin="round"></path>
      <path d="M12 10.5v4" stroke-width="1.6" stroke-linecap="round"></path>
      <path d="M12 17.4v.01" stroke-width="1.8" stroke-linecap="round"
      ></path>
    </svg>
    <span
      class="font-mono text-[12px] leading-none tracking-[-0.01em] text-ink/70 whitespace-nowrap"
    >
      Enable GPU acceleration for a better experience
    </span>
  </div>
</div>

<script>
  import {
    backdropColor,
    createGlassScene,
    SPHERE_R_FRAC,
    type GlassObject,
  } from "../scripts/glass-scene";

  {
    const scope = document.getElementById("hero-scope")!;
    const bg = scope.querySelector<HTMLElement>("[data-canvas-bg]")!;
    const wrap = scope.querySelector<HTMLElement>(".hero-canvas-wrap")!;
    const canvas = document.getElementById("hero-canvas") as HTMLCanvasElement;
    // The two sections the turn to dark is measured between — it runs from
    // partway down About to the top edge of Career. Optional: without the
    // anchor the scope stays bone end to end and only the hero objects move,
    // which is exactly the pre-dark behaviour.
    const about = scope.querySelector<HTMLElement>("#about");
    const darkAnchor = scope.querySelector<HTMLElement>("#career");
    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const forceCPU = new URLSearchParams(location.search).has("cpu");

    /* ══ Tunable knobs ══════════════════════════════════════════════════
       Per-object placement/scale plus the scroll response live here; colors
       and drift phase stay in OBJECTS below. The shared feel knobs (pointer
       sensitivity, easing, drift, fps caps) are the engine defaults in
       src/scripts/glass-scene.ts — override them via createGlassScene()
       options if this scene ever needs its own values. */

    // — Object placement —
    //   pos: center as a fraction of the viewport (x from left, y-up from
    //   bottom). scale: multiplier on the base sphere radius (SPHERE_R_FRAC).
    //   The teal sphere's x is an edge-touch point + one radius (edgeR: 1),
    //   so it reads a touch differently from the free-placed cube/purple.
    const TEAL_POS = { x: 0.5, y: 0.56 };
    const TEAL_SCALE = 1.0;
    const CUBE_POS = { x: 0.05, y: 0.12 };
    const CUBE_SCALE = 0.7;
    const PURPLE_POS = { x: 0.92, y: -0.1 };
    const PURPLE_SCALE = 0.55;

    // — Sensitivity (how far the objects move for a given input) —
    const SCROLL_SENSITIVITY = 0.45; // object climb per px scrolled
    // Once the turn to dark begins the light-half objects are on their way
    // out, so they leave faster than the page — they read as going, rather
    // than as hanging there fading. They travel this many background heights
    // over the turn, whatever length it works out to.
    const HERO_EXIT_SENSITIVITY = 0.85;

    // — The turn to dark —
    // Where in About it starts, as a fraction of that section's height measured
    // from its bottom: 0.25 is "when its last quarter has crossed the bottom of
    // the screen". It always ends at Career's top edge reaching the top of the
    // screen, which is not a knob — that is the frame the pin engages.
    const FADE_FROM_BOTTOM = 0.25;
    // Where each section stands in the turn, as a span of the 0…1 darkness
    // (see paintTurn). About holds at full strength until the ground has gone
    // roughly a third of the way and is gone by the time it is nearly black;
    // Career surfaces a little later and is whole well before its pin engages.
    const ABOUT_OUT: [number, number] = [0.32, 0.84];
    const CAREER_IN: [number, number] = [0.3, 0.88];
    // The fastest the turn may run, end to end, in ms. Scroll still sets where
    // it is headed, but a flick that crosses the whole handover in a frame or
    // two would otherwise slam the ground from bone to black; this is the
    // floor on how quickly it can get there. At ordinary scroll speeds the
    // turn moves slower than this and tracks scroll exactly.
    const TURN_MIN_MS = 300;

    // — Dark half —
    // How far the career orbs travel, in background heights, over the whole
    // dark stretch (front rising, pinned career section, quote). Tuned so the
    // last of them is still arriving as the quote scrolls out: high enough
    // that orbs keep passing, low enough that none crosses in a single flick.
    const CAREER_TRAVEL = 3.35;
    // Where each career orb starts, as a fraction of the background height
    // below the bottom edge — spaced so roughly three are in frame at once.
    const CAREER_START_Y = -0.35;
    const CAREER_GAP_Y = 0.55;

    /* ══════════════════════════════════════════════════════════════════ */

    /* ── Scroll behavior ──
       The background is pinned (sticky) for the whole scope — now hero
       through quote — so the glass cylinders hold still in screen space the
       entire way down and only leave with the flow at the very end.

       Three things are scrubbed from scroll position, all measured against
       the scope's own top so nothing here depends on this being the first
       thing on the page:

       · channel 0, the hero/about objects. They climb at SCROLL_SENSITIVITY
         until the turn to dark begins, then leave over it.
       · channel 1, the career orbs, on the normalised progress of the whole
         dark stretch.
       · the turn itself, read straight off the anchor section's live top edge
         rather than off a cached scroll position, so it cannot desync from
         the section it is handing over to no matter what reflows above.

       Both lifts are eased inside the engine, so the parallax glides. The turn
       is not: the page's smooth-scroll already carries it, and a second lag
       would leave the backdrop trailing the section. */
    let pinEnd = 1; // scroll distance the background stays pinned (px)
    let scopeTop = 0; // the scope's document offset
    let bgH = 1; // pinned background height (CSS px)
    let darkStart = 1; // scroll into the scope where the dark stretch begins
    let darkSpan = 1; // …and how much scroll it gets
    let fadeLead = 1; // how far Career's top edge climbs over the whole turn
    let fadeStart = 1; // scroll into the scope where the turn begins

    const clamp01 = (v: number) => (v < 0 ? 0 : v > 1 ? 1 : v);
    const smoothstep = (e0: number, e1: number, x: number) => {
      const t = clamp01((x - e0) / (e1 - e0));
      return t * t * (3 - 2 * t);
    };

    function onScrollFrame() {
      const y = window.scrollY - scopeTop;

      if (!darkAnchor) {
        scene.setScrollTarget(Math.max(y, 0) * SCROLL_SENSITIVITY, 0);
        return;
      }

      /* Progress of the turn, straight off the anchor's live top edge: one
         fadeLead above the top of the screen is 0 (all bone), level with it is
         1 (all dark), and the pin engages on that same frame. Smoothstepped so
         the backdrop eases into the turn and settles out of it instead of
         starting and stopping on a corner. */
      const d = clamp01(1 - darkAnchor.getBoundingClientRect().top / fadeLead);
      turnTarget = d;
      stepTurn(performance.now());

      // Light half: climb with the page, then leave over the turn.
      const climb = Math.min(Math.max(y, 0), fadeStart) * SCROLL_SENSITIVITY;
      scene.setScrollTarget(climb + d * bgH * HERO_EXIT_SENSITIVITY, 0);

      // Dark half.
      const q = clamp01((y - darkStart) / darkSpan);
      scene.setScrollTarget(q * CAREER_TRAVEL * bgH, 1);
    }

    /* ── Speed limit on the turn ──
       Scroll says where the turn should be (turnTarget); what is painted
       (turnShown) follows it, but never faster than one full turn per
       TURN_MIN_MS. Below that speed the two are the same number on the same
       frame, so a normal scroll is untouched and the ground stays locked to
       the section. Only a flick that outruns the cap leaves turnShown behind,
       and then a small rAF loop of its own carries it the rest of the way —
       the scroll bus has usually gone quiet by then, so it cannot wait on it.

       The limit is on the linear progress, before the smoothstep, so a capped
       turn still eases in and out rather than ramping at a constant rate. The
       objects' exit (setScrollTarget above) stays on the raw progress: that
       is the parallax, not the backdrop, and the engine already eases it.

       The budget for a step is the real time since the last one, so a slow
       frame rate does not stretch the turn. The exception is the first step
       after the turn has been sitting still: the time since then is idle, not
       a frame, and spending it would let the flick land in a single jump — so
       that step gets one frame's worth. (A hidden tab coming back mid-chase is
       capped the same way.) Reduced motion has no loops anywhere else on the
       page, so it snaps here too. */
    let turnTarget = 0;
    let turnShown = -1; // -1: nothing painted yet — the first frame snaps
    let turnLastT = 0;
    let turnMoving = false; // did the last step move, or leave a chase open?
    let turnRaf = 0;
    function stepTurn(now: number) {
      // A scroll tick can land while the loop is pending; either way this
      // call is the step for the frame, so there is only ever one loop.
      if (turnRaf) cancelAnimationFrame(turnRaf);
      turnRaf = 0;
      const elapsed = Math.max(now - turnLastT, 0);
      const dt = Math.min(elapsed, turnMoving ? 250 : 1000 / 60);
      turnLastT = now;
      const from = turnShown;

      if (turnShown < 0 || reducedMotion) {
        turnShown = turnTarget;
      } else {
        const max = dt / TURN_MIN_MS;
        const gap = turnTarget - turnShown;
        turnShown =
          Math.abs(gap) <= max ? turnTarget : turnShown + Math.sign(gap) * max;
      }

      const t = turnShown;
      const dark = t * t * (3 - 2 * t);
      scene.setDarkness(dark);
      paintTurn(dark);

      turnMoving = turnShown !== from || turnShown !== turnTarget;
      if (turnShown !== turnTarget) turnRaf = requestAnimationFrame(stepTurn);
    }

    /* Three things off the canvas move with the backdrop.

       The scope's own background, which is all that shows if no canvas paints
       at all, is repainted from the engine's own colours so that last-resort
       page darkens too.

       And the two sections either side of the turn, which cross-fade across it
       exactly as the two sets of orbs do. Neither can simply sit there while
       the ground moves under it: About's copy is set in a dark ink for bone
       and Career's in near-white for black, so in the middle of the turn —
       where the backdrop passes through mid-grey — whichever one stayed would
       be near the value of the thing behind it. Walking About's ink across
       with the backdrop does not help; it only puts the copy *at* that value
       instead of beside it. So each is at full strength while it is the one
       being read, and the handover happens in between: About dissolves into
       the dark as it leaves, Career surfaces out of it as it arrives, and the
       glass carries the middle on its own.

       All three are written only when the value moves, so away from the turn
       this is one compare a frame. */
    const alpha = (x: number) => (x > 0.999 ? "" : x.toFixed(3));
    let lastTurn = -1;
    function paintTurn(dark: number) {
      const v = Math.round(dark * 256) / 256;
      if (v === lastTurn) return;
      lastTurn = v;
      scope.style.backgroundColor = backdropColor(v);
      if (about)
        about.style.opacity = alpha(
          1 - smoothstep(ABOUT_OUT[0], ABOUT_OUT[1], v),
        );
      if (darkAnchor)
        darkAnchor.style.opacity = alpha(
          smoothstep(CAREER_IN[0], CAREER_IN[1], v),
        );
    }
    // Shared scroll bus (Layout head shim) — fires once per frame; the scene's
    // own render loop eases toward the target, so frame-exact timing isn't
    // required, but this keeps it to one listener across the site.
    (window as any).__onSmoothScrollTick(onScrollFrame);

    // Once the iris-open finishes, drop the clip so no stale clip-path
    // lingers on the canvas. The animation itself must be removed too: its
    // fill-mode keeps applying the end keyframe over any inline clip-path
    // override.
    wrap.addEventListener("animationend", (e) => {
      if (e.animationName === "hero-iris-open") {
        wrap.style.animation = "none";
        wrap.style.clipPath = "none";
      }
    });

    /* ── Scene config ──
       The glass render itself (WebGL2 + CPU fallback) lives in the shared
       engine, src/scripts/glass-scene.ts — only object layout and scroll
       wiring live here. */
    // Scene objects, composited back-to-front (smaller/farther first). All
    // share the same glass material, sensitivity and easing; only color and
    // drift phase differ here — placement/scale come from the knobs up top.
    // shape: 0 sphere, 1 cube. edgeR shifts the center right by that many
    // radii (lets the teal sphere rest against the page's center line).
    // Gradients are linear, 0% at the top of the object → 100% at the bottom.
    /* The dark half's orbs. Same material, same drift, but they read
       differently against near-black: where the hero's three are dark shapes
       pushing through bone, these are lit ones surfacing out of black, so the
       gradients run brighter and the matcap (a dark glossy ball) is mostly
       off. The palette walks the hero's purple/blue/teal across to the
       career section's lime, which is the accent every element in it shares.

       zone: 1 marks them as belonging below the front — they stay at zero
       coverage until it has risen past them — and lift: 1 puts them on the
       career scroll channel. Placement is generated rather than written out
       per object: they are a stream, and what matters is the spacing.
       cy/scale/x are the per-orb character. */
    const CAREER_COLORS = [
      // lime — the career accent, first up out of the dark
      {
        ga0: [0.404, 0.78, 0.271],
        ga1: [0.808, 0.969, 0.62],
        gb0: [0.176, 0.392, 0.11],
      },
      // violet, carried over from the hero's purple sphere
      {
        ga0: [0.451, 0.243, 0.878],
        ga1: [0.69, 0.529, 1.0],
        gb0: [0.267, 0.106, 0.588],
      },
      // cyan
      {
        ga0: [0.055, 0.647, 0.749],
        ga1: [0.353, 0.878, 0.949],
        gb0: [0.02, 0.325, 0.427],
      },
      // indigo
      {
        ga0: [0.176, 0.31, 0.902],
        ga1: [0.439, 0.576, 1.0],
        gb0: [0.078, 0.133, 0.573],
      },
      // lime again, small and bright
      {
        ga0: [0.404, 0.78, 0.271],
        ga1: [0.808, 0.969, 0.62],
        gb0: [0.176, 0.392, 0.11],
      },
      // teal — the hero's front sphere, returning last
      {
        ga0: [0.055, 0.788, 0.541],
        ga1: [0.361, 0.941, 0.714],
        gb0: [0.0, 0.443, 0.318],
      },
    ];
    /* Placement carries one constraint the hero's does not: the career section
       keeps live type over the whole left third of the frame (the year spine
       and the employer list), where the dossier panel is not there to sit
       between. So the big orbs stay right of ~0.4 — behind the panel and the
       open space under it — and only small, dim ones cross the rail.
                x     scale  shape (0 sphere, 1 cube)  matcap  brightness */
    const CAREER_PLACE = [
      { x: 0.78, s: 0.62, shape: 0 as const, mat: 0, dim: 0.5 },
      { x: 0.44, s: 0.95, shape: 0 as const, mat: 0.45, dim: 0.44 },
      { x: 0.11, s: 0.38, shape: 1 as const, mat: 0, dim: 0.38 },
      { x: 0.9, s: 0.72, shape: 0 as const, mat: 0, dim: 0.5 },
      { x: 0.31, s: 0.4, shape: 0 as const, mat: 0, dim: 0.34 },
      { x: 0.64, s: 1.05, shape: 0 as const, mat: 0, dim: 0.46 },
    ];

    const CAREER_OBJECTS: GlassObject[] = CAREER_PLACE.map((p, i) => ({
      shape: p.shape,
      mat: p.mat,
      rFrac: SPHERE_R_FRAC * p.s,
      cx: p.x,
      cy: CAREER_START_Y - i * CAREER_GAP_Y,
      edgeR: 0,
      ...CAREER_COLORS[i],
      gaMix: 0.66,
      gbMix: 0.34,
      dim: p.dim,
      // Staggered phases and mildly irregular speeds so the stream never
      // settles into a visible rhythm.
      driftAmp: 0.034 + (i % 3) * 0.008,
      driftYScale: 0.7,
      spdX: 0.15 + i * 0.017,
      spdY: 0.1 + i * 0.011,
      phX: i * 1.37,
      phY: 2.4 + i * 0.93,
      lift: 1,
      zone: 1,
    }));

    const OBJECTS: GlassObject[] = [
      {
        // purple sphere — back, smallest, lower-right
        shape: 0,
        mat: 0,
        rFrac: SPHERE_R_FRAC * PURPLE_SCALE,
        cx: PURPLE_POS.x,
        cy: PURPLE_POS.y,
        edgeR: 0,
        ga0: [0.541, 0.329, 0.941],
        ga1: [0.725, 0.549, 1.0],
        gb0: [0.369, 0.173, 0.753],
        gaMix: 0.6,
        gbMix: 0.4,
        driftAmp: 0.04,
        driftYScale: 0.7,
        spdX: 0.17,
        spdY: 0.11,
        phX: 2.1,
        phY: 4.3,
      },
      {
        // blue cube — middle, lower-left
        shape: 1,
        mat: 0,
        rFrac: SPHERE_R_FRAC * CUBE_SCALE,
        cx: CUBE_POS.x,
        cy: CUBE_POS.y,
        edgeR: 0,
        ga0: [0.133, 0.651, 0.949],
        ga1: [0.525, 0.847, 1.0],
        gb0: [0.055, 0.388, 0.784],
        gaMix: 0.6,
        gbMix: 0.4,
        driftAmp: 0.038,
        driftYScale: 0.7,
        spdX: 0.19,
        spdY: 0.13,
        phX: 0.7,
        phY: 1.9,
      },
      {
        // teal sphere — front, largest. #04D800 → #22DB14 → #fff over
        // #006C22 → #fff.
        shape: 0,
        mat: 1,
        rFrac: SPHERE_R_FRAC * TEAL_SCALE,
        cx: TEAL_POS.x,
        cy: TEAL_POS.y,
        edgeR: 1,
        ga0: [0.126, 0.997, 0.2],
        ga1: [0.233, 0.979, 0.778],
        gb0: [0.0, 0.824, 0.533],
        gaMix: 0.6,
        gbMix: 0.4,
        driftAmp: 0.05,
        driftYScale: 0.6,
        spdX: 0.21,
        spdY: 0.13,
        phX: 0.0,
        phY: 1.7,
      },
      ...CAREER_OBJECTS,
    ];

    /* ── GPU-acceleration notice ──
       Revealed only while the CPU fallback is driving the scene (WebGL
       unavailable, or the context was lost) and the scope is on screen. */
    const gpuWarning = document.getElementById("hero-gpu-warning")!;
    let usingCPU = false;
    let scopeVisible = true;
    function syncWarning() {
      gpuWarning.style.display = usingCPU && scopeVisible ? "flex" : "none";
    }

    const scene = createGlassScene({
      canvas,
      wrap,
      objects: OBJECTS,
      forceCPU,
      onCPUFallback: () => {
        usingCPU = true;
        syncWarning();
      },
    });

    /* Everything scroll-invariant, cached here so the per-frame path reads no
       layout it doesn't have to. Re-run on resize and whenever the scope's
       box changes (fonts, images, the career section's own reflow). */
    function measure() {
      bgH = bg.offsetHeight;
      scopeTop = scope.getBoundingClientRect().top + window.scrollY;
      pinEnd = Math.max(scope.offsetHeight - bgH, 1);

      if (!darkAnchor) return;
      const anchorTop =
        darkAnchor.getBoundingClientRect().top + window.scrollY - scopeTop;

      // The dark stretch the career orbs travel over: it opens as the anchor
      // enters the bottom of the pinned background and runs to the end of the
      // pin, i.e. the bottom of the quote.
      darkStart = Math.max(Math.min(anchorTop - bgH, pinEnd), 0);
      darkSpan = Math.max(pinEnd - darkStart, 1);

      // The turn, kept as a *distance* rather than a pair of scroll positions:
      // how much further Career's top edge has to climb between the frame the
      // turn starts and the frame it finishes at the top of the screen. That
      // way the per-frame path needs nothing but that edge's live position.
      const aboutH = about ? about.offsetHeight : 0;
      const aboutTop = about
        ? about.getBoundingClientRect().top + window.scrollY - scopeTop
        : anchorTop;
      const turnAt = aboutTop + aboutH * (1 - FADE_FROM_BOTTOM);
      fadeLead = Math.max(anchorTop - turnAt + window.innerHeight, 1);
      fadeStart = Math.max(anchorTop - fadeLead, 0);
    }

    let resizeTimer: number | undefined;
    new ResizeObserver(() => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        measure();
        scene.resize();
        onScrollFrame();
      }, 120);
    }).observe(scope);
    measure();
    scene.resize();
    onScrollFrame();

    // One observer drives both the warning and (when motion is allowed) the
    // render loop — same element, same threshold.
    new IntersectionObserver(
      (entries) => {
        scopeVisible = entries[0].isIntersecting;
        syncWarning();
        if (reducedMotion) return;
        scopeVisible ? scene.start() : scene.stop();
      },
      { threshold: 0 },
    ).observe(scope);

    if (reducedMotion) {
      scene.render(40);
    } else {
      document.addEventListener("visibilitychange", () => {
        document.hidden ? scene.stop() : scene.start();
      });
      scene.start();
    }
  }
</script>
