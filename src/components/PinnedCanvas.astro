---
/**
 * Pinned background scope.
 *
 * The background is sticky for the full height of this component, so
 * everything passed in via <slot /> scrolls over a frame that holds still, and
 * at the end of the scope the background leaves with the flow.
 *
 * Owns the two canvases, their wiring, and the CPU-fallback notice. The
 * sections that scroll over them (Hero, About, Career, Quote) are just
 * children.
 *
 * ── Light half, dark half ──
 * The scope spans both halves of the page's mood, and each half has a
 * background of its own. Under the hero and About it is a sheet of wet paper:
 * a fluid simulation carrying three pigments (src/scripts/ink-fluid.ts). Under
 * Career and the quote it is fluted glass on near-black
 * (src/scripts/glass-scene.ts), with one orb per employer drifting past while
 * its entry is on show in the pinned career section.
 *
 * The turn between them is scrubbed by scroll across the hand-off from About
 * to Career. It starts when About's last quarter clears the bottom of the
 * screen and is complete on the frame Career's top edge reaches the top of
 * it, which is the frame its scroll-pin engages. Over it the paper goes to
 * the glass's dark backdrop, taking the ink with it, and the glass fades in
 * above once the two are near enough the same ground to meet on it.
 *
 * The two sections either side of the turn cross-fade across it, because
 * neither can sit still while the ground moves under it: About is set in a
 * dark ink for bone, Career in near-white for black, and halfway through the
 * turn the backdrop is the value they both stand out against least. So About
 * dissolves as it leaves and Career surfaces as it arrives (see paintTurn
 * below). The quote, last, is only ever on black.
 *
 * Only the ink is needed to draw the top of the page, so only the ink ships
 * with it: the glass engine is fetched once the page has loaded and gone
 * idle, or as soon as the turn is reached if that comes first.
 */
---

<!-- The pin is lifted by one overhang and given the runway to still reach
     the scope's end by a negative margin of its own (both in global.css), so
     the background comes to rest flush with the quote's bottom edge and the
     next section starts there.

     The scope's own background is what shows if neither canvas ever paints.
     global.css leaves it bone; the script below repaints it from the same
     numbers the shaders use as the turn runs, so that last-resort page
     darkens with the rest. -->
<div
  id="hero-scope"
  class="relative"
>
  <div data-canvas-bg class="sticky top-0 h-[var(--bg-h)]" aria-hidden="true">
    <div class="hero-canvas-wrap absolute inset-0 overflow-hidden">
      <canvas id="ink-canvas" class="absolute inset-0 w-full h-full"></canvas>
      <!-- Over the ink, and out of sight until the turn to dark. -->
      <canvas
        id="glass-canvas"
        class="absolute inset-0 w-full h-full"
        style="visibility: hidden; opacity: 0"></canvas>
    </div>
  </div>

  <div class="hero-scope-content relative z-10">
    <slot />
  </div>

  <!-- Shown only when the WebGL scene can't run and the CPU fallback takes
       over. Fixed to the bottom-right; JS reveals it while the scope is in
       view, so it reads as pinned to the sections above. -->
  <div
    id="hero-gpu-warning"
    role="status"
    class="hidden fixed bottom-[max(1rem,env(safe-area-inset-bottom))] right-[max(1rem,env(safe-area-inset-right))] z-50 items-center gap-2 rounded-lg border border-ink/15 bg-white/70 backdrop-blur-md px-3 h-9 shadow-sm"
  >
    <svg
      width="15"
      height="15"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      class="shrink-0 text-amber-500"
      aria-hidden="true"
    >
      <path
        d="M12 4 2.5 20.5h19L12 4Z"
        stroke-width="1.6"
        stroke-linejoin="round"></path>
      <path d="M12 10.5v4" stroke-width="1.6" stroke-linecap="round"></path>
      <path d="M12 17.4v.01" stroke-width="1.8" stroke-linecap="round"
      ></path>
    </svg>
    <span
      class="font-mono text-[12px] leading-none tracking-[-0.01em] text-ink/70 whitespace-nowrap"
    >
      Enable GPU acceleration for a better experience
    </span>
  </div>
</div>

<script>
  import { mountInk } from "../scripts/ink-mount";
  import type { GlassObject, GlassScene } from "../scripts/glass-scene";
  import { BONE, DARK } from "../lib/gl-kit";
  import { docTop, onLayoutChange } from "../lib/layout-watch";

  {
    // Where in the turn the glass fades in over the ink.
    const GLASS_IN: [number, number] = [0.45, 1];

    const scope = document.getElementById("hero-scope")!;
    const bg = scope.querySelector<HTMLElement>("[data-canvas-bg]")!;
    const wrap = scope.querySelector<HTMLElement>(".hero-canvas-wrap")!;
    const inkCanvas = document.getElementById("ink-canvas") as HTMLCanvasElement;
    const canvas = document.getElementById("glass-canvas") as HTMLCanvasElement;
    // The two sections the turn to dark is measured between — it runs from
    // partway down About to the top edge of Career. Optional: without the
    // anchor the scope stays paper end to end.
    const about = scope.querySelector<HTMLElement>("#about");
    const darkAnchor = scope.querySelector<HTMLElement>("#career");
    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const forceCPU = new URLSearchParams(location.search).has("cpu");
    // The debug hooks work on the ink itself, so they keep it on this thread
    // (as does ?inklook=main, for ink-look.mjs to compare the two).
    const query = new URLSearchParams(location.search);
    const inkThread =
      query.has("inkdebug") || query.has("inkbench") || query.get("inklook") === "main"
        ? "page"
        : query.get("inklook") === "worker"
          ? "worker"
          : undefined;
    if (query.has("inkdebug"))
      import("../scripts/ink-debug").then(async (m) => {
        const direct = await ink.direct();
        if (direct) m.inkDebug(direct);
      });
    if (query.has("inkbench"))
      import("../scripts/ink-bench").then(async (m) => {
        const direct = await ink.direct();
        if (direct) m.inkBench(direct);
      });

    /* ══ Tunable knobs ══════════════════════════════════════════════════
       The glass's shared feel knobs (pointer sensitivity, easing, drift, fps
       caps) are the engine defaults in src/scripts/glass-scene.ts, and the
       ink's are at the top of src/scripts/ink-fluid.ts. */

    // — The turn to dark —
    // Where in About it starts, as a fraction of that section's height measured
    // from its bottom: 0.25 is "when its last quarter has crossed the bottom of
    // the screen". It always ends at Career's top edge reaching the top of the
    // screen, which is not a knob — that is the frame the pin engages.
    const FADE_FROM_BOTTOM = 0.25;
    // Where each section stands in the turn, as a span of the 0…1 darkness
    // (see paintTurn). About holds at full strength until the ground has gone
    // roughly a third of the way and is gone by the time it is nearly black;
    // Career surfaces a little later and is whole well before its pin engages.
    const ABOUT_OUT: [number, number] = [0.32, 0.84];
    const CAREER_IN: [number, number] = [0.3, 0.88];

    // — Dark half —
    // One career orb per employer, oldest first, each crossing the middle of
    // the frame while its own entry is the one on show in the pinned section.
    // The gap is how far apart successive orbs ride, in background heights —
    // it sets their speed too, since each has one entry's worth of scroll to
    // cover it in. ~0.5 keeps the next one rising as the last one leaves.
    const CAREER_GAP_Y = 0.5;
    // Where an orb sits while its entry is at the middle of its slot, as a
    // fraction of the background height from the bottom — the open band
    // between the copy and the time axis along the foot of the frame, so the
    // company on show has its orb in plain sight rather than under its words.
    const CAREER_MID_Y = 0.27;

    /* ══════════════════════════════════════════════════════════════════ */

    /* ── Scroll behavior ──
       The background is pinned (sticky) for the whole scope, hero through
       quote, so it holds still in screen space the entire way down and only
       leaves with the flow at the very end.

       Three things are scrubbed from scroll position, all measured against
       the scope's own top so nothing here depends on this being the first
       thing on the page:

       · the ink's sheet, which rides up with the page at a fraction of its
         speed.
       · one lift channel per career orb, each zeroed on the scroll position
         where its employer's entry sits mid-slot in the pinned career section
         — so every orb crosses the middle of the frame while its company is
         the one being read. Eased inside the engine, so the parallax glides.
       · the turn itself, read straight off the anchor section's live top edge
         rather than off a cached scroll position, so it cannot desync from
         the section it is handing over to no matter what reflows above. Not
         eased: the page's smooth-scroll already carries it, and a second lag
         would leave the backdrop trailing the section. */
    let scopeTop = 0; // the scope's document offset
    let bgH = 1; // pinned background height (CSS px)
    let careerAt = 1; // scroll into the scope where Career's pin engages
    let careerStep = 1; // scroll the pin gives each entry
    let fadeLead = 1; // how far Career's top edge climbs over the whole turn
    // The anchor's document top. It only moves with the page, so it is
    // re-measured on any layout change (lib/layout-watch.ts) — undebounced,
    // unlike measure() below, so the turn can't desync from the section it
    // is handing over to — rather than read back on every frame, where the
    // read would force whatever styles earlier subscribers wrote.
    let anchorDocTop = 0;

    const clamp01 = (v: number) => (v < 0 ? 0 : v > 1 ? 1 : v);
    const smoothstep = (e0: number, e1: number, x: number) => {
      const t = clamp01((x - e0) / (e1 - e0));
      return t * t * (3 - 2 * t);
    };

    function onScrollFrame(scrollY = window.scrollY) {
      const y = scrollY - scopeTop;

      ink?.setScroll(Math.max(y, 0));
      if (!darkAnchor) return;

      /* Progress of the turn, straight off the anchor's top edge: one
         fadeLead above the top of the screen is 0 (all bone), level with it is
         1 (all dark), and the pin engages on that same frame. Smoothstepped so
         the backdrop eases into the turn and settles out of it instead of
         starting and stopping on a corner. */
      const d = clamp01(1 - (anchorDocTop - scrollY) / fadeLead);
      const dark = d * d * (3 - 2 * d);
      if (dark > 0) loadGlass();
      ink?.setDarkness(dark);
      showGlass(smoothstep(GLASS_IN[0], GLASS_IN[1], dark));
      paintTurn(dark);
      if (!scene) return;

      // Dark half: orb i is at rest (lift 0, i.e. CAREER_MID_Y) when entry i
      // is mid-slot, and rides CAREER_GAP_Y background heights per entry.
      const rate = (CAREER_GAP_Y * bgH) / careerStep;
      for (let i = 0; i < CAREER_PLACE.length; i++) {
        const mid = careerAt + (i + 0.5) * careerStep;
        scene.setScrollTarget((y - mid) * rate, 1 + i);
      }
    }

    /* Three things off the canvas move with the backdrop.

       The scope's own background, which is all that shows if neither canvas
       paints at all, is repainted from the two engines' shared colours so
       that last-resort page darkens too.

       And the two sections either side of the turn, which cross-fade across it
       exactly as the two sets of orbs do. Neither can simply sit there while
       the ground moves under it: About's copy is set in a dark ink for bone
       and Career's in near-white for black, so in the middle of the turn —
       where the backdrop passes through mid-grey — whichever one stayed would
       be near the value of the thing behind it. Walking About's ink across
       with the backdrop does not help; it only puts the copy *at* that value
       instead of beside it. So each is at full strength while it is the one
       being read, and the handover happens in between: About dissolves into
       the dark as it leaves, Career surfaces out of it as it arrives, and the
       background carries the middle on its own.

       All three are written only when the value moves, so away from the turn
       this is one compare a frame.

       While either section is part-way through its fade it is lifted onto a
       layer of its own (will-change), so the fade is the compositor's to run
       and each frame of it is a blend of a layer already drawn. Left in the
       page's own layer, every step of the opacity would repaint the whole
       section, and both are screen-sized slabs of type. The layer is dropped
       again as soon as the section is fully in or out, so at rest the text
       is drawn straight into the page, as crisp as anywhere else on it (see
       Career's playhead for why that matters). */
    const alpha = (x: number) => (x > 0.999 ? "" : x.toFixed(3));
    const fade = (el: HTMLElement, x: number) => {
      el.style.opacity = alpha(x);
      const layer = x > 0 && x <= 0.999 ? "opacity" : "";
      if (el.style.willChange !== layer) el.style.willChange = layer;
    };
    let lastTurn = -1;
    function paintTurn(dark: number) {
      const v = Math.round(dark * 256) / 256;
      if (v === lastTurn) return;
      lastTurn = v;
      scope.style.backgroundColor = `rgb(${BONE.map((c, i) =>
        Math.round(255 * (c + (DARK[i] - c) * v)),
      ).join(" ")})`;
      if (about) fade(about, 1 - smoothstep(ABOUT_OUT[0], ABOUT_OUT[1], v));
      if (darkAnchor) fade(darkAnchor, smoothstep(CAREER_IN[0], CAREER_IN[1], v));
    }
    // Shared scroll bus (Layout head shim) — fires once per frame; the scene's
    // own render loop eases toward the target, so frame-exact timing isn't
    // required, but this keeps it to one listener across the site.
    (window as any).__onSmoothScrollTick(onScrollFrame);

    /* ── Scene config ──
       The glass render itself (WebGL2 + CPU fallback) lives in the shared
       engine, src/scripts/glass-scene.ts — only object layout and scroll
       wiring live here. shape: 0 sphere, 1 cube. Gradients are linear, 0% at
       the top of the object → 100% at the bottom. */
    /* The orbs — one per employer, oldest first, each in its company's
       colours. They are lit shapes surfacing out of black, so the matcap (a
       dark glossy ball) is mostly off and `dim` holds them back from being
       the brightest thing over the copy.

       The two gradients map onto a brand pair: ga0 is the top of the orb, ga1
       the lower half, and the material itself rolls the bottom rim to white —
       which is where the "and white" of the blue and purple pairs comes from,
       with ga1 pushed pale to meet it. gb0 is the shadowed base under both.

       zone: 1 marks them as belonging to the dark side of the engine's
       backdrop, where this scene holds it throughout, and each rides its own
       lift channel (1 + index) so it can be timed to its own entry. */
    const CAREER_ORBS = [
      {
        // McDonald's — Golden Arches over a ketchup red
        ga0: [0.86, 0.16, 0.11],
        ga1: [1.0, 0.78, 0.17],
        gb0: [0.47, 0.05, 0.03],
      },
      {
        // Artesian Builds — cobalt, washing out to white
        ga0: [0.13, 0.4, 0.96],
        ga1: [0.66, 0.82, 1.0],
        gb0: [0.04, 0.16, 0.56],
      },
      {
        // Squib — violet, washing out to a lavender white
        ga0: [0.5, 0.25, 0.94],
        ga1: [0.87, 0.8, 1.0],
        gb0: [0.23, 0.08, 0.52],
      },
      {
        // Rumor — black glass, white highlights, a gold accent. Black on
        // near-black has no edge of its own, so the dark glossy matcap is
        // left mostly uncovered (low gradient mixes): its white speculars and
        // the fresnel rim draw the ball, and the gold stays a band low on it
        // rather than turning it into a gold ball.
        ga0: [0.1, 0.1, 0.11],
        ga1: [0.8, 0.6, 0.22],
        gb0: [0.03, 0.03, 0.03],
        mat: 1,
        gaMix: 0.4,
        gbMix: 0.2,
      },
      {
        // Junior — deep blue into teal
        ga0: [0.07, 0.32, 0.9],
        ga1: [0.13, 0.86, 0.78],
        gb0: [0.02, 0.2, 0.42],
      },
    ];
    /* Placement carries one constraint: the career section sets its name and
       copy straight onto the glass, heaviest over the left of the frame,
       with nothing at all between them and the orbs. So
       the larger orbs stay right of ~0.4 — out past the copy column — and the
       ones that cross the left side stay a touch smaller. Sizes and
       brightness are kept close so the five read as one set rather than as
       big ones and stragglers.
                x     scale  shape (0 sphere, 1 cube)  brightness */
    const CAREER_PLACE = [
      { x: 0.76, s: 0.8, shape: 0 as const, dim: 0.56 },
      { x: 0.42, s: 0.9, shape: 0 as const, dim: 0.52 },
      { x: 0.16, s: 0.7, shape: 1 as const, dim: 0.48 },
      { x: 0.86, s: 0.85, shape: 0 as const, dim: 0.72 },
      { x: 0.56, s: 0.92, shape: 0 as const, dim: 0.52 },
    ];

    const careerObjects = (baseR: number) =>
      CAREER_PLACE.map((p, i): GlassObject => {
        const c = CAREER_ORBS[i];
        return {
          shape: p.shape,
          mat: c.mat ?? 0,
          rFrac: baseR * p.s,
          cx: p.x,
          cy: CAREER_MID_Y,
          edgeR: 0,
          ga0: c.ga0,
          ga1: c.ga1,
          gb0: c.gb0,
          gaMix: c.gaMix ?? 0.66,
          gbMix: c.gbMix ?? 0.34,
          dim: p.dim,
          // Staggered phases and mildly irregular speeds so the stream never
          // settles into a visible rhythm.
          driftAmp: 0.034 + (i % 3) * 0.008,
          driftYScale: 0.7,
          spdX: 0.15 + i * 0.017,
          spdY: 0.1 + i * 0.011,
          phX: i * 1.37,
          phY: 2.4 + i * 0.93,
          lift: 1 + i,
          zone: 1,
        };
      });

    /* ── Which background is running ──
       The two canvases hand over across the turn, and each scene only runs
       while its canvas can be seen: the ink until the glass is opaque over
       it, the glass from the moment it starts to show. */
    const ink = mountInk({
      canvas: inkCanvas,
      wrap,
      reducedMotion,
      thread: inkThread,
    });
    if (query.has("inklook")) (window as any).__inkLook = { ink, look: ink.look() };
    let scene: GlassScene | null = null;
    let glassAlpha = 0;
    function showGlass(a: number) {
      if (a === glassAlpha) return;
      glassAlpha = a;
      canvas.style.opacity = a > 0.999 ? "" : a.toFixed(3);
      canvas.style.visibility = a > 0 ? "" : "hidden";
      syncRunning();
    }
    function syncRunning() {
      if (reducedMotion) return;
      const live = scopeVisible && !document.hidden;
      live && glassAlpha < 1 ? ink?.start() : ink?.stop();
      live && glassAlpha > 0 ? scene?.start() : scene?.stop();
    }

    /* ── GPU-acceleration notice ──
       Revealed only while the CPU fallback is driving the scene (WebGL
       unavailable, or the context was lost) and the scope is on screen. */
    const gpuWarning = document.getElementById("hero-gpu-warning")!;
    let usingCPU = false;
    let scopeVisible = true;
    function syncWarning() {
      gpuWarning.style.display = usingCPU && scopeVisible ? "flex" : "none";
    }

    let glassWanted = false;
    function loadGlass() {
      if (glassWanted) return;
      glassWanted = true;
      import("../scripts/glass-scene").then((glass) => {
        scene = glass.createGlassScene({
          canvas,
          wrap,
          objects: careerObjects(glass.SPHERE_R_FRAC),
          forceCPU,
          onCPUFallback: () => {
            usingCPU = true;
            syncWarning();
          },
        });
        scene.setDarkness(1);
        scene.resize();
        onScrollFrame();
        if (reducedMotion) scene.render(40);
        else syncRunning();
      });
    }

    /* Everything scroll-invariant, cached here so the per-frame path reads no
       layout it doesn't have to. Re-run on resize and whenever the scope's
       box changes (fonts, images, the career section's own reflow). */
    function measure() {
      bgH = bg.offsetHeight;
      scopeTop = scope.getBoundingClientRect().top + window.scrollY;

      if (!darkAnchor) return;
      const anchorTop =
        darkAnchor.getBoundingClientRect().top + window.scrollY - scopeTop;

      // Career's pin, mirrored from its own script: progress 0 is its top
      // edge at the top of the screen, 1 is its full travel later, and that
      // travel is split evenly into one slot per entry (the newest entry's
      // slot doubles as the run-out). Oldest entry first, which is the order
      // the orbs are in.
      const pin = darkAnchor.querySelector<HTMLElement>(".pin");
      const travel =
        darkAnchor.offsetHeight - (pin?.offsetHeight ?? window.innerHeight);
      let entries = CAREER_PLACE.length;
      try {
        entries = JSON.parse(darkAnchor.dataset.stepMap || "[]").length || entries;
      } catch {}
      careerAt = anchorTop;
      careerStep = Math.max(travel / entries, 1);

      // The turn, kept as a *distance* rather than a pair of scroll positions:
      // how much further Career's top edge has to climb between the frame the
      // turn starts and the frame it finishes at the top of the screen. That
      // way the per-frame path needs nothing but that edge's live position.
      const aboutH = about ? about.offsetHeight : 0;
      const aboutTop = about
        ? about.getBoundingClientRect().top + window.scrollY - scopeTop
        : anchorTop;
      const turnAt = aboutTop + aboutH * (1 - FADE_FROM_BOTTOM);
      fadeLead = Math.max(anchorTop - turnAt + window.innerHeight, 1);
    }

    let resizeTimer: number | undefined;
    new ResizeObserver(() => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        measure();
        ink?.resize();
        scene?.resize();
        onScrollFrame();
      }, 120);
    }).observe(scope);
    measure();
    if (darkAnchor)
      onLayoutChange(() => {
        anchorDocTop = docTop(darkAnchor);
      }, onScrollFrame);
    else onScrollFrame();

    // One observer drives both the warning and (when motion is allowed) the
    // render loop — same element, same threshold.
    new IntersectionObserver(
      (entries) => {
        scopeVisible = entries[0].isIntersecting;
        syncWarning();
        syncRunning();
      },
      { threshold: 0 },
    ).observe(scope);

    // The glass is not needed until the turn, so it waits for the page to be
    // done loading and idle (onScrollFrame fetches it sooner on a page opened
    // part-way down).
    const whenIdle = () =>
      "requestIdleCallback" in window
        ? requestIdleCallback(loadGlass, { timeout: 4000 })
        : setTimeout(loadGlass, 1500);
    if (document.readyState === "complete") whenIdle();
    else addEventListener("load", whenIdle, { once: true });

    // Back to the tab: resume only what is on screen — the observer above is
    // what stops the loops while the scope isn't.
    if (!reducedMotion)
      document.addEventListener("visibilitychange", syncRunning);
  }
</script>
