---
import ActionButton from "./ActionButton.astro";
---

<!-- Scrolls over the pinned canvas in PinnedCanvas.astro — no background of
     its own. Height must match --hero-h, which the pin is measured against. -->
<section id="hero" class="relative h-[var(--hero-h)]">
  <div
    class="relative z-10 h-full flex flex-col justify-between gap-y-[100px] px-3 sm:px-6 lg:px-12 pt-[clamp(112px,calc(112px+(100vw-440px)*0.036),148px)] pb-[clamp(32px,calc(32px+(100vw-440px)*0.012),44px)]"
  >
    <h1
      class="hero-enter-mask font-display text-ink leading-none text-hero mt-[clamp(0px,calc((100vw-768px)*0.125),32px)]"
    >
      <span>Dominic Clerici</span>
    </h1>

    <div
      data-hero-fade
      class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6"
    >
      <div class="max-w-[640px]">
        <span
          class="hero-enter flex items-center mb-5 font-mono text-[13px] leading-none uppercase text-ink/60"
        >
          Engineer &amp; Designer&ensp;·&ensp;New York
        </span>
        <p
          class="hero-enter font-display text-ink/90 leading-[1.2] tracking-[-0.02em] text-lead"
        >
          I design and build software that&rsquo;s fast, useful, and worth
          looking at.
        </p>
      </div>

      <ActionButton
        href="#work"
        icon="down"
        variant="solid"
        caps
        class="hero-enter-cta shrink-0"
      >
        View selected work
      </ActionButton>
    </div>
  </div>
</section>

<script>
  import { smoothstep } from "../lib/easing";

  // Fades each [data-hero-fade] element out as it nears the top of the
  // viewport, and back in as it returns — a pure function of live position,
  // so reversing scroll direction reverses the fade with no extra state.
  // Progress is how far up the screen the element's top has travelled (0 at
  // the bottom edge, 1 at the top edge); the fade window sits right before
  // the element would exit, so it's fully gone just ahead of leaving.
  const FADE_START = 0.8;
  const FADE_END = 0.95;

  const section = document.getElementById("hero");
  const fadeEls = section
    ? Array.from(section.querySelectorAll<HTMLElement>("[data-hero-fade]"))
    : [];

  if (
    fadeEls.length &&
    matchMedia("(prefers-reduced-motion: no-preference)").matches
  ) {
    const update = () => {
      const vh = window.innerHeight;
      for (const el of fadeEls) {
        const rect = el.getBoundingClientRect();
        const progress = (vh - rect.top) / vh;
        const raw = Math.min(
          1,
          Math.max(0, (progress - FADE_START) / (FADE_END - FADE_START)),
        );
        const opacity = 1 - smoothstep(raw);
        el.style.opacity = opacity.toFixed(3);
        el.style.pointerEvents = opacity < 0.05 ? "none" : "";
      }
    };

    // Same-frame under the smooth-scroll engine, native-scroll fallback under
    // reduced motion — the shared bus (Layout head shim) handles both.
    (window as any).__onSmoothScrollTick(update);
    window.addEventListener("resize", update, { passive: true });
    update();
  }
</script>
