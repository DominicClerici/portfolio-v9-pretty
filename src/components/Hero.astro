---
import IconButton from "./IconButton.astro";
---

<!-- Scrolls over the pinned canvas in PinnedCanvas.astro — no background of
     its own. Height must match --hero-h, which the pin is measured against. -->
<section id="hero" class="relative h-[var(--hero-h)]">
  <div
    class="relative z-10 h-full flex flex-col justify-between gap-y-[100px] px-6 lg:px-12 pt-[clamp(112px,calc(112px+(100vw-440px)*0.036),148px)] pb-[clamp(32px,calc(32px+(100vw-440px)*0.012),44px)]"
  >
    <h1
      class="hero-enter-mask font-display text-ink leading-none tracking-[-0.03em] text-hero"
    >
      <span>Dominic Clerici.</span>
    </h1>

    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
      <div class="max-w-[640px]">
        <div
          class="hero-enter flex items-center mb-5"
          style="--enter-delay: 1.35s"
        >
          <span class="font-mono text-[13px] tracking-[-0.02em] leading-none uppercase text-ink/60">
            Engineer &amp; Designer&ensp;·&ensp;New York
          </span>
        </div>
        <p
          class="hero-enter font-display text-ink/90 leading-[1.2] tracking-[-0.02em] text-lead"
          style="--enter-delay: 1.35s"
        >
          I design and build software that&rsquo;s fast, useful, and worth
          looking at.
        </p>
      </div>

      <div
        class="hero-enter-cta flex items-center gap-3 shrink-0"
        style="--enter-delay: 1.75s"
      >
        <a
          href="#work"
          class="font-mono text-[14px] tracking-[-0.008em] text-ink border border-ink/35 rounded-lg h-10 px-4 inline-flex items-center hover:border-ink hover:bg-white/25 hover:backdrop-blur-md transition-colors duration-200"
        >
          View selected work
        </a>
        <IconButton
          href="#work"
          aria-label="Scroll to selected work"
          class="hover:translate-y-0.5"
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 14 14"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M7 1v11M2 7.5 7 12.5 12 7.5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </IconButton>
      </div>
    </div>
  </div>
</section>
