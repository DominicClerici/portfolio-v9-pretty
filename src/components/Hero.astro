<div id="hero-scope" class="relative bg-bone">
  <!-- Pinned canvas — sticky for the whole scope, so it holds still while
       the hero and the section below scroll over it, then leaves with the
       flow at the end of the scope. -->
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-frame">
      <div class="hero-canvas-wrap">
        <canvas id="hero-canvas"></canvas>
      </div>
    </div>
  </div>

  <div class="hero-scope-content">
    <section id="hero" class="relative h-svh min-h-[560px]">
      <!-- Content -->
      <div
        class="relative z-10 h-full max-w-[1524px] mx-auto flex flex-col justify-between gap-y-[100px] px-6 lg:px-12 pt-[clamp(112px,calc(112px+(100vw-440px)*0.036),148px)] pb-[clamp(32px,calc(32px+(100vw-440px)*0.012),44px)]"
      >
        <h1
          class="hero-enter-mask font-display font-normal text-ink leading-none tracking-[-0.03em] max-w-[1070px] text-[clamp(3.125rem,calc(3.125rem+(100vw-27.5rem)*0.062),7rem)]"
        >
          <span>Dominic Clerici.</span>
        </h1>

        <div
          class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6"
        >
          <div class="max-w-[640px]">
            <div
              class="hero-enter flex items-center gap-2.5 mb-5"
              style="--enter-delay: 1.6s"
            >
              <span
                class="w-[6px] h-[6px] rounded-full bg-bio-lime"
                aria-hidden="true"></span>
              <span
                class="font-mono text-[13px] leading-none tracking-[-0.02em] uppercase text-ink/60"
              >
                Engineer &amp; Designer&ensp;·&ensp;New York
              </span>
            </div>
            <p
              class="hero-enter font-display font-normal text-ink/90 leading-[1.2] tracking-[-0.02em] text-[clamp(1.25rem,calc(1.25rem+(100vw-27.5rem)*0.004),1.5rem)]"
              style="--enter-delay: 1.6s"
            >
              I design and build software that&rsquo;s fast, useful, and worth
              looking at.
            </p>
          </div>

          <div
            class="hero-enter-cta flex items-center gap-3 shrink-0"
            style="--enter-delay: 2s"
          >
            <a
              href="#work"
              class="font-mono text-[14px] tracking-[-0.008em] text-ink border border-ink/35 rounded-lg h-10 px-4 inline-flex items-center hover:border-ink transition-colors duration-200"
            >
              View selected work
            </a>
            <a
              href="#work"
              aria-label="Scroll to selected work"
              class="w-10 h-10 rounded-lg bg-bio-lime text-ink inline-flex items-center justify-center hover:translate-y-0.5 transition-transform duration-200"
            >
              <svg
                width="14"
                height="14"
                viewBox="0 0 14 14"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M7 1v11M2 7.5 7 12.5 12 7.5"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- The section below the hero scrolls over the same pinned canvas -->
    <slot />
  </div>
</div>

<script>
  {
    const scope = document.getElementById("hero-scope")!
    const bg = scope.querySelector<HTMLElement>(".hero-bg")!
    const wrap = scope.querySelector<HTMLElement>(".hero-canvas-wrap")!
    let canvas = document.getElementById("hero-canvas") as HTMLCanvasElement
    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches
    const forceCPU = new URLSearchParams(location.search).has("cpu")

    /* ── Scroll behavior ──
       The background is pinned (sticky) for the whole scope. While pinned,
       the glass cylinders hold still in screen space and the sphere climbs
       at 0.75× scroll speed. Once the pin ends the background leaves with
       the flow. The sphere's lift clamps at the pin end, so from there
       sphere and glass scroll away together with the page. */
    const SPHERE_SCROLL = 0.4
    let pinEnd = 1 // scroll distance the background stays pinned (px)
    let scrollLift = 0 // sphere lift from scroll, CSS px, clamped at pinEnd
    let scrollQueued = false
    function onScrollFrame() {
      scrollQueued = false
      const y = window.scrollY
      scrollLift = Math.min(y, pinEnd) * SPHERE_SCROLL
      // No raf loop under reduced motion — repaint the static frame instead
      // so the scroll-linked sphere parallax still tracks the page.
      if (reducedMotion) impl.render(40)
    }
    window.addEventListener(
      "scroll",
      () => {
        if (!scrollQueued) {
          scrollQueued = true
          requestAnimationFrame(onScrollFrame)
        }
      },
      { passive: true },
    )

    // Once the iris-open finishes, drop the clip so no stale clip-path
    // lingers on the canvas. The animation itself must be removed too: its
    // fill-mode keeps applying the end keyframe over any inline clip-path
    // override.
    wrap.addEventListener("animationend", (e) => {
      if (e.animationName === "hero-iris-open") {
        wrap.style.animation = "none"
        wrap.style.clipPath = "none"
      }
    })

    /* ── Glassmorphic render without the three.js bundle ──
       The Spline reference is a plane of touching glass cylinders between the
       camera and a green sphere. Reproduced here as two fullscreen passes of
       raw WebGL2: pass 1 draws the backdrop + sphere (impostor raytrace, the
       Spline material layers composited in-shader) into a mipmapped FBO;
       pass 2 treats the whole frame as packed diagonal cylinders — per pixel
       it derives the cylinder normal analytically, refracts the view ray in
       2D, and samples the blurred scene (mip LOD = the material's 45px blur)
       at the displaced point, then adds the fresnel seam and film grain.
       When WebGL is unavailable the same math runs per-pixel on the CPU
       against an analytic already-blurred sphere, at reduced resolution. */

    /* ── Scene & material config ──
       Numbers lifted from the Spline material panels; the few *_TUNE knobs
       translate Spline's world-space units into screen-space fractions. */
    // Cylinder plane
    const AXIS_DEG = 42 // cylinder axis angle, y-up screen space
    const PERIOD_FRAC = 0.078 // cylinder diameter, fraction of min(w, h)
    const IOR = 1.14 // Spline: refraction 1.16
    const THICK_FRAC = 0.7 // Spline: thickness 565 — screen-space equivalent
    const BLUR_PX = 52 // Spline: blur 45 (CSS px)
    // Glass fresnel — Spline: 80%, #fff, bias .24, scale 2.08, int 5.81, factor 1.17
    const G_FRES = { bias: 0.3, scale: 2.08, pow: 2.0, mix: 1.1 }
    const SEAM_DARK = 0.08 // subtle dark seam so packed cylinders read on white
    // Sphere
    const SPHERE_R_FRAC = 0.28 // radius, fraction of min(w, h)
    // At rest the sphere sits just right of center — its left edge touches
    // the page's vertical center line (center x = 0.5·w + radius).
    const SPHERE_EDGE_X = 0.5 // fraction of w the left edge rests on
    const SPHERE_Y = 0.52 // center height, fraction of h, y-up
    // Sphere fresnel — Spline: 100%, #fff, bias .4, scale 1.5, int 8, factor .8
    const S_FRES = { bias: 0.9, scale: 3.5, pow: 5.5, gain: 1.0 }
    // Linear gradients (0% at the top of the sphere → 100% at the bottom)
    const GRAD_A = {
      c0: [0.126, 0.997, 0.2],
      c1: [0.233, 0.979, 0.778],
      mix: 0.6,
    } // #04D800 → #22DB14 → #fff
    const GRAD_B = { c0: [0.0, 0.824, 0.533], mix: 0.4 } // #006C22 → #fff
    // Film grain, scaled by how much color the glass is carrying
    const GRAIN_SAT = 0.12
    const GRAIN_LUM = 0.22
    // Idle drift + pointer parallax
    const DRIFT_FRAC = 0.05
    const PARALLAX_FRAC = -0.3
    const BG = [0.957, 0.953, 0.945] // backdrop behind the glass

    const v3 = (c: number[]) => `vec3(${c.map((x) => x.toFixed(3)).join(", ")})`
    const f1 = (x: number) => x.toFixed(3)

    /* Pointer parallax + idle drift, shared by both backends */
    let px = 0
    let py = 0 // smoothed pointer, −0.5…0.5
    let tpx = 0
    let tpy = 0
    window.addEventListener(
      "pointermove",
      (e) => {
        tpx = e.clientX / window.innerWidth - 0.5
        tpy = 0.5 - e.clientY / window.innerHeight
      },
      { passive: true },
    )
    // Sphere center in y-up canvas pixels for a given time + canvas size.
    // `lift` is the scroll parallax in the caller's pixel scale — positive
    // moves the sphere up (y-up), i.e. it climbs as the page scrolls down.
    function sphereCenter(tSec: number, w: number, h: number, lift: number) {
      px += (tpx - px) * 0.04
      py += (tpy - py) * 0.04
      const m = Math.min(w, h)
      return [
        w * SPHERE_EDGE_X +
          m *
            (SPHERE_R_FRAC +
              DRIFT_FRAC * Math.sin(tSec * 0.21) +
              PARALLAX_FRAC * px),
        h * SPHERE_Y +
          m *
            (DRIFT_FRAC * 0.6 * Math.sin(tSec * 0.13 + 1.7) +
              PARALLAX_FRAC * py) +
          lift,
      ]
    }
    type Impl = { render: (tSec: number) => void; resize: () => void }
    let impl: Impl

    /* ── Shared render-loop harness (raf, resize, visibility) ── */
    let rafId: number | null = null
    let running = false
    let lastT = 0
    function loop(ms: number) {
      if (!running) return
      lastT = ms / 1000
      impl.render(lastT)
      rafId = requestAnimationFrame(loop)
    }
    function start() {
      if (running || reducedMotion) return
      running = true
      rafId = requestAnimationFrame(loop)
    }
    function stop() {
      running = false
      if (rafId !== null) cancelAnimationFrame(rafId)
      rafId = null
    }

    /* Sphere texture layer (Spline: Image 100%) — the reference photo of a
       dark glossy ball, projected matcap-style from the impostor normal.
       Both backends render before it arrives and once more when it does. */
    const matcap = new Image()
    let matcapReady = false
    matcap.onload = () => {
      matcapReady = true
      onMatcap?.()
      if (!running) impl.render(lastT)
    }
    matcap.src = "/glass-matcap.avif"
    let onMatcap: (() => void) | null = null

    /* ── Raw WebGL2 backend ── */
    let glTouched = false

    function startGL(): Impl | null {
      if (forceCPU) return null
      const gl = canvas.getContext("webgl2", {
        antialias: false, // both passes are fullscreen quads — nothing to MSAA
        alpha: false,
        powerPreference: "low-power",
      })
      if (!gl) return null
      glTouched = true

      const VS = `#version 300 es
        layout(location = 0) in vec2 aPos;
        void main() { gl_Position = vec4(aPos, 0.0, 1.0); }`

      // Pass 1 — backdrop + sphere impostor, Spline layers bottom-to-top:
      // image → fresnel → gradient B (40%) → gradient A (60%) → phong (60%)
      const SCENE_FS = `#version 300 es
        precision highp float;
        uniform vec3 uSphere;    // center (px, y-up), radius (px)
        uniform sampler2D uMatcap;
        uniform float uMatcapOn;
        out vec4 outColor;

        vec3 gradA(float t) {
          vec3 c = mix(${v3(GRAD_A.c0)}, ${v3(GRAD_A.c1)}, smoothstep(0.0, 0.8, t));
          return mix(c, vec3(1.0), smoothstep(0.8, 1.0, t));
        }
        vec3 gradB(float t) {
          return mix(${v3(GRAD_B.c0)}, vec3(1.0), smoothstep(0.8, 1.0, t));
        }

        void main() {
          vec2 p = (gl_FragCoord.xy - uSphere.xy) / uSphere.z;
          float r2 = dot(p, p);
          vec3 col = ${v3(BG)};
          if (r2 < 1.0) {
            vec3 n = vec3(p, sqrt(1.0 - r2));
            vec3 c = mix(vec3(0.16), texture(uMatcap, vec2(n.x, -n.y) * 0.5 + 0.5).rgb, uMatcapOn);
            float fr = clamp(${f1(S_FRES.bias)} + ${f1(S_FRES.scale)} * pow(1.0 - n.z, ${f1(S_FRES.pow)}), 0.0, 1.0);
            c += vec3(1.0) * fr * fr * ${f1(S_FRES.gain)};
            float t = 0.5 - n.y * 0.5;                  // 0 top → 1 bottom
            c = mix(c, gradB(t), ${f1(GRAD_B.mix)});
            c = mix(c, gradA(t), ${f1(GRAD_A.mix)});
            col = mix(col, c, smoothstep(0.0, 2.5 / uSphere.z, 1.0 - sqrt(r2)));
          }
          outColor = vec4(col, 1.0);
        }`

      // Pass 2 — the glass plane. Per pixel: cylinder normal from the packed
      // circle profile, 2D refraction (entry interface; the steep growth
      // toward the edges is what shears the sphere into blades), blurred
      // scene sample at the displaced point, fresnel seam, grain.
      const GLASS_FS = `#version 300 es
        precision highp float;
        uniform vec2 uRes;
        uniform sampler2D uScene;
        uniform float uLod;
        uniform float uPeriod;   // cylinder diameter, px
        uniform vec2 uAxis;      // unit axis direction
        uniform float uThick;    // displacement scale, px
        uniform float uTime;
        out vec4 outColor;

        float hash(vec2 p) {
          p = fract(p * vec2(123.34, 456.21));
          p += dot(p, p + 45.32);
          return fract(p.x * p.y);
        }

        void main() {
          vec2 perp = vec2(-uAxis.y, uAxis.x);
          float x = fract(dot(gl_FragCoord.xy, perp) / uPeriod) * 2.0 - 1.0;
          float ny = sqrt(max(1.0 - x * x, 1e-5));
          vec2 T = refract(vec2(0.0, -1.0), vec2(x, ny), 1.0 / ${f1(IOR)});
          float shift = T.x / max(abs(T.y), 0.05) * uThick;
          vec2 uv = (gl_FragCoord.xy + perp * shift) / uRes;

          // 4 rotated jitter taps hide mip-blur blockiness
          float a = hash(gl_FragCoord.xy) * 6.2832;
          vec2 j = vec2(cos(a), sin(a)) * uPeriod * 0.05 / uRes;
          vec3 c = textureLod(uScene, clamp(uv + j, 0.0, 1.0), uLod).rgb
                 + textureLod(uScene, clamp(uv - j, 0.0, 1.0), uLod).rgb
                 + textureLod(uScene, clamp(uv + vec2(-j.y, j.x), 0.0, 1.0), uLod).rgb
                 + textureLod(uScene, clamp(uv - vec2(-j.y, j.x), 0.0, 1.0), uLod).rgb;
          c *= 0.25;

          // displaced samples that land off-screen read as backdrop, not
          // as a smeared clamp of the frame edge
          vec2 ouv = max(vec2(0.0), max(-uv, uv - 1.0));
          c = mix(c, ${v3(BG)}, smoothstep(0.0, 0.04, max(ouv.x, ouv.y)));

          float fr = clamp(${f1(G_FRES.bias)} + ${f1(G_FRES.scale)} * pow(1.0 - ny, ${f1(G_FRES.pow)}), 0.0, 1.0);
          c *= 1.0 - fr * ${f1(SEAM_DARK)};
          c = mix(c, vec3(1.0), fr * fr * ${f1(G_FRES.mix)});

          float lum = dot(c, vec3(0.299, 0.587, 0.114));
          float sat = max(c.r, max(c.g, c.b)) - min(c.r, min(c.g, c.b));
          float g = hash(gl_FragCoord.xy + fract(uTime) * 61.7) - 0.5;
          c += g * (sat * ${f1(GRAIN_SAT)} + (1.0 - lum) * ${f1(GRAIN_LUM)});

          outColor = vec4(c, 1.0);
        }`

      function compile(type: number, src: string) {
        const s = gl!.createShader(type)!
        gl!.shaderSource(s, src)
        gl!.compileShader(s)
        if (!gl!.getShaderParameter(s, gl!.COMPILE_STATUS)) {
          console.error(gl!.getShaderInfoLog(s))
          return null
        }
        return s
      }
      function link(fs: string) {
        const p = gl!.createProgram()!
        const v = compile(gl!.VERTEX_SHADER, VS)
        const f = compile(gl!.FRAGMENT_SHADER, fs)
        if (!v || !f) return null
        gl!.attachShader(p, v)
        gl!.attachShader(p, f)
        gl!.linkProgram(p)
        if (!gl!.getProgramParameter(p, gl!.LINK_STATUS)) {
          console.error(gl!.getProgramInfoLog(p))
          return null
        }
        return p
      }
      const sceneProg = link(SCENE_FS)
      const glassProg = link(GLASS_FS)
      if (!sceneProg || !glassProg) return null

      const quad = gl.createBuffer()
      gl.bindBuffer(gl.ARRAY_BUFFER, quad)
      gl.bufferData(
        gl.ARRAY_BUFFER,
        new Float32Array([-1, -1, 3, -1, -1, 3]),
        gl.STATIC_DRAW,
      )
      gl.enableVertexAttribArray(0)
      gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0)

      const uSphere = gl.getUniformLocation(sceneProg, "uSphere")
      const uMatcapOn = gl.getUniformLocation(sceneProg, "uMatcapOn")
      gl.useProgram(sceneProg)
      gl.uniform1i(gl.getUniformLocation(sceneProg, "uMatcap"), 0)
      const uRes = gl.getUniformLocation(glassProg, "uRes")
      const uLod = gl.getUniformLocation(glassProg, "uLod")
      const uPeriod = gl.getUniformLocation(glassProg, "uPeriod")
      const uAxis = gl.getUniformLocation(glassProg, "uAxis")
      const uThick = gl.getUniformLocation(glassProg, "uThick")
      const uTime = gl.getUniformLocation(glassProg, "uTime")
      gl.useProgram(glassProg)
      gl.uniform1i(gl.getUniformLocation(glassProg, "uScene"), 1)

      // Matcap texture (unit 0)
      const matTex = gl.createTexture()
      gl.activeTexture(gl.TEXTURE0)
      gl.bindTexture(gl.TEXTURE_2D, matTex)
      gl.texImage2D(
        gl.TEXTURE_2D,
        0,
        gl.RGBA,
        1,
        1,
        0,
        gl.RGBA,
        gl.UNSIGNED_BYTE,
        new Uint8Array([40, 40, 40, 255]),
      )
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR)
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE)
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE)
      function uploadMatcap() {
        gl!.activeTexture(gl!.TEXTURE0)
        gl!.bindTexture(gl!.TEXTURE_2D, matTex)
        gl!.pixelStorei(gl!.UNPACK_FLIP_Y_WEBGL, true)
        gl!.texImage2D(
          gl!.TEXTURE_2D,
          0,
          gl!.RGBA,
          gl!.RGBA,
          gl!.UNSIGNED_BYTE,
          matcap,
        )
        gl!.pixelStorei(gl!.UNPACK_FLIP_Y_WEBGL, false)
      }
      onMatcap = uploadMatcap
      if (matcapReady) uploadMatcap()

      // Scene FBO (unit 1) — half resolution; it only ever gets sampled
      // through a deep blur, and the halving buys a free extra mip level.
      const FBO_SCALE = 0.5
      const sceneTex = gl.createTexture()
      const fbo = gl.createFramebuffer()
      let fw = 1
      let fh = 1
      function allocFBO(w: number, h: number) {
        fw = Math.max(1, Math.round(w * FBO_SCALE))
        fh = Math.max(1, Math.round(h * FBO_SCALE))
        gl!.activeTexture(gl!.TEXTURE1)
        gl!.bindTexture(gl!.TEXTURE_2D, sceneTex)
        gl!.texImage2D(
          gl!.TEXTURE_2D,
          0,
          gl!.RGBA,
          fw,
          fh,
          0,
          gl!.RGBA,
          gl!.UNSIGNED_BYTE,
          null,
        )
        gl!.texParameteri(
          gl!.TEXTURE_2D,
          gl!.TEXTURE_MIN_FILTER,
          gl!.LINEAR_MIPMAP_LINEAR,
        )
        gl!.texParameteri(gl!.TEXTURE_2D, gl!.TEXTURE_MAG_FILTER, gl!.LINEAR)
        gl!.texParameteri(gl!.TEXTURE_2D, gl!.TEXTURE_WRAP_S, gl!.CLAMP_TO_EDGE)
        gl!.texParameteri(gl!.TEXTURE_2D, gl!.TEXTURE_WRAP_T, gl!.CLAMP_TO_EDGE)
        gl!.bindFramebuffer(gl!.FRAMEBUFFER, fbo)
        gl!.framebufferTexture2D(
          gl!.FRAMEBUFFER,
          gl!.COLOR_ATTACHMENT0,
          gl!.TEXTURE_2D,
          sceneTex,
          0,
        )
        gl!.bindFramebuffer(gl!.FRAMEBUFFER, null)
      }

      canvas.addEventListener(
        "webglcontextlost",
        (e) => {
          e.preventDefault()
          stop()
          impl = startCPU()
          impl.resize()
          start()
        },
        { once: true },
      )

      let dpr = 1
      function render(tSec: number) {
        const [cx, cy] = sphereCenter(
          tSec,
          canvas.width,
          canvas.height,
          scrollLift * dpr,
        )
        const m = Math.min(canvas.width, canvas.height)

        // Pass 1 — scene into the FBO, then mip it down for the glass blur
        gl!.bindFramebuffer(gl!.FRAMEBUFFER, fbo)
        gl!.viewport(0, 0, fw, fh)
        gl!.useProgram(sceneProg)
        gl!.uniform3f(
          uSphere,
          cx * FBO_SCALE,
          cy * FBO_SCALE,
          m * SPHERE_R_FRAC * FBO_SCALE,
        )
        gl!.uniform1f(uMatcapOn, matcapReady ? 1 : 0)
        gl!.drawArrays(gl!.TRIANGLES, 0, 3)
        gl!.activeTexture(gl!.TEXTURE1)
        gl!.bindTexture(gl!.TEXTURE_2D, sceneTex)
        gl!.generateMipmap(gl!.TEXTURE_2D)

        // Pass 2 — glass to the screen
        gl!.bindFramebuffer(gl!.FRAMEBUFFER, null)
        gl!.viewport(0, 0, canvas.width, canvas.height)
        gl!.useProgram(glassProg)
        gl!.uniform2f(uRes, canvas.width, canvas.height)
        gl!.uniform1f(uLod, Math.log2(Math.max(BLUR_PX * dpr * FBO_SCALE, 1)))
        gl!.uniform1f(uPeriod, m * PERIOD_FRAC)
        const a = (AXIS_DEG * Math.PI) / 180
        gl!.uniform2f(uAxis, Math.cos(a), Math.sin(a))
        gl!.uniform1f(uThick, m * THICK_FRAC)
        gl!.uniform1f(uTime, tSec)
        gl!.drawArrays(gl!.TRIANGLES, 0, 3)
      }

      function resize() {
        const rect = wrap.getBoundingClientRect()
        dpr = Math.min(window.devicePixelRatio || 1, 1.75)
        canvas.width = Math.max(1, Math.round(rect.width * dpr))
        canvas.height = Math.max(1, Math.round(rect.height * dpr))
        allocFBO(canvas.width, canvas.height)
        if (reducedMotion || !running) render(reducedMotion ? 40 : lastT)
      }

      return { render, resize }
    }

    /* ── Canvas2D fallback backend ──
       Same per-pixel glass math, but the blurred scene behind the glass is
       sampled analytically — a soft-edged gradient blob is what a 45px blur
       of the sphere looks like, so no actual blur pass is needed. Runs at a
       small fixed resolution into ImageData, upscaled by the browser. */
    function startCPU(): Impl {
      if (glTouched) {
        const fresh = document.createElement("canvas")
        fresh.id = "hero-canvas"
        fresh.className = canvas.className
        canvas.replaceWith(fresh)
        canvas = fresh
        glTouched = false
      }
      const ctx = canvas.getContext("2d")!
      const W = 520
      let H = 300
      let cssH = 1 // wrap height in CSS px, for scroll-lift conversion
      let img: ImageData
      let buf: Uint8ClampedArray

      const lerp = (a: number, b: number, t: number) => a + (b - a) * t
      const sstep = (e0: number, e1: number, x: number) => {
        const t = Math.min(1, Math.max(0, (x - e0) / (e1 - e0)))
        return t * t * (3 - 2 * t)
      }

      // Green sphere ramp ≈ the GL gradient layers after the 45px blur:
      // a top→bottom ramp with a bright lower rim.
      function sphereColor(t: number): [number, number, number] {
        const gA = [
          lerp(GRAD_A.c0[0], GRAD_A.c1[0], sstep(0, 0.8, t)),
          lerp(GRAD_A.c0[1], GRAD_A.c1[1], sstep(0, 0.8, t)),
          lerp(GRAD_A.c0[2], GRAD_A.c1[2], sstep(0, 0.8, t)),
        ]
        const w = sstep(0.8, 1, t)
        const dark = 1 - GRAD_B.mix * (1 - w) * 0.5 // gradient B darkening
        return [
          255 * Math.min(1, lerp(gA[0] * dark, 1, w)),
          255 * Math.min(1, lerp(gA[1] * dark, 1, w)),
          255 * Math.min(1, lerp(gA[2] * dark, 1, w)),
        ]
      }

      function render(tSec: number) {
        const [scx, scy] = sphereCenter(
          tSec,
          W,
          H,
          (scrollLift * H) / Math.max(cssH, 1),
        )
        const cy = H - scy // ImageData is y-down
        const m = Math.min(W, H)
        const R = m * SPHERE_R_FRAC
        const blur = m * 0.06 // the baked-in "45px" softness
        const period = m * PERIOD_FRAC
        const thick = m * THICK_FRAC
        const a = (AXIS_DEG * Math.PI) / 180
        // y-down perp of the y-up axis direction
        const pxv = -Math.sin(a)
        const pyv = -Math.cos(a)
        const eta = 1 / IOR
        let seed = (tSec * 61.7) % 1

        for (let y = 0; y < H; y++) {
          for (let x = 0; x < W; x++) {
            const nx = fractCell(x * pxv + y * pyv, period)
            const ny = Math.sqrt(Math.max(1 - nx * nx, 1e-5))
            // 2D refract of (0,−1) about (nx, ny)
            const cosi = ny
            const k = 1 - eta * eta * (1 - cosi * cosi)
            const tx = -eta * 0 + (eta * cosi - Math.sqrt(Math.max(k, 0))) * nx
            const ty = -eta * 1 + (eta * cosi - Math.sqrt(Math.max(k, 0))) * ny
            const shift = (tx / Math.max(Math.abs(ty), 0.05)) * thick
            const sx = x + pxv * shift
            const sy = y + pyv * shift

            // analytic blurred scene sample
            const dx = sx - scx
            const dy = sy - cy
            const d = Math.sqrt(dx * dx + dy * dy)
            const cov = 1 - sstep(R - blur, R + blur, d)
            let r = BG[0] * 255
            let g = BG[1] * 255
            let b = BG[2] * 255
            if (cov > 0) {
              const t = Math.min(1, Math.max(0, (dy + R) / (2 * R)))
              const sc = sphereColor(t)
              r = lerp(r, sc[0], cov)
              g = lerp(g, sc[1], cov)
              b = lerp(b, sc[2], cov)
            }

            // fresnel seam + dark line
            let fr = G_FRES.bias + G_FRES.scale * Math.pow(1 - ny, G_FRES.pow)
            fr = Math.min(1, Math.max(0, fr))
            const wht = fr * fr * G_FRES.mix
            const drk = 1 - fr * SEAM_DARK
            r = lerp(r * drk, 255, wht)
            g = lerp(g * drk, 255, wht)
            b = lerp(b * drk, 255, wht)

            // grain
            const lum = (0.299 * r + 0.587 * g + 0.114 * b) / 255
            const sat = (Math.max(r, g, b) - Math.min(r, g, b)) / 255
            seed = (seed * 16807 + 0.123456789) % 1
            const gr =
              (seed - 0.5) * 255 * (sat * GRAIN_SAT + (1 - lum) * GRAIN_LUM)

            const i = (y * W + x) * 4
            buf[i] = r + gr
            buf[i + 1] = g + gr
            buf[i + 2] = b + gr
            buf[i + 3] = 255
          }
        }
        ctx.putImageData(img, 0, 0)
      }

      function fractCell(d: number, period: number) {
        const f = d / period
        return (f - Math.floor(f)) * 2 - 1
      }

      function resize() {
        const rect = wrap.getBoundingClientRect()
        cssH = rect.height
        H = Math.max(1, Math.round((W * rect.height) / Math.max(rect.width, 1)))
        canvas.width = W
        canvas.height = H
        img = ctx.createImageData(W, H)
        buf = img.data
        if (reducedMotion || !running) render(reducedMotion ? 40 : lastT)
      }

      return { render, resize }
    }

    impl = startGL() ?? startCPU()

    function measure() {
      pinEnd = Math.max(scope.offsetHeight - bg.offsetHeight, 1)
    }

    let resizeTimer: number | undefined
    new ResizeObserver(() => {
      clearTimeout(resizeTimer)
      resizeTimer = window.setTimeout(() => {
        measure()
        impl.resize()
        onScrollFrame()
      }, 120)
    }).observe(scope)
    measure()
    impl.resize()
    onScrollFrame()

    if (reducedMotion) {
      impl.render(40)
    } else {
      new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            entry.isIntersecting ? start() : stop()
          }
        },
        { threshold: 0 },
      ).observe(scope)
      document.addEventListener("visibilitychange", () => {
        document.hidden ? stop() : start()
      })
      start()
    }
  }
</script>
