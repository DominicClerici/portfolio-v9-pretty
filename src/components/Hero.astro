---
import ActionButton from "./ActionButton.astro";
---

<!-- Scrolls over the pinned canvas in PinnedCanvas.astro — no background of
     its own. Height must match --hero-h, which the pin is measured against.

     A poster on wet paper: a centred statement in the open middle of the
     sheet, where the ink (src/scripts/ink-fluid.ts) is, and the name set the
     full width of its foot. -->
<section id="hero" class="relative h-[var(--hero-h)]">
  <div
    class="relative z-10 h-full flex flex-col px-safe-3 sm:px-safe-6 lg:px-safe-12 pt-[clamp(88px,calc(88px+(100vw-440px)*0.036),124px)] pb-[clamp(14px,calc(14px+(100vw-440px)*0.01),26px)]"
  >
    <div class="flex-1 min-h-0 flex flex-col justify-center pb-[2vh]">
      <div data-hero-fade class="flex flex-col items-center text-center">
        <span
          class="hero-enter mb-[clamp(16px,1.8vw,26px)] font-mono text-[13px] leading-none uppercase text-ink/60"
          style="--enter-delay: 0.75s"
        >
          Engineer &amp; Designer&ensp;·&ensp;New York
        </span>
        <!-- Always exactly two lines, split at the <br>; the size is capped so
             the longer line (~14em) fits inside the px-3 gutters on any phone. -->
        <p
          class="hero-enter whitespace-nowrap font-display text-ink leading-[1.12] tracking-[-0.025em] text-[min(clamp(1.5rem,3.3vw,3rem),calc((100vw-24px)/14.6))]"
          style="--enter-delay: 0.85s"
        >
          I design and build software that&rsquo;s<br />fast, useful, and worth
          looking at.
        </p>
        <!-- ActionButton hands its style to the link inside it, so the delay
             rides on a wrapper. -->
        <div
          class="hero-enter-cta mt-[clamp(22px,2.6vw,38px)]"
          style="--enter-delay: 1.15s"
        >
          <ActionButton href="#work" icon="down" variant="solid" caps>
            View selected work
          </ActionButton>
        </div>
      </div>
    </div>

    <h1
      class="hero-name hero-enter-mask font-display text-ink"
      style="--enter-delay: 0.4s"
    >
      <span>Dominic Clerici</span>
    </h1>
  </div>
</section>

<style>
  /* The name runs gutter to gutter at every width: it is 6.43em wide at this
     tracking, so the size is the measure divided by a little more than that. */
  .hero-name {
    --gutter: 0.75rem;
    font-size: min(calc((100vw - 2 * var(--gutter)) / 6.5), 15.5rem);
    line-height: 0.82;
    letter-spacing: -0.05em;
    white-space: nowrap;
    text-align: center;
    padding: 0.06em 0 0.05em;
  }
  @media (width >= 40rem) {
    .hero-name {
      --gutter: 1.5rem;
    }
  }
  @media (width >= 64rem) {
    .hero-name {
      --gutter: 3rem;
    }
  }
</style>

<script>
  import { smoothstep } from "../lib/easing";
  import { docTop, onLayoutChange } from "../lib/layout-watch";

  // Fades each [data-hero-fade] element out as it nears the top of the
  // viewport, and back in as it returns — a pure function of live position,
  // so reversing scroll direction reverses the fade with no extra state.
  // Progress is how far up the screen the element's top has travelled (0 at
  // the bottom edge, 1 at the top edge); the fade window sits right before
  // the element would exit, so it's fully gone just ahead of leaving.
  const FADE_START = 0.8;
  const FADE_END = 0.95;

  const section = document.getElementById("hero");
  const fadeEls = section
    ? Array.from(section.querySelectorAll<HTMLElement>("[data-hero-fade]"))
    : [];

  if (
    fadeEls.length &&
    matchMedia("(prefers-reduced-motion: no-preference)").matches
  ) {
    // The elements move only with the page, so their document tops are
    // measured on layout changes and the frame is arithmetic (see
    // lib/layout-watch.ts). Each style is written only when it changes.
    const fades = fadeEls.map((el) => ({ el, top: 0, opacity: "" }));

    const update = (y = window.scrollY) => {
      const vh = window.innerHeight;
      for (const f of fades) {
        const progress = (vh - (f.top - y)) / vh;
        const raw = Math.min(
          1,
          Math.max(0, (progress - FADE_START) / (FADE_END - FADE_START)),
        );
        const opacity = (1 - smoothstep(raw)).toFixed(3);
        if (opacity === f.opacity) continue;
        f.opacity = opacity;
        f.el.style.opacity = opacity;
        f.el.style.pointerEvents = +opacity < 0.05 ? "none" : "";
      }
    };

    // Same-frame under the smooth-scroll engine, native-scroll fallback under
    // reduced motion — the shared bus (Layout head shim) handles both.
    (window as any).__onSmoothScrollTick(update);
    onLayoutChange(() => {
      for (const f of fades) f.top = docTop(f.el);
    }, update);
  }
</script>
