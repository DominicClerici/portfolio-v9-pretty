<section id="hero" class="relative h-svh min-h-[560px] bg-bone">
  <!-- Framed dark canvas — the bone gutter around it recesses on scroll -->
  <div class="hero-frame" aria-hidden="true">
    <div class="hero-canvas-wrap">
      <canvas id="hero-canvas"></canvas>
    </div>
  </div>

  <!-- Content -->
  <div class="relative z-10 h-full max-w-[1200px] mx-auto flex flex-col justify-between px-6 sm:px-8 md:px-10 pt-28 md:pt-36 pb-10 md:pb-14">
    <h1
      class="hero-enter-mask font-display font-normal text-paper leading-none tracking-[-0.03em] text-[clamp(3.25rem,9.5vw,6.9375rem)]"
    >
      <span>Dominic Clerici.</span>
    </h1>

    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-10 md:gap-6">
      <div class="max-w-[600px]">
        <div class="hero-enter flex items-center gap-2.5 mb-5" style="--enter-delay: 1.2s">
          <span class="w-[6px] h-[6px] rounded-full bg-bio-lime" aria-hidden="true"></span>
          <span class="font-mono text-[13px] leading-none tracking-[-0.02em] uppercase text-paper/60">
            Engineer &amp; Designer&ensp;·&ensp;New York
          </span>
        </div>
        <p
          class="hero-enter font-display font-normal text-paper/90 text-[20px] md:text-[24px] leading-[1.25] tracking-[-0.006em]"
          style="--enter-delay: 1.3s"
        >
          I design and build software that&rsquo;s fast, useful, and worth looking at.
        </p>
      </div>

      <div class="hero-enter flex items-center gap-3 shrink-0" style="--enter-delay: 1.45s">
        <a
          href="#work"
          class="font-mono text-[14px] tracking-[-0.008em] text-paper border border-paper/35 rounded-lg h-10 px-4 inline-flex items-center hover:border-paper transition-colors duration-200"
        >
          View selected work
        </a>
        <a
          href="#work"
          aria-label="Scroll to selected work"
          class="w-10 h-10 rounded-lg bg-bio-lime text-ink inline-flex items-center justify-center hover:translate-y-0.5 transition-transform duration-200"
        >
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M7 1v11M2 7.5 7 12.5 12 7.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  {
    const section = document.getElementById("hero")!;
    const frame = section.querySelector<HTMLElement>(".hero-frame")!;
    const wrap = section.querySelector<HTMLElement>(".hero-canvas-wrap")!;
    const canvas = document.getElementById("hero-canvas") as HTMLCanvasElement;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    /* ── Frame recess: gutter + radius collapse over the first ~40px of scroll ── */
    const RECESS_DISTANCE = 40;
    let recessQueued = false;
    function updateRecess() {
      recessQueued = false;
      const p = Math.min(window.scrollY / RECESS_DISTANCE, 1);
      frame.style.setProperty("--recess", p.toFixed(4));
    }
    window.addEventListener(
      "scroll",
      () => {
        if (!recessQueued) {
          recessQueued = true;
          requestAnimationFrame(updateRecess);
        }
      },
      { passive: true }
    );
    updateRecess();

    // Once the iris-open finishes, drop the clip so the frame's own radius
    // (which the recess animates to 0) is the only rounding in play.
    wrap.addEventListener("animationend", (e) => {
      if (e.animationName === "hero-iris-open") wrap.style.clipPath = "none";
    });

    /* ── Bioluminescent canvas ──
       Glowing motes drifting through a slow flow field on an abyssal
       ground, clustering around a wandering focal point. Mostly dim
       teal-green; a rationed few flash lime. */
    const ctx = canvas.getContext("2d")!;
    const DPR = Math.min(window.devicePixelRatio || 1, 1.75);

    let W = 0;
    let H = 0;

    type Mote = {
      x: number;
      y: number;
      vx: number;
      vy: number;
      z: number; // depth: 0.25 (far) → 1 (near)
      phase: number;
      pulse: number;
      lime: boolean;
    };
    let motes: Mote[] = [];

    function makeSprite(r: number, g: number, b: number) {
      const s = document.createElement("canvas");
      s.width = s.height = 64;
      const c = s.getContext("2d")!;
      // near-gaussian falloff — hard stops turn into visible rings once
      // trail accumulation amplifies them
      const grad = c.createRadialGradient(32, 32, 0, 32, 32, 32);
      grad.addColorStop(0, `rgba(${r},${g},${b},1)`);
      grad.addColorStop(0.18, `rgba(${r},${g},${b},0.62)`);
      grad.addColorStop(0.38, `rgba(${r},${g},${b},0.28)`);
      grad.addColorStop(0.6, `rgba(${r},${g},${b},0.1)`);
      grad.addColorStop(0.8, `rgba(${r},${g},${b},0.03)`);
      grad.addColorStop(1, `rgba(${r},${g},${b},0)`);
      c.fillStyle = grad;
      c.fillRect(0, 0, 64, 64);
      return s;
    }
    const tealSprite = makeSprite(126, 196, 176);
    const limeSprite = makeSprite(206, 247, 158);

    function seed() {
      const count = Math.round(Math.min(220, Math.max(80, (W * H) / 9500)));
      motes = Array.from({ length: count }, () => ({
        x: Math.random() * W,
        y: Math.random() * H,
        vx: 0,
        vy: 0,
        z: 0.25 + Math.random() * 0.75,
        phase: Math.random() * Math.PI * 2,
        pulse: 0.5 + Math.random() * 1.2,
        lime: Math.random() < 0.09,
      }));
    }

    function resize() {
      const rect = wrap.getBoundingClientRect();
      W = Math.max(1, Math.round(rect.width));
      H = Math.max(1, Math.round(rect.height));
      canvas.width = Math.round(W * DPR);
      canvas.height = Math.round(H * DPR);
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      seed();
      paintGround(1);
    }

    function paintGround(alpha: number) {
      ctx.globalCompositeOperation = "source-over";
      ctx.fillStyle = `rgba(17, 25, 24, ${alpha})`;
      ctx.fillRect(0, 0, W, H);
    }

    function flowAngle(x: number, y: number, t: number) {
      return (
        Math.sin(x * 0.0016 + t * 0.00019) * 1.9 +
        Math.cos(y * 0.0013 - t * 0.00023) * 1.7 +
        Math.sin((x + y) * 0.0005 + t * 0.00011) * 1.2
      );
    }

    function render(t: number) {
      // Trails: wash the previous frame down instead of clearing
      paintGround(0.16);
      ctx.globalCompositeOperation = "lighter";

      // Ambient breathing glows — drawn every frame into the trail buffer,
      // so their alpha accumulates to roughly drawAlpha / fadeAlpha. Keep
      // the per-frame value tiny.
      const g1 = Math.min(W, H);
      const ax = W * (0.62 + 0.1 * Math.sin(t * 0.00006));
      const ay = H * (0.45 + 0.12 * Math.cos(t * 0.00005));
      ctx.globalAlpha = 0.009 + 0.003 * Math.sin(t * 0.00012);
      ctx.drawImage(tealSprite, ax - g1 * 1.3, ay - g1 * 1.3, g1 * 2.6, g1 * 2.6);
      const bx = W * (0.2 + 0.08 * Math.cos(t * 0.00004));
      const by = H * (0.75 + 0.08 * Math.sin(t * 0.00007));
      ctx.globalAlpha = 0.006;
      ctx.drawImage(limeSprite, bx - g1, by - g1, g1 * 2, g1 * 2);

      // Wandering focal point the motes loosely school around
      const fx = W * (0.55 + 0.28 * Math.sin(t * 0.00005));
      const fy = H * (0.5 + 0.26 * Math.sin(t * 0.000037 + 1.7));

      for (const m of motes) {
        const a = flowAngle(m.x, m.y, t);
        m.vx += Math.cos(a) * 0.011 * m.z;
        m.vy += Math.sin(a) * 0.011 * m.z;
        m.vx += (fx - m.x) * 0.0000045;
        m.vy += (fy - m.y) * 0.0000045;
        m.vx *= 0.985;
        m.vy *= 0.985;
        m.x += m.vx;
        m.y += m.vy;

        // wrap with a margin so glows don't pop at the edges
        if (m.x < -40) m.x = W + 40;
        if (m.x > W + 40) m.x = -40;
        if (m.y < -40) m.y = H + 40;
        if (m.y > H + 40) m.y = -40;

        const blink = 0.55 + 0.45 * Math.sin(t * 0.001 * m.pulse + m.phase);
        const alpha = (m.lime ? 0.42 : 0.26) * m.z * blink;
        const size = (m.lime ? 22 : 16) * m.z * (0.75 + 0.25 * blink);
        ctx.globalAlpha = alpha;
        ctx.drawImage(m.lime ? limeSprite : tealSprite, m.x - size / 2, m.y - size / 2, size, size);
      }

      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = "source-over";
    }

    let rafId: number | null = null;
    let running = false;
    function loop(t: number) {
      if (!running) return;
      render(t);
      rafId = requestAnimationFrame(loop);
    }
    function start() {
      if (running || reducedMotion) return;
      running = true;
      rafId = requestAnimationFrame(loop);
    }
    function stop() {
      running = false;
      if (rafId !== null) cancelAnimationFrame(rafId);
      rafId = null;
    }

    let resizeTimer: number | undefined;
    new ResizeObserver(() => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        resize();
        if (reducedMotion) staticFrame();
      }, 120);
    }).observe(wrap);
    resize();

    // A settled still of the same scene for reduced motion
    function staticFrame() {
      paintGround(1);
      for (let i = 0; i < 40; i++) render(i * 120);
      paintGround(0.35);
      render(5000);
    }

    if (reducedMotion) {
      staticFrame();
    } else {
      new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            entry.isIntersecting ? start() : stop();
          }
        },
        { threshold: 0 }
      ).observe(section);
      document.addEventListener("visibilitychange", () => {
        document.hidden ? stop() : start();
      });
      start();
    }
  }
</script>
