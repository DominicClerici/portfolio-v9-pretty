---
// "The Gallery": three works, hung and lit. A sticky viewport turns vertical
// scroll into a walk along a gallery wall — matted, framed screenshots over a
// plaster wall with a real floor line, a museum plaque beside each frame, and
// ghost numerals drifting at a slower parallax rate behind the art. A ruler
// meter runs along the bottom with a position marker and room counter.
// Progressive enhancement: the default layout is a vertical stack; JS adds
// .is-h on desktop (motion allowed) to enable the horizontal machinery.
const projects = [
  {
    index: "01",
    title: "Dispatch",
    tech: "Astro · TypeScript · AI pipelines",
    fact: "writes itself every morning",
    description:
      "The last 24 hours of tech news, compressed into a 10 minute read. Two decoupled AI pipelines research, triage, and write it; GitHub Actions runs the whole thing while I sleep.",
    image: "/photos/dispatch.webp",
    alt: "Dispatch project screenshot",
    stack: ["Astro", "TypeScript", "OpenAI API", "Tailwind", "Vercel"],
    websiteUrl: "https://dispatch.dominicclerici.com/",
    githubUrl: "https://github.com/DominicClerici/dispatch",
    featured: false,
  },
  {
    index: "02",
    title: "Meridian",
    tech: "Vanilla TypeScript · Extensions",
    fact: "0 npm dependencies",
    description:
      "A new-tab extension for Chrome and Firefox with zero npm dependencies. Eleven feature modules, a reactive storage layer, and a recommendation engine that never lets data leave the browser.",
    image: "/photos/meridian.webp",
    alt: "Meridian project screenshot",
    stack: ["TypeScript", "esbuild", "Chrome APIs", "Firefox Add-ons"],
    websiteUrl: "https://meridian.dominicclerici.com/",
    githubUrl: "https://github.com/DominicClerici/meridian",
    featured: false,
  },
  {
    index: "03",
    title: "Fuzzbox",
    tech: "Next.js · React Native",
    fact: "design system: Neon Riff",
    description:
      "The companion I wished I had when learning guitar. Place notes on an interactive fretboard and it explains the chord you found — the intervals, the theory, why it sounds the way it does.",
    image: "/photos/fuzzbox.webp",
    alt: "Fuzzbox project screenshot",
    stack: ["TypeScript", "Next.js", "React Native", "Prisma", "PostgreSQL"],
    websiteUrl: "https://fuzzbox.dominicclerici.com/",
    githubUrl: null,
    featured: true,
  },
];
---

<section class="wg3 relative" aria-label="Selected work">
  <div class="wg3-scope" data-scope>
    <div class="wg3-stage" data-stage>
      <div class="wg3-track" data-track>
        <!-- Room entrance -->
        <div class="wg3-panel wg3-intro flex flex-col justify-center">
          <p class="font-mono text-[11px] leading-none tracking-[0.28em] uppercase text-ink/45">
            03&hairsp;/&hairsp;04 &mdash; Selected Work
          </p>
          <h2
            class="font-display text-ink leading-[1.04] tracking-[-0.025em] mt-7 text-[clamp(2.5rem,5vw,4.5rem)] max-w-[13ch]"
          >
            Three works, hung and lit.
          </h2>
          <p class="wg3-walk font-mono text-[11px] leading-none tracking-[0.24em] uppercase text-ink/45 mt-10">
            scroll to walk the room <span class="wg3-walk-arrow inline-block" aria-hidden="true">&rarr;</span>
          </p>
        </div>

        {
          projects.map((project, i) => (
            <div class={`wg3-panel wg3-exhibit ${i % 2 === 1 ? "wg3-low" : ""}`} data-exhibit={i}>
              <span class="wg3-num font-display absolute select-none" aria-hidden="true">
                {project.index}
              </span>
              <div class="wg3-art relative">
                <figure class="wg3-frame m-0">
                  <img
                    src={project.image}
                    srcset={`${project.image} 1x, ${project.image.replace(".webp", "-2x.webp")} 2x`}
                    alt={project.alt}
                    class="block w-full aspect-[16/9] object-cover object-top"
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
                <span class="wg3-shadow absolute" aria-hidden="true" />
              </div>
              <aside class="wg3-plaque">
                <p class="font-mono text-[10px] leading-none tracking-[0.22em] uppercase text-ink/40">
                  No. {project.index}
                  {project.featured && <span class="text-ink/70">&nbsp;&middot;&nbsp;on loan &mdash; featured</span>}
                </p>
                <h3 class="font-headline font-medium text-ink text-[26px] leading-[1.1] tracking-[-0.01em] mt-4">
                  {project.title}
                </h3>
                <p class="font-mono text-[10.5px] leading-[1.6] tracking-[0.1em] uppercase text-ink/45 mt-2">
                  {project.tech}
                </p>
                <p class="font-body text-[13.5px] leading-[1.65] text-ink/65 mt-4">{project.description}</p>
                <p class="font-mono text-[9.5px] leading-[1.8] tracking-[0.1em] uppercase text-ink/40 mt-4">
                  materials: {project.stack.join(", ")}
                </p>
                <p class="font-mono text-[9.5px] leading-none tracking-[0.1em] uppercase text-ink/40 mt-1.5">
                  {project.fact}
                </p>
                <div class="flex items-center gap-5 mt-5">
                  <a
                    href={project.websiteUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="wg3-link font-mono text-[11px] leading-none tracking-[0.12em] uppercase text-ink"
                  >
                    Visit site&nbsp;&nearr;
                  </a>
                  {project.githubUrl && (
                    <a
                      href={project.githubUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="wg3-link font-mono text-[11px] leading-none tracking-[0.12em] uppercase text-ink/55"
                    >
                      GitHub
                    </a>
                  )}
                </div>
              </aside>
            </div>
          ))
        }

        <!-- Room exit -->
        <div class="wg3-panel wg3-outro flex flex-col justify-center items-start">
          <p class="font-headline italic text-ink/80 text-[clamp(1.5rem,2.6vw,2.25rem)] leading-[1.3] max-w-[24ch]">
            The rest of the collection lives on GitHub.
          </p>
          <a
            href="https://github.com/DominicClerici"
            target="_blank"
            rel="noopener noreferrer"
            class="wg3-btn font-mono text-[11px] leading-none tracking-[0.16em] uppercase text-ink px-5 py-4 mt-9"
          >
            more on github&nbsp;&nearr;
          </a>
          <p class="font-mono text-[10px] leading-none tracking-[0.22em] uppercase text-ink/35 mt-14">
            salle 03 &middot; selected work
          </p>
        </div>
      </div>

      <!-- Floor meter: ruler, position marker, room counter -->
      <div class="wg3-meter absolute bottom-0 left-0 right-0 items-center gap-6 px-8" aria-hidden="true">
        <p class="font-mono text-[10px] leading-none tracking-[0.22em] uppercase text-ink/40 whitespace-nowrap">
          salle 03 &mdash; selected work
        </p>
        <div class="wg3-ruler relative flex-1">
          <span class="wg3-ruler-mark absolute" data-mark></span>
        </div>
        <p class="font-mono text-[10px] leading-none tracking-[0.22em] uppercase text-ink/40 whitespace-nowrap">
          <span data-counter>01</span>&hairsp;/&hairsp;03
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .wg3 {
    overflow-x: clip;
    background: #f4f2ed;
  }

  /* ── Vertical fallback (mobile, no-JS, reduced motion) ── */
  .wg3-stage {
    position: relative;
    background: linear-gradient(to bottom, #f4f2ed 75.9%, #d9d5c8 76%, #eae7dd 76.1%);
  }

  .wg3-panel {
    padding: clamp(56px, 9vh, 110px) clamp(24px, 6vw, 64px);
    position: relative;
  }

  .wg3-exhibit {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .wg3-art {
    max-width: 720px;
  }

  .wg3-frame {
    border: 14px solid #35302a;
    outline: 1px solid rgba(20, 16, 12, 0.35);
    padding: clamp(12px, 1.8vw, 24px);
    background: #fcfbf7;
    box-shadow: 0 32px 60px -32px rgba(34, 47, 48, 0.55);
  }

  .wg3-shadow {
    left: 8%;
    right: 8%;
    bottom: -7vh;
    height: 26px;
    background: radial-gradient(50% 50% at 50% 50%, rgba(34, 47, 48, 0.22), transparent 72%);
    filter: blur(5px);
  }

  .wg3-plaque {
    width: min(100%, 320px);
    background: #fbfaf5;
    border: 1px solid rgba(34, 47, 48, 0.12);
    border-radius: 4px;
    padding: 26px 26px 28px;
    box-shadow: 0 12px 28px -20px rgba(34, 47, 48, 0.4);
  }

  /* Ghost numerals painted on the wall behind the art */
  .wg3-num {
    top: 4%;
    left: -0.06em;
    font-size: clamp(11rem, 34vh, 22rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(34, 47, 48, 0.13);
    z-index: 0;
    transform: translateX(calc(var(--shift, 0px) * 0.08));
    will-change: transform;
  }

  .wg3-art,
  .wg3-plaque {
    z-index: 1;
  }

  .wg3-meter {
    display: none;
  }

  .wg3-link {
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-size: 0% 1px;
    background-position: 0 100%;
    padding-bottom: 3px;
    transition:
      background-size 0.3s cubic-bezier(0.22, 1, 0.36, 1),
      color 0.2s ease;
  }

  .wg3-link:hover {
    background-size: 100% 1px;
    color: var(--color-ink);
  }

  .wg3-btn {
    border: 1px solid rgba(34, 47, 48, 0.4);
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .wg3-btn:hover {
    background: var(--color-ink);
    color: #f4f2ed;
  }

  .wg3-link:focus-visible,
  .wg3-btn:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .wg3-walk-arrow {
      animation: wg3-nudge 1.8s ease-in-out infinite;
    }

    @keyframes wg3-nudge {
      0%,
      100% {
        transform: translateX(0);
      }
      50% {
        transform: translateX(6px);
      }
    }
  }

  /* ── Horizontal machinery, enabled by JS on desktop ── */
  .wg3.is-h .wg3-scope {
    /* height set by script: 100vh + track overflow */
  }

  .wg3.is-h .wg3-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }

  .wg3.is-h .wg3-track {
    display: flex;
    align-items: stretch;
    height: 100%;
    width: max-content;
    will-change: transform;
  }

  .wg3.is-h .wg3-panel {
    flex: 0 0 auto;
    height: 100%;
    display: flex;
  }

  .wg3.is-h .wg3-intro {
    width: 58vw;
    padding-left: clamp(48px, 8vw, 120px);
  }

  .wg3.is-h .wg3-exhibit {
    width: max-content;
    flex-direction: row;
    align-items: center;
    gap: clamp(40px, 4vw, 72px);
    padding: 0 6vw;
  }

  .wg3.is-h .wg3-art {
    width: clamp(560px, 46vw, 760px);
    max-width: none;
    /* Hang the art so its shadow lands on the floor line */
    transform: translateY(-6vh);
  }

  .wg3.is-h .wg3-low .wg3-art {
    transform: translateY(-2vh);
  }

  .wg3.is-h .wg3-shadow {
    bottom: auto;
    top: calc(100% + 4vh);
  }

  .wg3.is-h .wg3-plaque {
    /* fixed width: min(100%, …) can't resolve against the max-content panel */
    width: 320px;
    align-self: center;
    transform: translateY(2vh);
  }

  .wg3.is-h .wg3-exhibit {
    position: relative;
  }

  .wg3.is-h .wg3-outro {
    width: 56vw;
    padding-right: clamp(48px, 8vw, 120px);
  }

  .wg3.is-h .wg3-meter {
    display: flex;
    height: 56px;
    background: linear-gradient(to top, rgba(234, 231, 221, 0.9), rgba(234, 231, 221, 0));
  }

  .wg3-ruler {
    height: 14px;
    background: repeating-linear-gradient(
      to right,
      rgba(34, 47, 48, 0.28) 0 1px,
      transparent 1px 12px
    );
    background-position: 0 bottom;
    background-size: 100% 7px;
    background-repeat: no-repeat;
  }

  .wg3-ruler-mark {
    top: -2px;
    bottom: -2px;
    width: 2px;
    background: var(--color-ink);
    left: calc(var(--pp, 0) * 100%);
  }
</style>

<script>
  {
    const section = document.querySelector<HTMLElement>(".wg3");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const desktop = window.matchMedia("(min-width: 1024px)");
    if (section && !reducedMotion) {
      const scope = section.querySelector<HTMLElement>("[data-scope]");
      const track = section.querySelector<HTMLElement>("[data-track]");
      const mark = section.querySelector<HTMLElement>("[data-mark]");
      const counter = section.querySelector<HTMLElement>("[data-counter]");
      const exhibits = Array.from(section.querySelectorAll<HTMLElement>("[data-exhibit]"));

      let maxX = 0;
      let ticking = false;

      const update = () => {
        ticking = false;
        if (!scope || !track || !section.classList.contains("is-h") || maxX <= 0) return;
        const rect = scope.getBoundingClientRect();
        if (!rect.height) return;
        const p = Math.min(1, Math.max(0, -rect.top / maxX));
        const shift = p * maxX;
        track.style.transform = `translate3d(${-shift.toFixed(1)}px, 0, 0)`;
        track.style.setProperty("--shift", `${shift.toFixed(1)}px`);
        if (mark) mark.style.left = `${(p * 100).toFixed(2)}%`;
        if (counter && exhibits.length) {
          const viewCenter = window.innerWidth / 2;
          let best = 0;
          let bestDist = Infinity;
          exhibits.forEach((ex, i) => {
            const center = ex.offsetLeft + ex.offsetWidth / 2 - shift;
            const dist = Math.abs(center - viewCenter);
            if (dist < bestDist) {
              bestDist = dist;
              best = i;
            }
          });
          counter.textContent = `0${best + 1}`;
        }
      };

      const recalc = () => {
        if (!scope || !track) return;
        if (desktop.matches) {
          section.classList.add("is-h");
          const width = track.scrollWidth;
          // Hidden variant panel (display: none) — nothing to measure
          if (!width) return;
          maxX = Math.max(0, width - window.innerWidth);
          scope.style.height = `${window.innerHeight + maxX}px`;
        } else {
          section.classList.remove("is-h");
          scope.style.height = "";
          track.style.transform = "";
          maxX = 0;
        }
        update();
      };

      const onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      };

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", recalc, { passive: true });
      desktop.addEventListener("change", recalc);
      recalc();
    }
  }
</script>
