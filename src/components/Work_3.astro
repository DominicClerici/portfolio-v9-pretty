---
// V3 — "The Fader": neumorphic, scroll-driven, big. The section pins for
// ~3 screens and scrolling drags a physical fader thumb down an inset
// groove — each third of the travel slides a build onto the stage. Cool
// porcelain instead of V2's warm clay: same molded logic, different slab.
// No clicking required (V4's best idea), though the groove's notches are
// buttons that jump the scroll.
const projects = [
  {
    index: "01",
    title: "Dispatch",
    tech: "Astro · TypeScript · AI pipelines",
    fact: "writes itself every morning",
    description:
      "The last 24 hours of tech news, compressed into a 10 minute read. Two decoupled AI pipelines research, triage, and write it; GitHub Actions runs the whole thing while I sleep.",
    image: "/photos/dispatch.webp",
    alt: "Dispatch project screenshot",
    stack: ["Astro", "TypeScript", "OpenAI API", "Tailwind", "Vercel"],
    websiteUrl: "https://dispatch.dominicclerici.com/",
    githubUrl: "https://github.com/DominicClerici/dispatch",
  },
  {
    index: "02",
    title: "Meridian",
    tech: "Vanilla TypeScript · Extensions",
    fact: "0 npm dependencies",
    description:
      "A new-tab extension for Chrome and Firefox with zero npm dependencies. Eleven feature modules, a reactive storage layer, and a recommendation engine that never lets data leave the browser.",
    image: "/photos/meridian.webp",
    alt: "Meridian project screenshot",
    stack: ["TypeScript", "esbuild", "Chrome APIs", "Firefox Add-ons"],
    websiteUrl: "https://meridian.dominicclerici.com/",
    githubUrl: "https://github.com/DominicClerici/meridian",
  },
  {
    index: "03",
    title: "Fuzzbox",
    tech: "Next.js · React Native",
    fact: "design system: Neon Riff",
    featured: true,
    description:
      "The companion I wished I had when learning guitar. Place notes on an interactive fretboard and it explains the chord you found — the intervals, the theory, why it sounds the way it does.",
    image: "/photos/fuzzbox.webp",
    alt: "Fuzzbox project screenshot",
    stack: ["TypeScript", "Next.js", "React Native", "Prisma", "PostgreSQL"],
    websiteUrl: "https://fuzzbox.dominicclerici.com/",
    githubUrl: null,
  },
];
---

<section class="wn3 relative" aria-label="Selected work">
  <!-- Desktop: the pinned fader rig -->
  <div class="hidden lg:block relative lg:h-[280vh]" data-rig>
    <div class="sticky top-0 h-screen overflow-hidden flex flex-col">
      <div class="max-w-[1524px] w-full mx-auto px-12 pt-12 flex items-center justify-between gap-4">
        <div class="flex items-center gap-4">
          <span class="wn3-pill font-mono text-[13px] leading-none tracking-[-0.02em] text-ink/60 rounded-full px-3.5 py-2">
            03&hairsp;/&hairsp;04
          </span>
          <span class="font-mono text-[13px] leading-none tracking-[-0.02em] uppercase text-ink/60">
            Selected Work
          </span>
          <span class="font-mono text-[13px] leading-none tracking-[-0.02em] text-ink/40 ml-4">
            scroll to slide the fader
          </span>
        </div>
        <a
          href="https://github.com/DominicClerici"
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-[13px] leading-none tracking-[-0.02em] text-ink/45 hover:text-ink transition-colors duration-200"
        >
          more on github&nbsp;&nearr;
        </a>
      </div>

      <div class="flex-1 min-h-0 max-w-[1524px] w-full mx-auto px-12 grid content-center">
        <div class="grid grid-cols-[96px_minmax(0,1fr)] gap-12 items-center">
          <!-- Fader -->
          <div class="flex flex-col items-center gap-5">
            <span class="wn3-engraved font-mono text-[11px] leading-none tracking-[0.08em] uppercase">sel</span>
            <div class="wn3-track relative w-[52px] h-[min(54vh,460px)] rounded-full" data-track>
              {
                projects.map((project, i) => (
                  <button
                    type="button"
                    class="wn3-notch absolute left-1/2 -translate-x-1/2 -translate-y-1/2 cursor-pointer"
                    style={`top: ${((i + 0.5) / projects.length) * 100}%;`}
                    data-notch={i}
                    aria-label={`Scroll to ${project.title}`}
                  />
                ))
              }
              <div class="wn3-thumb absolute left-1/2 top-0 w-[38px] h-[64px] rounded-full" data-thumb>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
              </div>
            </div>
            <span class="wn3-engraved font-mono text-[12px] leading-none tracking-[-0.02em] tabular-nums" data-progress>
              0%
            </span>
          </div>

          <!-- Stage -->
          <div class="grid grid-cols-[minmax(0,7fr)_minmax(0,5fr)] gap-14 items-center">
            <div class="wn3-plate rounded-[30px] p-5">
              <div class="wn3-well rounded-[20px] p-3">
                <div class="relative rounded-[12px] overflow-hidden aspect-[16/10] bg-ink/5">
                  {
                    projects.map((project, i) => (
                      <img
                        src={project.image}
                        srcset={`${project.image} 1x, ${project.image.replace(".webp", "-2x.webp")} 2x`}
                        alt={project.alt}
                        class="wn3-shot absolute inset-0 w-full h-full object-cover object-top"
                        data-shot={i}
                        data-on={i === 0 ? "" : undefined}
                        loading="lazy"
                        decoding="async"
                      />
                    ))
                  }
                </div>
              </div>
            </div>

            <div class="relative">
              {
                projects.map((project, i) => (
                  <div class="wn3-panel" data-panel={i} hidden={i !== 0}>
                    <span class="wn3-index font-display font-normal leading-none tracking-[-0.03em] block">
                      {project.index}
                    </span>
                    <div class="flex items-center gap-3 flex-wrap mt-3">
                      <h3 class="font-display font-normal leading-[0.98] tracking-[-0.02em] text-ink text-[clamp(2.25rem,3.2vw,3.25rem)]">
                        {project.title}
                      </h3>
                      {project.featured && (
                        <span class="font-mono text-[11px] leading-none tracking-[-0.02em] uppercase text-ink bg-bio-lime rounded-full px-2.5 py-1.5">
                          featured
                        </span>
                      )}
                    </div>
                    <p class="font-mono text-[13px] leading-none tracking-[-0.02em] uppercase text-ink/45 mt-4">
                      {project.tech}
                    </p>
                    <p class="font-display text-[16px] leading-[1.6] text-ink/60 max-w-[440px] mt-6">
                      {project.description}
                    </p>

                    <div class="flex flex-wrap gap-3 mt-7">
                      {project.stack.map((item) => (
                        <span class="wn3-chip font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/60 rounded-full px-3.5 py-2.5">
                          {item}
                        </span>
                      ))}
                    </div>

                    <div class="flex items-center gap-4 mt-9">
                      <a
                        href={project.websiteUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="wn3-btn font-mono text-[13px] tracking-[-0.008em] text-ink rounded-[14px] h-11 px-5 inline-flex items-center"
                      >
                        Visit site
                      </a>
                      {project.githubUrl && (
                        <a
                          href={project.githubUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="font-mono text-[13px] tracking-[-0.008em] text-ink/55 h-11 px-2 inline-flex items-center hover:text-ink transition-colors duration-200"
                        >
                          GitHub
                        </a>
                      )}
                      <a
                        href={project.websiteUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`Open ${project.title} in a new tab`}
                        class="wn3-btn wn3-btn-go w-11 h-11 rounded-[14px] text-ink inline-flex items-center justify-center"
                      >
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                          <path
                            d="M2 12 12 2M4.5 2H12v7.5"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      </a>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <p class="max-w-[1524px] w-full mx-auto px-12 pb-8 font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/35 text-right">
        the fader is load-bearing
      </p>
    </div>
  </div>

  <!-- Mobile: molded cards, no rig -->
  <div class="lg:hidden max-w-[1524px] mx-auto px-6 py-[clamp(96px,14vh,180px)]">
    <div class="flex items-center gap-4 mb-10">
      <span class="wn3-pill font-mono text-[13px] leading-none tracking-[-0.02em] text-ink/60 rounded-full px-3.5 py-2">
        03&hairsp;/&hairsp;04
      </span>
      <span class="font-mono text-[13px] leading-none tracking-[-0.02em] uppercase text-ink/60">
        Selected Work
      </span>
    </div>

    <p
      class="font-display font-normal text-ink leading-[1.2] tracking-[-0.006em] text-[clamp(1.625rem,calc(1.625rem+(100vw-27.5rem)*0.02),2.625rem)] mb-12"
    >
      Three builds, brought to eye level&nbsp;&mdash;
      <span class="text-ink/55">one shelf at a time.</span>
    </p>

    <div class="flex flex-col gap-10">
      {
        projects.map((project) => (
          <article class="wn3-plate rounded-[26px] p-5">
            <div class="wn3-well rounded-[18px] p-2.5">
              <img
                src={project.image}
                srcset={`${project.image} 1x, ${project.image.replace(".webp", "-2x.webp")} 2x`}
                alt={project.alt}
                class="w-full aspect-[16/10] object-cover object-top rounded-[10px]"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="p-2 pt-6">
              <div class="flex items-center gap-3 flex-wrap">
                <h3 class="font-display font-normal leading-[1] tracking-[-0.018em] text-ink text-[clamp(1.75rem,calc(1.75rem+(100vw-27.5rem)*0.014),2.5rem)]">
                  {project.title}
                </h3>
                {project.featured && (
                  <span class="font-mono text-[11px] leading-none tracking-[-0.02em] uppercase text-ink bg-bio-lime rounded-full px-2.5 py-1.5">
                    featured
                  </span>
                )}
              </div>
              <p class="font-mono text-[12px] leading-none tracking-[-0.02em] uppercase text-ink/45 mt-3.5">
                {project.tech}
              </p>
              <p class="font-display text-[15px] leading-[1.6] text-ink/60 mt-5">{project.description}</p>

              <div class="flex flex-wrap gap-3 mt-6">
                {project.stack.map((item) => (
                  <span class="wn3-chip font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/60 rounded-full px-3.5 py-2.5">
                    {item}
                  </span>
                ))}
              </div>

              <div class="flex items-center gap-4 mt-8">
                <a
                  href={project.websiteUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="wn3-btn font-mono text-[13px] tracking-[-0.008em] text-ink rounded-[14px] h-11 px-5 inline-flex items-center"
                >
                  Visit site
                </a>
                {project.githubUrl && (
                  <a
                    href={project.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-mono text-[13px] tracking-[-0.008em] text-ink/55 h-11 px-2 inline-flex items-center hover:text-ink transition-colors duration-200"
                  >
                    GitHub
                  </a>
                )}
                <a
                  href={project.websiteUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Open ${project.title} in a new tab`}
                  class="wn3-btn wn3-btn-go w-11 h-11 rounded-[14px] text-ink inline-flex items-center justify-center ml-auto"
                >
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path
                      d="M2 12 12 2M4.5 2H12v7.5"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Cool porcelain — V2's molded logic on a different slab */
  .wn3 {
    --por: #e7eaee;
    --por-dark: rgba(155, 166, 180, 0.55);
    --por-darker: rgba(155, 166, 180, 0.75);
    --por-light: rgba(255, 255, 255, 0.95);
    background: var(--por);
  }

  .wn3-pill {
    box-shadow:
      inset 3px 3px 6px var(--por-dark),
      inset -3px -3px 6px var(--por-light);
  }

  .wn3-plate {
    background: var(--por);
    box-shadow:
      12px 12px 28px var(--por-dark),
      -12px -12px 28px var(--por-light);
  }

  .wn3-well {
    background: var(--por);
    box-shadow:
      inset 8px 8px 18px var(--por-dark),
      inset -8px -8px 18px var(--por-light);
  }

  /* ── The fader ── */
  .wn3-track {
    background: var(--por);
    box-shadow:
      inset 6px 6px 14px var(--por-darker),
      inset -6px -6px 14px var(--por-light);
  }

  .wn3-notch {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--por);
    box-shadow:
      inset 2px 2px 3px var(--por-darker),
      inset -2px -2px 3px var(--por-light);
  }

  .wn3-notch:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }

  .wn3-thumb {
    background: var(--por);
    margin-left: -19px; /* centers the 38px thumb on the groove */
    box-shadow:
      6px 6px 14px var(--por-darker),
      -6px -6px 14px var(--por-light),
      inset 0 1px 0 rgba(255, 255, 255, 0.7);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    will-change: transform;
  }

  /* Grip ridges; the middle one is the lime index line */
  .wn3-thumb span {
    width: 16px;
    height: 2px;
    border-radius: 999px;
    background: var(--por-darker);
  }

  .wn3-thumb span:nth-child(2) {
    background: var(--color-bio-lime);
    box-shadow: 0 0 8px 1px rgba(206, 247, 158, 0.9);
    height: 3px;
  }

  .wn3-engraved {
    color: rgba(34, 47, 48, 0.45);
    text-shadow: 1px 1px 0 rgba(255, 255, 255, 0.85);
  }

  /* Giant engraved index behind the title */
  .wn3-index {
    font-size: clamp(4rem, 6vw, 6rem);
    color: transparent;
    background: linear-gradient(145deg, rgba(155, 166, 180, 0.5), rgba(255, 255, 255, 0.9));
    -webkit-background-clip: text;
    background-clip: text;
  }

  /* ── Stage swaps ── */
  .wn3-shot {
    opacity: 0;
    transform: translateY(3%);
  }

  .wn3-shot[data-on] {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: no-preference) {
    .wn3-shot {
      transition:
        opacity 0.45s ease,
        transform 0.45s ease;
    }

    .wn3-panel {
      animation: wn3-rise 0.45s cubic-bezier(0.33, 1, 0.68, 1) both;
    }
  }

  @keyframes wn3-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  /* ── Chips & buttons (same molding as V2, cooler slab) ── */
  .wn3-chip {
    box-shadow:
      inset 3px 3px 7px var(--por-dark),
      inset -3px -3px 7px var(--por-light);
  }

  .wn3-btn {
    background: var(--por);
    box-shadow:
      6px 6px 14px var(--por-dark),
      -6px -6px 14px var(--por-light);
    transition:
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .wn3-btn:hover {
    transform: translateY(-1px);
  }

  .wn3-btn:active {
    transform: translateY(0);
    box-shadow:
      inset 4px 4px 10px var(--por-dark),
      inset -4px -4px 10px var(--por-light);
  }

  .wn3-btn:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }

  .wn3-btn-go {
    background: var(--color-bio-lime);
    box-shadow:
      6px 6px 14px var(--por-dark),
      -6px -6px 14px var(--por-light),
      inset 0 1px 0 rgba(255, 255, 255, 0.6);
  }

  .wn3-btn-go:active {
    box-shadow:
      inset 4px 4px 10px rgba(120, 150, 70, 0.5),
      inset -2px -2px 6px rgba(255, 255, 255, 0.6);
  }
</style>

<script>
  {
    const section = document.querySelector<HTMLElement>(".wn3");
    if (section) {
      const rig = section.querySelector<HTMLElement>("[data-rig]");
      const track = section.querySelector<HTMLElement>("[data-track]");
      const thumb = section.querySelector<HTMLElement>("[data-thumb]");
      const progress = section.querySelector<HTMLElement>("[data-progress]");
      const shots = section.querySelectorAll<HTMLElement>("[data-shot]");
      const panels = section.querySelectorAll<HTMLElement>("[data-panel]");
      const notches = section.querySelectorAll<HTMLButtonElement>("[data-notch]");
      const count = shots.length;

      let currentIdx = 0;

      const select = (idx: number) => {
        if (idx === currentIdx) return;
        currentIdx = idx;
        const id = String(idx);
        shots.forEach((shot) => {
          if (shot.dataset.shot === id) shot.setAttribute("data-on", "");
          else shot.removeAttribute("data-on");
        });
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.panel !== id;
        });
      };

      let ticking = false;

      const update = () => {
        ticking = false;
        if (!rig || !track || !thumb) return;
        const rect = rig.getBoundingClientRect();
        // Hidden variant panel (display: none) or mobile layout — nothing to drive
        if (!rect.height) return;
        const range = rect.height - window.innerHeight;
        if (range <= 0) return;
        const p = Math.min(1, Math.max(0, -rect.top / range));
        const travel = track.clientHeight - thumb.offsetHeight;
        thumb.style.transform = `translateY(${(p * travel).toFixed(1)}px)`;
        if (progress) progress.textContent = `${Math.round(p * 100)}%`;
        select(Math.min(count - 1, Math.floor(p * count)));
      };

      const onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      };

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
      update();

      // Notches jump the page scroll to the middle of that build's segment
      notches.forEach((notch) => {
        notch.addEventListener("click", () => {
          if (!rig) return;
          const rect = rig.getBoundingClientRect();
          const range = rect.height - window.innerHeight;
          const i = Number(notch.dataset.notch);
          const top = window.scrollY + rect.top + range * ((i + 0.5) / count);
          window.scrollTo({ top, behavior: "smooth" });
        });
      });
    }
  }
</script>
