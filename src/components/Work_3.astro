---
// V3 — "The Courier": the green sphere from the hero rolls back in. A
// Canvas2D scene behind the cards draws a route through all three
// projects; as you scroll, the sphere travels the route, lighting up each
// station as it passes. Same palette, same sphere, no WebGL.
const projects = [
  {
    index: "01",
    title: "Dispatch",
    tech: "Astro · TypeScript · AI pipelines",
    fact: "writes itself every morning",
    description:
      "The last 24 hours of tech news, compressed into a 10 minute read. Two decoupled AI pipelines research, triage, and write it; GitHub Actions runs the whole thing while I sleep.",
    image: "/photos/dispatch.webp",
    alt: "Dispatch project screenshot",
    stack: ["Astro", "TypeScript", "OpenAI API", "Vercel"],
    websiteUrl: "https://dispatch.dominicclerici.com/",
    githubUrl: "https://github.com/DominicClerici/dispatch",
  },
  {
    index: "02",
    title: "Meridian",
    tech: "Vanilla TypeScript · Extensions",
    fact: "0 npm dependencies",
    description:
      "A new-tab extension for Chrome and Firefox with zero npm dependencies. Eleven feature modules, a reactive storage layer, and a recommendation engine that never lets data leave the browser.",
    image: "/photos/meridian.webp",
    alt: "Meridian project screenshot",
    stack: ["TypeScript", "esbuild", "Chrome APIs", "Firefox Add-ons"],
    websiteUrl: "https://meridian.dominicclerici.com/",
    githubUrl: "https://github.com/DominicClerici/meridian",
  },
  {
    index: "03",
    title: "Fuzzbox",
    tech: "Next.js · React Native",
    fact: "design system: Neon Riff",
    featured: true,
    description:
      "The companion I wished I had when learning guitar. Place notes on an interactive fretboard and it explains the chord you found — the intervals, the theory, why it sounds the way it does.",
    image: "/photos/fuzzbox.webp",
    alt: "Fuzzbox project screenshot",
    stack: ["TypeScript", "Next.js", "React Native", "PostgreSQL"],
    websiteUrl: "https://fuzzbox.dominicclerici.com/",
    githubUrl: null,
  },
];

const placements = [
  "lg:col-start-1 lg:col-end-7",
  "lg:col-start-7 lg:col-end-13",
  "lg:col-start-1 lg:col-end-7",
];
---

<section class="cr3 relative bg-bone overflow-hidden" aria-label="Selected work">
  <canvas class="cr3-canvas absolute inset-0 w-full h-full pointer-events-none" data-courier-canvas aria-hidden="true"
  ></canvas>

  <div class="relative max-w-[1400px] mx-auto px-6 lg:px-12 py-[clamp(96px,14vh,180px)]">
    <div class="flex items-center justify-between gap-4 mb-10 lg:mb-14">
      <div class="flex items-center gap-4">
        <span
          class="font-mono text-[13px] leading-none tracking-[-0.02em] text-ink/60 border border-ink/30 rounded-full px-3.5 py-2"
        >
          03&hairsp;/&hairsp;04
        </span>
        <span class="font-mono text-[13px] leading-none tracking-[-0.02em] uppercase text-ink/60">
          Selected Work
        </span>
      </div>
      <a
        href="https://github.com/DominicClerici"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex font-mono text-[13px] leading-none tracking-[-0.02em] text-ink/45 hover:text-ink transition-colors duration-200"
      >
        more on github&nbsp;&nearr;
      </a>
    </div>

    <p
      class="font-display font-normal text-ink leading-[1.2] tracking-[-0.006em] max-w-[880px] text-[clamp(1.625rem,calc(1.625rem+(100vw-27.5rem)*0.02),2.625rem)] mb-16 lg:mb-32"
    >
      The sphere from upstairs makes deliveries&nbsp;&mdash;
      <span class="text-ink/55">scroll, and it walks the route.</span>
    </p>

    <div class="pl-9 sm:pl-12 lg:pl-0 flex flex-col gap-y-20 lg:gap-y-40 lg:grid lg:grid-cols-12">
      {
        projects.map((project, i) => (
          <article class:list={["cr3-station relative", placements[i]]} data-station={i}>
            <span
              class:list={[
                "cr3-node absolute top-12 -left-9 sm:-left-12",
                i % 2 === 0 ? "lg:-right-16 lg:left-auto" : "lg:-left-16",
              ]}
              data-node={i}
              aria-hidden="true"
            />

            <div class="cr3-card bg-paper rounded-[20px] border border-ink/10 overflow-hidden">
              <div class="p-4 sm:p-5 pb-0">
                <img
                  src={project.image}
                  srcset={`${project.image} 1x, ${project.image.replace(".webp", "-2x.webp")} 2x`}
                  alt={project.alt}
                  class="w-full aspect-[16/10] object-cover object-top rounded-[12px] border border-ink/10"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="p-6 sm:p-8">
                <div class="flex items-center gap-3 flex-wrap">
                  <span class="font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/45 border border-ink/20 rounded-full px-3 py-1.5">
                    stop&thinsp;{project.index}
                  </span>
                  {project.featured && (
                    <span class="font-mono text-[12px] leading-none tracking-[-0.02em] uppercase text-ink bg-bio-lime rounded-full px-3 py-1.5">
                      featured
                    </span>
                  )}
                  <span class="font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/40">
                    {project.fact}
                  </span>
                </div>

                <h3 class="font-display font-normal leading-[1] tracking-[-0.018em] text-ink mt-5 text-[clamp(1.875rem,calc(1.875rem+(100vw-27.5rem)*0.014),2.625rem)]">
                  {project.title}
                </h3>
                <p class="font-mono text-[12px] leading-none tracking-[-0.02em] uppercase text-ink/45 mt-3.5">
                  {project.tech}
                </p>
                <p class="font-display text-[15px] lg:text-[16px] leading-[1.6] text-ink/60 mt-5">
                  {project.description}
                </p>

                <div class="flex flex-wrap gap-x-5 gap-y-2.5 mt-6">
                  {project.stack.map((item) => (
                    <span class="inline-flex items-center gap-2">
                      <span class="w-[5px] h-[5px] rounded-full bg-bio-lime" aria-hidden="true" />
                      <span class="font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/55">{item}</span>
                    </span>
                  ))}
                </div>

                <div class="flex items-center gap-3 mt-8">
                  <a
                    href={project.websiteUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-mono text-[13px] tracking-[-0.008em] text-ink border border-ink/30 rounded-lg h-10 px-4 inline-flex items-center hover:border-ink transition-colors duration-200"
                  >
                    Visit site
                  </a>
                  {project.githubUrl && (
                    <a
                      href={project.githubUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-mono text-[13px] tracking-[-0.008em] text-ink/60 rounded-lg h-10 px-4 inline-flex items-center hover:text-ink transition-colors duration-200"
                    >
                      GitHub
                    </a>
                  )}
                  <span class="cr3-stamp font-mono text-[11px] leading-none tracking-[-0.02em] text-ink/35 ml-auto">
                    awaiting delivery
                  </span>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <p class="font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/35 text-right mt-16">
      route length: 3 stops · courier: one (1) green sphere
    </p>
  </div>
</section>

<style>
  .cr3-node {
    width: 18px;
    height: 18px;
    border-radius: 999px;
    background: var(--color-paper);
    border: 1.5px solid rgba(34, 47, 48, 0.3);
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .cr3-station.cr3-lit .cr3-node {
    background: var(--color-bio-lime);
    border-color: var(--color-ink);
    box-shadow: 0 0 0 6px rgba(206, 247, 158, 0.35);
  }

  .cr3-card {
    box-shadow: 0 20px 44px -28px rgba(34, 47, 48, 0.3);
    transition:
      border-color 0.35s ease,
      box-shadow 0.35s ease,
      transform 0.35s ease;
  }

  .cr3-station.cr3-lit .cr3-card {
    border-color: rgba(34, 47, 48, 0.22);
    box-shadow: 0 28px 56px -28px rgba(34, 47, 48, 0.38);
  }

  @media (prefers-reduced-motion: no-preference) {
    .cr3-station .cr3-card {
      transform: translateY(14px);
    }

    .cr3-station.cr3-lit .cr3-card {
      transform: translateY(0);
    }
  }

  .cr3-stamp {
    transition: color 0.3s ease;
  }

  .cr3-station.cr3-lit .cr3-stamp {
    color: var(--color-ink);
  }

  .cr3-station.cr3-lit .cr3-stamp::after {
    content: " ✓";
  }
</style>

<script>
  {
    const section = document.querySelector<HTMLElement>(".cr3");
    const canvas = section?.querySelector<HTMLCanvasElement>("[data-courier-canvas]");

    if (section && canvas) {
      const ctx = canvas.getContext("2d")!;
      const stations = [...section.querySelectorAll<HTMLElement>("[data-station]")];
      const nodes = [...section.querySelectorAll<HTMLElement>("[data-node]")];
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      const SPHERE_R = 26;
      let dpr = 1;
      let pts: { x: number; y: number }[] = []; // sampled route, CSS px
      let lens: number[] = []; // cumulative arc length
      let nodeArc: number[] = []; // arc length at each station node
      let total = 1;
      let progress = 0; // drawn position, 0..1 of total length
      let target = 0;
      let rafId = 0;

      // Catmull-Rom through the node centers, sampled to a polyline
      const buildRoute = () => {
        const rect = section.getBoundingClientRect();
        if (!rect.width || !rect.height) return false;
        const anchors = nodes.map((n) => {
          const r = n.getBoundingClientRect();
          return { x: r.left - rect.left + r.width / 2, y: r.top - rect.top + r.height / 2 };
        });
        if (anchors.some((a) => !isFinite(a.x))) return false;

        const first = anchors[0];
        const last = anchors[anchors.length - 1];
        const raw = [
          { x: first.x + (rect.width * 0.5 - first.x) * 0.6, y: Math.max(first.y - 340, 90) },
          ...anchors,
          { x: last.x, y: Math.min(last.y + 260, rect.height - 60) },
        ];

        pts = [];
        const P = (i: number) => raw[Math.min(Math.max(i, 0), raw.length - 1)];
        for (let s = 0; s < raw.length - 1; s++) {
          const p0 = P(s - 1);
          const p1 = P(s);
          const p2 = P(s + 1);
          const p3 = P(s + 2);
          for (let t = 0; t < 40; t++) {
            const u = t / 40;
            const u2 = u * u;
            const u3 = u2 * u;
            pts.push({
              x:
                0.5 *
                (2 * p1.x + (-p0.x + p2.x) * u + (2 * p0.x - 5 * p1.x + 4 * p2.x - p3.x) * u2 + (-p0.x + 3 * p1.x - 3 * p2.x + p3.x) * u3),
              y:
                0.5 *
                (2 * p1.y + (-p0.y + p2.y) * u + (2 * p0.y - 5 * p1.y + 4 * p2.y - p3.y) * u2 + (-p0.y + 3 * p1.y - 3 * p2.y + p3.y) * u3),
            });
          }
        }
        pts.push(raw[raw.length - 1]);

        lens = [0];
        for (let i = 1; i < pts.length; i++) {
          lens.push(lens[i - 1] + Math.hypot(pts[i].x - pts[i - 1].x, pts[i].y - pts[i - 1].y));
        }
        total = lens[lens.length - 1] || 1;

        // arc position of each anchor = nearest sample
        nodeArc = anchors.map((a) => {
          let best = 0;
          let bd = Infinity;
          for (let i = 0; i < pts.length; i += 4) {
            const d = Math.hypot(pts[i].x - a.x, pts[i].y - a.y);
            if (d < bd) {
              bd = d;
              best = lens[i];
            }
          }
          return best;
        });
        return true;
      };

      const pointAt = (arc: number) => {
        let lo = 0;
        let hi = lens.length - 1;
        while (lo < hi) {
          const mid = (lo + hi) >> 1;
          if (lens[mid] < arc) lo = mid + 1;
          else hi = mid;
        }
        const i = Math.max(lo, 1);
        const seg = lens[i] - lens[i - 1] || 1;
        const f = (arc - lens[i - 1]) / seg;
        return {
          x: pts[i - 1].x + (pts[i].x - pts[i - 1].x) * f,
          y: pts[i - 1].y + (pts[i].y - pts[i - 1].y) * f,
        };
      };

      const draw = () => {
        const w = canvas.width / dpr;
        const h = canvas.height / dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.clearRect(0, 0, w, h);
        if (pts.length < 2) return;

        const arc = progress * total;

        // Base route — quiet dashed ink
        ctx.beginPath();
        pts.forEach((p, i) => (i ? ctx.lineTo(p.x, p.y) : ctx.moveTo(p.x, p.y)));
        ctx.setLineDash([2, 7]);
        ctx.strokeStyle = "rgba(34, 47, 48, 0.28)";
        ctx.lineWidth = 1.5;
        ctx.stroke();
        ctx.setLineDash([]);

        // Travelled portion — solid lime with a soft glow
        ctx.beginPath();
        let started = false;
        for (let i = 0; i < pts.length; i++) {
          if (lens[i] > arc) break;
          if (started) ctx.lineTo(pts[i].x, pts[i].y);
          else {
            ctx.moveTo(pts[i].x, pts[i].y);
            started = true;
          }
        }
        if (started) {
          const tip = pointAt(arc);
          ctx.lineTo(tip.x, tip.y);
          ctx.strokeStyle = "#b7ef7c";
          ctx.lineWidth = 3;
          ctx.lineCap = "round";
          ctx.shadowColor = "rgba(206, 247, 158, 0.9)";
          ctx.shadowBlur = 8;
          ctx.stroke();
          ctx.shadowBlur = 0;
        }

        // The courier itself — hero's green sphere, matcap-ish shading
        const s = pointAt(arc);

        const sh = ctx.createRadialGradient(s.x, s.y + SPHERE_R * 1.35, SPHERE_R * 0.1, s.x, s.y + SPHERE_R * 1.35, SPHERE_R * 1.5);
        sh.addColorStop(0, "rgba(34, 47, 48, 0.22)");
        sh.addColorStop(1, "rgba(34, 47, 48, 0)");
        ctx.fillStyle = sh;
        ctx.save();
        ctx.translate(s.x, s.y + SPHERE_R * 1.35);
        ctx.scale(1, 0.32);
        ctx.beginPath();
        ctx.arc(0, 0, SPHERE_R * 1.5, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();

        const g = ctx.createRadialGradient(
          s.x - SPHERE_R * 0.38,
          s.y - SPHERE_R * 0.42,
          SPHERE_R * 0.12,
          s.x,
          s.y,
          SPHERE_R,
        );
        g.addColorStop(0, "#d8fba4");
        g.addColorStop(0.35, "#6fe93c");
        g.addColorStop(0.75, "#16c50d");
        g.addColorStop(1, "#079400");
        ctx.beginPath();
        ctx.arc(s.x, s.y, SPHERE_R, 0, Math.PI * 2);
        ctx.fillStyle = g;
        ctx.fill();

        // bottom rim light, like the hero sphere's white lower edge
        ctx.save();
        ctx.beginPath();
        ctx.arc(s.x, s.y, SPHERE_R, 0, Math.PI * 2);
        ctx.clip();
        const rim = ctx.createRadialGradient(s.x, s.y + SPHERE_R * 0.9, SPHERE_R * 0.1, s.x, s.y + SPHERE_R * 0.7, SPHERE_R);
        rim.addColorStop(0, "rgba(255, 255, 255, 0.85)");
        rim.addColorStop(0.45, "rgba(255, 255, 255, 0.25)");
        rim.addColorStop(1, "rgba(255, 255, 255, 0)");
        ctx.fillStyle = rim;
        ctx.fillRect(s.x - SPHERE_R, s.y - SPHERE_R, SPHERE_R * 2, SPHERE_R * 2);
        ctx.restore();

        // stations light up as the courier passes
        stations.forEach((st, i) => {
          st.classList.toggle("cr3-lit", arc >= nodeArc[i] - 4);
        });
      };

      const tick = () => {
        progress += (target - progress) * 0.09;
        draw();
        if (Math.abs(target - progress) > 0.0008) rafId = requestAnimationFrame(tick);
        else {
          progress = target;
          draw();
          rafId = 0;
        }
      };

      const onScroll = () => {
        const rect = section.getBoundingClientRect();
        if (!rect.height) return;
        const focus = window.innerHeight * 0.62 - rect.top;
        const y0 = pts.length ? pts[0].y : 0;
        const y1 = pts.length ? pts[pts.length - 1].y : 1;
        target = Math.min(Math.max((focus - y0) / Math.max(y1 - y0, 1), 0), 1);
        if (reducedMotion) {
          progress = target;
          draw();
        } else if (!rafId) {
          rafId = requestAnimationFrame(tick);
        }
      };

      const measure = () => {
        const rect = section.getBoundingClientRect();
        if (!rect.width || !rect.height) return;
        dpr = Math.min(window.devicePixelRatio || 1, 1.75);
        canvas.width = Math.round(rect.width * dpr);
        canvas.height = Math.round(rect.height * dpr);
        if (buildRoute()) onScroll();
      };

      let resizeTimer: number | undefined;
      new ResizeObserver(() => {
        clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(measure, 120);
      }).observe(section);

      let listening = false;
      const listen = (on: boolean) => {
        if (on && !listening) {
          window.addEventListener("scroll", onScroll, { passive: true });
          listening = true;
          onScroll();
        } else if (!on && listening) {
          window.removeEventListener("scroll", onScroll);
          listening = false;
        }
      };

      new IntersectionObserver(
        (entries) => entries.forEach((entry) => listen(entry.isIntersecting)),
        { rootMargin: "200px 0px" },
      ).observe(section);

      measure();
    }
  }
</script>
