---
// V1 — "Read-along illumination": words light up sequentially on scroll,
// like a reading lamp moving across the line. Key words ignite in lime.
const quote =
  "The most disastrous thing that you can ever learn is your first programming language.";
const emphasis = new Set(["disastrous", "first", "programming", "language."]);
const words = quote.split(" ").map((w) => ({ w, hot: emphasis.has(w) }));
---

<section
  class="qv1 relative bg-[#0a0a0a] overflow-hidden py-[clamp(120px,18vh,220px)] px-6 md:px-12"
  aria-label="Quote"
>
  <!-- Ghost opening quotation mark -->
  <div
    class="absolute -top-[0.16em] left-[1%] md:left-[5%] font-headline italic text-[clamp(14rem,30vw,28rem)] leading-none text-white/[0.045] select-none pointer-events-none"
    aria-hidden="true"
  >
    &ldquo;
  </div>

  <div class="relative max-w-4xl mx-auto text-center">
    <p class="font-mono text-[11px] md:text-xs uppercase tracking-[0.3em] text-white/40 mb-10 md:mb-16">
      An interlude &middot; on first languages
    </p>

    <blockquote
      class="font-headline italic text-[clamp(1.9rem,5.2vw,4.25rem)] leading-[1.16] text-[#f5f5f5]"
    >
      {words.map((word) => <span class="qv1-w" class:list={{ "qv1-hot": word.hot }}>{word.w + " "}</span>)}
    </blockquote>

    <div class="mt-10 md:mt-16 flex items-center justify-center gap-5">
      <span class="h-px w-10 md:w-16 bg-white/15" aria-hidden="true"></span>
      <cite class="font-mono not-italic text-[11px] md:text-sm uppercase tracking-[0.3em] text-bio-lime">
        Alan Kay
      </cite>
      <span class="h-px w-10 md:w-16 bg-white/15" aria-hidden="true"></span>
    </div>
  </div>

  <div class="absolute bottom-6 right-6 md:bottom-10 md:right-12">
    <p class="font-mono text-[10px] md:text-xs text-white/30 tracking-wide">
      &ldquo;Eh, maybe...&rdquo; &mdash; Dominic Clerici
    </p>
  </div>
</section>

<style>
  /* Dimmed state only applies once JS is running and motion is allowed,
     so no-JS and reduced-motion readers get the fully lit quote. */
  .qv1-js .qv1-w {
    color: rgba(245, 245, 245, 0.14);
    transition: color 0.5s ease, text-shadow 0.5s ease;
  }
  .qv1-js .qv1-hot {
    color: rgba(206, 247, 158, 0.16);
  }
  .qv1-js .qv1-w[data-lit] {
    color: #f5f5f5;
  }
  .qv1-js .qv1-hot[data-lit] {
    color: var(--color-bio-lime);
    text-shadow: 0 0 28px rgba(206, 247, 158, 0.28);
  }
  .qv1-hot {
    color: var(--color-bio-lime);
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>(".qv1");
  const motionOK = matchMedia("(prefers-reduced-motion: no-preference)").matches;

  if (section && motionOK) {
    section.classList.add("qv1-js");
    const words = [...section.querySelectorAll<HTMLElement>(".qv1-w")];
    let ticking = false;

    const update = () => {
      ticking = false;
      const r = section.getBoundingClientRect();
      const vh = innerHeight;
      // Illumination sweeps while the section travels the middle of the viewport
      const p = Math.min(1, Math.max(0, (vh * 0.92 - r.top) / Math.min(r.height, vh * 0.72)));
      const lit = Math.round(p * words.length);
      words.forEach((w, i) => w.toggleAttribute("data-lit", i < lit));
    };

    addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true }
    );
    addEventListener("resize", update, { passive: true });
    update();
  }
</script>
