---
// V1 — "The Seam": V2's strata pile, re-cut so the rock shows its minerals.
// Same sticky slabs and cover mechanic, but the backdrop is a quiet
// instrument wall: a giant recessed dial buried past the top-right corner
// sweeps with total scroll, a core-sample plumb line fills down the left
// gutter, and each build carries its own mineral color (lime, indigo, neon)
// through hairlines, numerals, and a glow that bleeds past the card edges
// as it seats. Porcelain stays porcelain — the color lives in the seams.
const projects = [
  {
    index: "01",
    title: "Dispatch",
    tech: "Astro · TypeScript · AI pipelines",
    fact: "writes itself every morning",
    description:
      "The last 24 hours of tech news, compressed into a 10 minute read. Two decoupled AI pipelines research, triage, and write it; GitHub Actions runs the whole thing while I sleep.",
    image: "/photos/dispatch.webp",
    alt: "Dispatch project screenshot",
    stack: ["Astro", "TypeScript", "OpenAI API", "Tailwind", "Vercel"],
    websiteUrl: "https://dispatch.dominicclerici.com/",
    githubUrl: "https://github.com/DominicClerici/dispatch",
  },
  {
    index: "02",
    title: "Meridian",
    tech: "Vanilla TypeScript · Extensions",
    fact: "0 npm dependencies",
    description:
      "A new-tab extension for Chrome and Firefox with zero npm dependencies. Eleven feature modules, a reactive storage layer, and a recommendation engine that never lets data leave the browser.",
    image: "/photos/meridian.webp",
    alt: "Meridian project screenshot",
    stack: ["TypeScript", "esbuild", "Chrome APIs", "Firefox Add-ons"],
    websiteUrl: "https://meridian.dominicclerici.com/",
    githubUrl: "https://github.com/DominicClerici/meridian",
  },
  {
    index: "03",
    title: "Fuzzbox",
    tech: "Next.js · React Native",
    fact: "design system: Neon Riff",
    featured: true,
    description:
      "The companion I wished I had when learning guitar. Place notes on an interactive fretboard and it explains the chord you found — the intervals, the theory, why it sounds the way it does.",
    image: "/photos/fuzzbox.webp",
    alt: "Fuzzbox project screenshot",
    stack: ["TypeScript", "Next.js", "React Native", "Prisma", "PostgreSQL"],
    websiteUrl: "https://fuzzbox.dominicclerici.com/",
    githubUrl: null,
  },
];

// Stair offset per layer — mirrored by STICK_TOP/STICK_STEP in the script
const STICK_TOP = 88;
const STICK_STEP = 26;
---

<section class="wm1 relative" aria-label="Selected work">
  <div class="max-w-[1524px] mx-auto px-6 lg:px-12 pt-[clamp(96px,14vh,180px)]">
    <div class="flex items-center justify-between gap-4 mb-10 lg:mb-14">
      <div class="flex items-center gap-4">
        <span class="wm1-pill font-mono text-[13px] leading-none tracking-[-0.02em] text-ink/60 rounded-full px-3.5 py-2">
          03&hairsp;/&hairsp;04
        </span>
        <span class="font-mono text-[13px] leading-none tracking-[-0.02em] uppercase text-ink/60">
          Selected Work
        </span>
      </div>
      <a
        href="https://github.com/DominicClerici"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex font-mono text-[13px] leading-none tracking-[-0.02em] text-ink/45 hover:text-ink transition-colors duration-200"
      >
        more on github&nbsp;&nearr;
      </a>
    </div>

    <p
      class="font-display font-normal text-ink leading-[1.2] tracking-[-0.006em] max-w-[880px] text-[clamp(1.625rem,calc(1.625rem+(100vw-27.5rem)*0.02),2.625rem)] mb-4 lg:mb-6"
    >
      Three builds, laid down in strata&nbsp;&mdash;
      <span class="text-ink/55">follow the seam between them.</span>
    </p>
  </div>

  <!-- Desktop: the sticky pile over the instrument wall -->
  <div class="relative" data-zone>
    <!-- Instrument wall: scroll-lit accents buried behind the pile -->
    <div class="absolute inset-0 hidden lg:block pointer-events-none" aria-hidden="true">
      <div class="sticky top-0 h-screen overflow-hidden">
        <span class="wm1-glow wm1-glow-0 absolute inset-0"></span>
        <span class="wm1-glow wm1-glow-1 absolute inset-0"></span>
        <span class="wm1-glow wm1-glow-2 absolute inset-0"></span>

        <div class="wm1-dial absolute rounded-full">
          <span class="wm1-arc wm1-arc-0 absolute rounded-full"></span>
          <span class="wm1-arc wm1-arc-1 absolute rounded-full"></span>
          <span class="wm1-arc wm1-arc-2 absolute rounded-full"></span>
        </div>

        <div class="wm1-plumb absolute rounded-full">
          <span class="wm1-plumb-fill absolute"></span>
          {
            projects.map((_, i) => (
              <span
                class={`wm1-plumb-dot wm1-pd-${i} absolute rounded-full`}
                style={`top: ${(((i + 0.5) / projects.length) * 100).toFixed(2)}%;`}
              />
            ))
          }
        </div>
      </div>
    </div>

    <div class="hidden lg:block max-w-[1360px] mx-auto px-16 xl:px-20 pb-24 relative z-[1]" data-pile>
      {
        projects.map((project, i) => (
          <div class="wm1-layer" data-layer={i}>
            <article
              class="wm1-card relative rounded-[36px] p-8 xl:p-10 overflow-hidden"
              data-card={i}
              style={`--i: ${i}; top: ${STICK_TOP + i * STICK_STEP}px;`}
            >
              <span class="wm1-hair absolute top-0 left-[8%] right-[8%]" aria-hidden="true" />
              <span class={`wm1-hairp wm1-hp-${i} absolute top-0 left-[8%] right-[8%]`} aria-hidden="true" />

              <div class="grid grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-14 items-center">
                <div class={i % 2 === 1 ? "order-last" : ""}>
                  <span
                    class={`wm1-num wm1-np-${i} font-display font-normal leading-[0.85] tracking-[-0.04em] block text-[clamp(5rem,8vw,8rem)]`}
                  >
                    {project.index}
                  </span>
                  <div class="flex items-center gap-3 flex-wrap mt-5">
                    <h3 class="font-display font-normal leading-[0.98] tracking-[-0.02em] text-ink text-[clamp(2rem,2.6vw,2.75rem)]">
                      {project.title}
                    </h3>
                    {project.featured && (
                      <span class="wm1-feat font-mono text-[11px] leading-none tracking-[-0.02em] uppercase text-ink rounded-full px-2.5 py-1.5">
                        featured
                      </span>
                    )}
                  </div>
                  <p class="font-mono text-[12px] leading-none tracking-[-0.02em] uppercase text-ink/45 mt-4">
                    {project.tech}
                    <span class="text-ink/30 normal-case">&nbsp;&middot;&nbsp;{project.fact}</span>
                  </p>
                  <p class="font-display text-[15px] leading-[1.6] text-ink/60 max-w-[460px] mt-6">
                    {project.description}
                  </p>

                  <div class="flex flex-wrap gap-2.5 mt-7">
                    {project.stack.map((item) => (
                      <span class="wm1-chip font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/60 rounded-full px-3.5 py-2.5">
                        {item}
                      </span>
                    ))}
                  </div>

                  <div class="flex items-center gap-4 mt-9 max-w-[460px]">
                    <a
                      href={project.websiteUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="wm1-btn font-mono text-[13px] tracking-[-0.008em] text-ink rounded-[14px] h-11 px-5 inline-flex items-center"
                    >
                      Visit site
                    </a>
                    {project.githubUrl && (
                      <a
                        href={project.githubUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="font-mono text-[13px] tracking-[-0.008em] text-ink/55 h-11 px-2 inline-flex items-center hover:text-ink transition-colors duration-200"
                      >
                        GitHub
                      </a>
                    )}
                    <a
                      href={project.websiteUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`Open ${project.title} in a new tab`}
                      class="wm1-btn wm1-btn-go w-11 h-11 rounded-[14px] text-ink inline-flex items-center justify-center ml-auto"
                    >
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                        <path
                          d="M2 12 12 2M4.5 2H12v7.5"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </a>
                  </div>
                </div>

                <div class="wm1-well rounded-[24px] p-4">
                  <img
                    src={project.image}
                    srcset={`${project.image} 1x, ${project.image.replace(".webp", "-2x.webp")} 2x`}
                    alt={project.alt}
                    class="w-full aspect-[16/9] object-cover object-top rounded-[14px]"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </div>

              <span class="wm1-veil absolute inset-0 rounded-[inherit]" aria-hidden="true" />
            </article>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Mobile: molded cards, static mineral tints, no pile -->
  <div class="lg:hidden max-w-[1524px] mx-auto px-6 pb-[clamp(96px,14vh,180px)] pt-8">
    <div class="flex flex-col gap-10">
      {
        projects.map((project, i) => (
          <article class="wm1-card relative rounded-[26px] p-5 overflow-hidden">
            <span class={`wm1-hairp wm1-hm-${i} absolute top-0 left-[12%] right-[12%]`} aria-hidden="true" />
            <div class="wm1-well rounded-[18px] p-2.5">
              <img
                src={project.image}
                srcset={`${project.image} 1x, ${project.image.replace(".webp", "-2x.webp")} 2x`}
                alt={project.alt}
                class="w-full aspect-[16/10] object-cover object-top rounded-[10px]"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="p-2 pt-6">
              <div class="flex items-center gap-3 flex-wrap">
                <span class={`wm1-num wm1-np-${i} font-display font-normal leading-none tracking-[-0.03em] text-[2.25rem]`}>
                  {project.index}
                </span>
                <h3 class="font-display font-normal leading-[1] tracking-[-0.018em] text-ink text-[clamp(1.75rem,calc(1.75rem+(100vw-27.5rem)*0.014),2.5rem)]">
                  {project.title}
                </h3>
                {project.featured && (
                  <span class="wm1-feat font-mono text-[11px] leading-none tracking-[-0.02em] uppercase text-ink rounded-full px-2.5 py-1.5">
                    featured
                  </span>
                )}
              </div>
              <p class="font-mono text-[12px] leading-none tracking-[-0.02em] uppercase text-ink/45 mt-3.5">
                {project.tech}
              </p>
              <p class="font-display text-[15px] leading-[1.6] text-ink/60 mt-5">{project.description}</p>

              <div class="flex flex-wrap gap-3 mt-6">
                {project.stack.map((item) => (
                  <span class="wm1-chip font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/60 rounded-full px-3.5 py-2.5">
                    {item}
                  </span>
                ))}
              </div>

              <div class="flex items-center gap-4 mt-8">
                <a
                  href={project.websiteUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="wm1-btn font-mono text-[13px] tracking-[-0.008em] text-ink rounded-[14px] h-11 px-5 inline-flex items-center"
                >
                  Visit site
                </a>
                {project.githubUrl && (
                  <a
                    href={project.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-mono text-[13px] tracking-[-0.008em] text-ink/55 h-11 px-2 inline-flex items-center hover:text-ink transition-colors duration-200"
                  >
                    GitHub
                  </a>
                )}
                <a
                  href={project.websiteUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Open ${project.title} in a new tab`}
                  class="wm1-btn wm1-btn-go w-11 h-11 rounded-[14px] text-ink inline-flex items-center justify-center ml-auto"
                >
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path
                      d="M2 12 12 2M4.5 2H12v7.5"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <p
    class="max-w-[1524px] mx-auto px-6 lg:px-12 pb-12 font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/35 text-right"
  >
    assay report: lime, indigo, neon &mdash; all load-bearing
  </p>
</section>

<style>
  /* Cool porcelain; --w0/--w1/--w2 are per-build blend weights and --p is
     total pile progress, both set from scroll. Defaults read as "Dispatch
     seated, nothing scrolled" so the section renders sane without JS. */
  .wm1 {
    --por: #eaedf1;
    --por-dark: rgba(151, 163, 180, 0.55);
    --por-darker: rgba(151, 163, 180, 0.72);
    --por-light: rgba(255, 255, 255, 0.95);
    --grad: linear-gradient(120deg, #cef79e, #9fe8cf 48%, #9cc2ff);
    /* Mineral palettes: 0 dispatch lime, 1 meridian indigo, 2 fuzzbox neon */
    --pg0: linear-gradient(120deg, #d3f89f, #a5e85c);
    --pg1: linear-gradient(120deg, #7c8ff7, #a78bfa);
    --pg2: linear-gradient(120deg, #ff6ec7, #3ee8a7 52%, #4dc9ff);
    background: var(--por);
  }

  .wm1-pill {
    box-shadow:
      inset 3px 3px 6px var(--por-dark),
      inset -3px -3px 6px var(--por-light);
  }

  /* ── Layers (V2's pile, verbatim) ── */
  .wm1-layer {
    min-height: 100vh;
    display: flex;
    align-items: flex-start;
  }

  .wm1-card {
    position: sticky;
    width: 100%;
    background: var(--por);
    box-shadow:
      14px 14px 34px var(--por-dark),
      -14px -14px 34px var(--por-light);
    transform: scale(calc(1 - var(--cover, 0) * 0.05));
    transform-origin: 50% 0;
  }

  @media (max-width: 1023px) {
    .wm1-card {
      position: relative;
      top: auto !important;
      transform: none;
    }
  }

  .wm1-veil {
    background: var(--por);
    opacity: calc(var(--cover, 0) * 0.55);
    pointer-events: none;
  }

  /* ── Instrument wall ── */
  /* Mineral glow bleeding past the seated card's edges */
  .wm1-glow-0 {
    background: radial-gradient(58% 46% at 50% 56%, rgba(165, 232, 92, 0.3), transparent 72%);
    opacity: calc(var(--w0, 1) * 0.55);
  }

  .wm1-glow-1 {
    background: radial-gradient(58% 46% at 50% 56%, rgba(139, 124, 250, 0.28), transparent 72%);
    opacity: calc(var(--w1, 0) * 0.55);
  }

  .wm1-glow-2 {
    background:
      radial-gradient(44% 38% at 38% 60%, rgba(255, 110, 199, 0.24), transparent 70%),
      radial-gradient(44% 38% at 66% 48%, rgba(77, 201, 255, 0.24), transparent 70%);
    opacity: calc(var(--w2, 0) * 0.55);
  }

  /* The buried dial: a giant recessed disk past the top-right corner whose
     rim arc fills with total scroll, tinted toward the seated build */
  .wm1-dial {
    --dial: 86vmin;
    width: var(--dial);
    height: var(--dial);
    top: calc(var(--dial) * -0.3);
    right: calc(var(--dial) * -0.3);
    background: var(--por);
    box-shadow:
      inset 10px 10px 26px var(--por-darker),
      inset -10px -10px 26px var(--por-light);
  }

  .wm1-arc {
    inset: 3.5vmin;
    -webkit-mask: radial-gradient(closest-side, transparent calc(100% - 30px), #000 calc(100% - 29px));
    mask: radial-gradient(closest-side, transparent calc(100% - 30px), #000 calc(100% - 29px));
  }

  .wm1-arc-0 {
    background: conic-gradient(
      from 135deg,
      #d3f89f 0deg,
      #a5e85c calc(var(--p, 0) * 300deg),
      transparent calc(var(--p, 0) * 300deg)
    );
    opacity: var(--w0, 1);
  }

  .wm1-arc-1 {
    background: conic-gradient(
      from 135deg,
      #7c8ff7 0deg,
      #a78bfa calc(var(--p, 0) * 300deg),
      transparent calc(var(--p, 0) * 300deg)
    );
    opacity: var(--w1, 0);
  }

  .wm1-arc-2 {
    background: conic-gradient(
      from 135deg,
      #ff6ec7 0deg,
      #3ee8a7 calc(var(--p, 0) * 150deg),
      #4dc9ff calc(var(--p, 0) * 300deg),
      transparent calc(var(--p, 0) * 300deg)
    );
    opacity: var(--w2, 0);
  }

  /* The plumb line: a core sample down the left gutter — the fill is the
     full strata gradient, revealed top-down by total scroll */
  .wm1-plumb {
    left: max(15px, calc((100vw - 1524px) / 2 + 15px));
    top: 16vh;
    width: 6px;
    height: 68vh;
    background: var(--por);
    box-shadow:
      inset 2px 2px 4px var(--por-darker),
      inset -2px -2px 4px var(--por-light);
  }

  .wm1-plumb-fill {
    inset: 1px;
    border-radius: 999px;
    background: linear-gradient(
      to bottom,
      #a5e85c,
      #cef79e 20%,
      #7c8ff7 42%,
      #a78bfa 58%,
      #ff6ec7 82%,
      #4dc9ff
    );
    clip-path: inset(0 0 calc((1 - var(--p, 0)) * 100%) 0 round 999px);
  }

  .wm1-plumb-dot {
    left: 50%;
    width: 12px;
    height: 12px;
    transform: translate(-50%, -50%);
    background: var(--por);
    box-shadow:
      inset 2px 2px 3px var(--por-darker),
      inset -2px -2px 3px var(--por-light);
  }

  .wm1-plumb-dot::after {
    content: "";
    position: absolute;
    inset: 3px;
    border-radius: 999px;
  }

  .wm1-pd-0::after {
    background: #a5e85c;
    box-shadow: 0 0 8px 1px rgba(165, 232, 92, 0.9);
    opacity: var(--w0, 1);
  }

  .wm1-pd-1::after {
    background: #8b7cf8;
    box-shadow: 0 0 8px 1px rgba(139, 124, 250, 0.9);
    opacity: var(--w1, 0);
  }

  .wm1-pd-2::after {
    background: linear-gradient(135deg, #ff6ec7, #4dc9ff);
    box-shadow: 0 0 8px 1px rgba(255, 110, 199, 0.8);
    opacity: var(--w2, 0);
  }

  /* ── Hairlines: shared seam under a mineral overlay that lights as the
     build seats (mobile gets the static wm1-hm-* tints instead) ── */
  .wm1-hair,
  .wm1-hairp {
    height: 2px;
    border-radius: 999px;
  }

  .wm1-hair {
    background: var(--grad);
    opacity: 0.85;
  }

  .wm1-hp-0 {
    background: var(--pg0);
    opacity: calc(var(--w0, 1) * 0.95);
  }

  .wm1-hp-1 {
    background: var(--pg1);
    opacity: calc(var(--w1, 0) * 0.95);
  }

  .wm1-hp-2 {
    background: var(--pg2);
    opacity: calc(var(--w2, 0) * 0.95);
  }

  .wm1-hm-0 {
    background: var(--pg0);
    opacity: 0.9;
  }

  .wm1-hm-1 {
    background: var(--pg1);
    opacity: 0.9;
  }

  .wm1-hm-2 {
    background: var(--pg2);
    opacity: 0.9;
  }

  /* Gradient-clipped numeral in the build's own mineral */
  .wm1-num {
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: saturate(0.9) brightness(0.74);
  }

  .wm1-np-0 {
    background-image: var(--pg0);
  }

  .wm1-np-1 {
    background-image: var(--pg1);
  }

  .wm1-np-2 {
    background-image: var(--pg2);
  }

  /* Aurora well (V2's shared gradient — restraint lives here) */
  .wm1-well {
    background:
      radial-gradient(120% 90% at 10% 6%, rgba(206, 247, 158, 0.5), transparent 55%),
      radial-gradient(110% 90% at 90% 94%, rgba(156, 194, 255, 0.45), transparent 55%),
      radial-gradient(90% 80% at 88% 8%, rgba(159, 232, 207, 0.4), transparent 55%),
      var(--por);
    box-shadow:
      inset 8px 8px 18px var(--por-dark),
      inset -8px -8px 18px var(--por-light);
  }

  .wm1-well img {
    box-shadow: 0 10px 26px -14px rgba(34, 47, 48, 0.45);
  }

  /* ── Fittings ── */
  .wm1-feat {
    background: var(--grad);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.6);
  }

  .wm1-chip {
    box-shadow:
      inset 3px 3px 7px var(--por-dark),
      inset -3px -3px 7px var(--por-light);
  }

  .wm1-btn {
    background: var(--por);
    box-shadow:
      6px 6px 14px var(--por-dark),
      -6px -6px 14px var(--por-light);
    transition:
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .wm1-btn:hover {
    transform: translateY(-1px);
  }

  .wm1-btn:active {
    transform: translateY(0);
    box-shadow:
      inset 4px 4px 10px var(--por-dark),
      inset -4px -4px 10px var(--por-light);
  }

  .wm1-btn:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }

  .wm1-btn-go {
    background: var(--grad);
    box-shadow:
      6px 6px 14px var(--por-dark),
      -6px -6px 14px var(--por-light),
      inset 0 1px 0 rgba(255, 255, 255, 0.6);
  }

  .wm1-btn-go:active {
    box-shadow:
      inset 4px 4px 10px rgba(110, 150, 120, 0.5),
      inset -2px -2px 6px rgba(255, 255, 255, 0.6);
  }
</style>

<script>
  {
    const section = document.querySelector<HTMLElement>(".wm1");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (section && !reducedMotion) {
      const zone = section.querySelector<HTMLElement>("[data-zone]");
      const cards = Array.from(section.querySelectorAll<HTMLElement>("[data-card]"));

      // Must track the inline sticky tops: 88px base, 26px stair
      const STICK_TOP = 88;
      const STICK_STEP = 26;

      let ticking = false;

      const update = () => {
        ticking = false;
        if (!zone) return;
        const rect = zone.getBoundingClientRect();
        // Hidden variant panel (display: none) or mobile layout — nothing to drive
        if (!rect.height) return;

        // Total pile progress + per-build blend weights for the instruments
        const range = rect.height - window.innerHeight;
        if (range > 0) {
          const p = Math.min(1, Math.max(0, -rect.top / range));
          const s = p * (cards.length - 1);
          section.style.setProperty("--p", p.toFixed(4));
          for (let i = 0; i < cards.length; i++) {
            section.style.setProperty(`--w${i}`, Math.max(0, 1 - Math.abs(s - i)).toFixed(3));
          }
        }

        // i's cover is driven by how far card i+1 has climbed toward its
        // own sticky seat; the last card is never covered
        for (let i = 0; i < cards.length - 1; i++) {
          const next = cards[i + 1].getBoundingClientRect();
          const seat = STICK_TOP + (i + 1) * STICK_STEP;
          const cover = Math.min(1, Math.max(0, 1 - (next.top - seat) / (window.innerHeight - seat)));
          cards[i].style.setProperty("--cover", cover.toFixed(3));
        }
      };

      const onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      };

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
      update();
    }
  }
</script>
