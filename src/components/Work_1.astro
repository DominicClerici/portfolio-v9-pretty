---
// V1 — "The Dial": neumorphic, scroll-driven. The section pins and the
// scroll becomes torque — a machined rotary dial turns through 300° of
// throw while a lime→mint→sky gradient arc sweeps its groove (V4's
// gradients, given a job). Each third of the throw clicks a build onto
// the stage. Same cool porcelain as V3, same no-click ethos; the tick
// stops around the groove jump the scroll.
const projects = [
  {
    index: "01",
    title: "Dispatch",
    tech: "Astro · TypeScript · AI pipelines",
    fact: "writes itself every morning",
    description:
      "The last 24 hours of tech news, compressed into a 10 minute read. Two decoupled AI pipelines research, triage, and write it; GitHub Actions runs the whole thing while I sleep.",
    image: "/photos/dispatch.webp",
    alt: "Dispatch project screenshot",
    stack: ["Astro", "TypeScript", "OpenAI API", "Tailwind", "Vercel"],
    websiteUrl: "https://dispatch.dominicclerici.com/",
    githubUrl: "https://github.com/DominicClerici/dispatch",
  },
  {
    index: "02",
    title: "Meridian",
    tech: "Vanilla TypeScript · Extensions",
    fact: "0 npm dependencies",
    description:
      "A new-tab extension for Chrome and Firefox with zero npm dependencies. Eleven feature modules, a reactive storage layer, and a recommendation engine that never lets data leave the browser.",
    image: "/photos/meridian.webp",
    alt: "Meridian project screenshot",
    stack: ["TypeScript", "esbuild", "Chrome APIs", "Firefox Add-ons"],
    websiteUrl: "https://meridian.dominicclerici.com/",
    githubUrl: "https://github.com/DominicClerici/meridian",
  },
  {
    index: "03",
    title: "Fuzzbox",
    tech: "Next.js · React Native",
    fact: "design system: Neon Riff",
    featured: true,
    description:
      "The companion I wished I had when learning guitar. Place notes on an interactive fretboard and it explains the chord you found — the intervals, the theory, why it sounds the way it does.",
    image: "/photos/fuzzbox.webp",
    alt: "Fuzzbox project screenshot",
    stack: ["TypeScript", "Next.js", "React Native", "Prisma", "PostgreSQL"],
    websiteUrl: "https://fuzzbox.dominicclerici.com/",
    githubUrl: null,
  },
];

// Dial geometry — mirrored by the constants in the script
const START = -150;
const SWEEP = 300;
---

<section class="wd1 relative" aria-label="Selected work">
  <!-- Desktop: the pinned dial rig -->
  <div class="hidden lg:block relative lg:h-[300vh]" data-rig>
    <div class="sticky top-0 h-screen overflow-hidden flex flex-col">
      <div class="max-w-[1524px] w-full mx-auto px-12 pt-12 flex items-center justify-between gap-4">
        <div class="flex items-center gap-4">
          <span class="wd1-pill font-mono text-[13px] leading-none tracking-[-0.02em] text-ink/60 rounded-full px-3.5 py-2">
            03&hairsp;/&hairsp;04
          </span>
          <span class="font-mono text-[13px] leading-none tracking-[-0.02em] uppercase text-ink/60">
            Selected Work
          </span>
          <span class="font-mono text-[13px] leading-none tracking-[-0.02em] text-ink/40 ml-4">
            scroll to turn the dial
          </span>
        </div>
        <a
          href="https://github.com/DominicClerici"
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-[13px] leading-none tracking-[-0.02em] text-ink/45 hover:text-ink transition-colors duration-200"
        >
          more on github&nbsp;&nearr;
        </a>
      </div>

      <div class="flex-1 min-h-0 max-w-[1524px] w-full mx-auto px-12 grid content-center">
        <div class="grid grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-16 items-center">
          <!-- The dial -->
          <div class="flex flex-col items-center gap-7">
            <div class="wd1-dial relative rounded-full" data-dial>
              <div class="wd1-face absolute inset-0 rounded-full" aria-hidden="true"></div>
              <div class="wd1-arc absolute rounded-full" style="--f: 0deg;" data-arc aria-hidden="true"></div>
              {
                projects.map((project, i) => (
                  <button
                    type="button"
                    class="wd1-tick absolute left-1/2 top-1/2 cursor-pointer"
                    style={`--a: ${START + ((i + 0.5) / projects.length) * SWEEP}deg;`}
                    data-tick={i}
                    aria-label={`Scroll to ${project.title}`}
                  />
                ))
              }
              <div class="wd1-knob absolute rounded-full">
                <div class="wd1-rotor absolute inset-0" data-rotor aria-hidden="true">
                  <span class="wd1-pointer"></span>
                </div>
                <div class="absolute inset-0 flex flex-col items-center justify-center gap-3">
                  <span
                    class="wd1-readout font-display font-normal leading-none tracking-[-0.03em] text-[clamp(3rem,4.4vw,4.5rem)]"
                    data-idx
                  >
                    01
                  </span>
                  <span class="wd1-engraved font-mono text-[12px] leading-none tracking-[0.08em] uppercase" data-name>
                    dispatch
                  </span>
                </div>
              </div>
            </div>
            <span class="wd1-engraved font-mono text-[12px] leading-none tracking-[-0.02em] tabular-nums" data-progress>
              0% of throw
            </span>
          </div>

          <!-- The stage -->
          <div class="wd1-stage min-w-0">
            <div class="wd1-plate rounded-[30px] p-5">
              <div class="wd1-well rounded-[20px] p-3">
                <div class="relative rounded-[12px] overflow-hidden aspect-[16/8.4] bg-ink/5">
                  {
                    projects.map((project, i) => (
                      <img
                        src={project.image}
                        srcset={`${project.image} 1x, ${project.image.replace(".webp", "-2x.webp")} 2x`}
                        alt={project.alt}
                        class="wd1-shot absolute inset-0 w-full h-full object-cover object-top"
                        data-shot={i}
                        data-on={i === 0 ? "" : undefined}
                        loading="lazy"
                        decoding="async"
                      />
                    ))
                  }
                </div>
              </div>
            </div>

            <div class="relative mt-8">
              {
                projects.map((project, i) => (
                  <div class="wd1-panel" data-panel={i} hidden={i !== 0}>
                    <div class="grid grid-cols-[minmax(0,6fr)_minmax(0,5fr)] gap-10 items-start">
                      <div>
                        <div class="flex items-center gap-3 flex-wrap">
                          <h3 class="font-display font-normal leading-[0.98] tracking-[-0.02em] text-ink text-[clamp(1.875rem,2.4vw,2.5rem)]">
                            {project.title}
                          </h3>
                          {project.featured && (
                            <span class="wd1-feat font-mono text-[11px] leading-none tracking-[-0.02em] uppercase text-ink rounded-full px-2.5 py-1.5">
                              featured
                            </span>
                          )}
                        </div>
                        <p class="font-mono text-[12px] leading-none tracking-[-0.02em] uppercase text-ink/45 mt-3.5">
                          {project.tech}
                        </p>
                        <p class="font-display text-[15px] leading-[1.6] text-ink/60 mt-5">{project.description}</p>
                      </div>

                      <div>
                        <div class="flex flex-wrap gap-2.5">
                          {project.stack.map((item) => (
                            <span class="wd1-chip font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/60 rounded-full px-3.5 py-2.5">
                              {item}
                            </span>
                          ))}
                        </div>
                        <div class="flex items-center gap-4 mt-7">
                          <a
                            href={project.websiteUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="wd1-btn font-mono text-[13px] tracking-[-0.008em] text-ink rounded-[14px] h-11 px-5 inline-flex items-center"
                          >
                            Visit site
                          </a>
                          {project.githubUrl && (
                            <a
                              href={project.githubUrl}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="font-mono text-[13px] tracking-[-0.008em] text-ink/55 h-11 px-2 inline-flex items-center hover:text-ink transition-colors duration-200"
                            >
                              GitHub
                            </a>
                          )}
                          <a
                            href={project.websiteUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`Open ${project.title} in a new tab`}
                            class="wd1-btn wd1-btn-go w-11 h-11 rounded-[14px] text-ink inline-flex items-center justify-center ml-auto"
                          >
                            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                              <path
                                d="M2 12 12 2M4.5 2H12v7.5"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                              />
                            </svg>
                          </a>
                        </div>
                      </div>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>

      <p class="max-w-[1524px] w-full mx-auto px-12 pb-8 font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/35 text-right">
        calibrated at the factory &mdash; torque to taste
      </p>
    </div>
  </div>

  <!-- Mobile: molded cards, no rig -->
  <div class="lg:hidden max-w-[1524px] mx-auto px-6 py-[clamp(96px,14vh,180px)]">
    <div class="flex items-center gap-4 mb-10">
      <span class="wd1-pill font-mono text-[13px] leading-none tracking-[-0.02em] text-ink/60 rounded-full px-3.5 py-2">
        03&hairsp;/&hairsp;04
      </span>
      <span class="font-mono text-[13px] leading-none tracking-[-0.02em] uppercase text-ink/60">
        Selected Work
      </span>
    </div>

    <p
      class="font-display font-normal text-ink leading-[1.2] tracking-[-0.006em] text-[clamp(1.625rem,calc(1.625rem+(100vw-27.5rem)*0.02),2.625rem)] mb-12"
    >
      Three builds on one dial&nbsp;&mdash;
      <span class="text-ink/55">every stop is load-bearing.</span>
    </p>

    <div class="flex flex-col gap-10">
      {
        projects.map((project) => (
          <article class="wd1-plate relative rounded-[26px] p-5 overflow-hidden">
            <span class="wd1-hair absolute top-0 left-[12%] right-[12%]" aria-hidden="true" />
            <div class="wd1-well rounded-[18px] p-2.5">
              <img
                src={project.image}
                srcset={`${project.image} 1x, ${project.image.replace(".webp", "-2x.webp")} 2x`}
                alt={project.alt}
                class="w-full aspect-[16/10] object-cover object-top rounded-[10px]"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="p-2 pt-6">
              <div class="flex items-center gap-3 flex-wrap">
                <h3 class="font-display font-normal leading-[1] tracking-[-0.018em] text-ink text-[clamp(1.75rem,calc(1.75rem+(100vw-27.5rem)*0.014),2.5rem)]">
                  {project.title}
                </h3>
                {project.featured && (
                  <span class="wd1-feat font-mono text-[11px] leading-none tracking-[-0.02em] uppercase text-ink rounded-full px-2.5 py-1.5">
                    featured
                  </span>
                )}
              </div>
              <p class="font-mono text-[12px] leading-none tracking-[-0.02em] uppercase text-ink/45 mt-3.5">
                {project.tech}
              </p>
              <p class="font-display text-[15px] leading-[1.6] text-ink/60 mt-5">{project.description}</p>

              <div class="flex flex-wrap gap-3 mt-6">
                {project.stack.map((item) => (
                  <span class="wd1-chip font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/60 rounded-full px-3.5 py-2.5">
                    {item}
                  </span>
                ))}
              </div>

              <div class="flex items-center gap-4 mt-8">
                <a
                  href={project.websiteUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="wd1-btn font-mono text-[13px] tracking-[-0.008em] text-ink rounded-[14px] h-11 px-5 inline-flex items-center"
                >
                  Visit site
                </a>
                {project.githubUrl && (
                  <a
                    href={project.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-mono text-[13px] tracking-[-0.008em] text-ink/55 h-11 px-2 inline-flex items-center hover:text-ink transition-colors duration-200"
                  >
                    GitHub
                  </a>
                )}
                <a
                  href={project.websiteUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Open ${project.title} in a new tab`}
                  class="wd1-btn wd1-btn-go w-11 h-11 rounded-[14px] text-ink inline-flex items-center justify-center ml-auto"
                >
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path
                      d="M2 12 12 2M4.5 2H12v7.5"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Cool porcelain slab (V3's clean palette) + the gradient instrument */
  .wd1 {
    --por: #e9ecf1;
    --por-dark: rgba(150, 162, 179, 0.55);
    --por-darker: rgba(150, 162, 179, 0.75);
    --por-light: rgba(255, 255, 255, 0.95);
    --grad: linear-gradient(120deg, #cef79e, #9fe8cf 48%, #9cc2ff);
    background: var(--por);
  }

  .wd1-pill {
    box-shadow:
      inset 3px 3px 6px var(--por-dark),
      inset -3px -3px 6px var(--por-light);
  }

  /* ── The dial ── */
  .wd1-dial {
    --dial: clamp(300px, 30vw, 430px);
    width: var(--dial);
    height: var(--dial);
  }

  /* Recessed basin; the raised knob covers its middle so the visible
     margin reads as a groove */
  .wd1-face {
    background: var(--por);
    box-shadow:
      inset 8px 8px 20px var(--por-darker),
      inset -8px -8px 20px var(--por-light);
  }

  /* Gradient arc, masked to a ring riding the groove. --f is the filled
     sweep in degrees, set from scroll. */
  .wd1-arc {
    inset: 10px;
    background: conic-gradient(
      from -150deg,
      #cef79e 0deg,
      #9fe8cf calc(var(--f) * 0.5),
      #9cc2ff var(--f),
      transparent var(--f)
    );
    -webkit-mask: radial-gradient(closest-side, transparent calc(100% - 26px), #000 calc(100% - 25px));
    mask: radial-gradient(closest-side, transparent calc(100% - 26px), #000 calc(100% - 25px));
  }

  /* Tick stops sit in the groove, under the passing arc */
  .wd1-tick {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--por);
    box-shadow:
      inset 2px 2px 3px var(--por-darker),
      inset -2px -2px 3px var(--por-light);
    transform: translate(-50%, -50%) rotate(var(--a)) translateY(calc(var(--dial) * -0.445)) rotate(calc(var(--a) * -1));
  }

  .wd1-tick:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }

  .wd1-knob {
    inset: 13.5%;
    background: var(--por);
    box-shadow:
      10px 10px 26px var(--por-darker),
      -10px -10px 26px var(--por-light),
      inset 0 1px 0 rgba(255, 255, 255, 0.7);
  }

  .wd1-rotor {
    will-change: transform;
  }

  /* The needle: a gradient sliver at 12 o'clock on the rotor */
  .wd1-pointer {
    position: absolute;
    top: 9px;
    left: 50%;
    width: 4px;
    height: 24px;
    margin-left: -2px;
    border-radius: 999px;
    background: var(--grad);
    box-shadow: 0 0 10px 1px rgba(159, 232, 207, 0.9);
  }

  /* Engraved numeral, tinted by the gradient */
  .wd1-readout {
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: saturate(0.85) brightness(0.72);
  }

  .wd1-engraved {
    color: rgba(34, 47, 48, 0.45);
    text-shadow: 1px 1px 0 rgba(255, 255, 255, 0.85);
  }

  /* ── Stage ── */
  /* Width doubles as the height budget: keeps plate + spec inside the pin
     on short screens */
  .wd1-stage {
    max-width: min(820px, calc((100vh - 380px) * 1.9));
  }

  .wd1-plate {
    background: var(--por);
    box-shadow:
      12px 12px 28px var(--por-dark),
      -12px -12px 28px var(--por-light);
  }

  .wd1-well {
    background: var(--por);
    box-shadow:
      inset 8px 8px 18px var(--por-dark),
      inset -8px -8px 18px var(--por-light);
  }

  .wd1-shot {
    opacity: 0;
    transform: translateY(3%);
  }

  .wd1-shot[data-on] {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: no-preference) {
    .wd1-shot {
      transition:
        opacity 0.45s ease,
        transform 0.45s ease;
    }

    .wd1-panel {
      animation: wd1-rise 0.45s cubic-bezier(0.33, 1, 0.68, 1) both;
    }
  }

  @keyframes wd1-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  /* ── Fittings ── */
  .wd1-feat {
    background: var(--grad);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.6);
  }

  .wd1-hair {
    height: 2px;
    border-radius: 999px;
    background: var(--grad);
    opacity: 0.85;
  }

  .wd1-chip {
    box-shadow:
      inset 3px 3px 7px var(--por-dark),
      inset -3px -3px 7px var(--por-light);
  }

  .wd1-btn {
    background: var(--por);
    box-shadow:
      6px 6px 14px var(--por-dark),
      -6px -6px 14px var(--por-light);
    transition:
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .wd1-btn:hover {
    transform: translateY(-1px);
  }

  .wd1-btn:active {
    transform: translateY(0);
    box-shadow:
      inset 4px 4px 10px var(--por-dark),
      inset -4px -4px 10px var(--por-light);
  }

  .wd1-btn:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }

  .wd1-btn-go {
    background: var(--grad);
    box-shadow:
      6px 6px 14px var(--por-dark),
      -6px -6px 14px var(--por-light),
      inset 0 1px 0 rgba(255, 255, 255, 0.6);
  }

  .wd1-btn-go:active {
    box-shadow:
      inset 4px 4px 10px rgba(110, 150, 120, 0.5),
      inset -2px -2px 6px rgba(255, 255, 255, 0.6);
  }
</style>

<script>
  {
    const section = document.querySelector<HTMLElement>(".wd1");
    if (section) {
      const rig = section.querySelector<HTMLElement>("[data-rig]");
      const arc = section.querySelector<HTMLElement>("[data-arc]");
      const rotor = section.querySelector<HTMLElement>("[data-rotor]");
      const idx = section.querySelector<HTMLElement>("[data-idx]");
      const name = section.querySelector<HTMLElement>("[data-name]");
      const progress = section.querySelector<HTMLElement>("[data-progress]");
      const shots = section.querySelectorAll<HTMLElement>("[data-shot]");
      const panels = section.querySelectorAll<HTMLElement>("[data-panel]");
      const ticks = section.querySelectorAll<HTMLButtonElement>("[data-tick]");
      const count = shots.length;
      const titles = ["dispatch", "meridian", "fuzzbox"];

      // Must track the CSS: arc from -150deg, 300° of throw
      const START = -150;
      const SWEEP = 300;

      let currentIdx = 0;

      const select = (i: number) => {
        if (i === currentIdx) return;
        currentIdx = i;
        const id = String(i);
        shots.forEach((shot) => {
          if (shot.dataset.shot === id) shot.setAttribute("data-on", "");
          else shot.removeAttribute("data-on");
        });
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.panel !== id;
        });
        if (idx) idx.textContent = `0${i + 1}`;
        if (name) name.textContent = titles[i] ?? "";
      };

      let ticking = false;

      const update = () => {
        ticking = false;
        if (!rig) return;
        const rect = rig.getBoundingClientRect();
        // Hidden variant panel (display: none) or mobile layout — nothing to drive
        if (!rect.height) return;
        const range = rect.height - window.innerHeight;
        if (range <= 0) return;
        const p = Math.min(1, Math.max(0, -rect.top / range));
        if (arc) arc.style.setProperty("--f", `${(p * SWEEP).toFixed(2)}deg`);
        if (rotor) rotor.style.transform = `rotate(${(START + p * SWEEP).toFixed(2)}deg)`;
        if (progress) progress.textContent = `${Math.round(p * 100)}% of throw`;
        select(Math.min(count - 1, Math.floor(p * count)));
      };

      const onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      };

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
      update();

      // Tick stops jump the page scroll to the middle of that build's segment
      ticks.forEach((tick) => {
        tick.addEventListener("click", () => {
          if (!rig) return;
          const rect = rig.getBoundingClientRect();
          const range = rect.height - window.innerHeight;
          const i = Number(tick.dataset.tick);
          const top = window.scrollY + rect.top + range * ((i + 0.5) / count);
          window.scrollTo({ top, behavior: "smooth" });
        });
      });
    }
  }
</script>
