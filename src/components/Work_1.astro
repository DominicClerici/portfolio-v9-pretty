---
// V1 — "The Bench": V3's layout — a sticky index on the left drives a
// sticky stage on the right — but the index rows are V2's typographic
// list, and the stage is V4's three-layer teardown (data dots, logic
// grid, interface screenshot) held permanently exploded. No hover
// theatrics: switching projects runs a choreographed swap — the layers
// stack into one, the screenshot fades to black, the image is exchanged
// in the dark, the lights come back up, and the stack spreads apart
// again. V3's spec sheet sits under the stage and swaps with the pick.
const projects = [
  {
    index: "01",
    title: "Dispatch",
    tech: "Astro · TypeScript · AI pipelines",
    fact: "writes itself every morning",
    logicNote: "2 AI pipelines · cron @ 6am",
    dataNote: "24h of news, triaged",
    description:
      "The last 24 hours of tech news, compressed into a 10 minute read. Two decoupled AI pipelines research, triage, and write it; GitHub Actions runs the whole thing while I sleep.",
    image: "/photos/dispatch.webp",
    alt: "Dispatch project screenshot",
    stack: ["Astro", "TypeScript", "OpenAI API", "Tailwind", "Vercel"],
    websiteUrl: "https://dispatch.dominicclerici.com/",
    githubUrl: "https://github.com/DominicClerici/dispatch",
  },
  {
    index: "02",
    title: "Meridian",
    tech: "Vanilla TypeScript · Extensions",
    fact: "0 npm dependencies",
    logicNote: "11 modules, all hand-built",
    dataNote: "45 days of history, kept local",
    description:
      "A new-tab extension for Chrome and Firefox with zero npm dependencies. Eleven feature modules, a reactive storage layer, and a from-scratch component library — plus a recommendation engine that never lets data leave the browser.",
    image: "/photos/meridian.webp",
    alt: "Meridian project screenshot",
    stack: ["TypeScript", "esbuild", "Chrome APIs", "Firefox Add-ons"],
    websiteUrl: "https://meridian.dominicclerici.com/",
    githubUrl: "https://github.com/DominicClerici/meridian",
  },
  {
    index: "03",
    title: "Fuzzbox",
    tech: "Next.js · React Native",
    fact: "design system: Neon Riff",
    featured: true,
    logicNote: "music theory engine",
    dataNote: "chords, intervals, voicings",
    description:
      "The companion I wished I had when learning guitar. Place notes on an interactive fretboard and it explains the chord you found — the intervals, the theory, why it sounds the way it does.",
    image: "/photos/fuzzbox.webp",
    alt: "Fuzzbox project screenshot",
    stack: ["TypeScript", "Next.js", "React Native", "Prisma", "PostgreSQL"],
    websiteUrl: "https://fuzzbox.dominicclerici.com/",
    githubUrl: null,
  },
];
---

<section class="wx1 relative bg-bone" aria-label="Selected work">
  <div class="max-w-[1524px] mx-auto px-6 lg:px-12 py-[clamp(96px,14vh,180px)]">
    <div class="flex items-center justify-between gap-4 mb-10 lg:mb-14">
      <div class="flex items-center gap-4">
        <span
          class="font-mono text-[13px] leading-none tracking-[-0.02em] text-ink/60 border border-ink/30 rounded-full px-3.5 py-2"
        >
          03&hairsp;/&hairsp;04
        </span>
        <span class="font-mono text-[13px] leading-none tracking-[-0.02em] uppercase text-ink/60">
          Selected Work
        </span>
      </div>
      <a
        href="https://github.com/DominicClerici"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex font-mono text-[13px] leading-none tracking-[-0.02em] text-ink/45 hover:text-ink transition-colors duration-200"
      >
        more on github&nbsp;&nearr;
      </a>
    </div>

    <p
      class="font-display font-normal text-ink leading-[1.2] tracking-[-0.006em] max-w-[880px] text-[clamp(1.625rem,calc(1.625rem+(100vw-27.5rem)*0.02),2.625rem)] mb-12 lg:mb-20"
    >
      One build on the bench at a time&nbsp;&mdash;
      <span class="text-ink/55">pick from the index and watch it come apart.</span>
    </p>

    <!-- Desktop: index rail + bench -->
    <div class="hidden lg:grid lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-14 lg:items-start">
      <!-- Index -->
      <div class="sticky top-[max(96px,calc(50vh-260px))]">
        <ul class="border-t border-ink/15">
          {
            projects.map((project, i) => (
              <li class="wx1-item border-b border-ink/15" data-item={i}>
                <button
                  type="button"
                  class="wx1-head w-full text-left py-5 cursor-pointer"
                  data-select={i}
                  data-image={project.image}
                  data-alt={project.alt}
                  data-logic-note={project.logicNote}
                  data-data-note={project.dataNote}
                  aria-pressed={i === 0 ? "true" : "false"}
                >
                  <span class="grid grid-cols-[36px_minmax(0,1fr)] items-baseline gap-3">
                    <span class="font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/40">
                      {project.index}
                    </span>
                    <span class="min-w-0">
                      <span class="flex items-center gap-2.5 min-w-0">
                        <span class="wx1-dot w-[6px] h-[6px] rounded-full bg-bio-lime shrink-0" aria-hidden="true" />
                        <span class="wx1-title font-display font-normal leading-[1] tracking-[-0.016em] text-ink/45 truncate text-[clamp(1.5rem,calc(1.5rem+(100vw-27.5rem)*0.006),1.75rem)]">
                          {project.title}
                        </span>
                        {project.featured && (
                          <span class="font-mono text-[10px] leading-none tracking-[-0.02em] uppercase text-ink bg-bio-lime rounded-full px-2 py-1 shrink-0">
                            featured
                          </span>
                        )}
                      </span>
                      <span class="block font-mono text-[11px] leading-none tracking-[-0.02em] uppercase text-ink/40 mt-2.5">
                        {project.tech}
                      </span>
                    </span>
                  </span>
                </button>
              </li>
            ))
          }
        </ul>
        <p class="font-mono text-[11px] leading-none tracking-[-0.02em] text-ink/35 mt-4 pl-1">
          swaps happen with the lights off
        </p>
      </div>

      <!-- Bench + spec sheet -->
      <div>
        <div class="wx1-stage relative" data-stage>
          <div class="wx1-space absolute inset-0">
            <div class="wx1-stack">
              <div class="wx1-floor" aria-hidden="true"></div>

              <div class="wx1-plane wx1-plane-data" aria-hidden="true">
                <span class="wx1-plane-tag font-mono">data · <span data-data-note>{projects[0].dataNote}</span></span>
              </div>

              <div class="wx1-plane wx1-plane-logic" aria-hidden="true">
                <span class="wx1-plane-tag font-mono">logic · <span data-logic-note>{projects[0].logicNote}</span></span>
                <span class="wx1-node" style="left: 26%; top: 30%;"></span>
                <span class="wx1-node" style="left: 62%; top: 58%;"></span>
                <span class="wx1-node" style="left: 44%; top: 76%;"></span>
              </div>

              <div class="wx1-plane wx1-plane-ui">
                <img
                  src={projects[0].image}
                  srcset={`${projects[0].image} 1x, ${projects[0].image.replace(".webp", "-2x.webp")} 2x`}
                  alt={projects[0].alt}
                  class="w-full h-full object-cover object-top"
                  decoding="async"
                  data-shot
                />
                <span class="wx1-plane-tag wx1-plane-tag-ui font-mono">interface</span>
                <div class="wx1-shutter absolute inset-0" aria-hidden="true"></div>
              </div>
            </div>
          </div>
          <p class="absolute -bottom-7 right-1 font-mono text-[11px] leading-none tracking-[-0.02em] text-ink/35">
            exploded view &mdash; interface / logic / data
          </p>
        </div>

        <!-- Spec sheet -->
        <div class="mt-16">
          {
            projects.map((project, i) => (
              <div class="wx1-panel" data-panel={i} hidden={i !== 0}>
                <div class="flex items-center gap-3 flex-wrap">
                  <span class="font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/45 border border-ink/20 rounded-full px-3 py-1.5">
                    fig.&thinsp;{project.index}
                  </span>
                  {project.featured && (
                    <span class="font-mono text-[12px] leading-none tracking-[-0.02em] uppercase text-ink bg-bio-lime rounded-full px-3 py-1.5">
                      featured
                    </span>
                  )}
                  <span class="font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/40">{project.fact}</span>
                </div>

                <div class="lg:grid lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-12 mt-6">
                  <div>
                    <h3 class="font-display font-normal leading-[0.98] tracking-[-0.02em] text-ink text-[clamp(2rem,calc(2rem+(100vw-27.5rem)*0.014),2.75rem)]">
                      {project.title}
                    </h3>
                    <p class="font-mono text-[13px] leading-none tracking-[-0.02em] uppercase text-ink/45 mt-4">
                      {project.tech}
                    </p>
                    <p class="font-display text-[16px] lg:text-[17px] leading-[1.6] text-ink/60 max-w-[520px] mt-6">
                      {project.description}
                    </p>
                  </div>

                  <div>
                    <dl class="border-t border-ink/10">
                      <div class="flex items-baseline gap-6 py-3.5 border-b border-ink/10">
                        <dt class="font-mono text-[11px] leading-none tracking-[-0.02em] uppercase text-ink/40 w-[72px] shrink-0">
                          stack
                        </dt>
                        <dd class="flex flex-wrap gap-x-5 gap-y-2">
                          {project.stack.map((item) => (
                            <span class="inline-flex items-center gap-2">
                              <span class="w-[5px] h-[5px] rounded-full bg-bio-lime" aria-hidden="true" />
                              <span class="font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/55">
                                {item}
                              </span>
                            </span>
                          ))}
                        </dd>
                      </div>
                      <div class="flex items-baseline gap-6 py-3.5 border-b border-ink/10">
                        <dt class="font-mono text-[11px] leading-none tracking-[-0.02em] uppercase text-ink/40 w-[72px] shrink-0">
                          status
                        </dt>
                        <dd class="font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/55">
                          live · maintained
                        </dd>
                      </div>
                    </dl>

                    <div class="flex items-center gap-3 mt-7">
                      <a
                        href={project.websiteUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="font-mono text-[13px] tracking-[-0.008em] text-ink border border-ink/30 rounded-lg h-10 px-4 inline-flex items-center hover:border-ink transition-colors duration-200"
                      >
                        Visit site
                      </a>
                      {project.githubUrl && (
                        <a
                          href={project.githubUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="font-mono text-[13px] tracking-[-0.008em] text-ink/60 rounded-lg h-10 px-4 inline-flex items-center hover:text-ink transition-colors duration-200"
                        >
                          GitHub
                        </a>
                      )}
                      <a
                        href={project.websiteUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`Open ${project.title} in a new tab`}
                        class="w-10 h-10 rounded-lg bg-bio-lime text-ink inline-flex items-center justify-center hover:-translate-y-0.5 transition-transform duration-200 ml-auto"
                      >
                        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                          <path
                            d="M2 12 12 2M4.5 2H12v7.5"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Mobile: plain cards -->
    <div class="lg:hidden flex flex-col gap-8">
      {
        projects.map((project) => (
          <article class="bg-paper rounded-[20px] border border-ink/10 overflow-hidden">
            <div class="p-4 pb-0">
              <img
                src={project.image}
                srcset={`${project.image} 1x, ${project.image.replace(".webp", "-2x.webp")} 2x`}
                alt={project.alt}
                class="w-full aspect-[16/10] object-cover object-top rounded-[12px] border border-ink/10"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div class="p-6">
              <div class="flex items-center gap-3 flex-wrap">
                <span class="font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/45 border border-ink/20 rounded-full px-3 py-1.5">
                  fig.&thinsp;{project.index}
                </span>
                {project.featured && (
                  <span class="font-mono text-[12px] leading-none tracking-[-0.02em] uppercase text-ink bg-bio-lime rounded-full px-3 py-1.5">
                    featured
                  </span>
                )}
                <span class="font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/40">{project.fact}</span>
              </div>

              <h3 class="font-display font-normal leading-[1] tracking-[-0.018em] text-ink mt-5 text-[clamp(1.875rem,calc(1.875rem+(100vw-27.5rem)*0.014),2.625rem)]">
                {project.title}
              </h3>
              <p class="font-mono text-[12px] leading-none tracking-[-0.02em] uppercase text-ink/45 mt-3.5">
                {project.tech}
              </p>
              <p class="font-display text-[15px] leading-[1.6] text-ink/60 mt-5">{project.description}</p>

              <div class="flex flex-wrap gap-x-5 gap-y-2.5 mt-6">
                {project.stack.map((item) => (
                  <span class="inline-flex items-center gap-2">
                    <span class="w-[5px] h-[5px] rounded-full bg-bio-lime" aria-hidden="true" />
                    <span class="font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/55">{item}</span>
                  </span>
                ))}
              </div>

              <div class="flex items-center gap-3 mt-8">
                <a
                  href={project.websiteUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-mono text-[13px] tracking-[-0.008em] text-ink border border-ink/30 rounded-lg h-10 px-4 inline-flex items-center hover:border-ink transition-colors duration-200"
                >
                  Visit site
                </a>
                {project.githubUrl && (
                  <a
                    href={project.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-mono text-[13px] tracking-[-0.008em] text-ink/60 rounded-lg h-10 px-4 inline-flex items-center hover:text-ink transition-colors duration-200"
                  >
                    GitHub
                  </a>
                )}
                <a
                  href={project.websiteUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Open ${project.title} in a new tab`}
                  class="w-10 h-10 rounded-lg bg-bio-lime text-ink inline-flex items-center justify-center hover:-translate-y-0.5 transition-transform duration-200 ml-auto"
                >
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path
                      d="M2 12 12 2M4.5 2H12v7.5"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <p class="font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/35 text-right mt-12">
      no screws were lost during disassembly
    </p>
  </div>
</section>

<style>
  .wx1-head:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 4px;
    border-radius: 6px;
  }

  .wx1-title {
    transition: color 0.3s ease;
  }

  .wx1-item[data-active] .wx1-title,
  .wx1-head:hover .wx1-title {
    color: var(--color-ink);
  }

  /* Lime dot marks the pick; hidden rows keep the slot so text doesn't shift */
  .wx1-dot {
    opacity: 0;
    transform: scale(0.4);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  .wx1-item[data-active] .wx1-dot {
    opacity: 1;
    transform: scale(1);
  }

  /* ── The bench ── */
  .wx1-stage {
    height: clamp(320px, 34vw, 460px);
  }

  .wx1-space {
    perspective: 1500px;
    display: grid;
    place-items: center;
  }

  /* Rest state: exploded. --spread drives the layer gap; the stage's
     is-flat class (set by the swap choreography) collapses it. */
  .wx1-stack {
    position: relative;
    width: min(74%, 520px);
    aspect-ratio: 16 / 10;
    transform-style: preserve-3d;
    transform: rotateX(52deg) rotateZ(-30deg) scale(0.94);
    --spread: 1;
  }

  .wx1-stage.is-flat .wx1-stack {
    --spread: 0;
  }

  .wx1-floor {
    position: absolute;
    left: 4%;
    right: 4%;
    bottom: -6%;
    height: 18%;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(34, 47, 48, 0.2), transparent 68%);
    transform: translateZ(-150px);
  }

  .wx1-plane {
    position: absolute;
    inset: 0;
    border-radius: 14px;
    border: 1px solid rgba(34, 47, 48, 0.14);
    overflow: hidden;
    backface-visibility: hidden;
  }

  /* Bottom layer — the data bed */
  .wx1-plane-data {
    background-color: var(--color-bone);
    background-image: radial-gradient(circle, rgba(34, 47, 48, 0.22) 1px, transparent 1px);
    background-size: 22px 22px;
    transform: translateZ(calc(var(--spread) * -86px));
    box-shadow: 0 30px 50px -30px rgba(34, 47, 48, 0.45);
  }

  /* Middle layer — the logic board */
  .wx1-plane-logic {
    background-color: var(--color-paper);
    background-image:
      linear-gradient(rgba(34, 47, 48, 0.09) 1px, transparent 1px),
      linear-gradient(90deg, rgba(34, 47, 48, 0.09) 1px, transparent 1px);
    background-size: 34px 34px;
    transform: translateZ(0px);
  }

  .wx1-node {
    position: absolute;
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--color-bio-lime);
    border: 1.5px solid var(--color-ink);
  }

  /* Top layer — the interface */
  .wx1-plane-ui {
    background: var(--color-paper);
    transform: translateZ(calc(var(--spread) * 86px + 1px));
    box-shadow: 0 24px 48px -24px rgba(34, 47, 48, 0.5);
  }

  /* The blackout curtain over the screenshot during a swap */
  .wx1-shutter {
    background: #0b0f10;
    opacity: 0;
    pointer-events: none;
  }

  .wx1-stage.is-dark .wx1-shutter {
    opacity: 1;
  }

  .wx1-plane-tag {
    position: absolute;
    left: 10px;
    bottom: 10px;
    font-size: 11px;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    background: rgba(247, 247, 245, 0.92);
    border: 1px solid rgba(34, 47, 48, 0.14);
    border-radius: 999px;
    padding: 6px 10px;
    white-space: nowrap;
    /* Layer tags only make sense while the stack is apart */
    opacity: var(--spread);
  }

  .wx1-plane-tag-ui {
    background: var(--color-bio-lime);
    border-color: transparent;
  }

  @media (prefers-reduced-motion: no-preference) {
    .wx1-plane {
      /* Durations here are mirrored by the timing constants in the script */
      transition: transform 0.65s cubic-bezier(0.65, 0, 0.35, 1);
    }

    .wx1-plane-data {
      transition-delay: 0.04s;
    }

    .wx1-shutter {
      transition: opacity 0.3s ease;
    }

    .wx1-plane-tag {
      transition: opacity 0.4s ease;
    }

    /* Spec sheet settles in when the pick changes (hidden toggle
       restarts the animation) */
    .wx1-panel {
      animation: wx1-rise 0.5s cubic-bezier(0.33, 1, 0.68, 1) both;
    }
  }

  @keyframes wx1-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
</style>

<script>
  {
    const section = document.querySelector<HTMLElement>(".wx1");
    if (section) {
      const items = section.querySelectorAll<HTMLElement>("[data-item]");
      const heads = section.querySelectorAll<HTMLButtonElement>("[data-select]");
      const panels = section.querySelectorAll<HTMLElement>("[data-panel]");
      const stage = section.querySelector<HTMLElement>("[data-stage]");
      const shot = section.querySelector<HTMLImageElement>("[data-shot]");
      // Scoped to the stage — the index buttons carry the same data-* attributes
      const logicNote = stage?.querySelector<HTMLElement>("[data-logic-note]") ?? null;
      const dataNote = stage?.querySelector<HTMLElement>("[data-data-note]") ?? null;
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // Must track the CSS: plane transform 0.65s (+0.04s delay), shutter 0.3s
      const COLLAPSE_MS = 700;
      const FADE_MS = 340;

      const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

      let current = "0";
      let target = "0";
      let animating = false;

      const setIndex = (id: string) => {
        items.forEach((item) => {
          if (item.dataset.item === id) item.setAttribute("data-active", "");
          else item.removeAttribute("data-active");
        });
        heads.forEach((head) => {
          head.setAttribute("aria-pressed", String(head.dataset.select === id));
        });
      };

      const setPanels = (id: string) => {
        panels.forEach((panel) => {
          panel.hidden = panel.dataset.panel !== id;
        });
      };

      const applyShot = async (id: string) => {
        const head = section.querySelector<HTMLElement>(`[data-select="${id}"]`);
        if (!head) return;
        const src = head.dataset.image!;
        if (shot) {
          shot.src = src;
          shot.srcset = `${src} 1x, ${src.replace(".webp", "-2x.webp")} 2x`;
          shot.alt = head.dataset.alt ?? "";
        }
        if (logicNote) logicNote.textContent = head.dataset.logicNote ?? "";
        if (dataNote) dataNote.textContent = head.dataset.dataNote ?? "";
        // Hold in the dark until the new frame is ready — no half-loaded reveal
        if (shot) await shot.decode().catch(() => {});
      };

      /* The swap choreography: stack together → lights off → exchange the
         specimen → lights on → spread apart. Loops in case the pick
         changed again mid-sequence — the latest click always wins. */
      const run = async () => {
        if (animating || !stage) return;
        animating = true;
        while (current !== target) {
          stage.classList.add("is-flat");
          await wait(COLLAPSE_MS);
          stage.classList.add("is-dark");
          await wait(FADE_MS);
          const id = target;
          await applyShot(id);
          setPanels(id);
          current = id;
          stage.classList.remove("is-dark");
          await wait(FADE_MS);
          stage.classList.remove("is-flat");
          await wait(COLLAPSE_MS);
        }
        animating = false;
      };

      heads.forEach((head) => {
        head.addEventListener("click", () => {
          const id = head.dataset.select!;
          if (id === target) return;
          target = id;
          setIndex(id);
          if (reducedMotion || !stage) {
            applyShot(id);
            setPanels(id);
            current = id;
            return;
          }
          run();
        });
      });

      setIndex("0");
      setPanels("0");

      // Warm the cache so the in-the-dark swap never waits on the network
      heads.forEach((head) => {
        const src = head.dataset.image;
        if (!src || src === shot?.src) return;
        const img = new Image();
        img.srcset = `${src} 1x, ${src.replace(".webp", "-2x.webp")} 2x`;
        img.src = src;
      });
    }
  }
</script>
