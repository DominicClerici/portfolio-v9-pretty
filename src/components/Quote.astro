---
// "Drift field": "Hello, World!" — everyone's first program — drifts
// dimly behind the quote in the syntax of many languages and eras, like dust
// that never quite settles. Near the cursor they glow lime. Canvas2D only.
---

<!-- Also backgroundless: the last section over the pinned glass canvas, which
     leaves with the flow at its bottom edge.

     The quote is centred by its own place-self, not the section's
     place-items. Safari lets a grid's place-items reach its absolutely
     positioned children too, which here are the grid, the field, the scrim
     and the corner line: centred, the line left its corner for the middle of
     the section. With nothing on the section, every engine places them by
     their insets alone. -->
<section
  class="qv4 relative overflow-hidden min-h-[78vh] grid py-[clamp(110px,15vh,190px)] px-safe-3 sm:px-safe-6 md:px-safe-12"
  aria-label="Quote"
>
  <div class="dot-grid" aria-hidden="true"></div>

  <canvas class="absolute inset-0 w-full h-full" aria-hidden="true"></canvas>

  <!-- Scrim so the quote stays readable over the field — and now over the
       glass behind it too, where an orb drifting past would otherwise put a
       bright patch under the type. Pulled in and eased off sooner than it
       used to be, so it covers the band the words actually occupy and leaves
       the rest of the section open to the scene. -->
  <div
    class="absolute inset-0 pointer-events-none bg-[radial-gradient(ellipse_58%_54%_at_50%_50%,rgba(16,16,16,0.9)_0%,rgba(16,16,16,0.42)_58%,transparent_100%)]"
    aria-hidden="true"
  ></div>

  <div
    class="relative place-self-center max-w-3xl mx-auto text-center pointer-events-none"
  >
    <p
      class="font-mono text-[11px] md:text-xs uppercase tracking-[0.3em] text-white/40 mb-8 md:mb-12"
    >
      // an interlude
    </p>

    <blockquote
      class="font-display text-[clamp(1.8rem,4.6vw,3.5rem)] leading-[1.22] tracking-[-0.01em] text-n-100"
    >
      &ldquo;The most disastrous thing that you can ever learn is your first
      programming language.&rdquo;<span
        class="inline-block w-[0.5em] h-[0.9em] ml-2 align-baseline bg-bio-lime motion-safe:animate-caret-blink"
        aria-hidden="true"></span>
    </blockquote>

    <cite
      class="block mt-8 md:mt-12 font-mono not-italic text-[11px] md:text-sm uppercase tracking-[0.3em] text-bio-lime"
    >
      Alan Kay
    </cite>
  </div>

  <!-- Off the corner by the same steps as before, and clear of the notch
     in landscape, like the section's gutters. -->
  <p
    class="absolute bottom-6 right-[max(1.5rem,env(safe-area-inset-right))] md:bottom-10 md:right-[max(3rem,env(safe-area-inset-right))] font-mono text-[10px] md:text-xs text-white/30 tracking-wide"
  >
    &ldquo;Eh, maybe...&rdquo; &mdash; Dominic Clerici
  </p>
</section>

<script>
  const section = document.querySelector<HTMLElement>(".qv4");
  const canvas = section?.querySelector("canvas");
  const ctx = canvas?.getContext("2d");

  if (section && canvas && ctx) {
    const motionOK = matchMedia(
      "(prefers-reduced-motion: no-preference)",
    ).matches;

    const LIME =
      getComputedStyle(document.documentElement)
        .getPropertyValue("--color-bio-lime")
        .trim() || "#cef79e";
    const DUST = "#dee4d8";

    // "Hello, World!" — everyone's first program — across languages and eras.
    // Each snippet is unique; the field renders exactly one of each.
    const TOKENS = [
      "mov ah, 9h; int 21h", // Assembly (x86 DOS)
      'PRINT *, "Hello, World!"', // Fortran
      'DISPLAY "Hello, World!"', // COBOL
      '10 PRINT "HELLO, WORLD!"', // BASIC
      "writeln('Hello, World!');", // Pascal
      'printf("Hello, World!\\n");', // C
      'std::cout << "Hello, World!"', // C++
      'NSLog(@"Hello, World!");', // Objective-C
      'echo "Hello, World!"', // Bash
      'putStrLn "Hello, World!"', // Haskell
      'print("Hello, World!")', // Python
      'puts "Hello, World!"', // Ruby
      'echo "Hello, World!";', // PHP
      'System.out.println("Hello, World!");', // Java
      'console.log("Hello, World!")', // JavaScript
      'Console.WriteLine("Hello, World!");', // C#
      'fmt.Println("Hello, World!")', // Go
      'println!("Hello, World!");', // Rust
      'IO.puts "Hello, World!"', // Elixir
      'io:format("Hello, World!~n").', // Erlang
      "++++++++[>++++[>++>+++>+++>+<<<<-]>+>+>->>+[<]<-]>>.>---.+++++++..+++.>>+.<<.+++.------.--------.>>+.", // Brainfuck
    ];

    type P = {
      t: string;
      x: number;
      y: number;
      vx: number;
      vy: number;
      s: number;
      a: number;
    };
    let w = 0;
    let h = 0;
    let parts: P[] = [];
    const mouse = { x: -1e4, y: -1e4 };

    const init = () => {
      const r = canvas.getBoundingClientRect();
      if (!r.width || !r.height) return false;
      const dpr = Math.min(devicePixelRatio || 1, 1.5);
      w = r.width;
      h = r.height;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      if (!parts.length) {
        // One particle per snippet — never repeated.
        parts = TOKENS.map((t) => ({
          t,
          x: Math.random() * w,
          y: Math.random() * h,
          vx: (Math.random() - 0.5) * 0.16,
          vy: (Math.random() - 0.5) * 0.1,
          s: 10 + Math.random() * 6,
          a: 0.05 + Math.random() * 0.09,
        }));
      }
      return true;
    };

    const draw = (step: boolean) => {
      ctx.clearRect(0, 0, w, h);
      ctx.textBaseline = "middle";
      ctx.textAlign = "center";
      for (const p of parts) {
        if (step) {
          p.x += p.vx;
          p.y += p.vy;
          if (p.x < -140) p.x = w + 140;
          if (p.x > w + 140) p.x = -140;
          if (p.y < -20) p.y = h + 20;
          if (p.y > h + 20) p.y = -20;
        }
        const dx = p.x - mouse.x;
        const dy = p.y - mouse.y;
        const glow = Math.max(0, 1 - (dx * dx + dy * dy) / (190 * 190));
        const lit = glow > 0.01;
        ctx.font = `${p.s}px "Roboto Mono", monospace`;
        ctx.fillStyle = lit ? LIME : DUST;
        ctx.globalAlpha = lit ? Math.min(0.85, p.a + glow * 0.55) : p.a;
        ctx.fillText(p.t, p.x, p.y);
      }
      ctx.globalAlpha = 1;
    };

    let raf = 0;
    let running = false;
    const loop = () => {
      draw(true);
      raf = requestAnimationFrame(loop);
    };
    const start = () => {
      if (!running && motionOK && w > 0) {
        running = true;
        raf = requestAnimationFrame(loop);
      }
    };
    const stop = () => {
      running = false;
      cancelAnimationFrame(raf);
    };

    let inView = false;
    new IntersectionObserver(
      (entries) => {
        inView = entries[0].isIntersecting;
        inView && !document.hidden ? start() : stop();
      },
      { threshold: 0.05 },
    ).observe(section);

    document.addEventListener("visibilitychange", () => {
      inView && !document.hidden ? start() : stop();
    });

    // Re-init on resize; draw a static frame regardless so reduced-motion
    // users still get the field.
    new ResizeObserver(() => {
      if (init()) draw(false);
    }).observe(canvas);

    section.addEventListener(
      "pointermove",
      (e) => {
        const r = canvas.getBoundingClientRect();
        mouse.x = e.clientX - r.left;
        mouse.y = e.clientY - r.top;
      },
      { passive: true },
    );
    section.addEventListener("pointerleave", () => {
      mouse.x = -1e4;
      mouse.y = -1e4;
    });
  }
</script>
