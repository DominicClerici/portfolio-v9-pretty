---
// The 40px lime action button that sits beside a text CTA (Hero, Career,
// Footer). Geometry and colour are fixed; the hover motion differs per
// placement, so it arrives through `class` along with any other extras.
// Remaining attributes (target, rel, aria-*, tabindex) pass through.
interface Props {
  href: string;
  class?: string;
  [key: string]: unknown;
}

const { href, class: className = "", ...rest } = Astro.props;
---

<a
  href={href}
  class:list={[
    "size-10 rounded-lg bg-bio-lime text-ink inline-flex items-center justify-center transition-transform duration-200",
    className,
  ]}
  {...rest}
>
  <slot />
</a>
