---
import IconButton from "./IconButton.astro"

const RANGE_START = 2019
const RANGE_END = 2027
const SPAN = RANGE_END - RANGE_START

const entries = [
  {
    period: "2025 — Now",
    start: 2025,
    end: 2026.5,
    lane: 0,
    now: true,
    company: "Rumor",
    title: "Full Stack Developer",
    description:
      "Building the platform behind Rumor — a private network connecting people to exclusive cultural events. Most of my time goes toward the host dashboard and mobile apps, everything from event creation and guest management to real-time analytics. Small team, so I touch most of the stack, from the database layer up to what users see on their phones.",
    skills: ["Full Stack", "Mobile", "Cloud Infrastructure"],
    tags: [
      "TypeScript",
      "PostgreSQL",
      "AWS Lambda",
      "Next.js",
      "React Native",
      "Swift",
    ],
    url: "https://www.therumor.com/",
  },
  {
    period: "2024 — 2026",
    start: 2024,
    end: 2026,
    lane: 1,
    now: false,
    company: "Squib",
    title: "Founding Engineer",
    description:
      "First engineer at an AI research lab building autonomous agents that model human behavior. I helped build Persona, a product that creates AI-powered social profiles — digital twins that grow audiences and predict how communities will respond before a campaign launches. Early-stage startup, so I had my hands in everything from agent architecture to the product interface.",
    skills: ["AI/ML", "Autonomous Agents", "Growth Engineering"],
    tags: ["Go", "TypeScript", "Python", "PostgreSQL"],
    url: "https://www.heysquib.com/",
  },
  {
    period: "2021 — 2022",
    start: 2021,
    end: 2022,
    lane: 0,
    now: false,
    company: "Artesian Builds",
    title: "Full Stack Developer",
    description:
      "Helped overhaul the company website — better design, tighter SEO, load times dropped about 40%. Also built internal tools for tracking sponsorship metrics and Twitch creator stats, which gave management real numbers instead of gut feelings. Small team, learned a lot about wearing different hats and shipping quickly.",
    skills: ["Full Stack", "Internal Tooling", "SEO", "Data Analysis"],
    tags: ["WordPress", "Elementor", "Electron", "Python", "PostgreSQL"],
    url: "https://en.wikipedia.org/wiki/Artesian_Builds",
  },
  {
    period: "2019",
    start: 2019.05,
    end: 2019.85,
    lane: 0,
    now: false,
    company: "McDonald's",
    title: "Crew Member",
    description:
      "Got me my first car at 16 — a '93 Miata with 220k miles on it. I still think about that car more than I probably should.",
    skills: ["Deep Fryer", "Cash Register", "Drive-Thru", "Customer Service"],
    tags: ["Ice Cream Machine (Broken)", "McFlurry Assembly", "Headset Comms"],
    url: "https://www.mcdonalds.com/us/en-us.html",
  },
]

// Vertical axis: oldest at the top, so a year maps to distance from RANGE_START
const yPct = (v: number) => ((v - RANGE_START) / SPAN) * 100
const years = Array.from({ length: SPAN }, (_, i) => RANGE_START + i)

// Render order oldest-first while keeping each entry's original index for
// selection/hover-sync wiring (data-select keys off the original i).
const orderedEntries = entries.map((entry, i) => ({ entry, i })).reverse()

// Scroll-pin choreography ----------------------------------------------------
// Each entry gets one viewport of scroll, plus one extra "run-out" viewport
// after the last entry so the marker travels off the final pill to the end of
// the spine before the scroll releases. Total travel is therefore N viewports
// (N-1 to step through the entries + 1 to run out), so the section is N+1 tall.
const N = entries.length
const stepPct = orderedEntries.map(({ entry }) => yPct(entry.start))
// Desktop playhead rides the year-scaled positions so it lines up with the bars.
const railStart = stepPct[0]
// Mobile markers are evenly spaced, sitting in the first N-1/N of the rail; the
// trailing segment (last dot -> end) is the run-out, mirroring the desktop spine.
const evenPct = orderedEntries.map((_, s) => (N > 0 ? (s / N) * 100 : 0))
// step index (oldest-first) -> original entry index
const stepMap = orderedEntries.map(({ i }) => i)
// The section rests on the oldest entry when the pin engages (progress 0).
const initialIndex = stepMap[0]
---

<section
  id="career"
  class="career-v1 relative bg-n-950"
  style={`height: ${(N + 1) * 100}svh`}
  data-step-pct={JSON.stringify(stepPct)}
  data-step-map={JSON.stringify(stepMap)}
  aria-label="Career"
>
  <div class="dot-grid" aria-hidden="true"></div>

  <!-- The pinned frame: everything inside stays in view while the tall section
       scrolls past, which reads as a scroll-lock without trapping the wheel. -->
  <div class="v1-pin sticky top-0 h-[100svh] overflow-hidden flex items-start">
    <div
      class="relative w-full max-w-[1524px] mx-auto px-3 sm:px-6 lg:px-12 py-8 lg:pt-[12svh] lg:pb-0"
    >
      <h2
        class="v1-heading font-display text-n-100 leading-[1.2] tracking-[-0.006em] max-w-[880px] text-[clamp(1.5rem,calc(1.5rem+(100vw-27.5rem)*0.018),2.5rem)] mb-6 lg:mb-12"
      >
        Time on one axis,
        <span class="text-white/45">the story on the other.</span>
      </h2>

      <!-- Mobile: horizontal timeline above the card strip (oldest left). -->
      <div class="v1-rail-h lg:hidden relative h-8 mb-5" aria-hidden="true">
        <div class="absolute inset-x-[7px] top-1/2 -translate-y-1/2">
          <div
            class="absolute inset-x-0 top-1/2 -translate-y-1/2 h-0.5 rounded-[2px] bg-n-800"
          >
          </div>
          <div
            class="v1-rail-fill-h absolute left-0 top-1/2 -translate-y-1/2 h-0.5 rounded-[2px] bg-bio-lime"
            style="width: 0%"
          >
          </div>
          {
            orderedEntries.map((_, s) => (
              <span
                class="absolute top-1/2 w-[7px] h-[7px] rounded-full bg-n-800 border border-n-700 -translate-x-1/2 -translate-y-1/2"
                style={`left: ${evenPct[s]}%`}
              />
            ))
          }
          <div
            class="v1-rail-tip-h absolute top-1/2 w-[11px] h-[11px] rounded-full bg-bio-lime -translate-x-1/2 -translate-y-1/2"
            style="left: 0%"
          />
        </div>
      </div>

      <div class="grid lg:grid-cols-[360px_1fr] gap-4 lg:gap-14 items-start">
        <!-- Rail: time spine + employer tabs.
             min-w-0 lets this grid column shrink to the viewport so the tab
             strip below scrolls horizontally instead of forcing an overflow. -->
        <div class="min-w-0 lg:grid lg:grid-cols-[66px_1fr] lg:gap-5">
          <!-- The spine — V3's chart, rotated vertical -->
          <div class="v1-spine relative hidden lg:block">
            <div class="absolute inset-x-0 top-2 bottom-2">
              <!-- Progress playhead: a horizontal marker line that sweeps down the
                   timeline (top -> bottom), landing on each bar as it's selected. -->
              <div
                class="v1-playhead absolute left-0 right-0"
                style={`top: ${railStart}%`}
                aria-hidden="true"
              >
              </div>
              {
                years.map((y) => (
                  <div
                    class="absolute inset-x-0"
                    style={`top: ${yPct(y)}%`}
                    aria-hidden="true"
                  >
                    <span class="absolute left-0 top-0 -translate-y-1/2 font-mono text-[10px] leading-none tracking-[-0.02em] text-n-400">
                      {`'${String(y).slice(2)}`}
                    </span>
                    <span class="absolute left-7 right-0 top-0 border-t border-n-800" />
                  </div>
                ))
              }
              {
                orderedEntries.map(({ entry, i }) => (
                  <span
                    class="v1-bar absolute w-[14px] rounded-full border border-n-700"
                    style={`top: ${yPct(entry.start)}%; height: ${yPct(entry.end) - yPct(entry.start)}%; left: ${30 + entry.lane * 20}px; --d: ${i * 120}ms`}
                    data-select={i}
                    data-on={i === initialIndex ? "true" : "false"}
                    aria-hidden="true"
                  >
                    {entry.now && (
                      <span class="absolute -bottom-[2px] left-1/2 -translate-x-1/2 flex w-[7px] h-[7px]">
                        <span class="v1-ping absolute inline-flex h-full w-full rounded-full bg-bio-lime opacity-70" />
                        <span class="relative inline-flex rounded-full h-[7px] w-[7px] bg-bio-lime" />
                      </span>
                    )}
                  </span>
                ))
              }
            </div>
          </div>

          <!-- Employer jump buttons — list rows on desktop, chip strip on mobile.
               Deliberately NOT role="tablist": selection here is driven by scroll
               position, not by arrow keys, so the tab pattern would promise
               keyboard semantics this section does not implement. They are plain
               buttons that scroll to an entry, with aria-current marking the one
               the playhead is currently on. -->
          <div
            class="flex lg:flex-col overflow-x-auto lg:overflow-visible gap-2 lg:gap-0 -mx-3 px-3 sm:-mx-6 sm:px-6 lg:mx-0 lg:px-0 pb-1 lg:pb-0"
            role="group"
            aria-label="Employers"
          >
            {
              orderedEntries.map(({ entry, i }) => (
                <button
                  type="button"
                  class="v1-tab shrink-0 lg:w-full text-left"
                  aria-current={i === initialIndex ? "true" : "false"}
                  data-select={i}
                >
                  <span class="block">
                    <span class="font-mono text-[11px] leading-none tracking-[-0.02em] text-n-400 block">
                      {entry.period}
                    </span>
                    <span class="v1-tab-name font-display leading-tight tracking-[-0.012em] text-[20px] lg:text-[24px] mt-1.5 inline-flex items-center gap-2.5">
                      <span
                        class="v1-tab-dot w-[6px] h-[6px] rounded-full bg-bio-lime shrink-0"
                        aria-hidden="true"
                      />
                      {entry.company}
                    </span>
                  </span>
                </button>
              ))
            }
          </div>
        </div>

        <!-- The dossier panel. min-w-0 keeps it inside the 1fr column instead
             of expanding past the viewport on small screens. -->
        <div
          class="relative min-w-0 rounded-[20px] border border-n-800 bg-n-900 lg:min-h-[460px] overflow-hidden"
        >
          {
            entries.map((entry, i) => (
              <div
                class="relative p-5 sm:p-8 lg:p-12"
                data-panel={i}
                hidden={i !== initialIndex}
              >
                {/* Ghost year watermark */}
                <span
                  class="absolute -top-8 right-2 font-display leading-none tracking-[-0.04em] text-white/[0.035] select-none pointer-events-none text-[clamp(9rem,18vw,15rem)]"
                  aria-hidden="true"
                >
                  {Math.floor(entry.start)}
                </span>

                <div class="relative v1-enter">
                  <div class="flex items-center gap-2.5">
                    <span
                      class:list={[
                        "w-[6px] h-[6px] rounded-full",
                        entry.now ? "bg-bio-lime" : "bg-n-600",
                      ]}
                      aria-hidden="true"
                    />
                    <span class="font-mono text-[13px] leading-none tracking-[-0.02em] uppercase text-n-400">
                      {entry.period}&ensp;·&ensp;{entry.title}
                    </span>
                  </div>

                  <h3 class="font-display leading-[0.95] tracking-[-0.02em] text-n-100 mt-4 sm:mt-6 text-[clamp(2.5rem,calc(2.5rem+(100vw-27.5rem)*0.028),4.5rem)]">
                    {entry.company}
                  </h3>

                  <p class="font-display text-[16px] lg:text-[17px] leading-[1.6] text-n-350 max-w-[640px] mt-4 sm:mt-6 lg:mt-8">
                    {entry.description}
                  </p>

                  <div class="flex flex-wrap gap-x-6 gap-y-3 mt-5 sm:mt-8 lg:mt-10">
                    {entry.skills.map((skill) => (
                      <span class="inline-flex items-center gap-2">
                        <span
                          class="w-[6px] h-[6px] rounded-full bg-bio-lime"
                          aria-hidden="true"
                        />
                        <span class="font-mono text-[12px] leading-none tracking-[-0.02em] uppercase text-n-300">
                          {skill}
                        </span>
                      </span>
                    ))}
                  </div>
                  <div class="flex flex-wrap gap-x-4 gap-y-2 mt-4 sm:mt-5">
                    {entry.tags.map((tag) => (
                      <span class="font-mono text-[12px] leading-none tracking-[-0.02em] text-n-400">
                        {tag}
                      </span>
                    ))}
                  </div>

                  <div class="flex items-center gap-3 mt-6 sm:mt-10 lg:mt-12">
                    <a
                      href={entry.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-mono text-[13px] tracking-[-0.008em] text-n-100 border border-n-700 rounded-lg h-10 px-4 inline-flex items-center hover:border-n-400 transition-colors duration-200"
                    >
                      Visit {entry.company}
                    </a>
                    {/* Same destination as the button above — a visual affordance,
                        not a second link. Hidden from AT and taken out of the tab
                        order so the pair is announced once, not twice. */}
                    <IconButton
                      href={entry.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-hidden="true"
                      tabindex="-1"
                      class="hover:-translate-y-0.5"
                    >
                      <svg
                        width="14"
                        height="14"
                        viewBox="0 0 14 14"
                        fill="none"
                        aria-hidden="true"
                      >
                        <path
                          d="M2 12 12 2M4.5 2H12v7.5"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </IconButton>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Mobile-only: opacity is toggled in JS as the section crosses the sticky
     lock boundary; this transition is what makes that toggle read as a fade
     instead of a snap. Desktop never sets the inline style, so it's inert there. */
  .v1-heading {
    transition: opacity 0.3s ease;
  }

  /* Progress playhead — horizontal marker line (desktop), sweeps top -> bottom */
  .v1-playhead {
    height: 2px;
    background: var(--color-bio-lime);
    transform: translateY(-50%);
    box-shadow: 0 0 8px
      color-mix(in srgb, var(--color-bio-lime) 45%, transparent);
  }

  .v1-playhead::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background: var(--color-bio-lime);
    transform: translate(-3px, -50%);
    box-shadow: 0 0 0 4px
      color-mix(in srgb, var(--color-bio-lime) 18%, transparent);
  }

  .v1-rail-tip-h {
    box-shadow: 0 0 0 4px
      color-mix(in srgb, var(--color-bio-lime) 18%, transparent);
  }

  /* Spine bars */
  .v1-bar {
    background: var(--color-n-850);
    cursor: pointer;
    /* transform is inert unless the grow-in below is active, so it can live in
       the single base transition rather than being redeclared under the
       reduced-motion query. */
    transition:
      transform 0.9s var(--ease-rise) var(--d, 0ms),
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .v1-bar:hover,
  .v1-bar.hl {
    border-color: color-mix(in srgb, var(--color-bio-lime) 50%, transparent);
    background: var(--color-n-800);
  }

  .v1-bar[data-on="true"] {
    background: var(--color-bio-lime);
    border-color: var(--color-bio-lime);
  }

  /* Tabs */
  .v1-tab-name {
    color: var(--color-n-400);
    transition: color 0.2s ease;
  }

  .v1-tab:hover .v1-tab-name,
  .v1-tab.hl .v1-tab-name {
    color: var(--color-n-300);
  }

  .v1-tab[aria-current="true"] .v1-tab-name {
    color: var(--color-n-100);
  }

  .v1-tab-dot {
    opacity: 0;
    transform: scale(0.4);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }

  .v1-tab[aria-current="true"] .v1-tab-dot {
    opacity: 1;
    transform: scale(1);
  }

  @media (min-width: 1024px) {
    .v1-tab {
      padding: 20px 0;
      border-top: 1px solid var(--color-n-800);
      cursor: pointer;
    }

    .v1-tab:last-child {
      border-bottom: 1px solid var(--color-n-800);
    }
  }

  @media (max-width: 1023px) {
    /* The pin is offset upward by the height of everything above the rail, so
       the heading scrolls off the top of the viewport *before* the section
       locks — buying back that vertical space on short screens. The offset is
       measured in JS (--v1-head-h) since the heading wraps at unpredictable
       widths; it already accounts for the padding the rail should keep above
       it once stuck. */
    .v1-pin {
      top: calc(-1 * var(--v1-head-h, 0px));
      height: calc(100svh + var(--v1-head-h, 0px));
    }

    /* The selection state is already carried by the chip's border and fill on
       mobile, so the dot is redundant width in a strip that is tight for it. */
    .v1-tab-dot {
      display: none;
    }

    .v1-tab {
      border: 1px solid var(--color-n-800);
      border-radius: 14px;
      padding: 12px 18px;
      background: var(--color-n-900);
      cursor: pointer;
      white-space: nowrap;
    }

    .v1-tab[aria-current="true"] {
      border-color: var(--color-n-600);
      background: var(--color-n-850);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Bars grow down the spine when it scrolls into view */
    .v1-bar {
      transform: scaleY(0);
      transform-origin: top center;
    }

    .v1-spine.in .v1-bar {
      transform: scaleY(1);
    }

    .v1-ping {
      animation: v1-ping 2.2s cubic-bezier(0, 0, 0.2, 1) infinite;
    }

    @keyframes v1-ping {
      0% {
        transform: scale(1);
        opacity: 0.7;
      }
      75%,
      100% {
        transform: scale(3);
        opacity: 0;
      }
    }

    /* Panel content entrance on tab switch */
    .v1-enter {
      animation: v1-rise 0.5s var(--ease-rise) both;
    }

    @keyframes v1-rise {
      from {
        opacity: 0;
        transform: translateY(16px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
</style>

<script>
  {
    const section = document.querySelector<HTMLElement>(".career-v1")
    if (section) {
      const tabs = section.querySelectorAll<HTMLButtonElement>(".v1-tab")
      const bars = section.querySelectorAll<HTMLElement>(".v1-bar")
      const panels = section.querySelectorAll<HTMLElement>("[data-panel]")
      const pin = section.querySelector<HTMLElement>(".v1-pin")
      // Mobile: the tab chips live in a horizontal scroller; the selected chip
      // is kept centered as selection moves (see select()).
      const tablist = section.querySelector<HTMLElement>("[role='group']")

      const stepPct: number[] = JSON.parse(section.dataset.stepPct || "[]")
      const stepMap: number[] = JSON.parse(section.dataset.stepMap || "[]")
      const N = stepPct.length

      // Desktop: horizontal playhead, positioned in the spine's year-% space.
      const playhead = section.querySelector<HTMLElement>(".v1-playhead")
      // Mobile: evenly-spaced rail, so the tip travels linearly with progress.
      const fillH = section.querySelector<HTMLElement>(".v1-rail-fill-h")
      const tipH = section.querySelector<HTMLElement>(".v1-rail-tip-h")

      const select = (id: string | undefined) => {
        if (!id) return
        tabs.forEach((t) =>
          t.setAttribute("aria-current", String(t.dataset.select === id)),
        )
        // Bring the newly selected chip into view within the mobile strip.
        // The guard scopes this to when the strip actually overflows (mobile);
        // on desktop the tabs stack vertically and this is a no-op.
        if (tablist && tablist.scrollWidth > tablist.clientWidth) {
          const active = tablist.querySelector<HTMLElement>(
            `[data-select="${id}"]`,
          )
          if (active) {
            const cRect = tablist.getBoundingClientRect()
            const aRect = active.getBoundingClientRect()
            const delta =
              aRect.left - cRect.left - (tablist.clientWidth - aRect.width) / 2
            tablist.scrollTo({
              left: tablist.scrollLeft + delta,
              behavior: "smooth",
            })
          }
        }
        bars.forEach((b) =>
          b.setAttribute("data-on", String(b.dataset.select === id)),
        )
        panels.forEach((panel) => {
          const show = panel.dataset.panel === id
          panel.hidden = !show
          if (show) {
            // retrigger the entrance animation
            const inner = panel.querySelector<HTMLElement>(".v1-enter")
            if (inner) {
              inner.style.animation = "none"
              void inner.offsetWidth
              inner.style.animation = ""
            }
          }
        })
      }

      // Scroll-pin: map scroll progress through the tall section to a travelling
      // tip (marker to marker) and the active entry (flips when the tip lands on
      // the next pill).
      let activeStep = -1

      const render = (p: number) => {
        // pages: 0..N. Pages [0, N-1] step through the entries; the last page
        // [N-1, N] is the run-out that carries the marker to the spine's end.
        const pages = p * N

        // Desktop playhead (year-scaled, in the spine's coordinate space).
        let yearPct: number
        if (N <= 1) {
          yearPct = stepPct[0] ?? 0
        } else if (pages <= N - 1) {
          // Step phase: travel marker to marker, landing on each bar.
          const s = Math.max(0, Math.min(Math.floor(pages), N - 2))
          const f = pages - s
          yearPct = stepPct[s] + (stepPct[s + 1] - stepPct[s]) * f
        } else {
          // Run-out phase: from the last bar down to the end of the spine (100%).
          const runF = Math.min(pages - (N - 1), 1)
          yearPct = stepPct[N - 1] + (100 - stepPct[N - 1]) * runF
        }
        if (playhead) playhead.style.top = `${yearPct}%`

        // Mobile rail is evenly spaced with a trailing run-out segment, so the
        // tip is linear across the whole track (last dot at (N-1)/N, end at 1).
        const linPct = p * 100
        if (fillH) fillH.style.width = `${linPct}%`
        if (tipH) tipH.style.left = `${linPct}%`

        // Small bias so arriving at a marker selects it even when the scroll
        // position lands a sub-pixel short of the exact page boundary.
        const step = Math.max(0, Math.min(Math.floor(pages + 0.01), N - 1))
        if (step !== activeStep) {
          activeStep = step
          select(String(stepMap[step]))
        }
      }

      // Register the pin's entry/exit scroll positions as soft barriers so the
      // smooth-scroll engine eases into and out of the lock instead of snapping.
      // Y_top is where the pin engages (content freezes); Y_bottom = Y_top + travel
      // is where it releases. Only meaningful on desktop where the pin is active.
      // Both values are scroll-invariant, so they only actually move on resize
      // or a late layout shift. Recomputing every frame is cheap but publishing
      // every frame is pointless churn, so only push when they change.
      let lastTop = NaN
      let lastTv = NaN
      const registerBarriers = (rectTop: number, tv: number) => {
        const setBarriers = (window as any).__setScrollBarriers as
          | ((ys: number[]) => void)
          | undefined
        if (!setBarriers) return
        const top = rectTop + window.scrollY
        if (top === lastTop && tv === lastTv) return
        lastTop = top
        lastTv = tv
        setBarriers(tv > 0 ? [top, top + tv] : [])
      }

      // Mobile only: let the heading scroll off before the pin engages, by
      // pulling the pin's sticky top up by everything above the rail. RAIL_PAD
      // is the gap the rail keeps below the viewport top once stuck.
      const railH = section.querySelector<HTMLElement>(".v1-rail-h")
      const RAIL_PAD = 20
      const mobileMQ = window.matchMedia("(max-width: 1023px)")
      const heading = section.querySelector<HTMLElement>(".v1-heading")
      let headH = 0
      // Scroll-invariant (see the barrier note above), so it is measured here
      // and read from cache in the scroll frame — offsetHeight in a scroll
      // handler forces a synchronous layout on every frame, page-wide, and
      // this section is 500svh.
      let travelPx = 0
      const measure = () => {
        if (railH) {
          const mobile = mobileMQ.matches
          headH = mobile ? Math.max(0, railH.offsetTop - RAIL_PAD) : 0
          section.style.setProperty("--v1-head-h", `${headH}px`)
        }
        // Must follow the write above: --v1-head-h feeds .v1-pin's height, so
        // reading the pin before it settles would measure the stale box.
        travelPx = section.offsetHeight - (pin?.offsetHeight ?? window.innerHeight)
      }

      let ticking = false
      const onScroll = () => {
        if (ticking) return
        ticking = true
        requestAnimationFrame(() => {
          ticking = false
          const rect = section.getBoundingClientRect()
          const tv = travelPx
          // entryLead (px) is progress the smooth-scroll engine has advanced
          // ahead of the real scroll while braking into the lock, so the pin
          // scrubs *during* the entry deceleration instead of dwelling at zero.
          const lead =
            ((window as any).__scrollProgressLead as (() => number) | undefined)?.() ?? 0
          const p = tv > 0 ? Math.max(0, Math.min((-rect.top + lead) / tv, 1)) : 0
          registerBarriers(rect.top, tv)
          render(p)

          // Mobile: the heading fades out the moment the section crosses into
          // its sticky lock (rect.top past -headH) and fades back in once
          // scrolling leaves that pinned range.
          if (heading) {
            const stuck = mobileMQ.matches && headH > 0 && rect.top <= -headH
            heading.style.opacity = stuck ? "0" : ""
          }
        })
      }

      window.addEventListener("scroll", onScroll, { passive: true })
      window.addEventListener("resize", () => {
        measure()
        onScroll()
      })
      measure()
      onScroll()

      if ("ResizeObserver" in window) {
        const ro = new ResizeObserver(() => {
          measure()
          onScroll()
        })
        // The heading's wrapped height depends on font loading and the panel's
        // own reflow, both of which land after this runs.
        if (railH) ro.observe(railH.parentElement ?? railH)
        // travelPx is derived from these two boxes, so observing them directly
        // is what keeps the cache honest between resize events.
        ro.observe(section)
        if (pin) ro.observe(pin)
      }

      // Clicking a tab / bar selects it and scrolls the page to that entry's slot
      // in the pin, reusing the site's smooth-scroll easing.
      section.querySelectorAll<HTMLElement>("[data-select]").forEach((el) => {
        el.addEventListener("click", () => {
          const id = el.dataset.select
          if (id == null) return
          const step = stepMap.indexOf(Number(id))
          if (step < 0) return
          // Selection is driven by the scroll handler as the page eases to the
          // target, so the panels scrub through en route rather than flashing.
          const tv = travelPx
          // step k is reached at pages = k, i.e. progress k/N (never in run-out).
          const targetP = N > 0 ? step / N : 0
          const y =
            section.getBoundingClientRect().top + window.scrollY + targetP * tv
          const smooth = (window as any).__smoothScrollTo as
            | ((y: number) => void)
            | undefined
          if (smooth) smooth(y)
          else window.scrollTo(0, y)
        })
      })

      // Hover sync between spine bars and tab rows — both carry data-select, so
      // grouping by that value pairs each bar with its tab.
      const groups = new Map<string, HTMLElement[]>()
      section.querySelectorAll<HTMLElement>("[data-select]").forEach((el) => {
        const key = el.dataset.select!
        if (!groups.has(key)) groups.set(key, [])
        groups.get(key)!.push(el)
      })
      groups.forEach((els) => {
        const toggle = (on: boolean) => () =>
          els.forEach((el) => el.classList.toggle("hl", on))
        els.forEach((el) => {
          el.addEventListener("mouseenter", toggle(true))
          el.addEventListener("mouseleave", toggle(false))
        })
      })

      // Grow-in trigger
      const spine = section.querySelector<HTMLElement>(".v1-spine")
      if (spine) {
        const io = new IntersectionObserver(
          (obs) => {
            obs.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("in")
                io.unobserve(e.target)
              }
            })
          },
          { threshold: 0.25 },
        )
        io.observe(spine)
      }
    }
  }
</script>
