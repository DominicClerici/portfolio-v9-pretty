---
import ActionButton from "./ActionButton.astro";
import {
  entries,
  ordered,
  monthYear,
  axisAt,
  nowYear,
} from "../data/career";

// Scroll-pin choreography ----------------------------------------------------
// Each entry gets half a viewport of scroll, plus one extra "run-out" half
// viewport after the last entry so the playhead travels off the final bar to
// the end of the axis before the scroll releases. Total travel is therefore
// N half-viewports, so the section is (N+1) * 50vh tall.
const N = entries.length;
// The axis runs to today, so this is only first paint: the script lays it
// out again from the visitor's clock (see axisAt in data/career.ts).
const axis = axisAt(nowYear());
// step index (oldest-first) -> original entry index
const stepMap = ordered.map(({ i }) => i);
const stepAccent = ordered.map(({ entry }) => entry.accent);
// The section rests on the oldest entry when the pin engages (progress 0).
const initialIndex = stepMap[0];

const pad = (n: number) => String(n).padStart(2, "0");
const stepOf = new Map(ordered.map(({ i }, s) => [i, s + 1]));
const lanes = Math.max(...entries.map((e) => e.lane)) + 1;
---

<!-- No background of its own: it scrolls over the pinned glass canvas in
     PinnedCanvas.astro, whose backdrop has already turned to near-black by
     exactly the line this section starts on.

     No card either: the scene is the surface. The company name is set huge
     straight onto the glass and rolls over letter by letter as the entries
     change, with the company's logo after it melting from one mark into
     the next; the copy sits beside it, straight on the scene too; and the
     time axis runs the full width along the foot of the
     frame — a Gantt of the whole career with a playhead sweeping across it,
     and the orbs rising through the open band just above it. -->
<section
  id="career"
  class="relative"
  style={`height: ${(N + 1) * 50}svh; --accent: ${stepAccent[0]}`}
  data-step-map={JSON.stringify(stepMap)}
  data-step-accent={JSON.stringify(stepAccent)}
  aria-label="Career"
>
  <!-- The pinned frame: everything inside stays in view while the tall section
       scrolls past, which reads as a scroll-lock without trapping the wheel.
       It is screen-sized, so iOS Safari would take it for a bar to extend
       under its own and leave near-black bars on the rest of the page;
       bleed-under-bars (global.css) keeps it out, which is why .frame, its
       only child, must stay positioned. -->
  <div
    class="pin sticky top-0 h-[100svh] overflow-hidden flex items-start bleed-under-bars"
  >
    <div class="frame relative w-full h-full">
      <div
        class="inner relative h-full max-w-[1524px] mx-auto px-safe-4 sm:px-safe-6 lg:px-safe-12"
      >
        <!-- ── Time axis (top on mobile, foot of the frame on desktop) ── -->
        <div class="axis">
          <div class="flex items-baseline justify-end mb-3 lg:mb-4">
            <h2 class="sr-only">Career</h2>
            <span
              class="readout font-mono text-[11px] lg:text-[12px] leading-none tracking-[-0.02em] text-n-400 tabular-nums"
              aria-hidden="true">{ordered[0].entry.start.replace("-", ".")}</span
            >
          </div>

          <!-- Deliberately NOT role="tablist": selection here is driven by
               scroll position, not by arrow keys. The bars are plain buttons
               that scroll to an entry, with aria-current marking the one the
               playhead is on. -->
          <div
            class="chart relative"
            style={`--lanes: ${lanes}`}
            role="group"
            aria-label="Employers"
          >
            {
              axis.marks
                .slice(1, -1)
                .map((m) => (
                  <span
                    class="year-rule"
                    style={`left: ${m.pct}%`}
                    aria-hidden="true"
                  />
                ))
            }
            {
              ordered.map(({ entry, i }) => (
                <button
                  type="button"
                  class="bar absolute"
                  style={`--l: ${axis.bar(entry).left}; --w: ${axis.bar(entry).width}; --lane: ${entry.lane}; --c: ${entry.accent}`}
                  data-select={i}
                  aria-label={`${entry.company}, ${entry.period}`}
                  aria-current={i === initialIndex ? "true" : "false"}
                >
                  <span class="bar-label font-mono text-[10px] lg:text-[11px] leading-none tracking-[-0.02em] whitespace-nowrap">
                    {entry.company}
                  </span>
                </button>
              ))
            }
            <span class="head-track" aria-hidden="true"
              ><span class="head"></span></span
            >
          </div>
          <div class="marks relative h-3 mt-2" aria-hidden="true">
            {
              axis.marks.map((m, k) => (
                <span
                  class="mark absolute top-0 font-mono text-[10px] leading-none tracking-[-0.02em] text-n-500 whitespace-nowrap"
                  style={`left: ${m.pct}%`}
                  data-edge={
                    k === 0
                      ? "start"
                      : k === axis.marks.length - 1
                        ? "end"
                        : undefined
                  }
                >
                  {m.label}
                </span>
              ))
            }
          </div>
        </div>

        <!-- ── Entries, stacked in one grid cell so the block never re-flows
             as they switch ── -->
        <div class="stack relative grid">
          {
            entries.map((entry, i) => (
              <article
                class="panel"
                data-panel={i}
                data-on={i === initialIndex ? "true" : "false"}
                aria-hidden={i === initialIndex ? "false" : "true"}
                inert={i !== initialIndex}
              >
                <h3
                  class="name font-display text-n-100 leading-[0.9] tracking-[-0.035em]"
                  aria-label={entry.company}
                >
                  {entry.company.split(" ").map((word, w, words) => (
                    <span class="inline-block overflow-hidden pb-[0.15em] -mb-[0.15em] align-top">
                      {[...word].map((ch, c) => (
                        <span
                          class="ch inline-block"
                          style={`--ci: ${c + words.slice(0, w).join("").length}`}
                          aria-hidden="true"
                        >
                          {ch}
                        </span>
                      ))}
                      {w < words.length - 1 && (
                        <span aria-hidden="true">&nbsp;</span>
                      )}
                      {w === words.length - 1 && (
                        <span class="logo-slot" aria-hidden="true">
                          <span
                            class="ch logo"
                            style={`--ci: ${words.join("").length}`}
                            set:html={entry.logo}
                          />
                        </span>
                      )}
                    </span>
                  ))}
                </h3>

                <div class="grid lg:grid-cols-12 gap-5 lg:gap-x-6 mt-5 lg:mt-10">
                  <div class="in lg:col-span-3 pt-1.5" style="--i: 1">
                    <p class="font-mono text-[12px] lg:text-[13px] leading-none tracking-[-0.02em] uppercase text-n-100">
                      {entry.title}
                    </p>
                    <p class="mt-2.5 font-mono text-[12px] leading-none tracking-[-0.02em] text-n-500 tabular-nums">
                      <time datetime={entry.start}>
                        {monthYear(entry.start)}
                      </time>
                      {" — "}
                      {entry.end ? (
                        <time datetime={entry.end}>{monthYear(entry.end)}</time>
                      ) : (
                        "Now"
                      )}
                    </p>
                    <ul
                      class="hidden lg:flex flex-col gap-2.5 mt-9"
                      aria-label="Focus"
                    >
                      {entry.skills.map((skill) => (
                        <li class="flex items-center gap-2.5 font-mono text-[12px] leading-none tracking-[-0.02em] uppercase text-n-300">
                          <span class="dash w-3 h-px" aria-hidden="true" />
                          {skill}
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div class="lg:col-span-7 xl:col-span-6 max-w-[640px]">
                    <p
                      class="desc in font-display text-[16px] lg:text-[18px] leading-[1.6] text-n-300"
                      style="--i: 2"
                    >
                      {entry.description}
                    </p>
                    <p
                      class="in lg:hidden font-mono text-[11px] leading-[1.7] tracking-[-0.02em] uppercase text-n-300 mt-4"
                      style="--i: 3"
                    >
                      {entry.skills.join("  ·  ")}
                    </p>
                    <p
                      class="in font-mono text-[12px] leading-[1.7] tracking-[-0.02em] text-n-500 mt-2 lg:mt-5"
                      style="--i: 3"
                    >
                      {entry.tags.join("  /  ")}
                    </p>
                    <div class="in" style="--i: 4">
                      <ActionButton
                        href={entry.url}
                        icon="external"
                        variant="solid-dark"
                        size="sm"
                        caps
                        target="_blank"
                        rel="noopener noreferrer"
                        class="mt-5 lg:mt-8"
                      >
                        Visit {entry.company}
                      </ActionButton>
                    </div>
                  </div>
                </div>
                <span class="sr-only">
                  Entry {stepOf.get(i)} of {N}
                </span>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .inner {
    display: flex;
    flex-direction: column;
  }

  .axis {
    order: 0;
    padding-top: 20px;
  }

  .stack {
    order: 1;
    margin-top: 28px;
  }

  @media (min-width: 1024px) {
    .inner {
      padding-top: 11svh;
    }

    .stack {
      order: 0;
      margin-top: 0;
    }

    .axis {
      order: 1;
      margin-top: auto;
      padding-top: 0;
      padding-bottom: 7svh;
    }
  }

  .stack > .panel {
    grid-area: 1 / 1;
  }

  .panel[data-on="false"] {
    pointer-events: none;
  }

  /* The name and its logo always share one line: the longest of them
     ("Artesian Builds" plus the logo) runs to just under 8em, so below
     ~440px the size tracks the container width (the viewport less the
     2rem gutter) instead of the fluid ramp. */
  .name {
    font-size: clamp(
      2rem,
      min(3.25rem + (100vw - 27.5rem) * 0.09, (100vw - 2rem) / 8),
      10rem
    );
  }

  /* The logo sits on the baseline after the last word (inside its span, so
     it never wraps onto a line of its own), about as tall as a capital.
     Once the script's morph canvas is up it draws the logo over this slot,
     gliding from slot to slot, and the inline SVGs stand down; without
     WebGL2 they stay, and roll over with the letters. */
  .logo-slot {
    display: inline-block;
    width: 0.7em;
    height: 0.7em;
    margin-left: 0.18em;
  }

  /* A touch larger on phones and tablets, where the name is smaller. */
  @media (max-width: 1023px) {
    .logo-slot {
      width: 0.8em;
      height: 0.8em;
    }
  }

  .logo-slot .logo,
  .logo-slot :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  #career[data-morph] .logo-slot .logo {
    visibility: hidden;
  }

  /* Short phones: the longest entry has to fit under the axis. */
  @media (max-width: 1023px) and (max-height: 740px) {
    .stack {
      margin-top: 18px;
    }

    .name {
      font-size: min(2.75rem, (100vw - 2rem) / 8);
    }

    .desc {
      font-size: 15px;
      line-height: 1.5;
    }
  }

  /* The accent follows the company on show (--accent, blended by the script
     below), so the foreground carries the colour of the orb behind it. */
  .dash {
    background: var(--accent);
  }

  .panel :global(.ab[data-variant]) {
    --ab-blob: var(--accent);
    --ab-bg-h: var(--accent);
    --ab-line-h: var(--accent);
  }

  /* ── Gantt ── */
  .chart {
    height: calc(var(--lanes) * 22px + (var(--lanes) - 1) * 6px);
    border-left: 1px solid rgb(255 255 255 / 0.12);
    border-right: 1px solid rgb(255 255 255 / 0.12);
  }

  @media (min-width: 1024px) {
    .chart {
      height: calc(var(--lanes) * 30px + (var(--lanes) - 1) * 8px);
    }
  }

  .year-rule {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: rgb(255 255 255 / 0.06);
  }

  .mark {
    transform: translateX(-50%);
  }

  .mark[data-edge="start"] {
    transform: none;
  }

  .mark[data-edge="end"] {
    transform: translateX(-100%);
  }

  /* --l / --w are the bar's left and width in % of the axis; set by the
     script as well as here. Each bar gives up 1px a side so bars that meet
     end to end in a lane still read as two. */
  .bar {
    left: calc(var(--l) * 1% + 1px);
    width: calc(var(--w) * 1% - 2px);
    top: calc(var(--lane) * (100% + 6px) / var(--lanes));
    height: calc((100% - (var(--lanes) - 1) * 6px) / var(--lanes));
    min-width: 6px;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.06);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
    cursor: pointer;
    transition:
      background-color 0.35s ease,
      box-shadow 0.35s ease;
  }

  .bar:hover {
    background: color-mix(in srgb, var(--c) 18%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--c) 50%, transparent);
  }

  .bar[aria-current="true"] {
    background: color-mix(in srgb, var(--c) 85%, transparent);
    box-shadow:
      inset 0 0 0 1px var(--c),
      0 0 24px color-mix(in srgb, var(--c) 45%, transparent);
  }

  /* Labels sit inside their bars; below lg the bars are too short for
     them, and the name is on screen in full anyway. */
  .bar-label {
    position: absolute;
    top: 50%;
    left: 8px;
    right: 4px;
    overflow: hidden;
    transform: translateY(-50%);
    text-align: left;
    color: var(--color-n-400);
    transition: color 0.35s ease;
    pointer-events: none;
  }

  .bar[aria-current="true"] .bar-label {
    color: var(--color-n-950);
  }

  @media (max-width: 1023px) {
    .bar-label {
      display: none;
    }
  }

  /* The playhead rides a full-width track that the script slides with a
     transform (in px, snapped to device pixels), so sweeping it costs a
     repaint of the head alone instead of a style and layout pass over the
     chart every scroll frame. The transform carries the head's 1px centring
     offset too, so the snapped edge is the one that is drawn. Deliberately
     not its own layer (no will-change): a composited layer lands on
     fractional device pixels on 2.625x/3x screens and softens the line. */
  .head-track {
    position: absolute;
    top: -8px;
    bottom: -8px;
    left: 0;
    right: 0;
    pointer-events: none;
    transform: translateX(-1px);
  }

  .head {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 2px;
    border-radius: 2px;
    background: var(--color-n-100);
    box-shadow: 0 0 12px rgb(255 255 255 / 0.5);
    pointer-events: none;
  }

  .head::before {
    content: "";
    position: absolute;
    top: -3px;
    left: 50%;
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background: var(--color-n-100);
    transform: translateX(-50%);
  }

  /* ── Hand-off ──
     Driven from the script below, not CSS transitions: a transition that is
     retargeted mid-flight drops its velocity and restarts its curve (and
     sits out its delay first), which stutters when the scroll outruns it.
     Until the script takes over, only the entry on show is visible. */
  .panel[data-on="false"] {
    visibility: hidden;
  }
</style>

<script>
  import {
    axisAt,
    entries,
    logoPaint,
    logoPath,
    nowYear,
    ordered,
  } from "../data/career";
  import type { LogoMorph } from "../scripts/logo-morph";
  import { docTop, onLayoutChange } from "../lib/layout-watch";
  {
    const section = document.querySelector<HTMLElement>("#career");
    if (section) {
      const pin = section.querySelector<HTMLElement>(".pin")!;
      const bars = section.querySelectorAll<HTMLElement>(".bar");
      const panels = section.querySelectorAll<HTMLElement>(".panel");
      const chart = section.querySelector<HTMLElement>(".chart")!;
      const headTrack = chart.querySelector<HTMLElement>(".head-track")!;
      // The accent's only consumers. Set on them rather than on the section,
      // a custom property changed there restyles every element in Career
      // (it inherits all the way down) on each frame of the blend.
      const accentEls = section.querySelectorAll<HTMLElement>(
        ".dash, .panel .ab[data-variant]",
      );
      const readout = section.querySelector<HTMLElement>(".readout")!;
      const stack = section.querySelector<HTMLElement>(".stack")!;


      // ── Axis ──
      // The axis runs to today, and the page may have been built months ago,
      // so lay it out again from this visitor's clock: bars, year marks, and
      // where each entry's bar starts, which is where the playhead heads for.
      const now = nowYear();
      const axis = axisAt(now);
      bars.forEach((bar) => {
        const { entry } = ordered.find(
          ({ i }) => i === Number(bar.dataset.select),
        )!;
        const { left, width } = axis.bar(entry);
        bar.style.setProperty("--l", String(left));
        bar.style.setProperty("--w", String(width));
      });
      chart.querySelectorAll(".year-rule").forEach((el) => el.remove());
      for (const m of axis.marks.slice(1, -1)) {
        const rule = document.createElement("span");
        rule.className = "year-rule";
        rule.style.left = `${m.pct}%`;
        rule.setAttribute("aria-hidden", "true");
        chart.prepend(rule);
      }
      const marks = section.querySelector<HTMLElement>(".marks")!;
      const markTpl = marks.firstElementChild!;
      marks.replaceChildren(
        ...axis.marks.map((m, k) => {
          const el = markTpl.cloneNode() as HTMLElement;
          el.textContent = m.label;
          el.style.left = `${m.pct}%`;
          if (k === 0) el.dataset.edge = "start";
          else if (k === axis.marks.length - 1) el.dataset.edge = "end";
          else delete el.dataset.edge;
          return el;
        }),
      );
      const stepPct = ordered.map(({ entry }) => axis.bar(entry).left);
      const stepMap: number[] = JSON.parse(section.dataset.stepMap || "[]");
      const stepAccent: string[] = JSON.parse(
        section.dataset.stepAccent || "[]",
      );
      const N = stepMap.length;

      // ── Accent blend ──
      // The accent follows the selected entry, but crosses over in the stretch
      // of scroll just before each hand-off instead of cutting, so it moves
      // with the orb colours behind it — and is whole again the frame the new
      // entry takes over (which is also where a jump-click lands).
      const hex = (h: string) => [
        parseInt(h.slice(1, 3), 16),
        parseInt(h.slice(3, 5), 16),
        parseInt(h.slice(5, 7), 16),
      ];
      const accents = stepAccent.map(hex);
      const BLEND = 0.35; // length of the cross-over, in entries
      const accentAt = (pages: number) => {
        const a = Math.max(0, Math.min(Math.floor(pages + 0.01), N - 1));
        let b = a;
        let t = 0;
        const x = (pages - (a + 1 - BLEND)) / BLEND;
        if (a + 1 <= N - 1 && x > 0) {
          b = a + 1;
          const c = Math.min(x, 1);
          t = c * c * (3 - 2 * c);
        }
        const c = accents[a].map((v, j) =>
          Math.round(v + (accents[b][j] - v) * t),
        );
        return `rgb(${c[0]} ${c[1]} ${c[2]})`;
      };

      // ── Hand-off motion ──
      // Every moving piece — each letter of the name, each block of copy —
      // carries one value s: 0 at rest, ±1 fully off (+ is below). It is
      // integrated frame by frame rather than tweened, so whenever the target
      // changes mid-flight the piece keeps the position and speed it had and
      // simply bends toward the new one: no restarts, no jumps.
      //
      //   leaving  — constant acceleration away from rest (ease-in), keeping
      //              whatever velocity it already had.
      //   arriving — a critically damped spring to rest. From off-screen it
      //              is launched at the spring's own speed, which traces a
      //              pure ease-out; from mid-flight it just curves back.
      //
      // Delays (the letter stagger) only postpone the switch: the piece keeps
      // moving the old way meanwhile, instead of freezing as a CSS
      // transition-delay would.
      type Kind = {
        draw: (el: HTMLElement, s: number) => void;
        accel: number; // leaving, in s-units per second²
        omega: number; // arriving spring stiffness, rad/s
      };
      type Piece = {
        el: HTMLElement;
        kind: Kind;
        delayIn: number; // ms, when arriving from off-screen
        delayOut: number; // ms
        s: number;
        v: number;
        mode: "idle" | "in" | "out";
        side: number; // leaving: the side it heads for; arriving: comes from
        next: { mode: "in" | "out"; side: number; at: number } | null;
      };

      // Letters travel 1.25em. The lowest descender (the q in Squib) hangs
      // 1.04em below the top of its letter box, and the tallest ascender sits
      // 0.1em inside it; the clip runs from the box top to 1.05em (the h3's
      // 0.15em bottom padding), so this clears it both ways with room over.
      // They dim to 0.25 as they go and brighten from it as they land.
      const LETTER: Kind = {
        draw: (el, s) => {
          el.style.transform = s
            ? `translate3d(0, ${(s * 1.25).toFixed(4)}em, 0)`
            : "";
          el.style.opacity = s
            ? String(1 - 0.75 * Math.min(1, Math.abs(s) / 0.8))
            : "";
        },
        accel: 2 / 0.36 ** 2, // clears the clip in 0.36s from rest
        omega: 8,
      };
      const COPY: Kind = {
        draw: (el, s) => {
          el.style.transform = s
            ? `translate3d(0, ${(s * 16).toFixed(2)}px, 0)`
            : "";
          el.style.opacity = s ? String(1 - Math.min(1, Math.abs(s))) : "";
        },
        accel: 2 / 0.3 ** 2,
        omega: 8,
      };

      const piecesOf = new Map<HTMLElement, Piece[]>();
      panels.forEach((panel) => {
        const on = panel.dataset.on === "true";
        const make = (
          el: HTMLElement,
          kind: Kind,
          delayIn: number,
          delayOut: number,
        ): Piece => {
          const p: Piece = {
            el,
            kind,
            delayIn,
            delayOut,
            s: on ? 0 : 1,
            v: 0,
            mode: "idle",
            side: 1,
            next: null,
          };
          kind.draw(el, p.s);
          return p;
        };
        piecesOf.set(panel, [
          ...[...panel.querySelectorAll<HTMLElement>(".ch")].map((el) => {
            const ci = Number(el.style.getPropertyValue("--ci")) || 0;
            return make(el, LETTER, 100 + ci * 22, ci * 20);
          }),
          ...[...panel.querySelectorAll<HTMLElement>(".in")].map((el) => {
            const i = Number(el.style.getPropertyValue("--i")) || 0;
            return make(el, COPY, 160 + i * 60, 0);
          }),
        ]);
      });

      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      );
      const hidden = (p: Piece) => Math.abs(p.s) >= 1;

      const advance = (p: Piece, t: number, dt: number) => {
        if (p.next && t >= p.next.at) {
          const { mode, side } = p.next;
          p.next = null;
          p.side = side;
          if (mode === "in" && hidden(p)) {
            // Off-screen, so it can be moved to the side it enters from.
            p.s = side;
            p.v = -p.kind.omega * side;
          }
          p.mode = mode === "out" && hidden(p) && p.v === 0 ? "idle" : mode;
        }
        if (p.mode === "in") {
          const w = p.kind.omega;
          p.v += (-w * w * p.s - 2 * w * p.v) * dt;
          p.s += p.v * dt;
          if (Math.abs(p.s) < 2e-4 && Math.abs(p.v) < 2e-3) {
            p.s = 0;
            p.v = 0;
            p.mode = "idle";
          }
        } else if (p.mode === "out") {
          p.v += p.side * p.kind.accel * dt;
          p.s += p.v * dt;
          if (hidden(p) && Math.sign(p.v) === Math.sign(p.s)) {
            p.s = Math.sign(p.s);
            p.v = 0;
            p.mode = "idle";
          }
        }
      };

      let running = false;
      let lastT = 0;
      const tick = (t: number) => {
        // Capped so a backgrounded tab resumes where it left off rather than
        // leaping; split into small steps so the spring stays exact.
        const total = Math.min(t - lastT, 64) / 1000;
        lastT = t;
        const n = Math.max(1, Math.ceil(total / 0.004));
        let busy = false;
        piecesOf.forEach((pieces, panel) => {
          let shown = panel.dataset.on === "true";
          for (const p of pieces) {
            if (p.mode === "idle" && !p.next) continue;
            const s0 = p.s;
            for (let k = 0; k < n; k++) advance(p, t, total / n);
            if (p.s !== s0) p.kind.draw(p.el, p.s);
            if (p.mode !== "idle" || p.next) busy = true;
          }
          if (!shown) shown = pieces.some((p) => !hidden(p));
          panel.style.visibility = shown ? "visible" : "";
        });
        if (busy) requestAnimationFrame(tick);
        else running = false;
      };
      const kick = () => {
        if (running) return;
        running = true;
        lastT = performance.now();
        requestAnimationFrame(tick);
      };

      // dir: +1 scrolling down (old leaves upward, new arrives from below).
      const handOff = (panel: HTMLElement, on: boolean, dir: number) => {
        const pieces = piecesOf.get(panel)!;
        if (reduceMotion.matches) {
          for (const p of pieces) {
            p.s = on ? 0 : 1;
            p.v = 0;
            p.mode = "idle";
            p.next = null;
            p.kind.draw(p.el, p.s);
          }
          panel.style.visibility = on ? "visible" : "";
          return;
        }
        const now = performance.now();
        for (const p of pieces) {
          // A piece still in view turns around at once (with a small ripple
          // across the word); one that is out of sight waits its turn.
          const delay = on
            ? hidden(p)
              ? p.delayIn
              : p.delayOut / 2
            : p.delayOut;
          p.next = {
            mode: on ? "in" : "out",
            side: on ? dir : -dir,
            at: now + delay,
          };
        }
        kick();
      };

      // ── Logo ──
      // One canvas for every entry's logo (see scripts/logo-morph.ts), laid
      // over the slot after the name on show. If WebGL goes, the inline SVGs
      // in the slots take back over.
      //
      // Nothing of it is built while the page is loading: its context, its
      // shader and its distance fields shouldn't compete with the page's
      // first seconds. It starts once the page has loaded and gone idle (as
      // the footer photo does), or sooner if the section comes within a
      // screen of view first. Not later than that: the fields are built in a
      // worker, so starting early costs the main thread only the context and
      // shader, and it means they are all in before anyone scrolls this far —
      // otherwise the first one to be needed would be built there and then,
      // on the main thread, mid-scroll. The SVGs are the logo until the first
      // field is in (see logoMorph's onReady); at rest the canvas draws
      // exactly what they show, so the hand-over is invisible. `morph` stays
      // null until it has happened, so everything below treats the canvas as
      // absent until it can draw.
      //
      // Its code is fetched then too, rather than with the page: it is half
      // of this script, shaders and all, and none of it runs before this. A
      // failed fetch leaves the SVGs, as no WebGL does.
      let morph: LogoMorph | null = null;
      let morphStarted = false;
      const startMorph = () => {
        if (morphStarted) return;
        morphStarted = true;
        nearIO.disconnect();
        import("../scripts/logo-morph")
          .then(({ logoMorph }) => {
            const m = logoMorph(
              entries.map((e) => ({ path: logoPath(e), paint: logoPaint(e) })),
              stepMap[Math.max(activeStep, 0)],
              () => {
                morph = null;
                delete section.dataset.morph;
                m?.canvas.remove();
              },
              () => {
                if (!m) return;
                stack.append(m.canvas);
                morph = m;
                if (activeStep < 0) return;
                morph.show(stepMap[activeStep], true);
                placeLogo(true);
                section.dataset.morph = "";
              },
            );
          })
          .catch(() => {});
      };
      const nearIO = new IntersectionObserver(
        (seen) => {
          if (seen.some((e) => e.isIntersecting)) startMorph();
        },
        { rootMargin: "100% 0px" },
      );
      nearIO.observe(section);
      const whenIdle = () =>
        "requestIdleCallback" in window
          ? requestIdleCallback(startMorph, { timeout: 2000 })
          : setTimeout(startMorph, 200);
      if (document.readyState === "complete") whenIdle();
      else addEventListener("load", whenIdle, { once: true });
      // Headed left, for a shorter name, the logo would cross the old name
      // on its way out. Those letters leave left to right, 20ms apart, and
      // take about a third of a second to clear, so it holds until the last
      // of them is nearly gone.
      //
      // Each entry's slot, as a box in the stack (where the canvas sits), is
      // measured with the rest of the layout in measure() below rather than
      // read back here: this runs inside the scroll frame, on the very frame
      // an entry hands over, after select() has just written to every panel,
      // so reading a rect would force a style and layout pass of the whole
      // section right as its letters set off. The panels all share one grid
      // cell and keep their layout while hidden, and the stack carries the
      // canvas with it as the pin sticks, so a slot's place in the stack only
      // changes when layout does.
      type Slot = { x: number; y: number; size: number; letters: number };
      const slots = new Map<number, Slot>();
      const slotEls = new Map<number, Element>();
      panels.forEach((panel) => {
        const key = Number(panel.dataset.panel);
        slotEls.set(key, panel.querySelector(".logo-slot")!);
        slots.set(key, {
          x: 0,
          y: 0,
          size: 0,
          letters: panel.querySelectorAll(".ch:not(.logo)").length,
        });
      });
      const measureSlots = () => {
        const s = stack.getBoundingClientRect();
        slotEls.forEach((el, key) => {
          const r = el.getBoundingClientRect();
          const slot = slots.get(key)!;
          slot.x = r.left - s.left;
          slot.y = r.top - s.top;
          slot.size = r.width;
        });
      };
      let logoX = NaN;
      let letters = 0;
      const placeLogo = (instant: boolean) => {
        if (!morph || activeStep < 0) return;
        const { x, y, size, letters: count } = slots.get(stepMap[activeStep])!;
        const delay = x < logoX - 1 ? 260 + (letters - 1) * 20 : 0;
        logoX = x;
        letters = count;
        morph.place(x, y, size, instant, delay);
      };
      // After a layout change the slot is only measured again. On phones,
      // resize fires every time the address bar slides in or out, which
      // happens mid-scroll; cutting the glide to its end there made the
      // logo stutter back and forth. Reflowing keeps it moving and just
      // shifts where it lands.
      const reflowLogo = () => {
        if (!morph || activeStep < 0) return;
        const { x, y, size } = slots.get(stepMap[activeStep])!;
        logoX = x;
        morph.reflow(x, y, size);
      };

      // ── Selection ──
      let activeStep = -1;
      const select = (step: number) => {
        const dir = activeStep < 0 || step >= activeStep ? 1 : -1;
        const first = activeStep < 0;
        activeStep = step;
        const key = String(stepMap[step]);
        bars.forEach((b) =>
          b.setAttribute("aria-current", String(b.dataset.select === key)),
        );
        panels.forEach((panel) => {
          const on = panel.dataset.panel === key;
          const was = panel.dataset.on === "true";
          panel.dataset.on = String(on);
          panel.setAttribute("aria-hidden", String(!on));
          panel.inert = !on;
          if (on !== was && !first) handOff(panel, on, dir);
        });
        // The first selection only confirms (or corrects) the server-rendered
        // entry, so it cuts rather than animating in on page load.
        if (first)
          panels.forEach((panel) => {
            const on = panel.dataset.on === "true";
            for (const p of piecesOf.get(panel)!) {
              p.s = on ? 0 : 1;
              p.kind.draw(p.el, p.s);
            }
          });
        if (morph) {
          const instant = first || reduceMotion.matches;
          morph.show(stepMap[step], instant);
          placeLogo(instant);
          section.dataset.morph = "";
        }
      };

      // Scroll-pin: map progress through the tall section to the playhead
      // (bar to bar, then out to the axis end) and the active entry (flips
      // when the playhead lands on the next bar). Everything is written only
      // when it changes.
      let lastP = -1;
      let lastX = NaN;
      let lastAccent = "";
      let lastLabel = "";
      const render = (p: number) => {
        if (p === lastP) return;
        lastP = p;
        // pages: 0..N. Pages [0, N-1] step through the entries; the last page
        // [N-1, N] is the run-out.
        const pages = p * N;

        let yr: number;
        if (N <= 1) yr = stepPct[0] ?? 0;
        else if (pages <= N - 1) {
          const s = Math.max(0, Math.min(Math.floor(pages), N - 2));
          yr = stepPct[s] + (stepPct[s + 1] - stepPct[s]) * (pages - s);
        } else {
          yr =
            stepPct[N - 1] +
            (100 - stepPct[N - 1]) * Math.min(pages - (N - 1), 1);
        }
        // The head's left edge (1px left of centre), snapped to the device
        // pixel `left` used to land it on: rounded where it lands on screen,
        // since the chart itself can start part-way into a pixel.
        const dpr = window.devicePixelRatio || 1;
        const x =
          Math.round((chartX + (+yr.toFixed(3) / 100) * chartW - 1) * dpr) /
            dpr -
          chartX;
        if (x !== lastX) {
          lastX = x;
          headTrack.style.transform = `translateX(${x}px)`;
        }

        // Read-out of where the playhead is, to the month.
        // Capped at today: in a job's first month the axis runs on to the
        // end of that month.
        const t = Math.min(axis.year(yr), now);
        // (The epsilon keeps a bar start like 2021 + 4/12 from reading as April.)
        const mo = Math.min(12, Math.floor((t % 1) * 12 + 1e-6) + 1);
        const label = `${Math.floor(t)}.${String(mo).padStart(2, "0")}`;
        if (label !== lastLabel) {
          lastLabel = label;
          readout.textContent = label;
        }

        const accent = accentAt(pages);
        if (accent !== lastAccent) {
          lastAccent = accent;
          for (const el of accentEls) el.style.setProperty("--accent", accent);
        }

        // Small bias so arriving at a bar selects it even when the scroll
        // position lands a sub-pixel short of the exact page boundary.
        const step = Math.max(0, Math.min(Math.floor(pages + 0.01), N - 1));
        if (step !== activeStep) select(step);
      };

      // Register the pin's entry/exit scroll positions as soft barriers so the
      // smooth-scroll engine eases into and out of the lock instead of
      // snapping. Both are scroll-invariant, so they are only published when
      // they change (resize or a late layout shift).
      let lastTop = NaN;
      let lastTv = NaN;
      const registerBarriers = (top: number, tv: number) => {
        const setBarriers = (window as any).__setScrollBarriers as
          ((ys: number[]) => void) | undefined;
        if (!setBarriers) return;
        if (top === lastTop && tv === lastTv) return;
        lastTop = top;
        lastTv = tv;
        setBarriers(tv > 0 ? [top, top + tv] : []);
      };

      // Scroll-invariant, so it is measured here and read from cache in the
      // scroll frame — offsetHeight in a scroll handler forces a synchronous
      // layout on every frame, page-wide, and this section is several
      // viewports tall.
      let travelPx = 0;
      // The playhead's track spans the chart's padding box, as `left: %` did:
      // its unrounded width and on-screen left edge (the pin is sticky, so
      // scrolling never moves it sideways).
      let chartW = 0;
      let chartX = 0;
      // The section moves only with the page (the pin inside it is what
      // sticks), so its document top is cached too and the frame's rect.top
      // is sectionTop - scrollY.
      let sectionTop = 0;
      const measure = () => {
        travelPx = section.offsetHeight - pin.offsetHeight;
        sectionTop = docTop(section);
        const r = chart.getBoundingClientRect();
        const w = r.width - 2 * chart.clientLeft;
        const x = r.left + chart.clientLeft;
        if (w !== chartW || x !== chartX) {
          chartW = w;
          chartX = x;
          lastP = -1; // the playhead's px position moves with them
        }
        measureSlots();
      };

      // On the shared bus this runs inside the engine's tick — the same frame
      // as its scrollTo — so __scrollProgressLead reports the entry-brake lead
      // the engine set this very frame and the pin scrubs *during* the
      // deceleration with no one-frame trail.
      const frame = (y = window.scrollY) => {
        const top = sectionTop - y;
        const tv = travelPx;
        const lead =
          (
            (window as any).__scrollProgressLead as (() => number) | undefined
          )?.() ?? 0;
        const p =
          tv > 0 ? Math.max(0, Math.min((-top + lead) / tv, 1)) : 0;
        registerBarriers(sectionTop, tv);
        render(p);
      };

      (window as any).__onSmoothScrollTick(frame);
      // Resizes, font loads (the name reflows when the display face
      // arrives, moving the slot) and anything above shifting the section.
      // travelPx is derived from the section's and the pin's boxes, so
      // watching them directly is what keeps the cache honest between resize
      // events; the chart for the playhead, and the stack because the logo's
      // slot moves whenever the entries reflow.
      onLayoutChange(
        measure,
        (y) => {
          frame(y);
          reflowLogo();
        },
        [section, pin, chart, stack],
      );

      // Clicking a bar scrolls the page to that entry's slot in the pin,
      // reusing the site's smooth-scroll easing. Selection then follows the
      // scroll, so the entries scrub through en route rather than flashing.
      bars.forEach((el) => {
        el.addEventListener("click", () => {
          const step = stepMap.indexOf(Number(el.dataset.select));
          if (step < 0) return;
          // step k is reached at pages = k, i.e. progress k/N (never in run-out).
          const targetP = N > 0 ? step / N : 0;
          const y =
            section.getBoundingClientRect().top +
            window.scrollY +
            targetP * travelPx;
          const smooth = (window as any).__smoothScrollTo as
            ((y: number) => void) | undefined;
          if (smooth) smooth(y);
          else window.scrollTo(0, y);
        });
      });
    }
  }
</script>
