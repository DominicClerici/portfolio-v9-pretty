---
const RANGE_START = 2019
const RANGE_END = 2027
const SPAN = RANGE_END - RANGE_START

const entries = [
  {
    period: "2025 — Now",
    year: "2025",
    start: 2025,
    end: 2026.5,
    lane: 0,
    now: true,
    company: "Rumor",
    title: "Full Stack Developer",
    description:
      "Building the platform behind Rumor — a private network connecting people to exclusive cultural events. Most of my time goes toward the host dashboard and mobile apps, everything from event creation and guest management to real-time analytics. Small team, so I touch most of the stack, from the database layer up to what users see on their phones.",
    skills: ["Full Stack", "Mobile", "Cloud Infrastructure"],
    tags: [
      "TypeScript",
      "PostgreSQL",
      "AWS Lambda",
      "Next.js",
      "React Native",
      "Swift",
    ],
    url: "https://www.therumor.com/",
  },
  {
    period: "2024 — 2026",
    year: "2024",
    start: 2024,
    end: 2026,
    lane: 1,
    now: false,
    company: "Squib",
    title: "Founding Engineer",
    description:
      "First engineer at an AI research lab building autonomous agents that model human behavior. I helped build Persona, a product that creates AI-powered social profiles — digital twins that grow audiences and predict how communities will respond before a campaign launches. Early-stage startup, so I had my hands in everything from agent architecture to the product interface.",
    skills: ["AI/ML", "Autonomous Agents", "Growth Engineering"],
    tags: ["Go", "TypeScript", "Python", "PostgreSQL"],
    url: "https://www.heysquib.com/",
  },
  {
    period: "2021 — 2022",
    year: "2021",
    start: 2021,
    end: 2022,
    lane: 0,
    now: false,
    company: "Artesian Builds",
    title: "Full Stack Developer",
    description:
      "Helped overhaul the company website — better design, tighter SEO, load times dropped about 40%. Also built internal tools for tracking sponsorship metrics and Twitch creator stats, which gave management real numbers instead of gut feelings. Small team, learned a lot about wearing different hats and shipping quickly.",
    skills: ["Full Stack", "Internal Tooling", "SEO", "Data Analysis"],
    tags: ["WordPress", "Elementor", "Electron", "Python", "PostgreSQL"],
    url: "https://en.wikipedia.org/wiki/Artesian_Builds",
  },
  {
    period: "2019",
    year: "2019",
    start: 2019.05,
    end: 2019.85,
    lane: 0,
    now: false,
    company: "McDonald's",
    title: "Crew Member",
    description:
      "Got me my first car at 16 — a '93 Miata with 220k miles on it. I still think about that car more than I probably should.",
    skills: ["Deep Fryer", "Cash Register", "Drive-Thru", "Customer Service"],
    tags: ["Ice Cream Machine (Broken)", "McFlurry Assembly", "Headset Comms"],
    url: "https://www.mcdonalds.com/us/en-us.html",
  },
]

// Vertical axis: oldest at the top, so a year maps to distance from RANGE_START
const yPct = (v: number) => ((v - RANGE_START) / SPAN) * 100
const years = Array.from({ length: SPAN }, (_, i) => RANGE_START + i)

// Render order oldest-first while keeping each entry's original index for
// selection/hover-sync wiring (data-select/data-i key off the original i).
const orderedEntries = entries
  .map((entry, i) => ({ entry, i }))
  .slice()
  .reverse()

// Scroll-pin choreography ----------------------------------------------------
// Each entry gets one viewport of scroll, plus one extra "run-out" viewport
// after the last entry so the marker travels off the final pill to the end of
// the spine before the scroll releases. Total travel is therefore N viewports
// (N-1 to step through the entries + 1 to run out), so the section is N+1 tall.
const N = entries.length
const stepPct = orderedEntries.map(({ entry }) => yPct(entry.start))
// Desktop playhead rides the year-scaled positions so it lines up with the bars.
const railStart = stepPct[0]
// Mobile markers are evenly spaced, sitting in the first N-1/N of the rail; the
// trailing segment (last dot -> end) is the run-out, mirroring the desktop spine.
const evenPct = orderedEntries.map((_, s) => (N > 0 ? (s / N) * 100 : 0))
// step index (oldest-first) -> original entry index
const stepMap = orderedEntries.map(({ i }) => i)
// The section rests on the oldest entry when the pin engages (progress 0).
const initialIndex = stepMap[0]
---

<section
  class="career-v1 relative bg-[#0a0a0a]"
  style={`height: ${(N + 1) * 100}svh`}
  data-step-pct={JSON.stringify(stepPct)}
  data-step-map={JSON.stringify(stepMap)}
  aria-label="Career"
>
  <div class="v1-dots absolute inset-0 pointer-events-none" aria-hidden="true">
  </div>

  <!-- The pinned frame: everything inside stays in view while the tall section
       scrolls past, which reads as a scroll-lock without trapping the wheel. -->
  <div class="v1-pin sticky top-0 h-[100svh] overflow-hidden flex items-center">
    <div
      class="relative w-full max-w-[1524px] mx-auto px-6 lg:px-12 py-8 lg:py-0"
    >
      <p
        class="font-display font-normal text-[#f5f5f5] leading-[1.2] tracking-[-0.006em] max-w-[880px] text-[clamp(1.5rem,calc(1.5rem+(100vw-27.5rem)*0.018),2.5rem)] mb-6 lg:mb-12"
      >
        Time on one axis,
        <span class="text-white/45">the story on the other.</span>
      </p>

      <!-- Mobile: horizontal timeline above the card strip (oldest left). -->
      <div class="v1-railh lg:hidden relative h-8 mb-5" aria-hidden="true">
        <div class="v1-railh-inner absolute inset-x-[7px] top-1/2 -translate-y-1/2">
          <div class="v1-railh-track absolute inset-x-0 top-1/2 -translate-y-1/2">
          </div>
          <div class="v1-rail-fill-h absolute left-0 top-1/2 -translate-y-1/2" style="width: 0%">
          </div>
          {
            orderedEntries.map((_, s) => (
              <span
                class="v1-rail-marker-h absolute top-1/2"
                style={`left: ${evenPct[s]}%`}
              />
            ))
          }
          <div class="v1-rail-tip-h absolute top-1/2" style="left: 0%" />
        </div>
      </div>

      <div class="grid lg:grid-cols-[360px_1fr] gap-8 lg:gap-14 items-start">
        <!-- Rail: time spine + employer tabs -->
        <div class="lg:grid lg:grid-cols-[66px_1fr] lg:gap-5">
          <!-- The spine — V3's chart, rotated vertical -->
          <div class="v1-spine relative hidden lg:block">
            <div class="absolute inset-x-0 top-2 bottom-2">
              <!-- Progress playhead: a horizontal marker line that sweeps down the
                   timeline (top -> bottom), landing on each bar as it's selected. -->
              <div
                class="v1-playhead absolute left-0 right-0"
                style={`top: ${railStart}%`}
                aria-hidden="true"
              >
              </div>
              {
                years.map((y) => (
                  <div
                    class="absolute inset-x-0"
                    style={`top: ${yPct(y)}%`}
                    aria-hidden="true"
                  >
                    <span class="absolute left-0 top-0 -translate-y-1/2 font-mono text-[10px] leading-none tracking-[-0.02em] text-[#4d4d4d]">
                      {`'${String(y).slice(2)}`}
                    </span>
                    <span class="absolute left-7 right-0 top-0 border-t border-[#1b1b1b]" />
                  </div>
                ))
              }
              {
                orderedEntries.map(({ entry, i }) => (
                  <button
                    type="button"
                    class="v1-bar absolute w-[14px] rounded-full border border-[#333333]"
                    style={`top: ${yPct(entry.start)}%; height: ${yPct(entry.end) - yPct(entry.start)}%; left: ${30 + entry.lane * 20}px; --d: ${i * 120}ms`}
                    data-select={i}
                    data-i={i}
                    data-on={i === initialIndex ? "true" : "false"}
                    aria-label={`${entry.company}, ${entry.period}`}
                  >
                    {entry.now && (
                      <span
                        class="absolute -bottom-[2px] left-1/2 -translate-x-1/2 flex w-[7px] h-[7px]"
                        aria-hidden="true"
                      >
                        <span class="v1-ping absolute inline-flex h-full w-full rounded-full bg-bio-lime opacity-70" />
                        <span class="relative inline-flex rounded-full h-[7px] w-[7px] bg-bio-lime" />
                      </span>
                    )}
                  </button>
                ))
              }
            </div>
          </div>

          <!-- Tabs — list rows on desktop, chip strip on mobile -->
          <div
            class="flex lg:flex-col overflow-x-auto lg:overflow-visible gap-2 lg:gap-0 -mx-6 px-6 lg:mx-0 lg:px-0 pb-1 lg:pb-0"
            role="tablist"
            aria-label="Employers"
          >
            {
              orderedEntries.map(({ entry, i }) => (
                <button
                  type="button"
                  class="v1-tab group shrink-0 lg:w-full text-left"
                  role="tab"
                  aria-selected={i === initialIndex ? "true" : "false"}
                  data-select={i}
                  data-i={i}
                >
                  <span class="block">
                    <span class="font-mono text-[11px] leading-none tracking-[-0.02em] text-[#5f5f5f] block">
                      {entry.period}
                    </span>
                    <span class="v1-tab-name font-display font-normal leading-tight tracking-[-0.012em] text-[20px] lg:text-[24px] mt-1.5 inline-flex items-center gap-2.5">
                      <span
                        class="v1-tab-dot w-[6px] h-[6px] rounded-full bg-bio-lime shrink-0"
                        aria-hidden="true"
                      />
                      {entry.company}
                    </span>
                  </span>
                </button>
              ))
            }
          </div>
        </div>

        <!-- The dossier panel -->
        <div
          class="relative rounded-[20px] border border-[#232323] bg-[#0f0f0f] lg:min-h-[460px] overflow-hidden"
        >
          {
            entries.map((entry, i) => (
              <div
                class="v1-panel relative p-7 sm:p-9 lg:p-12"
                role="tabpanel"
                data-panel={i}
                hidden={i !== initialIndex}
              >
                {/* Ghost year watermark */}
                <span
                  class="absolute -top-8 right-2 font-display leading-none tracking-[-0.04em] text-white/[0.035] select-none pointer-events-none text-[clamp(9rem,18vw,15rem)]"
                  aria-hidden="true"
                >
                  {entry.year}
                </span>

                <div class="relative v1-enter">
                  <div class="flex items-center gap-2.5">
                    <span
                      class:list={[
                        "w-[6px] h-[6px] rounded-full",
                        entry.now ? "bg-bio-lime" : "bg-[#4a4a4a]",
                      ]}
                      aria-hidden="true"
                    />
                    <span class="font-mono text-[13px] leading-none tracking-[-0.02em] uppercase text-[#8a8a8a]">
                      {entry.period}&ensp;·&ensp;{entry.title}
                    </span>
                  </div>

                  <h3 class="font-display font-normal leading-[0.95] tracking-[-0.02em] text-[#f5f5f5] mt-6 text-[clamp(2.5rem,calc(2.5rem+(100vw-27.5rem)*0.028),4.5rem)]">
                    {entry.company}
                  </h3>

                  <p class="font-display text-[16px] lg:text-[17px] leading-[1.6] text-[#a8a8a8] max-w-[640px] mt-6 lg:mt-8">
                    {entry.description}
                  </p>

                  <div class="flex flex-wrap gap-x-6 gap-y-3 mt-8 lg:mt-10">
                    {entry.skills.map((skill) => (
                      <span class="inline-flex items-center gap-2">
                        <span
                          class="w-[6px] h-[6px] rounded-full bg-bio-lime"
                          aria-hidden="true"
                        />
                        <span class="font-mono text-[12px] leading-none tracking-[-0.02em] uppercase text-[#c9c9c9]">
                          {skill}
                        </span>
                      </span>
                    ))}
                  </div>
                  <div class="flex flex-wrap gap-x-4 gap-y-2 mt-5">
                    {entry.tags.map((tag) => (
                      <span class="font-mono text-[12px] leading-none tracking-[-0.02em] text-[#616161]">
                        {tag}
                      </span>
                    ))}
                  </div>

                  <div class="flex items-center gap-3 mt-10 lg:mt-12">
                    <a
                      href={entry.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-mono text-[13px] tracking-[-0.008em] text-[#f5f5f5] border border-[#3a3a3a] rounded-lg h-10 px-4 inline-flex items-center hover:border-[#8a8a8a] transition-colors duration-200"
                    >
                      Visit {entry.company}
                    </a>
                    <a
                      href={entry.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`Open ${entry.company} in a new tab`}
                      class="w-10 h-10 rounded-lg bg-bio-lime text-ink inline-flex items-center justify-center hover:-translate-y-0.5 transition-transform duration-200"
                    >
                      <svg
                        width="14"
                        height="14"
                        viewBox="0 0 14 14"
                        fill="none"
                        aria-hidden="true"
                      >
                        <path
                          d="M2 12 12 2M4.5 2H12v7.5"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </a>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .v1-dots {
    background-image: radial-gradient(
      circle,
      rgba(255, 255, 255, 0.05) 1px,
      transparent 1px
    );
    background-size: 26px 26px;
    /* Viewport-anchored so the grid lines up seamlessly with the quote
       section directly below (which uses the same fixed grid). */
    background-attachment: fixed;
  }

  /* Progress playhead — horizontal marker line (desktop), sweeps top -> bottom */
  .v1-playhead {
    height: 2px;
    background: #cef79e;
    transform: translateY(-50%);
    box-shadow: 0 0 8px rgba(206, 247, 158, 0.45);
  }

  .v1-playhead::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 8px;
    height: 8px;
    border-radius: 9999px;
    background: #cef79e;
    transform: translate(-3px, -50%);
    box-shadow: 0 0 0 4px rgba(206, 247, 158, 0.18);
  }

  /* Progress rail — horizontal (mobile) */
  .v1-railh-track,
  .v1-rail-fill-h {
    height: 2px;
    border-radius: 2px;
  }

  .v1-railh-track {
    background: #242424;
  }

  .v1-rail-fill-h {
    background: #cef79e;
  }

  .v1-rail-marker-h {
    width: 7px;
    height: 7px;
    border-radius: 9999px;
    background: #2a2a2a;
    border: 1px solid #3d3d3d;
    transform: translate(-50%, -50%);
  }

  .v1-rail-tip-h {
    width: 11px;
    height: 11px;
    border-radius: 9999px;
    background: #cef79e;
    box-shadow: 0 0 0 4px rgba(206, 247, 158, 0.18);
    transform: translate(-50%, -50%);
  }

  /* Spine bars */
  .v1-bar {
    background: #191919;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease;
  }

  .v1-bar:hover,
  .v1-bar.hl {
    border-color: rgba(206, 247, 158, 0.5);
    background: #232323;
  }

  .v1-bar[data-on="true"] {
    background: #cef79e;
    border-color: #cef79e;
  }

  /* Tabs */
  .v1-tab-name {
    color: #6e6e6e;
    transition: color 0.2s ease;
  }

  .v1-tab:hover .v1-tab-name,
  .v1-tab.hl .v1-tab-name {
    color: #bdbdbd;
  }

  .v1-tab[aria-selected="true"] .v1-tab-name {
    color: #f5f5f5;
  }

  .v1-tab-dot {
    opacity: 0;
    transform: scale(0.4);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }

  .v1-tab[aria-selected="true"] .v1-tab-dot {
    opacity: 1;
    transform: scale(1);
  }

  @media (min-width: 1024px) {
    .v1-tab {
      padding: 20px 0;
      border-top: 1px solid #222222;
      cursor: pointer;
    }

    .v1-tab:last-child {
      border-bottom: 1px solid #222222;
    }
  }

  @media (max-width: 1023px) {
    .v1-tab {
      border: 1px solid #2a2a2a;
      border-radius: 14px;
      padding: 12px 18px;
      background: #111111;
      cursor: pointer;
      white-space: nowrap;
    }

    .v1-tab[aria-selected="true"] {
      border-color: #4a4a4a;
      background: #191919;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Bars grow down the spine when it scrolls into view */
    .v1-bar {
      transform: scaleY(0);
      transform-origin: top center;
      transition:
        transform 0.9s cubic-bezier(0.33, 1, 0.68, 1) var(--d, 0ms),
        background-color 0.2s ease,
        border-color 0.2s ease;
    }

    .v1-spine.in .v1-bar {
      transform: scaleY(1);
    }

    .v1-ping {
      animation: v1-ping 2.2s cubic-bezier(0, 0, 0.2, 1) infinite;
    }

    @keyframes v1-ping {
      0% {
        transform: scale(1);
        opacity: 0.7;
      }
      75%,
      100% {
        transform: scale(3);
        opacity: 0;
      }
    }

    /* Panel content entrance on tab switch */
    .v1-enter {
      animation: v1-rise 0.5s cubic-bezier(0.33, 1, 0.68, 1) both;
    }

    @keyframes v1-rise {
      from {
        opacity: 0;
        transform: translateY(16px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
</style>

<script>
  {
    const section = document.querySelector<HTMLElement>(".career-v1")
    if (section) {
      const tabs = section.querySelectorAll<HTMLButtonElement>("[role='tab']")
      const bars = section.querySelectorAll<HTMLButtonElement>(".v1-bar")
      const panels = section.querySelectorAll<HTMLElement>("[data-panel]")
      const pin = section.querySelector<HTMLElement>(".v1-pin")

      const stepPct: number[] = JSON.parse(section.dataset.stepPct || "[]")
      const stepMap: number[] = JSON.parse(section.dataset.stepMap || "[]")
      const N = stepPct.length

      // Desktop: horizontal playhead, positioned in the spine's year-% space.
      const playhead = section.querySelector<HTMLElement>(".v1-playhead")
      // Mobile: evenly-spaced rail, so the tip travels linearly with progress.
      const fillH = section.querySelector<HTMLElement>(".v1-rail-fill-h")
      const tipH = section.querySelector<HTMLElement>(".v1-rail-tip-h")

      const select = (id: string | undefined) => {
        if (!id) return
        tabs.forEach((t) =>
          t.setAttribute("aria-selected", String(t.dataset.select === id)),
        )
        bars.forEach((b) =>
          b.setAttribute("data-on", String(b.dataset.select === id)),
        )
        panels.forEach((panel) => {
          const show = panel.dataset.panel === id
          panel.hidden = !show
          if (show) {
            // retrigger the entrance animation
            const inner = panel.querySelector<HTMLElement>(".v1-enter")
            if (inner) {
              inner.style.animation = "none"
              void inner.offsetWidth
              inner.style.animation = ""
            }
          }
        })
      }

      // Scroll-pin: map scroll progress through the tall section to a travelling
      // tip (marker to marker) and the active entry (flips when the tip lands on
      // the next pill).
      let activeStep = -1
      const travel = () =>
        section.offsetHeight - (pin?.offsetHeight ?? window.innerHeight)

      const render = (p: number) => {
        // pages: 0..N. Pages [0, N-1] step through the entries; the last page
        // [N-1, N] is the run-out that carries the marker to the spine's end.
        const pages = p * N

        // Desktop playhead (year-scaled, in the spine's coordinate space).
        let yearPct: number
        if (N <= 1) {
          yearPct = stepPct[0] ?? 0
        } else if (pages <= N - 1) {
          // Step phase: travel marker to marker, landing on each bar.
          const s = Math.max(0, Math.min(Math.floor(pages), N - 2))
          const f = pages - s
          yearPct = stepPct[s] + (stepPct[s + 1] - stepPct[s]) * f
        } else {
          // Run-out phase: from the last bar down to the end of the spine (100%).
          const runF = Math.min(pages - (N - 1), 1)
          yearPct = stepPct[N - 1] + (100 - stepPct[N - 1]) * runF
        }
        if (playhead) playhead.style.top = `${yearPct}%`

        // Mobile rail is evenly spaced with a trailing run-out segment, so the
        // tip is linear across the whole track (last dot at (N-1)/N, end at 1).
        const linPct = p * 100
        if (fillH) fillH.style.width = `${linPct}%`
        if (tipH) tipH.style.left = `${linPct}%`

        // Small bias so arriving at a marker selects it even when the scroll
        // position lands a sub-pixel short of the exact page boundary.
        const step = Math.max(0, Math.min(Math.floor(pages + 0.01), N - 1))
        if (step !== activeStep) {
          activeStep = step
          select(String(stepMap[step]))
        }
      }

      let ticking = false
      const onScroll = () => {
        if (ticking) return
        ticking = true
        requestAnimationFrame(() => {
          ticking = false
          const rect = section.getBoundingClientRect()
          const tv = travel()
          const p = tv > 0 ? Math.max(0, Math.min(-rect.top / tv, 1)) : 0
          render(p)
        })
      }

      window.addEventListener("scroll", onScroll, { passive: true })
      window.addEventListener("resize", onScroll)
      onScroll()

      // Clicking a tab / bar selects it and scrolls the page to that entry's slot
      // in the pin, reusing the site's smooth-scroll easing.
      section.querySelectorAll<HTMLElement>("[data-select]").forEach((el) => {
        el.addEventListener("click", () => {
          const id = el.dataset.select
          if (id == null) return
          const step = stepMap.indexOf(Number(id))
          if (step < 0) return
          // Selection is driven by the scroll handler as the page eases to the
          // target, so the panels scrub through en route rather than flashing.
          const tv = travel()
          // step k is reached at pages = k, i.e. progress k/N (never in run-out).
          const targetP = N > 0 ? step / N : 0
          const y =
            section.getBoundingClientRect().top + window.scrollY + targetP * tv
          const smooth = (window as any).__smoothScrollTo as
            | ((y: number) => void)
            | undefined
          if (smooth) smooth(y)
          else window.scrollTo(0, y)
        })
      })

      // Hover sync between spine bars and tab rows
      const groups = new Map<string, HTMLElement[]>()
      section.querySelectorAll<HTMLElement>("[data-i]").forEach((el) => {
        const key = el.dataset.i!
        if (!groups.has(key)) groups.set(key, [])
        groups.get(key)!.push(el)
      })
      groups.forEach((els) => {
        const toggle = (on: boolean) => () =>
          els.forEach((el) => el.classList.toggle("hl", on))
        els.forEach((el) => {
          el.addEventListener("mouseenter", toggle(true))
          el.addEventListener("mouseleave", toggle(false))
        })
      })

      // Grow-in trigger
      const spine = section.querySelector<HTMLElement>(".v1-spine")
      if (spine) {
        const io = new IntersectionObserver(
          (obs) => {
            obs.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add("in")
                io.unobserve(e.target)
              }
            })
          },
          { threshold: 0.25 },
        )
        io.observe(spine)
      }
    }
  }
</script>
