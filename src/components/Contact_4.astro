---
// V4 — "The Patch": for the audience that reads this site, a message is a
// commit. The git log above the editor holds the quote as the initial
// commit (hash 0a0a0a0 — the page background) and your unwritten commit as
// cef79e1 (the lime). Its subject line rewrites itself live from the first
// line you type; the editor shows your words as added lines, + gutter and
// all. Button: git push → dominic.
---

<section class="cv4 relative bg-[#0a0a0a] overflow-hidden" aria-label="Contact">
  <div class="relative max-w-[880px] mx-auto px-6 lg:px-10 py-[clamp(96px,14vh,180px)]">
    <h2 class="sr-only">Contact</h2>

    <p class="font-mono text-[12px] leading-none tracking-[-0.02em] uppercase text-white/45">
      04&hairsp;/&hairsp;04 &middot; Contact
    </p>

    <p class="font-display font-normal leading-[1.12] tracking-[-0.012em] text-[#f5f5f5] mt-8 text-[clamp(2rem,4.5vw,3rem)]">
      Ship me something.
    </p>

    <!-- The log: your commit writes itself as you type below -->
    <div class="cv4-log font-mono text-[12px] sm:text-[13px] leading-[1.9] tracking-[-0.008em] mt-10 overflow-x-auto">
      <p class="whitespace-nowrap">
        <span class="text-bio-lime">*&ensp;cef79e1</span>
        <span class="text-white/40">&ensp;(HEAD &rarr; dominic/inbox)&ensp;</span>
        <span class="cv4-log-subject text-white/35 italic">your message — unwritten</span>
      </p>
      <p class="whitespace-nowrap">
        <span class="text-white/30">*&ensp;0a0a0a0</span>
        <span class="text-white/55">&ensp;initial commit: &ldquo;The first language was a disaster. Everything since has been on purpose.&rdquo;</span>
      </p>
    </div>

    <!-- The editor -->
    <form class="cv4-form mt-8 border border-[#232323] rounded-xl bg-[#0e0f0e] overflow-hidden" novalidate>
      <div class="flex items-center justify-between gap-4 px-5 sm:px-6 py-3.5 border-b border-[#1e1e1e]">
        <span class="font-mono text-[11px] tracking-[0.04em] uppercase text-white/45">message.patch &middot; new file</span>
        <span class="cv4-stat font-mono text-[11px] tracking-[0.04em] text-white/35" aria-hidden="true">+0 &minus;0</span>
      </div>

      <!-- Author line, git-style -->
      <div class="flex flex-wrap items-baseline gap-x-2 gap-y-3 px-5 sm:px-6 py-4 border-b border-[#1e1e1e] font-mono text-[13px]">
        <span class="text-white/40 shrink-0">Author:</span>
        <label for="cv4-name" class="sr-only">Your name (optional)</label>
        <input id="cv4-name" name="name" type="text" autocomplete="name" placeholder="anonymous" data-fit="9" class="cv4-inline" />
        <span class="text-white/40">&lt;</span>
        <label for="cv4-email" class="sr-only">Your email (optional)</label>
        <input id="cv4-email" name="email" type="email" autocomplete="email" placeholder="no-reply@expected" data-fit="18" class="cv4-inline" />
        <span class="text-white/40">&gt;</span>
      </div>

      <!-- Diff body: everything you write is an added line -->
      <div class="relative">
        <div class="cv4-gutter absolute inset-y-0 left-0 w-[54px] pt-5 font-mono text-[14px] leading-[26px] text-right select-none pointer-events-none" aria-hidden="true"></div>
        <label for="cv4-message" class="sr-only">Your message (required)</label>
        <textarea
          id="cv4-message"
          name="message"
          rows="6"
          required
          placeholder="first line becomes the subject. the rest is yours."
          class="cv4-body block w-full bg-transparent border-none outline-none resize-none font-mono text-[14px] leading-[26px] text-bio-lime placeholder:text-white/25 placeholder:not-italic pt-5 pb-6 pl-[66px] pr-5 sm:pr-6"
        ></textarea>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-4 px-5 sm:px-6 py-4 border-t border-[#1e1e1e]">
        <span class="font-mono text-[11px] tracking-[-0.008em] text-[#5f5f5f]">
          Every patch gets read. No CI, no merge conflicts — review in ~48h.
        </span>
        <button
          type="submit"
          class="cv4-push shrink-0 inline-flex items-center gap-2.5 font-mono text-[13px] tracking-[-0.008em] bg-bio-lime text-ink rounded-md h-11 px-5 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-bio-lime"
        >
          git push &rarr; dominic
        </button>
      </div>

      <p class="cv4-error hidden font-mono text-[11px] tracking-[-0.008em] text-[#e0a68b] px-5 sm:px-6 pb-4" role="alert">
        nothing staged — write a line or two first.
      </p>
    </form>

    <!-- Remotes -->
    <div class="flex flex-wrap items-baseline gap-x-7 gap-y-3 mt-10 font-mono text-[12px] tracking-[-0.02em]">
      <span class="uppercase text-white/30">remotes</span>
      <a href="https://github.com/DominicClerici" target="_blank" rel="noopener noreferrer" class="cv4-remote">github.com/DominicClerici</a>
      <a href="https://www.linkedin.com/in/dominic-clerici/" target="_blank" rel="noopener noreferrer" class="cv4-remote">linkedin/dominic-clerici</a>
      <a href="mailto:contact@dominicclerici.com" class="cv4-remote">contact@dominicclerici.com</a>
    </div>
  </div>
</section>

<style>
  .cv4-inline {
    background: transparent;
    border: none;
    border-bottom: 1px dashed rgba(255, 255, 255, 0.25);
    border-radius: 0;
    outline: none;
    padding: 0 0.15em 2px;
    font: inherit;
    color: #e9e9e6;
    caret-color: var(--color-bio-lime);
    transition: border-color 0.2s ease;
  }

  .cv4-inline::placeholder {
    color: rgba(255, 255, 255, 0.25);
  }

  .cv4-inline:focus {
    border-bottom-style: solid;
    border-bottom-color: var(--color-bio-lime);
  }

  /* Added-lines tint, like a diff view */
  .cv4-body {
    background: linear-gradient(to right, transparent 54px, rgba(206, 247, 158, 0.025) 54px);
    caret-color: var(--color-bio-lime);
  }

  .cv4-gutter {
    border-right: 1px solid #1e1e1e;
  }

  .cv4-gutter span {
    display: block;
    padding-right: 10px;
  }

  .cv4-gutter .cv4-ln {
    color: rgba(255, 255, 255, 0.22);
  }

  .cv4-gutter .cv4-plus {
    color: rgba(206, 247, 158, 0.75);
  }

  .cv4-stat.cv4-stat-live {
    color: var(--color-bio-lime);
  }

  .cv4-log-subject.cv4-has-subject {
    color: #e9e9e6;
    font-style: normal;
  }

  .cv4-remote {
    color: #8a8a8a;
    transition: color 0.2s ease;
  }

  .cv4-remote:hover {
    color: var(--color-bio-lime);
  }

  .cv4-remote:focus-visible {
    outline: 2px solid var(--color-bio-lime);
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .cv4-push {
      transition: transform 0.2s ease;
    }

    .cv4-push:hover {
      transform: translateY(-2px);
    }
  }
</style>

<script>
  {
    const section = document.querySelector<HTMLElement>(".cv4");
    const form = section?.querySelector<HTMLFormElement>(".cv4-form");

    if (section && form) {
      const message = form.querySelector<HTMLTextAreaElement>("#cv4-message");
      const gutter = form.querySelector<HTMLElement>(".cv4-gutter");
      const stat = form.querySelector<HTMLElement>(".cv4-stat");
      const error = form.querySelector<HTMLElement>(".cv4-error");
      const logSubject = section.querySelector<HTMLElement>(".cv4-log-subject");

      // Author fields grow with their contents
      form.querySelectorAll<HTMLInputElement>("[data-fit]").forEach((input) => {
        const min = Number(input.dataset.fit) || 10;
        const fit = () => {
          input.style.width = `${Math.max(min, input.value.length + 2)}ch`;
        };
        input.addEventListener("input", fit);
        fit();
      });

      const render = () => {
        const text = message?.value ?? "";
        const lines = text.split("\n");
        const count = lines.length;

        if (gutter) {
          gutter.replaceChildren(
            ...lines.map((_, i) => {
              const row = document.createElement("span");
              const n = document.createElement("i");
              n.className = "cv4-ln not-italic";
              n.textContent = String(i + 1).padStart(2, " ");
              const plus = document.createElement("i");
              plus.className = "cv4-plus not-italic";
              plus.textContent = " +";
              row.append(n, plus);
              return row;
            }),
          );
        }

        if (stat) {
          const added = text.trim() ? count : 0;
          stat.innerHTML = `+${added} −0`;
          stat.classList.toggle("cv4-stat-live", added > 0);
        }

        // The commit in the log writes itself from your first line
        if (logSubject) {
          const first = (lines[0] || "").trim();
          const subject = first.length > 52 ? `${first.slice(0, 52)}…` : first;
          logSubject.textContent = subject || "your message — unwritten";
          logSubject.classList.toggle("cv4-has-subject", Boolean(subject));
        }

        if (message) {
          message.style.height = "auto";
          message.style.height = `${message.scrollHeight}px`;
        }
        error?.classList.add("hidden");
      };

      message?.addEventListener("input", render);
      render();

      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const data = new FormData(form);
        const name = String(data.get("name") || "").trim();
        const email = String(data.get("email") || "").trim();
        const body = String(data.get("message") || "").trim();

        if (!body) {
          error?.classList.remove("hidden");
          message?.focus();
          return;
        }

        const firstLine = body.split("\n")[0].trim();
        const subject = firstLine.length > 78 ? `${firstLine.slice(0, 78)}…` : firstLine;
        const lines = [body, "", name ? `— ${name}` : "", email ? `Reply to: ${email}` : ""].filter(Boolean);
        window.location.href = `mailto:contact@dominicclerici.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join("\n"))}`;
      });
    }
  }
</script>
