---
import Work from "./Work.astro";
import Work1 from "./Work_1.astro";
import Work2 from "./Work_2.astro";
import Work3 from "./Work_3.astro";
import Work4 from "./Work_4.astro";

const variants = [
  { id: "original", label: "Original" },
  { id: "1", label: "1" },
  { id: "2", label: "2" },
  { id: "3", label: "3" },
  { id: "4", label: "4" },
];
---

<div class="relative" data-work-variant-switcher>
  <div
    class="absolute top-4 right-3 sm:right-4 md:right-8 z-20 flex gap-1 bg-surface-dim/90 backdrop-blur border border-primary/20 p-1"
  >
    {
      variants.map((variant) => (
        <button
          type="button"
          data-variant-btn={variant.id}
          class="font-label text-[9px] md:text-[10px] tracking-widest uppercase px-2 py-1 text-secondary hover:text-primary transition-colors data-[active=true]:bg-primary data-[active=true]:text-background"
        >
          {variant.label}
        </button>
      ))
    }
  </div>

  <div data-variant-panel="original"><Work /></div>
  <div data-variant-panel="1" hidden><Work1 /></div>
  <div data-variant-panel="2" hidden><Work2 /></div>
  <div data-variant-panel="3" hidden><Work3 /></div>
  <div data-variant-panel="4" hidden><Work4 /></div>
</div>

<script>
  const STORAGE_KEY = "work-variant";
  const root = document.querySelector("[data-work-variant-switcher]");

  if (root) {
    const buttons = root.querySelectorAll<HTMLButtonElement>("[data-variant-btn]");
    const panels = root.querySelectorAll<HTMLElement>("[data-variant-panel]");

    const setActive = (id: string) => {
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.variantPanel !== id;
      });
      buttons.forEach((btn) => {
        btn.dataset.active = String(btn.dataset.variantBtn === id);
      });
      localStorage.setItem(STORAGE_KEY, id);
    };

    buttons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const id = btn.dataset.variantBtn;
        if (id) setActive(id);
      });
    });

    setActive(localStorage.getItem(STORAGE_KEY) || "original");
  }
</script>
