---
import ActionButton from "./ActionButton.astro";
import photo from "../data/footer-photo.json";

const year = new Date().getFullYear();

// Always exactly two lines, split here (the type is capped to fit, below).
const statement =
  "I design and build software that\u2019s\nfast, useful, and worth looking at.";

const navigate = [
  { label: "About", href: "#about" },
  { label: "Career", href: "#career" },
  { label: "Work", href: "#work" },
  { label: "Contact", href: "#contact" },
];

// Screens that get the portrait cut. Keep in step with the same query in the
// styles, which picks its blur-up.
const PORTRAIT = "(max-width: 1023px) and (orientation: portrait)";
// Each cut is cover-fitted to a frame as tall as the screen plus the cut's
// overhang below it (see the styles), so its displayed width is that height
// × its aspect — unless the screen is wider than that, when the width fills
// it.
const sizes = ({
  width,
  height,
  overhang,
}: {
  width: number;
  height: number;
  overhang: number;
}) => {
  const tall = 1 + overhang;
  return `(min-aspect-ratio: ${width}/${Math.round(height * tall)}) 100vw, ${+((100 * tall * width) / height).toFixed(2)}vh`;
};
const PORTRAIT_SIZES = sizes(photo.portrait);
const LANDSCAPE_SIZES = sizes(photo.landscape);

// Each with the icon it wears on phones, where the links sit beside the
// button rather than in a column: GitHub's and LinkedIn's marks (filled, from
// Simple Icons) and outline glyphs for the other two, all on a 24px grid.
const connect = [
  {
    label: "GitHub",
    href: "https://github.com/DominicClerici",
    external: true,
    fill: "M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12",
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/dominic-clerici/",
    external: true,
    fill: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.125 2.062 2.062 0 0 1 0 4.125zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
  },
  {
    label: "Email",
    href: "mailto:contact@dominicclerici.com",
    external: false,
    stroke: "M4 5.5h16a1.5 1.5 0 0 1 1.5 1.5v10a1.5 1.5 0 0 1-1.5 1.5H4A1.5 1.5 0 0 1 2.5 17V7A1.5 1.5 0 0 1 4 5.5zM3 7l9 6.5L21 7",
  },
  {
    label: "Resume",
    href: "/DominicClerici_CV.pdf",
    external: true,
    stroke: "M14 2.5H6.5A1.5 1.5 0 0 0 5 4v16a1.5 1.5 0 0 0 1.5 1.5h11A1.5 1.5 0 0 0 19 20V7.5zM14 2.5v5h5M8.5 12.5h7M8.5 16.5h7",
  },
];
---

<!-- Mobile browsers grow and shrink the visible screen as their toolbars
     collapse and return, and the footer must not jump when they do (see the
     styles for the heights):

       · the footer is as tall as the screen ever gets (lvh), so at the
         bottom of the page it fills the screen even with the toolbars away,
         and the section above never peeks in;
       · its content fills just the part of the screen that is showing
         (dvh), from the top of the screen down to the top of the toolbar,
         so none of it is ever behind the toolbar or pushed down by it. -->
<footer
  id="site-footer"
  class="relative overflow-hidden flex flex-col justify-end"
>
  <!-- The mountain backdrop is viewport-fixed and sits *behind* the whole
       page (-z-10), so the opaque sections above the footer hide it and the
       footer — which has no background of its own — is the only window onto
       it. That window opening as the footer rises is the reveal, and because
       the pin is real CSS fixed positioning rather than a scroll-driven
       transform, the photo cannot drift on compositor-driven (touch)
       scrolling.

       It is pinned to the top of the screen and as tall as the screen ever
       gets, so it never changes size or moves as the toolbars come and go:
       they just float over its foot. On phones and portrait tablets it is
       instead pinned 10vh below the screen's bottom edge and 10vh taller,
       the photo's overhang, so it runs on under Safari's toolbar there (the
       portrait cut carries the extra 10% at its foot, so what shows on
       screen is unchanged). Safari (from iOS 26) is particular
       about fixed layers at the screen's edges, in two ways:

         · it tints its status bar and toolbar from their background colour.
           This outer box has none and stays fully opaque, so Safari takes it
           as the edge element and lets the page show through its bars, edge
           to edge. (Made even slightly transparent, it is passed over for
           <body>, and both bars go the page's near-black.)
         · it cuts opaque fixed layers off at the top of its floating
           toolbar, leaving the page's own background below. So what the box
           holds sits in a layer a hair short of opaque, which it draws all
           the way down.

       Three layers: the photo itself (the real background, and all there
       is without WebGL2 or under reduced motion), the heat-haze canvas drawn
       pixel-for-pixel over the lake once its texture is up, and above md a scrim that keeps the bone type legible against
       the peak and the near water. The backdrop's own background image is
       a tiny blur-up of whichever cut the <picture> picks, so the text has
       something to sit on before the real one arrives.

       The photo (Mount Shuksan over Picture Lake, 4:3) comes in two cuts,
       rendered by footer-photos.mjs: the whole of it for landscape screens,
       pinned to its top centre so the peak always shows, 1280w up to its full
       4340w; and a 3:4 crop for phones and portrait tablets, cut just short
       enough at the bottom for the lake to fill the lower 25% of a tall
       screen, with a faint dark fade baked into its foot. Each is AVIF with
       a WebP fallback.

       The srcsets are held back in data-srcset: as a fixed element the photo
       is always "in the viewport" to the browser, so it would load alongside
       the hero and compete with it. The script sets them once the page has
       loaded and gone idle instead. Its alt is empty — the scene is
       decorative. -->
  <div
    class="footer-canvas-wrap fixed inset-x-0 top-0 -z-10"
    style={`--overhang:${photo.portrait.overhang * 100}vh`}
    aria-hidden="true"
  >
    <div
      class="footer-backdrop absolute inset-0"
      style={`--blur-landscape:url(${photo.landscape.placeholder});--blur-portrait:url(${photo.portrait.placeholder})`}
    >
      <picture>
        <source
          media={PORTRAIT}
          type="image/avif"
          data-srcset={photo.portrait.avif}
          sizes={PORTRAIT_SIZES}
        />
        <source
          media={PORTRAIT}
          type="image/webp"
          data-srcset={photo.portrait.webp}
          sizes={PORTRAIT_SIZES}
        />
        <source
          type="image/avif"
          data-srcset={photo.landscape.avif}
          sizes={LANDSCAPE_SIZES}
        />
        <img
          class="footer-photo absolute inset-0 w-full h-full object-cover object-top"
          data-srcset={photo.landscape.webp}
          data-cuts={JSON.stringify({
            landscape: [photo.landscape.width, photo.landscape.height, photo.landscape.rect],
            portrait: [
              photo.portrait.width,
              photo.portrait.height,
              photo.portrait.rect,
            ],
          })}
          sizes={LANDSCAPE_SIZES}
          width={photo.landscape.width}
          height={photo.landscape.height}
          alt=""
          decoding="async"
          fetchpriority="low"
        />
      </picture>
      <!-- Placed and sized by the haze over the lake's band of the photo -->
      <canvas id="footer-canvas" class="absolute left-0 w-full"></canvas>
      <div class="footer-scrim absolute inset-0"></div>
    </div>
  </div>

  <div class="footer-content relative z-10 shrink-0 flex flex-col">
    <!-- Cap bar: the previous (contact) section's color, fully-rounded bottom
         corners. Mirrors the page header's layout (same h-20/md:py-7/px) so the
         bar height tracks the header exactly. The header echo inside fades in
         only once the page is scrolled to its very bottom (see script). It's
         decorative (aria-hidden + tabindex=-1) — the real header and the footer
         nav below already expose these links to assistive tech. Phones have
         no header to echo, so there the bar is left out, and the contact
         section above rounds off its own bottom corners instead. -->
    <div
      class="shrink-0 hidden md:flex items-center bg-n-950 rounded-b-full lg:py-4 py-3 px-10 lg:px-14"
      aria-hidden="true"
    >
      <div
        class="footer-header hidden md:flex w-full justify-between items-center"
      >
        <a
          href="https://dev.dominicclerici.com"
          target="_blank"
          rel="noopener noreferrer"
          tabindex="-1"
          data-terminal="footer"
          class="inline-flex font-mono text-[14px] text-bone py-1.5"
        >
          <span data-terminal-text>&gt;</span><span data-terminal-cursor>_</span
          >
        </a>

        <nav class="flex gap-7 items-center">
          <a
            href="https://www.linkedin.com/in/dominic-clerici/"
            target="_blank"
            rel="noopener noreferrer"
            tabindex="-1"
            class="font-mono text-[13px] tracking-[-0.02em] uppercase text-bone/70 hover:text-bone transition-colors duration-150"
          >
            LinkedIn
          </a>
          <a
            href="mailto:contact@dominicclerici.com"
            tabindex="-1"
            class="font-mono text-[13px] tracking-[-0.02em] uppercase text-bone/70 hover:text-bone transition-colors duration-150"
          >
            Email
          </a>
          <a
            href="/DominicClerici_CV.pdf"
            target="_blank"
            rel="noopener noreferrer"
            tabindex="-1"
            class="font-mono text-[13px] tracking-[-0.02em] uppercase text-bone border border-bone/35 rounded-xl px-4 py-1.5 hover:bg-bio-lime hover:text-ink hover:border-bio-lime transition-colors duration-150"
          >
            Resume
          </a>
        </nav>
      </div>
    </div>

    <div
      class="flex-1 min-h-0 flex flex-col lg:flex-row lg:justify-between gap-10 lg:gap-16 px-3 sm:px-6 lg:px-12 pt-10 md:pt-16"
    >
      <div class="@container lg:flex-1 max-w-[600px]">
        <!-- Statement: typed out as a short sequence once the footer is well
             in view (see script). Three layers share one grid cell: an sr-only
             copy for assistive tech, an invisible ghost of the statement that
             holds the box at its final height so the button below never
             shifts, and the live layer the typewriter writes into. The live
             layer server-renders the full statement so it still reads without
             JS; the script empties it before the footer is reached.

             The lines never wrap: the type is capped so the longer of the two
             (~14em) always fits the column — 100cqi is the wrapper's width,
             which is why the wrapper is a size container that flexes into the
             space the nav leaves on lg rather than sizing to its text. -->
        <p
          class="grid whitespace-pre font-display text-bone leading-[1.2] tracking-[-0.02em] text-[min(clamp(1.5rem,calc(1rem+2vw),2.5rem),calc(100cqi/14.6))]"
        >
          <span class="sr-only">{statement}</span>
          <span class="invisible [grid-area:1/1]" aria-hidden="true"
            >{statement}</span
          >
          <span
            class="footer-statement [grid-area:1/1]"
            aria-hidden="true"
            ><span data-typed>{statement}</span><span
              class="footer-caret"
              data-state="off"></span><span class="invisible" data-rest
            ></span></span
          >
        </p>
        <!-- On phones the connect links ride beside the button as icons, in
             place of the nav columns, drawn in a little tighter on the
             narrowest (360px) screens so the row still fits -->
        <div class="mt-8 flex items-center gap-2.5 min-[380px]:gap-4">
          <ActionButton href="#contact" icon="right" variant="solid" caps>
            Get in touch
          </ActionButton>
          <ul class="md:hidden flex items-center gap-1" aria-label="Connect">
            {
              connect.map((link) => (
                <li>
                  <a
                    href={link.href}
                    aria-label={link.label}
                    class="size-8 min-[380px]:size-9 inline-flex items-center justify-center rounded-lg text-bone/85 hover:text-bone hover:bg-bone/10 transition-colors duration-150"
                    {...(link.external
                      ? { target: "_blank", rel: "noopener noreferrer" }
                      : {})}
                  >
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      {link.fill ? (
                        <path d={link.fill} fill="currentColor" />
                      ) : (
                        <path
                          d={link.stroke}
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.75"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      )}
                    </svg>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <div
        class="hidden md:flex items-start justify-between lg:justify-end gap-8 lg:gap-14"
      >
        <nav class="flex gap-8 lg:gap-14" aria-label="Footer navigation">
          <div class="border-l border-bone/25 pl-5 lg:pl-6 lg:min-w-[150px]">
            <p
              class="font-mono text-[12px] leading-none tracking-[-0.02em] uppercase text-bone/65"
            >
              Navigate
            </p>
            <ul class="mt-5 space-y-2">
              {
                navigate.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="font-display text-[17px] leading-snug tracking-[-0.01em] text-bone/85 hover:text-bone transition-colors duration-150"
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="border-l border-bone/25 pl-5 lg:pl-6 lg:min-w-[150px]">
            <p
              class="font-mono text-[12px] leading-none tracking-[-0.02em] uppercase text-bone/65"
            >
              Connect
            </p>
            <ul class="mt-5 space-y-2">
              {
                connect.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="font-display text-[17px] leading-snug tracking-[-0.01em] text-bone/85 hover:text-bone transition-colors duration-150"
                      {...(link.external
                        ? { target: "_blank", rel: "noopener noreferrer" }
                        : {})}
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </nav>
      </div>
    </div>

    <div class="shrink-0 px-3 sm:px-6 lg:px-12 pb-5 md:pb-6">
      <p
        class="footer-name inline-block font-display text-bone leading-[0.95] tracking-[-0.03em] whitespace-nowrap"
      >
        Dominic Clerici
      </p>
      <p
        class="font-mono text-[11px] leading-none tracking-[-0.02em] uppercase text-bone/60 mt-4"
      >
        &copy; {year} Dominic Clerici. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  /* The footer's heights (see the markup): the footer and the backdrop as
     tall as the screen ever gets, --footer-h, and the content as tall as
     the part of it showing, --box-h; neither below a floor. 100vh first,
     for browsers without the newer viewport units. */
  #site-footer {
    --footer-min: 680px;
    --footer-h: max(var(--footer-min), 100vh);
    --box-h: max(var(--footer-min), 100vh);
    height: var(--footer-h);
  }
  @media (min-width: 768px) {
    #site-footer {
      --footer-min: 780px;
    }
  }
  @supports (height: 100dvh) {
    #site-footer {
      --footer-h: max(var(--footer-min), 100lvh);
      --box-h: max(var(--footer-min), 100dvh);
    }
  }
  .footer-content {
    height: var(--box-h);
  }

  /* The backdrop (see the markup): never resized, and itself opaque with
     no background colour; its contents a hair short of opaque, over the
     blur-up, cut and pinned to match whichever photo the <picture> picks. */
  .footer-canvas-wrap {
    height: var(--footer-h);
  }
  .footer-backdrop {
    opacity: 0.99;
    background: var(--blur-landscape) center top / cover;
  }
  /* Same query as PORTRAIT in the frontmatter. The portrait cut hangs its
     overhang below the screen (see the markup). */
  @media (max-width: 1023px) and (orientation: portrait) {
    .footer-canvas-wrap {
      top: auto;
      bottom: calc(-1 * var(--overhang));
      height: calc(var(--footer-h) + var(--overhang));
    }
    .footer-backdrop {
      background-image: var(--blur-portrait);
    }
  }

  /* Holds the haze canvas back until it has drawn a frame over the photo.
     Where it draws, it matches the <img> beneath pixel-for-pixel (and it is
     transparent everywhere else), so the fade only brings the shimmer up
     rather than swapping one picture for another. */
  #footer-canvas {
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  #footer-canvas.is-ready {
    opacity: 1;
  }

  /* Darkens the sky behind the statement and nav and the near water behind
     the giant name; the middle stays clear so the peak and the far shore,
     where the shimmer peaks, read at full strength. */
  .footer-scrim {
    background: linear-gradient(
      to bottom,
      rgb(10 10 10 / 0.5) 0%,
      rgb(10 10 10 / 0.25) 28%,
      rgb(10 10 10 / 0) 42%,
      rgb(10 10 10 / 0) 58%,
      rgb(10 10 10 / 0.3) 76%,
      rgb(10 10 10 / 0.6) 100%
    );
  }
  /* Below lg the nav columns stack under the statement and land on the
     snowfields and pale granite themselves, so the scrim holds its strength
     down past them, then clears over the trees and the far shore. */
  @media (max-width: 1023px) {
    .footer-scrim {
      background: linear-gradient(
        to bottom,
        rgb(10 10 10 / 0.5) 0%,
        rgb(10 10 10 / 0.5) 22%,
        rgb(10 10 10 / 0.5) 48%,
        rgb(10 10 10 / 0) 60%,
        rgb(10 10 10 / 0) 68%,
        rgb(10 10 10 / 0.3) 82%,
        rgb(10 10 10 / 0.6) 100%
      );
    }
  }
  /* Phones need none: the statement, the button and the connect icons all
     sit on the clear sky above the peak, and the name on the lake. */
  @media (max-width: 767px) {
    .footer-scrim {
      display: none;
    }
  }

  /* Typewriter caret for the statement. Zero net advance (2px border, -2px
     margin) so showing or hiding it never reflows the line. Solid while
     characters are landing, blinking during the pauses, gone otherwise. */
  .footer-caret {
    display: inline-block;
    width: 0;
    height: 1em;
    margin-right: -2px;
    border-left: 2px solid currentColor;
    vertical-align: -0.12em;
  }
  .footer-caret[data-state="off"] {
    visibility: hidden;
  }
  .footer-caret[data-state="blink"] {
    animation: footer-caret-blink 1.06s steps(1) infinite;
  }
  @keyframes footer-caret-blink {
    50% {
      visibility: hidden;
    }
  }

  /* Header echo in the cap bar: hidden until the page is scrolled to its very
     bottom, then it rises 6px and fades in; leaving the bottom reverses it. */
  .footer-header {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.45s ease,
      transform 0.45s ease;
  }
  .footer-header.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .footer-header {
      transition-property: opacity;
      transform: none;
    }
  }
</style>

<script>
  import { createHeatHaze, type HeatHaze } from "../scripts/heat-haze";
  import {
    makeState,
    typeText,
    cancelAnim,
    stopBlink,
  } from "../scripts/terminal";

  {
    const footer = document.getElementById("site-footer")!;
    const photo = footer.querySelector<HTMLImageElement>(".footer-photo")!;
    const canvas = document.getElementById(
      "footer-canvas",
    ) as HTMLCanvasElement;
    const name = footer.querySelector<HTMLElement>(".footer-name")!;
    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    /* ── Giant name ──
       Sized to span the content width exactly, reference-style: measure at a
       fixed size, then scale so the text's edges meet the padding. */
    function fitName() {
      name.style.fontSize = "100px";
      const parent = name.parentElement!;
      const cs = getComputedStyle(parent);
      const width =
        parent.clientWidth -
        parseFloat(cs.paddingLeft) -
        parseFloat(cs.paddingRight);
      name.style.fontSize = `${(100 * width) / Math.max(name.scrollWidth, 1)}px`;
    }

    /* ── Mountain backdrop + heat haze ──
       The photo starts loading as soon as the page is done with the network
       and the main thread: after the load event, at the first idle moment,
       at low fetch priority. Nothing the page needs waits on it, and it is
       usually in long before the footer is reached. Once it has decoded, the
       haze takes it as a texture, again in idle time. Arriving at the footer
       sooner (a jump straight to it) brings each step forward instead. The
       shimmer only runs while the footer is actually on screen. Under reduced
       motion, or without WebGL2, the photo is left as it is. */
    let haze: HeatHaze | null = null;
    let footerVisible = false;
    let decoded = false;

    const idle = (fn: () => void) =>
      "requestIdleCallback" in window
        ? requestIdleCallback(fn, { timeout: 2000 })
        : setTimeout(fn, 200);

    // The photo's current source, for the haze: its files are named for their
    // cut and width (footer-mountain-<cut>-<width>.<ext>), and each cut's
    // pixel size and place in the full photo ride on the <img>. The height
    // follows from the cut's aspect, rounded as the generator's resize rounds
    // it — naturalHeight won't do, as for a srcset pick it is divided by the
    // pick's density and floored.
    const cuts: Record<string, [number, number, number[]]> = JSON.parse(
      photo.dataset.cuts!,
    );
    const source = () => {
      const [, cut, w] = /-(landscape|portrait)-(\d+)\.\w+$/.exec(
        photo.currentSrc,
      )!;
      const [cw, ch, rect] = cuts[cut];
      const width = Number(w);
      return { width, height: Math.round((width * ch) / cw), rect };
    };

    function startHaze() {
      if (haze || !decoded) return;
      haze = createHeatHaze({
        canvas,
        frame: footer.querySelector<HTMLElement>(".footer-canvas-wrap")!,
        img: photo,
        source,
        onReady: () => canvas.classList.add("is-ready"),
        onLost: () => {
          canvas.classList.remove("is-ready");
          haze = null;
          // Not restarted: a lost context stays with the photo alone
          decoded = false;
        },
      });
      if (footerVisible && !document.hidden) haze?.start();
    }

    function loadPhoto() {
      if (photo.srcset) return;
      // The <source>s first, so the <img> chooses among all of them
      for (const el of footer.querySelectorAll<HTMLSourceElement>(
        "picture source",
      )) {
        el.srcset = el.dataset.srcset!;
      }
      photo.srcset = photo.dataset.srcset!;
      if (reducedMotion) return;
      photo
        .decode()
        .then(() => {
          decoded = true;
          if (footerVisible) startHaze();
          else idle(startHaze);
        })
        .catch(() => {});
      // Turning a tablet or phone switches between the cuts; the haze re-reads
      // the photo once the new one is in.
      photo.addEventListener("load", () => haze?.reload());
    }

    if (document.readyState === "complete") idle(loadPhoto);
    else addEventListener("load", () => idle(loadPhoto), { once: true });

    new IntersectionObserver(
      (entries, io) => {
        if (entries.some((e) => e.isIntersecting)) {
          loadPhoto();
          io.disconnect();
        }
      },
      { rootMargin: "600px 0px" },
    ).observe(footer);

    new IntersectionObserver(
      (entries) => {
        footerVisible = entries[0].isIntersecting;
        if (footerVisible) {
          loadPhoto();
          startHaze();
          haze?.start();
        } else {
          haze?.stop();
        }
      },
      { threshold: 0 },
    ).observe(footer);

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) haze?.stop();
      else if (footerVisible) haze?.start();
    });

    /* ── Statement typewriter ──
       Once the viewport's bottom edge has reached the footer's bottom 40%,
       the statement plays a short sequence: a thank-you, a nudge to reach
       out, then the statement itself, each typed out, held, and backspaced
       away before the next. It plays once per visit — only after the footer
       has left the viewport entirely does it re-arm and blank the text for
       the next arrival.

       The untyped remainder of the current line is kept in the layout as
       invisible text, so words never jump between lines as they are typed.
       Under reduced motion none of this runs and the statement simply stays
       as rendered. */
    const SEQUENCE = [
      "Thanks for reading my portfolio!",
      "If you haven\u2019t already,\nFeel free to reach out!",
    ];
    // Rates are set as speed-ups on the original 45–90ms/char and 24ms/char.
    const TYPE_SPEEDUP = 1.15;
    const ERASE_SPEEDUP = 1.05;
    const HOLD_MS = 1500;
    const GAP_MS = 400;
    const ERASE_MS = 24 / ERASE_SPEEDUP;
    // Beat between the trigger and the first keystroke.
    const START_DELAY_MS = 400;
    // Human-ish typing: a jittered base rate with a beat after punctuation.
    const typeDelay = (ch: string) =>
      (45 + Math.random() * 45 + (/[,.!]/.test(ch) ? 140 : 0)) / TYPE_SPEEDUP;

    const typedEl = footer.querySelector<HTMLElement>("[data-typed]")!;
    const restEl = footer.querySelector<HTMLElement>("[data-rest]")!;
    const caretEl = footer.querySelector<HTMLElement>(".footer-caret")!;
    // The statement itself comes from the server-rendered markup.
    const STATEMENT = typedEl.textContent!;
    // Where the bottom 40% begins; the sentinel covers from there down.
    const TRIGGER_FRAC = 0.6;

    function renderLine(
      text: string,
      n: number,
      caret: "off" | "blink" | "solid",
    ) {
      typedEl.textContent = text.slice(0, n);
      restEl.textContent = text.slice(n);
      caretEl.dataset.state = caret;
    }

    // One pending timer at a time. Cancelling clears it and bumps the run id;
    // the abandoned run is left awaiting a promise that never settles.
    let typeTimer: number | undefined;
    let runId = 0;
    const sleep = (ms: number) =>
      new Promise<void>((r) => (typeTimer = window.setTimeout(r, ms)));

    async function typeLine(text: string, id: number) {
      for (let i = 1; i <= text.length; i++) {
        renderLine(text, i, "solid");
        await sleep(typeDelay(text[i - 1]));
        if (id !== runId) return;
      }
    }

    async function eraseLine(text: string, id: number) {
      for (let i = text.length - 1; i >= 0; i--) {
        renderLine(text, i, "solid");
        await sleep(ERASE_MS);
        if (id !== runId) return;
      }
    }

    async function hold(text: string, ms: number) {
      renderLine(text, text.length, "blink");
      await sleep(ms);
    }

    async function playStatement() {
      const id = ++runId;
      const live = () => id === runId;
      await sleep(START_DELAY_MS);
      if (!live()) return;
      for (const line of SEQUENCE) {
        await typeLine(line, id);
        if (!live()) return;
        await hold(line, HOLD_MS);
        if (!live()) return;
        await eraseLine(line, id);
        if (!live()) return;
        await hold("", GAP_MS);
        if (!live()) return;
      }
      await typeLine(STATEMENT, id);
      if (!live()) return;
      await hold(STATEMENT, HOLD_MS);
      if (!live()) return;
      renderLine(STATEMENT, STATEMENT.length, "off");
    }

    function resetStatement() {
      runId++;
      clearTimeout(typeTimer);
      renderLine("", 0, "off");
    }

    if (!reducedMotion) {
      resetStatement();

      const sentinel = document.createElement("div");
      sentinel.setAttribute("aria-hidden", "true");
      sentinel.style.cssText = `position:absolute;left:0;right:0;bottom:0;top:${TRIGGER_FRAC * 100}%;pointer-events:none;`;
      footer.appendChild(sentinel);

      let armed = true;
      new IntersectionObserver(
        (entries) => {
          if (armed && entries[0].isIntersecting) {
            armed = false;
            playStatement();
          }
        },
        { threshold: 0 },
      ).observe(sentinel);

      new IntersectionObserver(
        (entries) => {
          if (!entries[0].isIntersecting) {
            armed = true;
            resetStatement();
          }
        },
        { threshold: 0 },
      ).observe(footer);
    }

    /* ── Header echo ──
       The cap-bar header echo fades in only while the page is scrolled to its
       very bottom (within 6px), reversing on the way out. Each fresh entry
       replays the terminal typing from scratch once the rise/fade settles;
       each exit cancels the typing and resets the prompt. */
    const headerEcho = footer.querySelector<HTMLElement>(".footer-header")!;
    const echoState = makeState(
      footer.querySelector<HTMLElement>('[data-terminal="footer"]')!,
    );
    let echoVisible = false;

    function setEchoVisible(visible: boolean) {
      if (visible === echoVisible) return;
      echoVisible = visible;
      if (visible) {
        headerEcho.classList.add("is-visible");
      } else {
        headerEcho.classList.remove("is-visible");
        cancelAnim(echoState);
        stopBlink(echoState);
        echoState.textEl.textContent = ">";
      }
    }

    headerEcho.addEventListener("transitionend", (e) => {
      if (e.propertyName === "opacity" && echoVisible) typeText(echoState);
    });

    // Reading documentElement.scrollHeight forces a full-document layout, so
    // it is cached rather than re-read per scroll frame. It moves only when
    // the page's height does, which the observer below is the signal for.
    let docScrollH = document.documentElement.scrollHeight;
    function measureDocH() {
      docScrollH = document.documentElement.scrollHeight;
    }

    function onEchoScroll() {
      const distanceFromBottom =
        docScrollH - (window.scrollY + window.innerHeight);
      setEchoVisible(distanceFromBottom <= 6);
    }
    // Shared scroll bus — functional (not decorative), so it must run under
    // reduced motion too, which the bus's native scroll listener guarantees.
    (window as any).__onSmoothScrollTick(onEchoScroll);
    onEchoScroll();

    let resizeTimer: number | undefined;
    new ResizeObserver(() => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        // fitName writes a font size, then reads metrics back, then writes
        // again — two forced layouts on the largest text node on the page.
        // Rotation and window resizes can fire this in bursts; it belongs
        // behind a debounce rather than running on every one of those
        // ticks.
        fitName();
        onEchoScroll();
      }, 120);
    }).observe(footer);

    // Page height moves with content well outside the footer — Work's spreads
    // expand — so the echo's distance-from-bottom test is invalidated from the
    // document box, not from the footer observer above.
    new ResizeObserver(() => {
      measureDocH();
      onEchoScroll();
    }).observe(document.documentElement);

    fitName();
    // Refit once the display face arrives — metrics differ from the fallback.
    document.fonts?.ready.then(fitName);
  }
</script>
