---
import ActionButton from "./ActionButton.astro";

const year = new Date().getFullYear();

const navigate = [
  { label: "About", href: "#about" },
  { label: "Career", href: "#career" },
  { label: "Work", href: "#work" },
  { label: "Contact", href: "#contact" },
];

const connect = [
  {
    label: "GitHub",
    href: "https://github.com/DominicClerici",
    external: true,
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/dominic-clerici/",
    external: true,
  },
  {
    label: "Email",
    href: "mailto:contact@dominicclerici.com",
    external: false,
  },
  {
    label: "Resume",
    href: "/DominicClerici_CV.pdf",
    external: true,
  },
];
---

<footer
  id="site-footer"
  class="relative h-svh min-h-[680px] md:min-h-[780px] overflow-hidden"
>
  <!-- The road backdrop is viewport-fixed and sits *behind* the whole page
       (-z-10), so the opaque sections above the footer hide it and the footer
       — which has no background of its own — is the only window onto it. That
       window opening as the footer rises is the reveal, and because the pin is
       real CSS fixed positioning rather than a scroll-driven transform, the
       photo cannot drift on compositor-driven (touch) scrolling. Fixed to the
       *visual* viewport, it also covers the strip below an svh-tall footer
       when mobile chrome retracts.

       Three layers: the photo itself (the real background, and all there is
       without WebGL2 or under reduced motion), the heat-haze canvas drawn
       pixel-for-pixel over it once its texture is up, and a scrim that keeps
       the bone type legible against the sky and the asphalt while leaving the
       horizon — where the shimmer is — clear. The wrap's own background is a
       24px blur-up of the photo, so the text has something to sit on before
       the real one arrives.

       The photo's srcset is held back in data-srcset: as a fixed element it
       is always "in the viewport" to the browser's lazy loader and would load
       with the hero. It is set as the footer approaches instead (see script).
       Its alt is empty — the scene is decorative. -->
  <div
    class="footer-canvas-wrap fixed inset-0 -z-10 bg-n-900 bg-cover bg-center"
    style="background-image:url(data:image/webp;base64,UklGRn4AAABXRUJQVlA4IHIAAADQBACdASoYABAAPtFUo0uoJKMhsAgBABoJbACdMoR4OsC//s/+A8r1dXfbR+T1KAD9UHdKkFssr1uAGAtq9AzTe97a56fnZN1o/RSh0O/HUusSXRqqGG9iaHjeCyQ4jG5bY0mhWjPEq14ZONnmyxP6AAA=)"
    aria-hidden="true"
  >
    <img
      class="footer-photo absolute inset-0 w-full h-full object-cover"
      data-srcset="/photos/footer-road.webp 1280w, /photos/footer-road-2x.webp 2000w"
      sizes="100vw"
      width="2000"
      height="1333"
      alt=""
      decoding="async"
    />
    <canvas id="footer-canvas" class="absolute inset-0 w-full h-full"></canvas>
    <div class="footer-scrim absolute inset-0"></div>
  </div>

  <div class="relative z-10 h-full flex flex-col">
    <!-- Cap bar: the previous (contact) section's color, fully-rounded bottom
         corners. Mirrors the page header's layout (same h-20/md:py-7/px) so the
         bar height tracks the header exactly. The header echo inside fades in
         only once the page is scrolled to its very bottom (see script). It's
         decorative (aria-hidden + tabindex=-1) — the real header and the footer
         nav below already expose these links to assistive tech. -->
    <div
      class="shrink-0 flex items-center bg-n-950 rounded-b-full lg:py-4 py-3 px-10 lg:px-14"
      aria-hidden="true"
    >
      <div
        class="footer-header hidden md:flex w-full justify-between items-center"
      >
        <a
          href="https://dev.dominicclerici.com"
          target="_blank"
          rel="noopener noreferrer"
          tabindex="-1"
          data-terminal="footer"
          class="inline-flex font-mono text-[14px] text-bone py-1.5"
        >
          <span data-terminal-text>&gt;</span><span data-terminal-cursor>_</span
          >
        </a>

        <nav class="flex gap-7 items-center">
          <a
            href="https://www.linkedin.com/in/dominic-clerici/"
            target="_blank"
            rel="noopener noreferrer"
            tabindex="-1"
            class="font-mono text-[13px] tracking-[-0.02em] uppercase text-bone/70 hover:text-bone transition-colors duration-150"
          >
            LinkedIn
          </a>
          <a
            href="mailto:contact@dominicclerici.com"
            tabindex="-1"
            class="font-mono text-[13px] tracking-[-0.02em] uppercase text-bone/70 hover:text-bone transition-colors duration-150"
          >
            Email
          </a>
          <a
            href="/DominicClerici_CV.pdf"
            target="_blank"
            rel="noopener noreferrer"
            tabindex="-1"
            class="font-mono text-[13px] tracking-[-0.02em] uppercase text-bone border border-bone/35 rounded-xl px-4 py-1.5 hover:bg-bio-lime hover:text-ink hover:border-bio-lime transition-colors duration-150"
          >
            Resume
          </a>
        </nav>
      </div>
    </div>

    <div
      class="flex-1 min-h-0 flex flex-col lg:flex-row lg:justify-between gap-10 lg:gap-16 px-3 sm:px-6 lg:px-12 pt-10 md:pt-16"
    >
      <div class="max-w-[560px]">
        <p
          class="font-display text-bone leading-[1.2] tracking-[-0.02em] text-[clamp(1.5rem,calc(1rem+2vw),2.5rem)]"
        >
          I design and build software that&rsquo;s fast, useful, and worth
          looking at.
        </p>
        <ActionButton href="#contact" icon="right" variant="solid" caps class="mt-8">
          Get in touch
        </ActionButton>
      </div>

      <div
        class="flex items-start justify-between lg:justify-end gap-8 lg:gap-14"
      >
        <nav class="flex gap-8 lg:gap-14" aria-label="Footer navigation">
          <div class="border-l border-bone/25 pl-5 lg:pl-6 lg:min-w-[150px]">
            <p
              class="font-mono text-[12px] leading-none tracking-[-0.02em] uppercase text-bone/65"
            >
              Navigate
            </p>
            <ul class="mt-5 space-y-2">
              {
                navigate.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="font-display text-[17px] leading-snug tracking-[-0.01em] text-bone/85 hover:text-bone transition-colors duration-150"
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
          <div class="border-l border-bone/25 pl-5 lg:pl-6 lg:min-w-[150px]">
            <p
              class="font-mono text-[12px] leading-none tracking-[-0.02em] uppercase text-bone/65"
            >
              Connect
            </p>
            <ul class="mt-5 space-y-2">
              {
                connect.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      class="font-display text-[17px] leading-snug tracking-[-0.01em] text-bone/85 hover:text-bone transition-colors duration-150"
                      {...(link.external
                        ? { target: "_blank", rel: "noopener noreferrer" }
                        : {})}
                    >
                      {link.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </nav>
        <a
          href="#hero"
          aria-label="Back to top"
          class="hidden md:inline-flex w-10 h-10 rounded-lg border border-bone/40 text-bone items-center justify-center hover:border-bone hover:bg-white/15 transition-colors duration-200"
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 14 14"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M7 13V2M2 6.5 7 1.5l5 5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </div>

    <div class="shrink-0 px-3 sm:px-6 lg:px-12 pb-5 md:pb-6">
      <p
        class="footer-name inline-block font-display text-bone leading-[0.95] tracking-[-0.03em] whitespace-nowrap"
      >
        Dominic Clerici
      </p>
      <p
        class="font-mono text-[11px] leading-none tracking-[-0.02em] uppercase text-bone/60 mt-4"
      >
        &copy; {year} Dominic Clerici. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  /* Holds the haze canvas back until it has drawn a frame over the photo. It
     is opaque (alpha: false), so shown any earlier it would be a black sheet;
     once drawn it matches the <img> beneath pixel-for-pixel, so the fade only
     brings the shimmer up rather than swapping one picture for another. */
  #footer-canvas {
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  #footer-canvas.is-ready {
    opacity: 1;
  }

  /* Darkens the sky behind the statement and nav and the asphalt behind the
     giant name; the middle stays clear so the horizon and its shimmer read at
     full strength. */
  .footer-scrim {
    background: linear-gradient(
      to bottom,
      rgb(10 10 10 / 0.5) 0%,
      rgb(10 10 10 / 0.25) 28%,
      rgb(10 10 10 / 0) 42%,
      rgb(10 10 10 / 0) 58%,
      rgb(10 10 10 / 0.3) 76%,
      rgb(10 10 10 / 0.6) 100%
    );
  }
  /* Below lg the nav columns stack under the statement and land on the pale
     horizon itself, so the scrim carries on down past them. */
  @media (max-width: 1023px) {
    .footer-scrim {
      background: linear-gradient(
        to bottom,
        rgb(10 10 10 / 0.5) 0%,
        rgb(10 10 10 / 0.35) 30%,
        rgb(10 10 10 / 0.3) 46%,
        rgb(10 10 10 / 0) 58%,
        rgb(10 10 10 / 0) 64%,
        rgb(10 10 10 / 0.3) 80%,
        rgb(10 10 10 / 0.6) 100%
      );
    }
  }

  /* Header echo in the cap bar: hidden until the page is scrolled to its very
     bottom, then it rises 6px and fades in; leaving the bottom reverses it. */
  .footer-header {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.45s ease,
      transform 0.45s ease;
  }
  .footer-header.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .footer-header {
      transition-property: opacity;
      transform: none;
    }
  }
</style>

<script>
  import { createHeatHaze, type HeatHaze } from "../scripts/heat-haze";
  import {
    makeState,
    typeText,
    cancelAnim,
    stopBlink,
  } from "../scripts/terminal";

  {
    const footer = document.getElementById("site-footer")!;
    const photo = footer.querySelector<HTMLImageElement>(".footer-photo")!;
    const canvas = document.getElementById(
      "footer-canvas",
    ) as HTMLCanvasElement;
    const name = footer.querySelector<HTMLElement>(".footer-name")!;
    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    /* ── Giant name ──
       Sized to span the content width exactly, reference-style: measure at a
       fixed size, then scale so the text's edges meet the padding. */
    function fitName() {
      name.style.fontSize = "100px";
      const parent = name.parentElement!;
      const cs = getComputedStyle(parent);
      const width =
        parent.clientWidth -
        parseFloat(cs.paddingLeft) -
        parseFloat(cs.paddingRight);
      name.style.fontSize = `${(100 * width) / Math.max(name.scrollWidth, 1)}px`;
    }

    /* ── Road backdrop + heat haze ──
       As the footer comes within 600px the photo starts loading; once it has
       decoded, the haze takes it as a texture. The shimmer only runs while
       the footer is actually on screen. Under reduced motion, or without
       WebGL2, the photo is left as it is. */
    let haze: HeatHaze | null = null;
    let footerVisible = false;

    function loadPhoto() {
      if (photo.srcset) return;
      photo.srcset = photo.dataset.srcset!;
      if (reducedMotion) return;
      photo
        .decode()
        .then(() => {
          haze = createHeatHaze({
            canvas,
            img: photo,
            onReady: () => canvas.classList.add("is-ready"),
            onLost: () => {
              canvas.classList.remove("is-ready");
              haze = null;
            },
          });
          if (footerVisible && !document.hidden) haze?.start();
        })
        .catch(() => {});
    }

    new IntersectionObserver(
      (entries, io) => {
        if (entries.some((e) => e.isIntersecting)) {
          loadPhoto();
          io.disconnect();
        }
      },
      { rootMargin: "600px 0px" },
    ).observe(footer);

    new IntersectionObserver(
      (entries) => {
        footerVisible = entries[0].isIntersecting;
        if (footerVisible) {
          loadPhoto();
          haze?.start();
        } else {
          haze?.stop();
        }
      },
      { threshold: 0 },
    ).observe(footer);

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) haze?.stop();
      else if (footerVisible) haze?.start();
    });

    /* ── Header echo ──
       The cap-bar header echo fades in only while the page is scrolled to its
       very bottom (within 6px), reversing on the way out. Each fresh entry
       replays the terminal typing from scratch once the rise/fade settles;
       each exit cancels the typing and resets the prompt. */
    const headerEcho = footer.querySelector<HTMLElement>(".footer-header")!;
    const echoState = makeState(
      footer.querySelector<HTMLElement>('[data-terminal="footer"]')!,
    );
    let echoVisible = false;

    function setEchoVisible(visible: boolean) {
      if (visible === echoVisible) return;
      echoVisible = visible;
      if (visible) {
        headerEcho.classList.add("is-visible");
      } else {
        headerEcho.classList.remove("is-visible");
        cancelAnim(echoState);
        stopBlink(echoState);
        echoState.textEl.textContent = ">";
      }
    }

    headerEcho.addEventListener("transitionend", (e) => {
      if (e.propertyName === "opacity" && echoVisible) typeText(echoState);
    });

    // Reading documentElement.scrollHeight forces a full-document layout, so
    // it is cached rather than re-read per scroll frame. It moves only when
    // the page's height does, which the observer below is the signal for.
    let docScrollH = document.documentElement.scrollHeight;
    function measureDocH() {
      docScrollH = document.documentElement.scrollHeight;
    }

    function onEchoScroll() {
      const distanceFromBottom =
        docScrollH - (window.scrollY + window.innerHeight);
      setEchoVisible(distanceFromBottom <= 6);
    }
    // Shared scroll bus — functional (not decorative), so it must run under
    // reduced motion too, which the bus's native scroll listener guarantees.
    (window as any).__onSmoothScrollTick(onEchoScroll);
    onEchoScroll();

    let resizeTimer: number | undefined;
    new ResizeObserver(() => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        // fitName writes a font size, then reads metrics back, then writes
        // again — two forced layouts on the largest text node on the page.
        // The footer is h-svh, so mobile URL-bar show/hide retriggers this
        // observer mid-scroll; it belongs behind a debounce rather than
        // running on every one of those ticks.
        fitName();
        onEchoScroll();
      }, 120);
    }).observe(footer);

    // Page height moves with content well outside the footer — Work's spreads
    // expand — so the echo's distance-from-bottom test is invalidated from the
    // document box, not from the footer observer above.
    new ResizeObserver(() => {
      measureDocH();
      onEchoScroll();
    }).observe(document.documentElement);

    fitName();
    // Refit once the display face arrives — metrics differ from the fallback.
    document.fonts?.ready.then(fitName);
  }
</script>
