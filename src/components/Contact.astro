---
// "The Letter": the form IS a letter. Name and email are inline
// fill-in-the-blank inputs woven into the prose (--font-display, set at the
// same size and leading as the surrounding text so the inputs are visually
// indistinguishable from it), the message is the letter's body, and the
// quote signs off as a P.S.

const links = [
  {
    label: "GitHub",
    href: "https://github.com/DominicClerici",
    external: true,
  },
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/dominic-clerici/",
    external: true,
  },
  {
    label: "contact@dominicclerici.com",
    href: "mailto:contact@dominicclerici.com",
    external: false,
  },
]

const FOCUS_RING =
  "focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-bio-lime"

const LINK_CLASS = `font-mono text-[12px] tracking-[-0.02em] uppercase text-n-400 hover:text-bio-lime transition-colors duration-200 ${FOCUS_RING}`

// Small outline button — the captcha's "start over" and the "write another"
// affordance. Colour and padding differ per instance; everything else is shared.
const GHOST_BTN = `font-mono text-[11px] tracking-[-0.02em] uppercase bg-transparent border border-n-700 cursor-pointer hover:text-bio-lime hover:border-bio-lime/40 ${FOCUS_RING}`
---

<section
  id="contact"
  class="relative bg-n-950 overflow-hidden"
  aria-labelledby="contact-heading"
>
  <div
    class="relative max-w-[860px] mx-auto px-6 md:px-10 py-[clamp(110px,15vh,190px)]"
  >
    <h2 id="contact-heading" class="sr-only">Contact</h2>

    <!-- Notebook margin rule -->
    <div
      class="cv2-margin absolute top-0 bottom-0 left-3 md:-left-8 w-px pointer-events-none"
      aria-hidden="true"
    >
    </div>

    <p
      class="font-mono text-[12px] leading-none tracking-[-0.02em] uppercase text-white/45 mb-14 md:mb-20"
    >
      04&hairsp;/&hairsp;04 &middot; Write to me
    </p>

    <form class="cv2-form" novalidate>
      <p class="cv2-line">Hi Dominic —</p>

      <p class="cv2-line mt-6">
        <label for="cv2-name" class="sr-only">Your name (optional)</label>
        my name is
        <input
          id="cv2-name"
          name="name"
          type="text"
          autocomplete="name"
          data-fit="10"
          class="cv2-blank"
        />
        <span class="text-white/35"
          >(or don&rsquo;t say — that&rsquo;s fine)</span
        >
        and I wanted to tell you:
      </p>

      <label for="cv2-message" class="sr-only">Your message (required)</label>
      <textarea
        id="cv2-message"
        name="message"
        rows="3"
        required
        placeholder="…anything. This is the only part I actually need."
        class="cv2-body mt-8"></textarea>

      <p class="cv2-line mt-8">
        <label for="cv2-email" class="sr-only">Your email (optional)</label>
        If a reply would be welcome, I&rsquo;m at
        <input
          id="cv2-email"
          name="email"
          type="email"
          autocomplete="email"
          data-fit="14"
          class="cv2-blank"
        />.
      </p>

      <div class="flex items-center gap-6 mt-14 md:mt-16">
        <span class="cv2-seal-wrap relative shrink-0">
          <button
            type="submit"
            aria-label="Prove your humanity"
            class:list={[
              "cv2-seal group relative w-[64px] h-[64px] rounded-full bg-bio-lime text-ink inline-flex items-center justify-center cursor-pointer",
              "disabled:bg-n-850 disabled:text-n-500 disabled:cursor-not-allowed",
              FOCUS_RING,
            ]}
          >
            <svg
              class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
              width="18"
              height="18"
              viewBox="0 0 14 14"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M2 12 12 2M4.5 2H12v7.5"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
          <span class="cv2-tip" aria-hidden="true"
            >Already sent &mdash; one letter is plenty.</span
          >
        </span>
        <div>
          <p
            class="cv2-cta-title font-mono text-[13px] tracking-[-0.02em] text-n-300"
          >
            Prove your humanity
          </p>
          <p
            class="cv2-cta-sub font-mono text-[11px] tracking-[-0.02em] text-n-500 mt-1.5"
          >
            I promise this won&rsquo;t be your usual captcha.
          </p>
          <button
            type="button"
            class:list={[
              "cv2-again hidden mt-3 px-3 py-[7px] text-n-400 transition-colors duration-200",
              GHOST_BTN,
            ]}>Write another letter</button
          >
        </div>
      </div>

      <p
        class="cv2-error hidden font-mono text-[12px] tracking-[-0.02em] text-[#e0a68b] mt-6"
        role="alert"
      >
        The letter needs a body — write anything at all.
      </p>

      <div id="cv2-captcha" popover class="cv2-captcha">
        <div class="cv2-cap-main">
          <p
            class="font-mono text-[11px] leading-none tracking-[-0.02em] uppercase text-white/45"
          >
            Proof of humanity
          </p>
          <p
            class="font-display text-[19px] leading-[1.5] tracking-[-0.005em] mt-4"
          >
            One last thing — sign here.
            <span class="text-white/35">Any scribble counts.</span>
          </p>
          <div class="relative h-[116px] mt-5">
            <canvas
              class:list={[
                "cv2-sig absolute inset-0 w-full h-full touch-none cursor-crosshair",
                FOCUS_RING,
              ]}
              tabindex="0"
              role="img"
              aria-label="Signature area. Draw any scribble with your mouse or finger."
            ></canvas>
            <span
              class="absolute left-1 bottom-[30px] font-mono text-[12px] text-white/25 pointer-events-none"
              aria-hidden="true">&times;</span
            >
            <div
              class="cv2-sig-line absolute left-0.5 right-0.5 bottom-6 pointer-events-none"
              aria-hidden="true"
            >
            </div>
          </div>
          <div class="flex items-center justify-between gap-4 mt-4">
            <p class="cv2-cap-status" role="status">
              Sign with a scribble — any scribble.
            </p>
            <button
              type="button"
              class:list={[
                "cv2-cap-reset shrink-0 px-2.5 py-1.5 text-n-300 transition-[color,border-color,opacity] duration-200",
                GHOST_BTN,
              ]}
              aria-label="Clear the signature and start over"
            >
              Start over
            </button>
          </div>
          <button
            type="button"
            class:list={[
              "cv2-cap-send flex items-center justify-center gap-2 w-full mt-5 py-[11px] cursor-pointer",
              "font-mono text-[12px] tracking-[-0.02em] uppercase bg-bio-lime text-n-950 transition-colors duration-200",
              "disabled:bg-n-850 disabled:text-n-500 disabled:cursor-not-allowed",
              FOCUS_RING,
            ]}
            disabled
          >
            <span class="cv2-cap-spinner" aria-hidden="true"></span>
            <span class="cv2-cap-send-label">Awaiting a signature</span>
          </button>
        </div>
        <div
          class="cv2-cap-sent absolute inset-0 flex flex-col items-center justify-center gap-3 text-bio-lime opacity-0 pointer-events-none transition-opacity duration-300 delay-150"
          aria-hidden="true"
        >
          <svg width="40" height="40" viewBox="0 0 14 14" fill="none">
            <path
              d="M2 12 12 2M4.5 2H12v7.5"
              pathLength="1"
              stroke="currentColor"
              stroke-width="1.2"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
          <p class="font-mono text-[12px] tracking-[-0.02em]">Off it goes.</p>
        </div>
      </div>
    </form>

    <div class="border-t border-n-800 mt-16 md:mt-20 pt-10">
      <p
        class="font-display italic text-[19px] md:text-[22px] leading-[1.55] text-white/55 max-w-[560px]"
      >
        P.S. — The first language was a disaster. Everything since has been
        <span class="text-bio-lime not-italic">on purpose</span>.
      </p>

      <div class="flex flex-wrap gap-x-8 gap-y-3 mt-10">
        {
          links.map((link) => (
            <a
              href={link.href}
              class={LINK_CLASS}
              {...(link.external
                ? { target: "_blank", rel: "noopener noreferrer" }
                : {})}
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* The notebook margin rule, and its echo inside the captcha slip:
     one gradient, two fade insets. */
  .cv2-margin,
  .cv2-captcha::before {
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in srgb, var(--color-bio-lime) 28%, transparent)
        var(--rule-fade),
      color-mix(in srgb, var(--color-bio-lime) 28%, transparent)
        calc(100% - var(--rule-fade)),
      transparent
    );
  }

  .cv2-margin {
    --rule-fade: 120px;
  }

  /* The letter's voice. The prose lines and the textarea share it exactly, so
     the body is indistinguishable from the text around it. */
  .cv2-form {
    --letter-ink: #e9e9e6;
  }

  .cv2-line,
  .cv2-body {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.4vw, 2.125rem);
    line-height: 1.55;
    letter-spacing: -0.005em;
    color: var(--letter-ink);
  }

  .cv2-body {
    display: block;
    width: 100%;
    background: transparent;
    border: none;
    outline: none;
    resize: none;
    padding: 0;
    caret-color: var(--color-bio-lime);
  }

  .cv2-body::placeholder {
    color: rgb(255 255 255 / 0.22);
    font-style: italic;
  }

  /* The dashed-blank language: the inline inputs and the signature line are
     dashed until filled, then solid lime. */
  .cv2-blank,
  .cv2-sig-line {
    border: 0 solid transparent;
    border-bottom: 1px dashed rgb(255 255 255 / 0.35);
    transition: border-color 0.2s ease;
  }

  .cv2-blank:focus,
  .cv2-captcha.is-ready .cv2-sig-line {
    border-bottom-style: solid;
    border-bottom-color: var(--color-bio-lime);
  }

  .cv2-blank {
    display: inline-block;
    vertical-align: baseline;
    width: 10ch;
    max-width: 100%;
    background: transparent;
    border-radius: 0;
    outline: none;
    padding: 0 0.15em 0.05em;
    font: inherit;
    color: var(--color-bio-lime);
    caret-color: var(--color-bio-lime);
  }

  /* Sent state: the seal goes quiet. Both the scale and the arrow's nudge have
     to be withheld — Tailwind drives the nudge through `translate`, not
     `transform`, so it needs its own reset. */
  .cv2-seal:disabled svg {
    translate: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .cv2-seal {
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .cv2-seal:not(:disabled):hover {
      transform: scale(1.06) rotate(4deg);
    }
  }

  /* Raised dark surfaces: the captcha slip and the seal's tooltip */
  .cv2-captcha,
  .cv2-tip {
    background: var(--color-n-900);
    border: 1px solid var(--color-n-800);
  }

  /* The captcha: a slip of the same letter, in the top layer */
  .cv2-captcha {
    --rule-fade: 24px;
    position: fixed;
    inset: auto;
    margin: 0;
    width: min(340px, calc(100vw - 32px));
    padding: 22px 24px 18px 30px;
    color: var(--letter-ink);
    overflow: visible;
    /* keeps the exit transition visible in browsers that drop it from the top layer early */
    z-index: 60;
    opacity: 0;
    transform: translateY(8px) rotate(-0.5deg);
  }

  /* After a send, the slip leaves upward — the way the arrow went */
  .cv2-captcha.is-sent-anim {
    transform: translateY(-14px) rotate(0.4deg);
  }

  .cv2-captcha:popover-open {
    opacity: 1;
    transform: none;
  }

  /* Echo of the notebook margin rule */
  .cv2-captcha::before {
    content: "";
    position: absolute;
    top: 14px;
    bottom: 14px;
    left: 11px;
    width: 1px;
    pointer-events: none;
  }

  .cv2-cap-status {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: -0.02em;
    color: var(--color-n-400);
    transition: color 0.2s ease;
  }

  .cv2-captcha.is-signed .cv2-cap-status {
    color: var(--color-bio-lime);
  }

  /* Only offered once there's ink to regret */
  .cv2-cap-reset {
    opacity: 0;
    pointer-events: none;
  }

  .cv2-captcha.has-ink .cv2-cap-reset {
    opacity: 1;
    pointer-events: auto;
  }

  .cv2-captcha.is-sending .cv2-cap-reset,
  .cv2-captcha.is-sent-anim .cv2-cap-reset {
    opacity: 0;
    pointer-events: none;
  }

  .cv2-cap-main {
    transition: opacity 0.25s ease;
  }

  .cv2-captcha.is-sent-anim .cv2-cap-main {
    opacity: 0;
  }

  .cv2-cap-spinner {
    display: none;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1.5px solid var(--color-n-600);
    border-top-color: var(--color-n-300);
  }

  .cv2-captcha.is-sending .cv2-cap-spinner {
    display: inline-block;
  }

  /* "Off it goes." — the seal's arrow, drawn then released */
  .cv2-captcha.is-sent-anim .cv2-cap-sent {
    opacity: 1;
  }

  .cv2-tip {
    position: absolute;
    bottom: calc(100% + 12px);
    left: 50%;
    transform: translateX(-50%) translateY(3px);
    white-space: nowrap;
    padding: 8px 11px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: -0.02em;
    color: var(--color-n-300);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
    z-index: 10;
  }

  .cv2-form[data-sent] .cv2-seal-wrap:hover .cv2-tip {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  @media (prefers-reduced-motion: no-preference) {
    .cv2-captcha {
      transition:
        opacity 0.25s var(--ease-settle),
        transform 0.25s var(--ease-settle),
        overlay 0.25s ease allow-discrete,
        display 0.25s ease allow-discrete;
    }

    @starting-style {
      .cv2-captcha:popover-open {
        opacity: 0;
        transform: translateY(8px) rotate(-0.5deg);
      }
    }

    .cv2-cap-spinner {
      animation: cv2-spin 0.7s linear infinite;
    }

    @keyframes cv2-spin {
      to {
        transform: rotate(360deg);
      }
    }

    .cv2-captcha.is-sent-anim .cv2-cap-sent path {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: cv2-draw 0.45s ease 0.3s forwards;
    }

    @keyframes cv2-draw {
      to {
        stroke-dashoffset: 0;
      }
    }

    .cv2-captcha.is-sent-anim .cv2-cap-sent svg {
      animation: cv2-fly 0.55s cubic-bezier(0.6, -0.1, 0.9, 0.5) 1.05s forwards;
    }

    @keyframes cv2-fly {
      to {
        transform: translate(30px, -30px);
        opacity: 0;
      }
    }

    .cv2-captcha.is-sent-anim .cv2-cap-sent p {
      opacity: 0;
      animation: cv2-appear 0.3s ease 1.2s forwards;
    }

    @keyframes cv2-appear {
      to {
        opacity: 1;
      }
    }
  }
</style>

<script>
  import {
    MIN_INK,
    MIN_SAMPLES,
    inspectInk,
    botMessage,
    type Pt,
  } from "../scripts/signature"

  {
    const form = document.querySelector<HTMLFormElement>(".cv2-form")
    if (form) {
      const message = form.querySelector<HTMLTextAreaElement>("#cv2-message")
      const error = form.querySelector<HTMLElement>(".cv2-error")

      // Blanks grow with their contents, like handwriting filling a line
      form.querySelectorAll<HTMLInputElement>("[data-fit]").forEach((input) => {
        const min = Number(input.dataset.fit) || 10
        const fit = () => {
          input.style.width = `${Math.max(min, input.value.length + 2)}ch`
        }
        input.addEventListener("input", fit)
        fit()
      })

      if (message) {
        message.addEventListener("input", () => {
          message.style.height = "auto"
          message.style.height = `${message.scrollHeight}px`
          error?.classList.add("hidden")
        })
      }

      const sendLetter = () => {
        const data = new FormData(form)
        const name = String(data.get("name") || "").trim()
        const email = String(data.get("email") || "").trim()
        const body = String(data.get("message") || "").trim()
        const subject = name
          ? `A letter from ${name}`
          : "A letter from your portfolio"
        const lines = [
          "Hi Dominic —",
          "",
          body,
          "",
          name ? `— ${name}` : "",
          email ? `Reply to: ${email}` : "",
          "✍ signed by hand",
        ].filter(Boolean)
        window.location.href = `mailto:contact@dominicclerici.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join("\n"))}`
      }

      // --- The captcha: sign the letter ---
      const SENT_KEY = "cv2-letter-sent"
      const seal = form.querySelector<HTMLButtonElement>(".cv2-seal")
      const pop = form.querySelector<HTMLElement>("#cv2-captcha")
      const canvas = pop?.querySelector<HTMLCanvasElement>(".cv2-sig")
      const status = pop?.querySelector<HTMLElement>(".cv2-cap-status")
      const ctx = canvas?.getContext("2d")
      const sendBtn = pop?.querySelector<HTMLButtonElement>(".cv2-cap-send")
      const resetSig = pop?.querySelector<HTMLButtonElement>(".cv2-cap-reset")
      const sendLabel = pop?.querySelector<HTMLElement>(".cv2-cap-send-label")
      const ctaTitle = form.querySelector<HTMLElement>(".cv2-cta-title")
      const ctaSub = form.querySelector<HTMLElement>(".cv2-cta-sub")
      const again = form.querySelector<HTMLButtonElement>(".cv2-again")

      const INK =
        getComputedStyle(document.documentElement)
          .getPropertyValue("--color-bio-lime")
          .trim() || "#cef79e"

      let strokes: Pt[][] = []

      let inkLength = 0
      let samples = 0
      let ready = false
      let committed = false
      let drawing = false
      let last: { x: number; y: number; t: number; w: number } | null = null
      let sendT1 = 0
      let sendT2 = 0

      // localStorage can throw in strict privacy modes — treat as "never sent"
      const readSent = () => {
        try {
          return Boolean(localStorage.getItem(SENT_KEY))
        } catch {
          return false
        }
      }

      const applySentState = (sent: boolean) => {
        if (seal) seal.disabled = sent
        if (sent) form.setAttribute("data-sent", "")
        else form.removeAttribute("data-sent")
        if (ctaTitle)
          ctaTitle.textContent = sent ? "Letter sent." : "Prove your humanity"
        if (ctaSub)
          ctaSub.textContent = sent
            ? "One letter is plenty — I promise I read them."
            : "I promise this won’t be your usual captcha."
        again?.classList.toggle("hidden", !sent)
      }

      const setStatus = (text: string) => {
        if (status) status.textContent = text
      }

      const resetPad = () => {
        if (!canvas || !ctx) return
        const dpr = window.devicePixelRatio || 1
        canvas.width = canvas.clientWidth * dpr
        canvas.height = canvas.clientHeight * dpr
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
        ctx.lineCap = "round"
        ctx.lineJoin = "round"
        ctx.strokeStyle = INK
        ctx.fillStyle = INK
        inkLength = 0
        samples = 0
        strokes = []
        ready = false
        committed = false
        drawing = false
        last = null
        pop?.classList.remove(
          "is-ready",
          "is-signed",
          "is-sending",
          "is-sent-anim",
          "has-ink",
        )
        if (sendBtn) sendBtn.disabled = true
        if (sendLabel) sendLabel.textContent = "Awaiting a signature"
        setStatus("Sign with a scribble — any scribble.")
      }

      const markReady = () => {
        ready = true
        pop?.classList.add("is-ready")
        if (sendBtn) sendBtn.disabled = false
        if (sendLabel) sendLabel.textContent = "Send the letter"
      }

      const placePopover = () => {
        if (!pop || !seal || !pop.matches(":popover-open")) return
        const r = seal.getBoundingClientRect()
        const w = pop.offsetWidth
        const h = pop.offsetHeight
        const pad = 12
        let top = r.top - h - 14
        if (top < pad)
          top = Math.min(r.bottom + 14, window.innerHeight - h - pad)
        const left = Math.min(
          Math.max(r.left, pad),
          window.innerWidth - w - pad,
        )
        pop.style.top = `${top}px`
        pop.style.left = `${left}px`
      }

      if (pop && canvas && ctx && seal && sendBtn) {
        // Ink with a live nib: slower strokes pool wider, like a real pen
        canvas.addEventListener("pointerdown", (e) => {
          if (committed) return
          canvas.setPointerCapture(e.pointerId)
          drawing = true
          strokes.push([{ x: e.offsetX, y: e.offsetY }])
          pop.classList.add("has-ink")
          last = { x: e.offsetX, y: e.offsetY, t: e.timeStamp, w: 2.4 }
          ctx.beginPath()
          ctx.arc(e.offsetX, e.offsetY, 1.2, 0, Math.PI * 2)
          ctx.fill()
        })

        canvas.addEventListener("pointermove", (e) => {
          if (!drawing || !last || committed) return
          const x = e.offsetX
          const y = e.offsetY
          const dist = Math.hypot(x - last.x, y - last.y)
          if (dist < 1) return
          const speed = dist / Math.max(e.timeStamp - last.t, 1)
          const target = Math.min(Math.max(3.4 - speed * 1.1, 1.1), 3.4)
          const width = last.w + (target - last.w) * 0.3
          ctx.lineWidth = width
          ctx.beginPath()
          ctx.moveTo(last.x, last.y)
          ctx.lineTo(x, y)
          ctx.stroke()
          inkLength += dist
          samples += 1
          strokes[strokes.length - 1]?.push({ x, y })
          last = { x, y, t: e.timeStamp, w: width }
          if (!ready && inkLength > MIN_INK && samples > MIN_SAMPLES)
            markReady()
        })

        const liftPen = () => {
          if (!drawing) return
          drawing = false
          last = null
          if (committed) return
          const verdict = inspectInk(strokes)
          if (verdict.flagged) {
            // Too much of the ink is geometrically perfect — revoke the
            // signature until some human wobble dilutes it
            ready = false
            pop.classList.remove("is-ready", "is-signed")
            sendBtn.disabled = true
            if (sendLabel) sendLabel.textContent = "Awaiting a signature"
            setStatus(botMessage(verdict))
          } else if (ready) {
            pop.classList.add("is-signed")
            setStatus("Good enough for me — send it.")
          } else if (samples < 3) {
            setStatus("That's a dot. I need a whole scribble.")
          } else {
            setStatus("Almost — keep the scribble going.")
          }
        }
        canvas.addEventListener("pointerup", liftPen)
        canvas.addEventListener("pointercancel", liftPen)

        resetSig?.addEventListener("click", () => {
          if (committed) return
          resetPad()
          canvas.focus({ preventScroll: true })
        })

        sendBtn.addEventListener("click", () => {
          if (!ready || committed) return
          committed = true
          sendBtn.disabled = true
          pop.classList.add("is-sending")
          if (sendLabel) sendLabel.textContent = "Sealing…"
          sendT1 = window.setTimeout(() => {
            try {
              localStorage.setItem(SENT_KEY, new Date().toISOString())
            } catch {
              /* still send; the page just won't remember */
            }
            sendLetter()
            setStatus("Sent — off it goes.")
            pop.classList.add("is-sent-anim")
            sendT2 = window.setTimeout(() => {
              if (pop.matches(":popover-open")) pop.hidePopover()
              else applySentState(true)
            }, 2000)
          }, 1000)
        })

        // Open locks page scroll (compensating for the vanished scrollbar).
        // Closing early (Esc, light dismiss) abandons an unsent attempt;
        // once the letter is away, closing just finalizes the sent state
        pop.addEventListener("toggle", (e) => {
          const open =
            (e as unknown as { newState: string }).newState === "open"
          const html = document.documentElement
          // overflow:hidden blocks native inputs; the engine lock stops the
          // smooth-scroll's programmatic scrolling, which overflow can't
          ;(
            window as unknown as { __smoothScrollLock?: (l: boolean) => void }
          ).__smoothScrollLock?.(open)
          if (open) {
            const gap = window.innerWidth - html.clientWidth
            html.style.overflow = "hidden"
            if (gap > 0) html.style.paddingRight = `${gap}px`
            // The slip is positioned by hand, so it only needs to track the
            // viewport while it's actually up
            window.addEventListener("resize", placePopover, { passive: true })
            window.addEventListener("scroll", placePopover, { passive: true })
            return
          }
          window.removeEventListener("resize", placePopover)
          window.removeEventListener("scroll", placePopover)
          html.style.overflow = ""
          html.style.paddingRight = ""
          drawing = false
          if (committed) {
            window.clearTimeout(sendT1)
            window.clearTimeout(sendT2)
            if (readSent()) applySentState(true)
          }
        })

        again?.addEventListener("click", () => {
          try {
            localStorage.removeItem(SENT_KEY)
          } catch {
            /* nothing to clear */
          }
          applySentState(false)
          seal.focus()
        })

        if (readSent()) applySentState(true)
      }

      form.addEventListener("submit", (e) => {
        e.preventDefault()
        if (readSent()) return
        const body = String(new FormData(form).get("message") || "").trim()
        if (!body) {
          error?.classList.remove("hidden")
          message?.focus()
          return
        }
        if (pop && canvas && ctx && typeof pop.showPopover === "function") {
          pop.showPopover()
          resetPad()
          placePopover()
          canvas.focus({ preventScroll: true })
        } else {
          sendLetter()
        }
      })
    }
  }
</script>
