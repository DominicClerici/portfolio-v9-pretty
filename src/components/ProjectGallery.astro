---
// The gallery column of an edition. Rendered three times per project: inside
// the arch as the window's replica (decorative — the arch's own button carries
// the label), inside the spread, and — leadOnly — as the mobile spread's hero
// plate, the landing spot the arch's plate flies out to. The portal clones
// these at open time, so the markup has to survive cloneNode without JS wiring.
import type { ImageMetadata } from "astro";
import type { GalleryPlate } from "../data/projects";

interface Props {
  gallery: GalleryPlate[];
  decorative?: boolean;
  leadOnly?: boolean;
  /** Fetch at once rather than lazily: the standalone project page, where
   *  the column is the page. The lead plate is its largest paint, so it goes
   *  first; the rest follow at low priority. Lazy loading can't be left to
   *  do this there, as the plates sit in the spread's own scroller, and
   *  outside Chromium a lazy image in a nested scroller isn't fetched until
   *  it has already scrolled into sight. */
  eager?: boolean;
}

const {
  gallery,
  decorative = false,
  leadOnly = false,
  eager = false,
} = Astro.props;

const plates = leadOnly ? gallery.slice(0, 1) : gallery;

// Imported rather than served from public/, so the build emits them under
// /_astro/ with a hash in their names: immutable, and cached for a year.
const images = import.meta.glob<ImageMetadata>("../assets/photos/*.webp", {
  import: "default",
  eager: true,
});
const image = (file: string) => {
  const img = images[`../assets/photos/${file}`];
  if (!img) throw new Error(`ProjectGallery: no src/assets/photos/${file}`);
  return img;
};
// By width, so the browser takes the 1x plate wherever it covers the column
// at the screen's density (a 592px column on a 2x laptop needs 1184px) rather
// than the 2x one on every 2x screen
const srcset = (file: string) =>
  [image(file), image(file.replace(".webp", "-2x.webp"))]
    .map((img) => `${img.src} ${img.width}w`)
    .join(", ");
// The column's width: the spread's gallery column on desktop (the page less
// the 36rem story, the 6rem gap and 48px of padding each side, and past
// 1280px half the overflow as well); the page's width, at most, below that.
// The home page's replica is seated at the same width, or narrower.
const sizes =
  "(min-width: 1280px) calc(50vw - 128px), (min-width: 1024px) calc(100vw - 768px), 100vw";
---

<div class:list={["we1-gallery flex flex-col", leadOnly && "we1-ghero"]}>
  {
    plates.map((g, k) => (
      <figure class:list={["m-0", k === 0 && "we1-gfig-lead"]}>
        <div class="we1-gframe relative overflow-hidden">
          <img
            src={image(g.src).src}
            srcset={srcset(g.src)}
            sizes={sizes}
            width={image(g.src).width}
            height={image(g.src).height}
            alt={decorative ? "" : g.alt}
            class={
              k === 0
                ? "block w-full h-auto"
                : "absolute inset-0 w-full h-full object-cover object-top"
            }
            loading={eager ? "eager" : "lazy"}
            fetchpriority={eager ? (k === 0 ? "high" : "low") : undefined}
            decoding="async"
          />
        </div>
      </figure>
    ))
  }
</div>

<style>
  .we1-gallery {
    padding-top: clamp(150px, 19vh, 230px);
    padding-bottom: 120px;
    gap: 72px;
  }

  .we1-gframe {
    border-radius: 22px;
    background: #ececea;
    box-shadow: 0 26px 60px -30px
      color-mix(in srgb, var(--color-ink) 40%, transparent);
    aspect-ratio: 16 / 9;
  }

  /* The lead plate is the door you came through — shown whole, un-cropped */
  .we1-gfig-lead .we1-gframe {
    aspect-ratio: auto;
  }

  @media (max-width: 1023px) {
    .we1-gallery {
      padding-top: 24px;
      padding-bottom: 72px;
      gap: 56px;
    }
  }

  /* The hero variant carries no column padding of its own — the flying clone
     is seated by its frame rect, and in-spread spacing is Work.astro's */
  .we1-gallery.we1-ghero {
    padding: 0;
    gap: 0;
  }
</style>
