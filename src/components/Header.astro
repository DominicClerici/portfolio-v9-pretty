---
const navLinks = [
  {
    label: "LinkedIn",
    href: "https://www.linkedin.com/in/dominic-clerici/",
    external: true,
  },
  {
    label: "Email",
    href: "mailto:contact@dominicclerici.com",
    external: false,
  },
];
---

<!-- Desktop only: on mobile the hero stands alone with no header. -->
<header class="hidden md:block absolute top-0 left-0 w-full z-[70]">
  <div
    class="header-enter px-6 lg:px-12 py-7 flex justify-between items-center"
  >
    <a
      href="https://dev.dominicclerici.com"
      target="_blank"
      rel="noopener noreferrer"
      data-terminal="header"
      aria-label="Open developer terminal"
      class="inline-flex font-mono text-[14px] text-ink py-1.5"
    >
      <span data-terminal-text>&gt;</span><span data-terminal-cursor>_</span>
    </a>

    <nav class="flex gap-7 items-center" aria-label="Main navigation">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="font-mono text-[13px] tracking-[-0.02em] uppercase text-ink/70 hover:text-ink transition-colors duration-150"
            {...(link.external
              ? { target: "_blank", rel: "noopener noreferrer" }
              : {})}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="/DominicClerici_CV.pdf"
        class="font-mono text-[13px] tracking-[-0.02em] uppercase text-ink border border-ink/35 rounded-xl px-4 py-1.5 hover:bg-bio-lime hover:text-ink hover:border-bio-lime transition-colors duration-150"
        target="_blank"
        rel="noopener noreferrer"
      >
        Resume
      </a>
    </nav>
  </div>
</header>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .header-enter {
      opacity: 0;
      transform: translateY(-18px);
      animation: header-drop 0.8s var(--ease-settle) 0.65s forwards;
    }

    @keyframes header-drop {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
</style>

<script>
  import {
    makeState,
    startBlink,
    stopBlink,
    cancelAnim,
    typeText,
    deleteText,
  } from "../scripts/terminal";

  // === Desktop Header Button ===
  const headerEl = document.querySelector<HTMLElement>(
    '[data-terminal="header"]',
  );
  if (headerEl) {
    const hs = makeState(headerEl);

    new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) {
          hs.isInView = true;
          if (!hs.isHovering) {
            if (hs.visTimer !== null) {
              clearTimeout(hs.visTimer);
            }
            hs.visTimer = window.setTimeout(() => startBlink(hs), 5000);
          }
        } else {
          hs.isInView = false;
          if (!hs.isHovering) stopBlink(hs);
          if (hs.visTimer !== null) {
            clearTimeout(hs.visTimer);
            hs.visTimer = null;
          }
        }
      }
    }).observe(headerEl);

    headerEl.addEventListener("mouseenter", () => {
      hs.isHovering = true;
      if (hs.visTimer !== null) {
        clearTimeout(hs.visTimer);
        hs.visTimer = null;
      }
      typeText(hs);
    });

    headerEl.addEventListener("mouseleave", async () => {
      hs.isHovering = false;
      const completed = await deleteText(hs);
      if (completed && !hs.isHovering && hs.isInView) {
        startBlink(hs);
      }
    });
  }

  // === Desktop Scroll Button ===
  const scrollEl = document.querySelector<HTMLElement>(
    '[data-terminal="scroll"]',
  );
  const heroSection = document.getElementById("hero");

  if (scrollEl && heroSection) {
    const ss = makeState(scrollEl);

    new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) {
          scrollEl.style.opacity = "0.5";
          scrollEl.classList.remove("pointer-events-none");
          scrollEl.classList.add("pointer-events-auto");
          ss.isInView = true;
          if (!ss.isHovering) {
            if (ss.visTimer !== null) {
              clearTimeout(ss.visTimer);
            }
            ss.visTimer = window.setTimeout(() => startBlink(ss), 5000);
          }
        } else {
          scrollEl.style.opacity = "0";
          scrollEl.classList.add("pointer-events-none");
          scrollEl.classList.remove("pointer-events-auto");
          ss.isInView = false;
          cancelAnim(ss);
          stopBlink(ss);
          ss.textEl.textContent = ">";
          if (ss.visTimer !== null) {
            clearTimeout(ss.visTimer);
            ss.visTimer = null;
          }
        }
      }
    }).observe(heroSection);

    scrollEl.addEventListener("mouseenter", () => {
      ss.isHovering = true;
      if (ss.visTimer !== null) {
        clearTimeout(ss.visTimer);
        ss.visTimer = null;
      }
      typeText(ss);
    });

    scrollEl.addEventListener("mouseleave", async () => {
      ss.isHovering = false;
      const completed = await deleteText(ss);
      if (completed && !ss.isHovering && ss.isInView) {
        startBlink(ss);
      }
    });
  }
</script>
