---
// "The Morning Editions": Dispatch prints a paper every morning, so the whole
// shelf is typeset like one — each build is the front page of its own edition,
// run off the same press across one day: morning, midday, late. Newsreader
// italic mastheads, an arched plate window for the artwork, one ink per
// edition (press blue, ocean teal, magenta). Scroll seats each plate like a
// page coming off the press: the arch rises, its halo ring settles, and the
// image eases out of overscan. Warm paper, generous margins, no rules.
//
// The arch is also a door — and before that, a window. Each arch holds a
// full replica of its spread (paper, wash, and the gallery column) pinned to
// the viewport at the exact position the open spread will place it: the
// spread is a fixed overlay, so its landing coordinates are viewport
// coordinates. Scrolling sweeps the arch across that stationary scene — the
// images never move, only the mask does, a window panning over a room.
// Clicking (or "Learn more") expands the mask to the full viewport; nothing
// behind it shifts, so the walk-through is seamless.
// Gallery images and story copy are placeholders to swap for real content.
const projects = [
  {
    index: "01",
    title: "Dispatch",
    edition: "morning edition",
    fact: "writes itself every morning",
    description:
      "The last 24 hours of tech news, compressed into a 10 minute read. Two decoupled AI pipelines research, triage, and write it; GitHub Actions runs the whole thing while I sleep.",
    image: "/photos/dispatch.webp",
    alt: "Dispatch project screenshot",
    stack: ["Astro", "TypeScript", "OpenAI API", "Tailwind", "Vercel"],
    websiteUrl: "https://dispatch.dominicclerici.com/",
    githubUrl: "https://github.com/DominicClerici/dispatch",
    featured: false,
    accent: "#33569c",
    wash: "rgba(51, 86, 156, 0.09)",
    details: [
      { label: "Role", value: "Design & build — solo" },
      { label: "Timeline", value: "2025 — ongoing" },
      { label: "Status", value: "In print daily" },
    ],
    story: [
      "Dispatch exists because I kept losing whole mornings to tab sprawl — four newsletters, two aggregators, and a feed that never ended. The brief I set myself was narrow: everything that mattered in tech in the last twenty-four hours, printed as one calm page, readable before the coffee goes cold.",
      "Two decoupled pipelines run the press. The first is a researcher: it sweeps sources overnight, scores stories against each other, and throws most of them away. The second is a writer: it takes the surviving shortlist and sets it in plain language, with a hard budget of ten minutes of reading. Neither pipeline knows the other exists — they only share an editorial contract.",
      "GitHub Actions is the night shift. It runs the whole edition while I sleep, and the only moving part I ever touch is reading the paper it leaves behind.",
    ],
    gallery: [
      { src: "/photos/dispatch.webp", alt: "Dispatch front page", caption: "The front page of a live edition, printed at six sharp." },
      { src: "/photos/dispatch.webp", alt: "Dispatch placeholder plate", caption: "Placeholder plate — the triage pipeline's scoring pass." },
      { src: "/photos/dispatch.webp", alt: "Dispatch placeholder plate", caption: "Placeholder plate — a story moving from shortlist to print." },
    ],
  },
  {
    index: "02",
    title: "Meridian",
    edition: "midday edition",
    fact: "0 npm dependencies",
    description:
      "A new-tab extension for Chrome and Firefox with zero npm dependencies. Eleven feature modules, a reactive storage layer, and a recommendation engine that never lets data leave the browser.",
    image: "/photos/meridian.webp",
    alt: "Meridian project screenshot",
    stack: ["TypeScript", "esbuild", "Chrome APIs", "Firefox Add-ons"],
    websiteUrl: "https://meridian.dominicclerici.com/",
    githubUrl: "https://github.com/DominicClerici/meridian",
    featured: false,
    accent: "#2c7a6f",
    wash: "rgba(44, 122, 111, 0.09)",
    details: [
      { label: "Role", value: "Design & build — solo" },
      { label: "Timeline", value: "2024 — 2025" },
      { label: "Status", value: "Live on two stores" },
    ],
    story: [
      "Meridian is a protest against the modern new-tab page — the weather widgets, the sponsored links, the quiet phone-home. It ships with zero npm dependencies: every line that runs in the browser is a line I wrote and can read.",
      "Under the hood it is eleven feature modules seated on a reactive storage layer. Each module owns its slice of state; the layer broadcasts changes and the page settles itself, no framework in the room.",
      "The recommendation engine is the part I'm proudest of: it learns what you open and when, and never lets a byte of that leave the machine. Your habits stay yours.",
    ],
    gallery: [
      { src: "/photos/meridian.webp", alt: "Meridian new tab", caption: "A fresh tab, seated and quiet." },
      { src: "/photos/meridian.webp", alt: "Meridian placeholder plate", caption: "Placeholder plate — the module registry at work." },
      { src: "/photos/meridian.webp", alt: "Meridian placeholder plate", caption: "Placeholder plate — the on-device recommendation pass." },
    ],
  },
  {
    index: "03",
    title: "Fuzzbox",
    edition: "late edition",
    fact: "design system: Neon Riff",
    description:
      "The companion I wished I had when learning guitar. Place notes on an interactive fretboard and it explains the chord you found — the intervals, the theory, why it sounds the way it does.",
    image: "/photos/fuzzbox.webp",
    alt: "Fuzzbox project screenshot",
    stack: ["TypeScript", "Next.js", "React Native", "Prisma", "PostgreSQL"],
    websiteUrl: "https://fuzzbox.dominicclerici.com/",
    githubUrl: null,
    featured: true,
    accent: "#b4487f",
    wash: "rgba(180, 72, 127, 0.1)",
    details: [
      { label: "Role", value: "Design & build — solo" },
      { label: "Timeline", value: "2025 — ongoing" },
      { label: "Status", value: "Editor's pick — in beta" },
    ],
    story: [
      "Fuzzbox started with a chord I found by accident and couldn't name. Every tool I tried wanted me to already know the answer; I wanted one that would meet me at the fretboard.",
      "Place notes on the interactive fretboard and Fuzzbox explains what you've built — the intervals, the theory, why it rings the way it does. It is the companion I wished I had in the first year of playing.",
      "The whole thing wears a design system called Neon Riff — stage-light color on deep black, built to feel like the back room of a guitar shop after hours.",
    ],
    gallery: [
      { src: "/photos/fuzzbox.webp", alt: "Fuzzbox fretboard", caption: "The fretboard, mid-chord." },
      { src: "/photos/fuzzbox.webp", alt: "Fuzzbox placeholder plate", caption: "Placeholder plate — interval breakdown for a found chord." },
      { src: "/photos/fuzzbox.webp", alt: "Fuzzbox placeholder plate", caption: "Placeholder plate — Neon Riff tokens in the wild." },
    ],
  },
];
---

<section id="work" class="we1 relative" aria-label="Selected work">
  <header class="max-w-[1200px] mx-auto px-6 lg:px-12 pt-[clamp(96px,14vh,180px)] text-center">
    <p class="font-mono text-[11px] leading-none tracking-[0.3em] uppercase text-ink/45">
      03&hairsp;/&hairsp;04 &mdash; Selected Work
    </p>
    <h2
      class="font-headline italic font-normal text-ink leading-[1.02] tracking-[-0.01em] mt-7 text-[clamp(2.5rem,6.5vw,4.75rem)]"
    >
      The Morning Editions
    </h2>
    <p class="font-body text-[15px] leading-[1.7] text-ink/55 max-w-[540px] mx-auto mt-6">
      Three builds, run off the same press across one day &mdash; morning, midday, and late.
    </p>
  </header>

  {
    projects.map((project, i) => (
      <>
        {i > 0 && (
          <div class="we1-asterism text-center font-headline text-[18px] tracking-[0.9em] text-ink/30 pl-[0.9em]" aria-hidden="true">
            &middot;&nbsp;&middot;&nbsp;&middot;
          </div>
        )}
        <article class={`we1-plate relative ${i % 2 === 1 ? "we1-flip" : ""}`} data-plate={i} style={`--acc: ${project.accent}; --wash: ${project.wash};`}>
          <div class="max-w-[1200px] mx-auto px-6 lg:px-12 grid grid-cols-1 lg:grid-cols-[minmax(0,11fr)_minmax(0,9fr)] gap-12 lg:gap-20 items-center relative">
            <div class={`we1-copy order-2 ${i % 2 === 1 ? "lg:order-2" : "lg:order-1"}`}>
              <p class="font-mono text-[11px] leading-none tracking-[0.28em] uppercase text-ink/45">
                Edition {project.index}
                <span class="we1-folio-dot inline-block align-middle mx-3" aria-hidden="true" />
                <span style="color: var(--acc);">{project.edition}</span>
              </p>
              <h3 class="font-headline italic font-normal text-ink leading-[0.98] tracking-[-0.015em] mt-6 text-[clamp(3rem,8vw,5.5rem)]">
                {project.title}
              </h3>
              <p class="font-headline text-[17px] leading-[1.75] text-ink/70 max-w-[52ch] mt-7">{project.description}</p>
              <p class="we1-colophon font-mono text-[11px] leading-[1.9] tracking-[0.14em] uppercase text-ink/45 mt-8">
                Set in &mdash; {project.stack.join(" · ")}
              </p>
              <p class="font-mono text-[11px] leading-none tracking-[0.14em] uppercase text-ink/35 mt-3">
                {project.fact}
              </p>
              <div class="flex items-center flex-wrap gap-x-7 gap-y-4 mt-9">
                <a
                  href={project.websiteUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="we1-link font-headline italic text-[19px] text-ink"
                >
                  Visit the site&nbsp;&nearr;
                </a>
                <button
                  type="button"
                  class="we1-more font-mono text-[12px] tracking-[0.1em] uppercase we1-focus"
                  data-open={i}
                >
                  <span class="we1-more-glyph" aria-hidden="true" />
                  Learn more
                </button>
                {project.githubUrl && (
                  <a
                    href={project.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-mono text-[12px] tracking-[0.1em] uppercase text-ink/50 hover:text-ink transition-colors duration-200 we1-focus"
                  >
                    Source
                  </a>
                )}
              </div>
            </div>

            <figure class={`we1-fig relative order-1 ${i % 2 === 1 ? "lg:order-1" : "lg:order-2"} m-0`}>
              <span class="we1-no font-headline italic absolute select-none" aria-hidden="true">
                No.&thinsp;{i + 1}
              </span>
              <div class="we1-arch-wrap relative mx-auto">
                <span class="we1-ring absolute" aria-hidden="true" />
                <span class="we1-ring2 absolute" aria-hidden="true" />
                <button type="button" class="we1-door block w-full" data-open={i} aria-label={`Read the full story — ${project.title}`}>
                  <div class="we1-arch relative overflow-hidden">
                    <div class="we1-view absolute" data-view aria-hidden="true">
                      <div class="we1-gallery flex flex-col">
                        {project.gallery.map((g, k) => (
                          <figure class={`we1-gfig m-0 ${k === 0 ? "we1-gfig-lead" : ""}`}>
                            <div class="we1-gframe relative overflow-hidden">
                              <img
                                src={g.src}
                                srcset={`${g.src} 1x, ${g.src.replace(".webp", "-2x.webp")} 2x`}
                                alt=""
                                class={k === 0 ? "block w-full h-auto" : "absolute inset-0 w-full h-full object-cover object-top"}
                                loading="lazy"
                                decoding="async"
                              />
                            </div>
                            <figcaption class="font-mono text-[10px] leading-[1.7] tracking-[0.16em] uppercase text-ink/40 mt-4 text-center">
                              fig. 0{k + 1} &mdash; {g.caption}
                            </figcaption>
                          </figure>
                        ))}
                      </div>
                    </div>
                  </div>
                </button>
                {project.featured && (
                  <span class="we1-stamp absolute font-mono text-[10px] leading-none tracking-[0.22em] uppercase">
                    Editor&rsquo;s pick
                  </span>
                )}
              </div>
            </figure>
          </div>
        </article>
      </>
    ))
  }

  <p
    class="max-w-[1200px] mx-auto px-6 lg:px-12 pb-14 pt-4 font-mono text-[11px] leading-none tracking-[0.18em] uppercase text-ink/35 text-center"
  >
    end of the print run &mdash; back tomorrow, six a.m. sharp
  </p>

  {
    projects.map((project, i) => (
      <div
        class={`we1-spread ${i % 2 === 1 ? "we1-spread-flip" : ""}`}
        data-spread={i}
        data-lenis-prevent
        tabindex="-1"
        role="dialog"
        aria-modal="true"
        aria-labelledby={`we1-spread-title-${i}`}
        style={`--acc: ${project.accent}; --wash: ${project.wash};`}
        hidden
      >
        <button type="button" class="we1-back font-mono text-[11px] leading-none tracking-[0.14em] uppercase we1-focus" data-close>
          &larr;&ensp;Back to the front page
        </button>

        <div class="we1-sgrid grid grid-cols-1 gap-x-24">
          <div class="we1-story">
            <p class="font-mono text-[11px] leading-none tracking-[0.28em] uppercase text-ink/45" data-rise style="--ri: 0;">
              Edition {project.index}
              <span class="we1-folio-dot inline-block align-middle mx-3" aria-hidden="true" />
              <span style="color: var(--acc);">{project.edition}</span>
              <span class="we1-folio-dot inline-block align-middle mx-3" aria-hidden="true" />
              the full story
            </p>
            <h3
              id={`we1-spread-title-${i}`}
              class="font-headline italic font-normal text-ink leading-[0.96] tracking-[-0.015em] mt-6 text-[clamp(3.25rem,7vw,5.75rem)]"
              data-rise
              style="--ri: 1;"
            >
              {project.title}
            </h3>
            <p class="font-headline text-[19px] leading-[1.7] text-ink/75 max-w-[52ch] mt-8" data-rise style="--ri: 2;">
              {project.description}
            </p>
            <div class="mt-9 space-y-6 max-w-[58ch]">
              {project.story.map((para, j) => (
                <p class="font-body text-[15px] leading-[1.85] text-ink/65" data-rise style={`--ri: ${3 + j};`}>
                  {para}
                </p>
              ))}
            </div>
            <dl class="we1-details grid grid-cols-3 gap-6 mt-12 max-w-[52ch]" data-rise style={`--ri: ${3 + project.story.length};`}>
              {project.details.map((d) => (
                <div>
                  <dt class="font-mono text-[10px] leading-none tracking-[0.22em] uppercase text-ink/40">{d.label}</dt>
                  <dd class="font-headline text-[15px] leading-[1.5] text-ink/80 mt-2.5">{d.value}</dd>
                </div>
              ))}
            </dl>
            <p
              class="we1-colophon font-mono text-[11px] leading-[1.9] tracking-[0.14em] uppercase text-ink/45 mt-10"
              data-rise
              style={`--ri: ${4 + project.story.length};`}
            >
              Set in &mdash; {project.stack.join(" · ")}
            </p>
            <div class="flex items-center flex-wrap gap-x-7 gap-y-4 mt-10" data-rise style={`--ri: ${5 + project.story.length};`}>
              <a
                href={project.websiteUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="we1-link font-headline italic text-[19px] text-ink"
              >
                Visit the site&nbsp;&nearr;
              </a>
              {project.githubUrl && (
                <a
                  href={project.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-mono text-[12px] tracking-[0.1em] uppercase text-ink/50 hover:text-ink transition-colors duration-200 we1-focus"
                >
                  Source
                </a>
              )}
            </div>
          </div>

          <div class="we1-gallery flex flex-col">
            {project.gallery.map((g, k) => (
              <figure class={`we1-gfig m-0 ${k === 0 ? "we1-gfig-lead" : ""}`}>
                <div class="we1-gframe relative overflow-hidden">
                  <img
                    src={g.src}
                    srcset={`${g.src} 1x, ${g.src.replace(".webp", "-2x.webp")} 2x`}
                    alt={g.alt}
                    class={k === 0 ? "block w-full h-auto" : "absolute inset-0 w-full h-full object-cover object-top"}
                    loading="eager"
                    decoding="async"
                  />
                </div>
                <figcaption class="font-mono text-[10px] leading-[1.7] tracking-[0.16em] uppercase text-ink/40 mt-4 text-center">
                  fig. 0{k + 1} &mdash; {g.caption}
                </figcaption>
              </figure>
            ))}
          </div>
        </div>

        <div class="pb-16 pt-6 text-center">
          <button type="button" class="we1-endline font-mono text-[11px] leading-none tracking-[0.18em] uppercase text-ink/35 we1-focus" data-close>
            fold the paper &mdash; back to the front page
          </button>
        </div>
      </div>
    ))
  }

  <div class="we1-portal" data-portal aria-hidden="true">
    <div class="we1-portal-col" data-portal-col></div>
  </div>
</section>

<style>
  .we1 {
    overflow-x: clip;
    background: #faf8f2;
    --door-ease: cubic-bezier(0.77, 0, 0.175, 1);
    --settle-ease: cubic-bezier(0.22, 1, 0.36, 1);
    /* --in: entry progress (0 offscreen → 1 seated), --par: full-traverse
       progress for parallax. Defaults render the seated state without JS. */
  }

  .we1-plate {
    --in: 1;
    --par: 0.5;
    padding: clamp(80px, 11vh, 140px) 0;
  }

  /* One tinted wash pooled behind the figure side */
  .we1-plate::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(46% 62% at 74% 50%, var(--wash), transparent 72%);
    opacity: var(--in);
  }

  .we1-flip::before {
    background: radial-gradient(46% 62% at 26% 50%, var(--wash), transparent 72%);
  }

  .we1-folio-dot {
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: var(--acc);
  }

  /* ── The arch plate ── */
  /* isolate so the numeral's z-index: -1 stays inside the figure instead of
     dropping behind the section background */
  .we1-fig {
    isolation: isolate;
  }

  .we1-arch-wrap {
    max-width: 440px;
    transform: translateY(calc((1 - var(--in)) * 70px));
    opacity: calc(0.2 + var(--in) * 0.8);
    will-change: transform;
  }

  .we1-door {
    cursor: pointer;
    border-radius: 999px 999px 26px 26px;
  }

  .we1-door:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 6px;
  }

  .we1-arch {
    aspect-ratio: 0.84;
    border-radius: 999px 999px 26px 26px;
    background: #faf8f2;
    box-shadow: 0 26px 60px -30px rgba(34, 47, 48, 0.45);
    transition: box-shadow 0.55s var(--settle-ease);
  }

  /* The view: a replica of the spread, seen through the arch. Without JS (or
     with reduced motion / narrow viewports) it stays arch-sized and simply
     shows the gallery column at arch width — the lead plate, like before.
     With JS on desktop (.we1-js) it becomes a viewport-sized scene: the
     gallery replica is seated at the spread's landing rect and the whole view
     is counter-translated by the arch's viewport position every frame, so the
     content holds still while the arch sweeps over it. */
  .we1-view {
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #faf8f2;
    will-change: transform;
  }

  .we1-view .we1-gallery {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
  }

  @media (max-width: 1023px) {
    /* Small screens keep the old gentle drift instead of the pinned scene */
    .we1-view .we1-gallery {
      transform: translateY(calc((0.5 - var(--par)) * 26px));
    }
  }

  @media (min-width: 1024px) {
    .we1-js .we1-view {
      width: 100vw;
      height: 100dvh;
      background:
        radial-gradient(44% 36% at 78% 6%, var(--wash), transparent 70%),
        #faf8f2;
    }

    .we1-js .we1-flip .we1-view {
      background:
        radial-gradient(44% 36% at 22% 6%, var(--wash), transparent 70%),
        #faf8f2;
    }

    /* No JS / reduced motion: the arch-sized fallback shouldn't inherit the
       spread's tall desktop gallery padding — keep the lead plate in view */
    .we1:not(.we1-js) .we1-view .we1-gallery {
      padding-top: 24px;
    }
  }

  /* Warm accent light seeping up from inside the doorway (hover state) */
  .we1-arch::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(85% 55% at 50% 104%, color-mix(in srgb, var(--acc) 32%, transparent), transparent 72%);
    opacity: 0;
    transition: opacity 0.55s var(--settle-ease);
  }

  /* Halo ring settles around the arch as it seats */
  .we1-ring {
    inset: -16px;
    border: 1px solid var(--acc);
    border-radius: 999px 999px 34px 34px;
    opacity: calc(var(--in) * 0.55);
    transform: scale(calc(0.965 + var(--in) * 0.035));
    pointer-events: none;
  }

  /* Second ring, hover only — glows outward when the door is "unlatched" */
  .we1-ring2 {
    inset: -26px;
    border: 1px solid var(--acc);
    border-radius: 999px 999px 40px 40px;
    opacity: 0;
    transform: scale(0.97);
    pointer-events: none;
    transition:
      opacity 0.55s var(--settle-ease),
      transform 0.55s var(--settle-ease);
  }

  /* Shared invited state: hovering/focusing the door OR the Learn more button.
     No lift/scale here — moving the arch would drag the "world" seen through
     the window along with it and break the illusion; the invitation is all
     light: deeper shadow, inner glow, outer ring. */
  .we1-plate:has(.we1-door:hover, .we1-more:hover, .we1-door:focus-visible, .we1-more:focus-visible) .we1-arch {
    box-shadow: 0 36px 76px -28px color-mix(in srgb, var(--acc) 34%, rgba(34, 47, 48, 0.5));
  }

  .we1-plate:has(.we1-door:hover, .we1-more:hover, .we1-door:focus-visible, .we1-more:focus-visible) .we1-arch::after {
    opacity: 1;
  }

  .we1-plate:has(.we1-door:hover, .we1-more:hover, .we1-door:focus-visible, .we1-more:focus-visible) .we1-ring2 {
    opacity: 0.85;
    transform: scale(1);
  }

  /* Ghost folio numeral behind the plate */
  .we1-no {
    font-size: clamp(6rem, 15vw, 11rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--acc) 40%, transparent);
    top: -0.35em;
    right: -0.08em;
    z-index: -1;
    transform: translateY(calc((0.5 - var(--par)) * 60px));
    will-change: transform;
  }

  .we1-flip .we1-no {
    right: auto;
    left: -0.08em;
  }

  .we1-stamp {
    top: 8%;
    right: -14px;
    padding: 10px 14px;
    border: 1.5px solid var(--acc);
    border-radius: 999px;
    color: var(--acc);
    background: rgba(250, 248, 242, 0.85);
    transform: rotate(6deg);
    pointer-events: none;
  }

  .we1-flip .we1-stamp {
    right: auto;
    left: -14px;
    transform: rotate(-6deg);
  }

  /* ── Links: accent underline that draws on hover ── */
  .we1-link {
    background-image: linear-gradient(var(--acc), var(--acc));
    background-repeat: no-repeat;
    background-size: 100% 1.5px;
    background-position: 0 96%;
    padding-bottom: 3px;
    transition: background-size 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .we1-link:hover {
    background-size: 38% 1.5px;
  }

  .we1-link:focus-visible,
  .we1-focus:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 4px;
    border-radius: 2px;
  }

  /* ── Learn more: mono button with a tiny arch that fills with ink ── */
  .we1-more {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--acc);
    cursor: pointer;
  }

  .we1-more-glyph {
    width: 9px;
    height: 12px;
    border: 1.5px solid var(--acc);
    border-radius: 999px 999px 2px 2px;
    transition: background 0.3s var(--settle-ease);
  }

  .we1-plate:has(.we1-door:hover, .we1-more:hover, .we1-door:focus-visible, .we1-more:focus-visible) .we1-more-glyph {
    background: var(--acc);
  }

  /* ── The portal: an expanding clip mask over the (stationary) spread ── */
  /* Full-viewport layer painted like the spread (paper + wash) with a clone
     of the gallery column frozen at its landing position — the same scene the
     arch window shows, so only the clip window ever moves. */
  .we1-portal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 45;
    background:
      radial-gradient(44% 36% at var(--wx, 78%) 6%, var(--pwash, transparent), transparent 70%),
      #faf8f2;
    clip-path: inset(var(--ct, 0px) var(--cr, 0px) var(--cb, 0px) var(--cl, 0px) round 999px 999px 26px 26px);
    transition:
      clip-path 0.82s var(--door-ease),
      opacity 0.24s ease;
  }

  .we1-portal-col {
    position: absolute;
    left: var(--fx, 0px);
    top: var(--fy, 0px);
    width: var(--fw, 300px);
  }

  .we1-portal-on {
    display: block;
  }

  .we1-portal-full {
    clip-path: inset(0px 0px 0px 0px round 0px 0px 0px 0px);
  }

  .we1-portal-fade {
    opacity: 0;
  }

  /* ── Closing: content dissolves over the shrinking portal ── */
  /* The spread lifts above the portal and fades as one layer. Inside the
     clip the portal paints the same paper + column at scrollTop 0, so an
     unscrolled gallery reads as perfectly still while only the text (and,
     outside the clip, the paper) dissolves into the revealed page. */
  /* Compound selector: must outrank .we1-spread's own z-index below */
  .we1-spread.we1-spread-close {
    z-index: 50;
    pointer-events: none;
  }

  .we1-spread-out {
    opacity: 0;
    transition: opacity 0.49s ease; /* 60% of the 0.82s door shrink */
  }

  /* Scrolled gallery: the portal's column starts hidden so the spread's
     scrolled images genuinely fade out with it... */
  .we1-portal-col-hide .we1-portal-col {
    opacity: 0;
  }

  /* ...then fades back in at the top of the column near the end */
  .we1-portal-col-in .we1-portal-col {
    opacity: 1;
    transition: opacity 0.25s ease; /* 30% of the door shrink */
  }

  /* ── The inside spread ── */
  .we1-spread {
    position: fixed;
    inset: 0;
    z-index: 40;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    background:
      radial-gradient(44% 36% at 78% 6%, var(--wash), transparent 70%),
      #faf8f2;
  }

  .we1-spread:focus {
    outline: none;
  }

  .we1-spread-flip {
    background:
      radial-gradient(44% 36% at 22% 6%, var(--wash), transparent 70%),
      #faf8f2;
  }

  .we1-spread-flip .we1-story {
    order: 2;
  }

  .we1-spread-flip .we1-gallery {
    order: 1;
  }

  .we1-back {
    position: fixed;
    top: 22px;
    left: max(22px, env(safe-area-inset-left));
    z-index: 5;
    padding: 12px 18px;
    border: 1px solid rgba(34, 47, 48, 0.14);
    border-radius: 999px;
    color: rgba(34, 47, 48, 0.6);
    background: rgba(250, 248, 242, 0.82);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    cursor: pointer;
    transition:
      color 0.25s ease,
      border-color 0.25s ease;
  }

  .we1-back:hover {
    color: var(--color-ink, #222f30);
    border-color: color-mix(in srgb, var(--acc) 55%, transparent);
  }

  .we1-sgrid {
    padding-inline: 24px;
  }

  .we1-story {
    padding-top: clamp(120px, 16vh, 180px);
    padding-bottom: 96px;
  }

  .we1-gallery {
    padding-top: clamp(150px, 19vh, 230px);
    padding-bottom: 120px;
    gap: 72px;
  }

  .we1-gframe {
    border-radius: 22px;
    background: #eef0ea;
    box-shadow: 0 26px 60px -30px rgba(34, 47, 48, 0.4);
    aspect-ratio: 4 / 3;
  }

  /* The lead plate is the door you came through — shown whole, un-cropped */
  .we1-gfig-lead .we1-gframe {
    aspect-ratio: auto;
  }

  .we1-endline {
    cursor: pointer;
    transition: color 0.25s ease;
  }

  .we1-endline:hover {
    color: var(--acc);
  }

  /* Content rises in staggered once the portal dissolves */
  .we1-spread [data-rise] {
    opacity: 0.1;
    transform: translateY(6px);
    transition:
      opacity 0.7s var(--settle-ease),
      transform 0.7s var(--settle-ease);
    transition-delay: calc(var(--ri, 0) * 70ms);
  }

  .we1-spread.is-in [data-rise] {
    opacity: 1;
    transform: none;
  }

  @media (min-width: 1024px) {
    /* Story column sits where the old centered 1280px container put it; the
       gallery column runs from the gap to the page edge, with half the column
       gap (48px) as its edge padding */
    .we1-sgrid {
      grid-template-columns: minmax(0, 36rem) minmax(0, 1fr);
      padding-left: calc(max((100vw - 1280px) / 2, 0px) + 48px);
      padding-right: 48px;
    }

    .we1-spread-flip .we1-sgrid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 36rem);
      padding-left: 48px;
      padding-right: calc(max((100vw - 1280px) / 2, 0px) + 48px);
    }

    .we1-story {
      position: sticky;
      top: 0;
      align-self: start;
      max-height: 100dvh;
      overflow-y: auto;
      scrollbar-width: none;
    }

    .we1-story::-webkit-scrollbar {
      display: none;
    }
  }

  @media (max-width: 1023px) {
    .we1-arch-wrap {
      max-width: 360px;
    }

    .we1-no {
      font-size: clamp(5rem, 22vw, 8rem);
      top: -0.3em;
    }

    .we1-plate {
      padding: clamp(64px, 9vh, 110px) 0;
    }

    .we1-story {
      padding-top: 110px;
      padding-bottom: 24px;
    }

    .we1-gallery {
      padding-top: 24px;
      padding-bottom: 72px;
      gap: 56px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .we1-plate {
      --in: 1 !important;
      --par: 0.5 !important;
    }

    .we1-portal {
      display: none !important;
    }

    .we1-arch,
    .we1-ring2,
    .we1-arch::after,
    .we1-spread [data-rise] {
      transition: none !important;
    }

    .we1-spread [data-rise] {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  {
    const section = document.querySelector<HTMLElement>(".we1");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (section) {
      const spreads = Array.from(section.querySelectorAll<HTMLElement>("[data-spread]"));
      const desktop = window.matchMedia("(min-width: 1024px)");

      const spreadFor = (i: number) => spreads.find((s) => s.dataset.spread === String(i));
      const galleryFor = (spread: HTMLElement) => spread.querySelector<HTMLElement>(".we1-gallery");
      // Both scroll containers: the spread itself (gallery) and the sticky
      // story column, which scrolls independently on desktop
      const resetScroll = (spread: HTMLElement) => {
        spread.scrollTop = 0;
        const story = spread.querySelector<HTMLElement>(".we1-story");
        if (story) story.scrollTop = 0;
      };

      const windows = Array.from(section.querySelectorAll<HTMLElement>("[data-plate]")).map((plate) => ({
        plate,
        i: Number(plate.dataset.plate),
        arch: plate.querySelector<HTMLElement>(".we1-arch"),
        view: plate.querySelector<HTMLElement>("[data-view]"),
        replica: plate.querySelector<HTMLElement>("[data-view] .we1-gallery"),
      }));

      // ── The window: each arch looks through at its spread's gallery ──
      // The spread is a fixed overlay, so its gallery's rect at scrollTop 0 is
      // in viewport coordinates. The replica inside each arch is seated at
      // that rect (on measure), and the viewport-sized view around it is
      // translated by minus the arch's own viewport position every frame —
      // pinning the scene to the viewport while the arch sweeps over it.
      type GalRect = { left: number; top: number; width: number };
      // undefined = stale, retry when visible; null = windows off (mobile)
      const galRects: (GalRect | null | undefined)[] = [];

      const galRectOf = (spread: HTMLElement): GalRect | undefined => {
        const gallery = galleryFor(spread);
        if (!gallery) return undefined;
        const wasHidden = spread.hidden;
        if (wasHidden) {
          spread.style.visibility = "hidden";
          spread.hidden = false;
        }
        const r = gallery.getBoundingClientRect();
        const rect = { left: r.left, top: r.top + spread.scrollTop, width: r.width };
        if (wasHidden) {
          spread.hidden = true;
          spread.style.visibility = "";
        }
        // Zero width means we measured before layout settled — retry later
        return rect.width > 0 ? rect : undefined;
      };

      const measureAll = () => {
        for (const w of windows) {
          const spread = spreadFor(w.i);
          galRects[w.i] = desktop.matches ? (spread && galRectOf(spread)) : null;
          if (!w.view || !w.replica) continue;
          const g = galRects[w.i];
          if (g) {
            w.replica.style.left = `${g.left}px`;
            w.replica.style.top = `${g.top}px`;
            w.replica.style.width = `${g.width}px`;
          } else {
            w.replica.style.left = "";
            w.replica.style.top = "";
            w.replica.style.width = "";
            w.view.style.transform = "";
          }
        }
      };

      if (!reducedMotion) {
        section.classList.add("we1-js");
        let ticking = false;
        let measureQueued = false;

        const remeasureSoon = () => {
          if (measureQueued) return;
          measureQueued = true;
          requestAnimationFrame(() => {
            measureQueued = false;
            measureAll();
            update();
          });
        };

        function update() {
          ticking = false;
          const vh = window.innerHeight;
          for (const w of windows) {
            const rect = w.plate.getBoundingClientRect();
            // Not laid out (display: none) — nothing to drive
            if (!rect.height) continue;
            const raw = Math.min(1, Math.max(0, (vh - rect.top) / (vh * 0.7)));
            const eased = raw * raw * (3 - 2 * raw);
            const par = Math.min(1, Math.max(0, (vh - rect.top) / (vh + rect.height)));
            w.plate.style.setProperty("--in", eased.toFixed(3));
            w.plate.style.setProperty("--par", par.toFixed(3));

            if (!w.view || !w.arch) continue;
            const g = galRects[w.i];
            if (g === undefined) {
              // Became measurable after an earlier stale measurement
              if (desktop.matches) remeasureSoon();
              continue;
            }
            if (!g) continue;
            // Read after --in lands so the arch rect already carries this
            // frame's entry transform — the scene must not trail the arch
            const a = w.arch.getBoundingClientRect();
            const t = `translate(${(-a.left).toFixed(2)}px, ${(-a.top).toFixed(2)}px)`;
            if (w.view.style.transform !== t) w.view.style.transform = t;
          }
        }

        // The smooth-scroll engine moves the page inside its own rAF tick; a
        // plain scroll listener repaints one frame behind it. This hook runs
        // synchronously after each tick's scrollTo — same frame, no lag.
        const hook = () => (window as any).__onSmoothScrollTick?.(update) ?? null;
        let detachTick: (() => void) | null = hook();

        const onScroll = () => {
          if (!detachTick) detachTick = hook();
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        };

        let resizeRaf = 0;
        const onResize = () => {
          cancelAnimationFrame(resizeRaf);
          resizeRaf = requestAnimationFrame(() => {
            measureAll();
            update();
          });
        };

        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onResize, { passive: true });
        measureAll();
        update();
      }

      // ── Walk-through-the-door open/close ──
      const portal = section.querySelector<HTMLElement>("[data-portal]");
      const portalCol = portal?.querySelector<HTMLElement>("[data-portal-col]");

      const OPEN_MS = 820;
      const SWAP_MS = 240;
      // Close choreography, scaled to the door shrink (OPEN_MS): content
      // fades over the first 60%; a scrolled gallery's images fade back in
      // starting at 80%, over 30%. Keep the CSS durations in sync
      // (.we1-spread-out, .we1-portal-col-in).
      const CLOSE_FADE_MS = Math.round(OPEN_MS * 0.6);
      const COL_IN_AT_MS = Math.round(OPEN_MS * 0.8);
      const COL_IN_MS = Math.round(OPEN_MS * 0.3);

      let openIndex = -1;
      let busy = false;
      let lastTrigger: HTMLElement | null = null;
      let detachSpreadScroll: (() => void) | null = null;
      const timers = new Set<ReturnType<typeof setTimeout>>();

      const attachScroll = (spread: HTMLElement) => {
        detachSpreadScroll?.();
        detachSpreadScroll = (window as any).__attachSmoothScroll?.(spread) ?? null;
      };

      const detachScroll = () => {
        detachSpreadScroll?.();
        detachSpreadScroll = null;
      };

      const later = (fn: () => void, ms: number) => {
        const id = setTimeout(() => {
          timers.delete(id);
          fn();
        }, ms);
        timers.add(id);
      };

      const clearTimers = () => {
        for (const id of timers) clearTimeout(id);
        timers.clear();
      };

      const lock = (on: boolean) => {
        document.documentElement.style.overflow = on ? "hidden" : "";
        // The smooth-scroll engine drives window.scrollTo itself, so it must be
        // frozen alongside overflow (see smooth-scroll.ts hard lock)
        (window as any).__smoothScrollLock?.(on);
      };

      const archFor = (i: number) => section.querySelector<HTMLElement>(`[data-plate="${i}"] .we1-arch`);

      const setClipRect = (rect: DOMRect) => {
        if (!portal) return;
        portal.style.setProperty("--ct", `${rect.top}px`);
        portal.style.setProperty("--cl", `${rect.left}px`);
        portal.style.setProperty("--cr", `${window.innerWidth - rect.right}px`);
        portal.style.setProperty("--cb", `${window.innerHeight - rect.bottom}px`);
      };

      const setColRect = (g: GalRect) => {
        if (!portal) return;
        portal.style.setProperty("--fx", `${g.left}px`);
        portal.style.setProperty("--fy", `${g.top}px`);
        portal.style.setProperty("--fw", `${g.width}px`);
      };

      // The portal shows the same stationary scene the arch window does — a
      // clone of the gallery column frozen at its landing rect
      const fillPortal = (spread: HTMLElement) => {
        const gallery = galleryFor(spread);
        if (portalCol && gallery) portalCol.replaceChildren(gallery.cloneNode(true));
      };

      const dressPortal = (spread: HTMLElement) => {
        if (!portal) return;
        portal.style.setProperty("--pwash", getComputedStyle(spread).getPropertyValue("--wash") || "transparent");
        portal.style.setProperty("--wx", spread.classList.contains("we1-spread-flip") ? "22%" : "78%");
      };

      const resetPortal = () => {
        portal?.classList.remove("we1-portal-on", "we1-portal-full", "we1-portal-fade", "we1-portal-col-hide", "we1-portal-col-in");
      };

      const open = (i: number, trigger: HTMLElement) => {
        if (busy || openIndex >= 0) return;
        const spread = spreadFor(i);
        const arch = archFor(i);
        if (!spread || !arch) return;

        openIndex = i;
        lastTrigger = trigger;
        lock(true);
        history.pushState({ we1: i }, "");

        if (reducedMotion || !portal || !portalCol) {
          spread.hidden = false;
          resetScroll(spread);
          spread.classList.add("is-in");
          attachScroll(spread);
          spread.focus({ preventScroll: true });
          return;
        }

        busy = true;

        // The gallery's landing rect (measured with the spread laid out but
        // invisible) — the portal freezes the whole column there
        const g = galRectOf(spread) ?? { left: 0, top: 0, width: 100 };
        fillPortal(spread);
        dressPortal(spread);
        setColRect(g);
        setClipRect(arch.getBoundingClientRect());
        portal.classList.add("we1-portal-on");
        portal.getBoundingClientRect();
        portal.classList.add("we1-portal-full");

        later(() => {
          spread.hidden = false;
          resetScroll(spread);
          attachScroll(spread);
          requestAnimationFrame(() => {
            requestAnimationFrame(() => spread.classList.add("is-in"));
          });
          portal.classList.add("we1-portal-fade");
          later(() => {
            resetPortal();
            busy = false;
            spread.focus({ preventScroll: true });
          }, SWAP_MS);
        }, OPEN_MS);
      };

      const close = () => {
        if (openIndex < 0) return;
        const i = openIndex;
        openIndex = -1;
        const spread = spreadFor(i);
        const arch = archFor(i);

        const finish = () => {
          detachScroll();
          if (spread) {
            spread.classList.remove("is-in", "we1-spread-close", "we1-spread-out");
            resetScroll(spread);
            spread.hidden = true;
          }
          lastTrigger?.focus({ preventScroll: true });
        };

        // Mid-open interrupt or reduced motion: snap closed
        if (reducedMotion || busy || !portal || !portalCol || !arch || !spread) {
          clearTimers();
          resetPortal();
          busy = false;
          finish();
          lock(false);
          return;
        }

        busy = true;
        // Portal scene is the scrollTop-0 state (what the arch window shows);
        // galRectOf compensates if the spread was scrolled. If the gallery was
        // scrolled, its images fade out with the spread (the portal's column
        // starts hidden) and fade back in at the top near the end; if not, the
        // portal's identical column keeps the images steady under the fade.
        const scrolled = spread.scrollTop > 1;
        const g = galRectOf(spread) ?? { left: 0, top: 0, width: 100 };
        fillPortal(spread);
        dressPortal(spread);
        setColRect(g);
        setClipRect(arch.getBoundingClientRect());
        portal.classList.add("we1-portal-on", "we1-portal-full");
        portal.classList.toggle("we1-portal-col-hide", scrolled);
        spread.classList.add("we1-spread-close");
        portal.getBoundingClientRect();
        // Same frame: the door starts shrinking and the content starts fading
        portal.classList.remove("we1-portal-full");
        spread.classList.add("we1-spread-out");

        later(finish, CLOSE_FADE_MS);
        if (scrolled) later(() => portal.classList.add("we1-portal-col-in"), COL_IN_AT_MS);
        later(() => {
          resetPortal();
          lock(false);
          busy = false;
        }, scrolled ? COL_IN_AT_MS + COL_IN_MS : OPEN_MS);
      };

      const requestClose = () => {
        if (openIndex < 0 || busy) return;
        if (history.state && history.state.we1 != null) {
          history.back();
        } else {
          close();
        }
      };

      section.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        const opener = target.closest<HTMLElement>("[data-open]");
        if (opener?.dataset.open != null) {
          open(Number(opener.dataset.open), opener);
          return;
        }
        if (target.closest("[data-close]")) requestClose();
      });

      window.addEventListener("popstate", () => {
        if (openIndex >= 0) close();
      });

      window.addEventListener("keydown", (e) => {
        if (e.key === "Escape") requestClose();
      });
    }
  }
</script>
