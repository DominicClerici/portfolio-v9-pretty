---
import { projects } from "../data/projects";
import { SHAPES, maskUri, ringBoxes } from "../lib/workShapes";
import ProjectGallery from "./ProjectGallery.astro";
import ProjectLinks from "./ProjectLinks.astro";
import ProjectSpread from "./ProjectSpread.astro";

// "The Morning Editions": Dispatch prints a paper every morning, so the whole
// shelf is typeset like one — each build is the front page of its own edition,
// run off the same press across one day: morning, midday, late. Set in the
// site's own system (Aspekta display, Roboto Mono labels, bone paper, ink),
// with a shaped plate window for the artwork and one ink per edition, drawn
// from the hero's glass objects (cube blue, sphere green, sphere purple).
// Each edition cuts its own window: Dispatch a rounded diamond (two on
// mobile), Meridian a grid of circles, Fuzzbox a stack of bars — geometry in
// src/lib/workShapes.ts. Scroll seats each plate like a page coming off the
// press: the window rises, its halo rings settle, and the image eases out of
// overscan.
//
// The window is also a door. Each window holds a full replica of its spread
// (paper, wash, and the gallery column) pinned to the viewport at the exact
// position the open spread will place it: the spread is a fixed overlay, so
// its landing coordinates are viewport coordinates. Scrolling sweeps the
// window across that stationary scene — the images never move, only the mask
// does, a window panning over a room. Clicking (or "Learn more") expands the
// mask to the full viewport; nothing behind it shifts, so the walk-through
// is seamless.
//
// On mobile there is no pinned scene to walk into. Instead the plate itself
// steps through the door: the spread leads with the same plate as a hero
// image, and on open the window mask expands while a clone of the plate
// flies from the window to the hero's landing rect — one continuous object,
// tapped card to story cover. Close reverses the flight back into the
// doorway.
//
// Copy and imagery live in src/data/projects.ts.

// Static assets per shape: the mask the window is cut with, the boxes the
// halo outlines are drawn from (one per sub-shape — see .we1-ringp), and the
// aspect each variant locks to.
const shapeAssets = (id: (typeof projects)[number]["shape"]) => {
  const s = SHAPES[id];
  const variant = (v: (typeof s)["desktop"]) => ({
    h: v.h,
    ar: 100 / v.h,
    mask: maskUri(v),
    rings: ringBoxes(v),
  });
  return { d: variant(s.desktop), m: variant(s.mobile) };
};
---

<section id="work" class="we1 relative" aria-label="Selected work">
  <header
    class="max-w-[1200px] mx-auto px-3 sm:px-6 lg:px-12 pt-[clamp(96px,14vh,180px)]"
  >
    <div class="border-t border-ink/20" aria-hidden="true"></div>
  </header>

  {
    projects.map((project, i) => {
      const shape = shapeAssets(project.shape);
      return (
        <>
          {i > 0 && (
            <div
              class="max-w-[1200px] mx-auto px-3 sm:px-6 lg:px-12"
              aria-hidden="true"
            >
              <div class="border-t border-ink/20" />
            </div>
          )}
          <article
            class={`we1-plate relative ${i % 2 === 1 ? "we1-flip" : ""}`}
            data-plate={i}
            data-shape={project.shape}
            data-slug={project.slug}
            data-doc-title={`${project.title} — Dominic Clerici`}
            data-doc-desc={project.description}
            style={`--acc: ${project.accent}; --wash: ${project.wash}; --paper: ${project.paper};`}
          >
            <div class="max-w-[1200px] mx-auto px-3 sm:px-6 lg:px-12 grid grid-cols-1 lg:grid-cols-[minmax(0,11fr)_minmax(0,9fr)] gap-12 lg:gap-20 items-center relative">
              <div class="we1-copy">
                <h3 class="font-display text-ink leading-[0.98] tracking-[-0.03em] text-[clamp(2.75rem,7vw,5rem)]">
                  {project.title}
                </h3>
                <p class="font-display text-[17px] leading-[1.6] tracking-[-0.01em] text-ink/70 max-w-[52ch] mt-7">
                  {project.description}
                </p>
                <p class="font-mono text-[12px] leading-[1.9] tracking-[-0.02em] uppercase text-ink/45 mt-8">
                  Set in &mdash; {project.stack.join(" · ")}
                </p>
                <p class="font-mono text-[12px] leading-none tracking-[-0.02em] uppercase text-ink/35 mt-3">
                  {project.fact}
                </p>
                <ProjectLinks
                  websiteUrl={project.websiteUrl}
                  githubUrl={project.githubUrl}
                  class="mt-9"
                >
                  <a
                    href={`/projects/${project.slug}/`}
                    class="we1-more we1-focus font-mono text-[13px] tracking-[-0.02em] uppercase inline-flex items-center gap-[9px] cursor-pointer"
                    data-open={i}
                  >
                    <span
                      class="we1-more-glyph"
                      aria-hidden="true"
                      style={`--gm: ${shape.d.mask}; --gar: ${shape.d.ar.toFixed(4)};`}
                    />
                    Learn more
                  </a>
                </ProjectLinks>
              </div>

              <figure class="we1-fig relative m-0">
                <span
                  class="we1-no font-display absolute select-none"
                  aria-hidden="true"
                >
                  No.&thinsp;{i + 1}
                </span>
                <div
                  class="we1-arch-wrap relative mx-auto"
                  style={`--ar-d: ${shape.d.ar.toFixed(4)}; --ar-m: ${shape.m.ar.toFixed(4)}; --mask-d: ${shape.d.mask}; --mask-m: ${shape.m.mask};`}
                >
                  <div
                    class="we1-rings we1-rings-d absolute"
                    aria-hidden="true"
                  >
                    {shape.d.rings.map((b) => (
                      <span
                        class="we1-ringp absolute"
                        style={`--x: ${b.x}; --y: ${b.y}; --w: ${b.w}; --h: ${b.h}; --rr: ${b.r}; --rot: ${b.rot}deg;`}
                      />
                    ))}
                  </div>
                  <div
                    class="we1-rings we1-rings-m absolute"
                    aria-hidden="true"
                  >
                    {shape.m.rings.map((b) => (
                      <span
                        class="we1-ringp absolute"
                        style={`--x: ${b.x}; --y: ${b.y}; --w: ${b.w}; --h: ${b.h}; --rr: ${b.r}; --rot: ${b.rot}deg;`}
                      />
                    ))}
                  </div>
                  <span class="we1-shade absolute" aria-hidden="true" />
                  <a
                    href={`/projects/${project.slug}/`}
                    class="we1-door block w-full cursor-pointer"
                    data-open={i}
                    aria-label={`Read the full story — ${project.title}`}
                  >
                    <div class="we1-arch relative overflow-hidden">
                      <div
                        class="we1-view absolute"
                        data-view
                        aria-hidden="true"
                      >
                        <ProjectGallery gallery={project.gallery} decorative />
                      </div>
                    </div>
                  </a>
                  {project.featured && (
                    <span class="we1-stamp absolute font-mono text-[11px] leading-none tracking-[-0.01em] uppercase">
                      Editor&rsquo;s pick
                    </span>
                  )}
                </div>
              </figure>
            </div>
          </article>
        </>
      );
    })
  }

  <div
    class="max-w-[1200px] mx-auto px-3 sm:px-6 lg:px-12 pb-[clamp(96px,14vh,180px)]"
    aria-hidden="true"
  >
    <div class="border-t border-ink/20"></div>
  </div>

  {
    projects.map((project, i) => (
      <ProjectSpread project={project} index={i} mode="overlay" />
    ))
  }

  <div class="we1-portal" data-portal aria-hidden="true">
    <div class="we1-portal-col" data-portal-col></div>
  </div>
</section>

<style>
  .we1 {
    overflow-x: clip;
    background: var(--color-bone);
    /* The door's ease lives in the script (doorEase) — the clip is rAF-driven */
    /* --paper: the stock the inside spread is printed on, set per edition in
       projects.ts. The front page stays on plain bone; only the spread — and
       the arch window looking into it — carries the tint. */
    --paper: var(--color-bone);
    /* --in: entry progress (0 offscreen → 1 seated), --par: full-traverse
       progress for parallax. Defaults render the seated state without JS. */
  }

  .we1-plate {
    --in: 1;
    --par: 0.5;
    padding: clamp(80px, 11vh, 140px) 0;
  }

  /* One tinted wash pooled behind the figure side */
  .we1-plate::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      46% 62% at 74% 50%,
      var(--wash),
      transparent 72%
    );
    opacity: var(--in);
  }

  .we1-flip::before {
    background: radial-gradient(
      46% 62% at 26% 50%,
      var(--wash),
      transparent 72%
    );
  }

  /* Column order: copy under figure on mobile, sides swapping per edition on
     desktop — driven off .we1-flip alone, like the spread below */
  .we1-copy {
    order: 2;
  }

  /* ── The arch plate ── */
  /* isolate so the numeral's z-index: -1 stays inside the figure instead of
     dropping behind the section background */
  .we1-fig {
    isolation: isolate;
    order: 1;
  }

  @media (min-width: 1024px) {
    .we1-copy {
      order: 1;
    }

    .we1-fig {
      order: 2;
    }

    .we1-flip .we1-copy {
      order: 2;
    }

    .we1-flip .we1-fig {
      order: 1;
    }
  }

  .we1-arch-wrap {
    /* The halo outlines size themselves off this box in cqw (see .we1-ringp);
       inline-size, not size, so the arch still sets the block axis */
    container-type: inline-size;
    max-width: 440px;
    transform: translateY(calc((1 - var(--in)) * 70px));
    opacity: calc(0.2 + var(--in) * 0.8);
    will-change: transform;
  }

  .we1-door {
    border-radius: 14px;
  }

  .we1-door:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 6px;
  }

  /* The window itself: cut with the edition's shape mask (an SVG data-URI
     from workShapes.ts, stretched to the box — the box's aspect-ratio is
     locked to the same geometry, so the stretch is uniform) */
  .we1-arch {
    aspect-ratio: var(--ar-d, 0.84);
    background: var(--paper);
    -webkit-mask: var(--mask-d) center / 100% 100% no-repeat;
    mask: var(--mask-d) center / 100% 100% no-repeat;
  }

  /* The mask clips the window's own box-shadow, so the shadow lives on a
     masked underlay whose silhouette a drop-shadow filter can trace. Its
     fill is the same paper the window paints, so the mask's antialiased
     edge blends instead of fringing. */
  .we1-shade {
    inset: 0;
    background: var(--paper);
    -webkit-mask: var(--mask-d) center / 100% 100% no-repeat;
    mask: var(--mask-d) center / 100% 100% no-repeat;
    filter: drop-shadow(
      0 22px 24px color-mix(in srgb, var(--color-ink) 28%, transparent)
    );
    transition: filter 0.55s var(--ease-settle);
    pointer-events: none;
  }

  /* Halo outlines, one layer per breakpoint variant. The layer carries the
     figure-wide entry motion; each outline inside it is its own element. */
  .we1-rings {
    /* Daylight between the window's edge and its outline, on every side.
       The hover state below just raises it — see .we1-ringp. */
    --ring-gap: 6px;
    inset: 0;
    pointer-events: none;
    opacity: var(--in);
    transform: scale(calc(0.965 + var(--in) * 0.035));
    transform-origin: center;
  }

  /* One element per sub-shape, sized to that sub exactly — the visible ring
     is its outline, held --ring-gap off the box on all four sides.
     outline-offset is doing real work here: it insets by a flat length and
     grows the corner radius to match, so it is a true offset of the shape at
     any size, and raising it on hover widens every gap by the same number of
     pixels. A transform scale can't do that — a single factor moves a wide
     edge further than a narrow one, and per-axis factors would have to be
     1 + 2 * gap / size, which mixes cqw with px and so can't be expressed in
     CSS (calc can't divide a length by a length) and would change with the
     plate's rendered width besides.

     cqw reads off .we1-arch-wrap, whose aspect is locked to the variant's, so
     one unit of shape geometry is 1cqw down both axes. Circles arrive as
     squares and the half-width border-radius rounds them back off. */
  .we1-ringp {
    left: calc(var(--x) * 1cqw);
    top: calc(var(--y) * 1cqw);
    width: calc(var(--w) * 1cqw);
    height: calc(var(--h) * 1cqw);
    /* left/top place the sub's center; back up by half its box */
    margin-left: calc(var(--w) * 1cqw / -2);
    margin-top: calc(var(--h) * 1cqw / -2);
    border-radius: calc(var(--rr) * 1cqw);
    outline: 1px solid var(--acc);
    outline-offset: var(--ring-gap);
    opacity: var(--ro, 0.55);
    transform: rotate(var(--rot));
    transition:
      opacity 0.55s var(--ease-settle),
      outline-offset 0.55s var(--ease-settle);
  }

  .we1-rings-m {
    display: none;
  }

  /* The view: a replica of the spread, seen through the arch. Without JS (or
     with reduced motion / narrow viewports) it stays arch-sized and simply
     shows the gallery column at arch width — the lead plate, like before.
     With JS on desktop (.we1-js) it becomes a viewport-sized scene: the
     gallery replica is seated at the spread's landing rect and the whole view
     is counter-translated by the arch's viewport position every frame, so the
     content holds still while the arch sweeps over it. */
  .we1-view {
    inset: 0;
    background: var(--paper);
    will-change: transform;
  }

  /* :global — the gallery column is rendered by ProjectGallery.astro, so it
     carries that component's scope, not this one's */
  .we1-view :global(.we1-gallery) {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
  }

  @media (max-width: 1023px) {
    /* Small screens keep the old gentle drift instead of the pinned scene */
    .we1-view :global(.we1-gallery) {
      transform: translateY(calc((0.5 - var(--par)) * 26px));
    }
  }

  @media (min-width: 1024px) {
    .we1-js .we1-view {
      width: 100vw;
      height: 100dvh;
      background:
        radial-gradient(44% 36% at 78% 6%, var(--wash), transparent 70%),
        var(--paper);
    }

    .we1-js .we1-flip .we1-view {
      background:
        radial-gradient(44% 36% at 22% 6%, var(--wash), transparent 70%),
        var(--paper);
    }

    /* No JS / reduced motion: the arch-sized fallback shouldn't inherit the
       spread's tall desktop gallery padding — keep the lead plate in view */
    .we1:not(.we1-js) .we1-view :global(.we1-gallery) {
      padding-top: 24px;
    }
  }

  /* Warm accent light seeping up from inside the doorway (hover state) */
  .we1-arch::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      85% 55% at 50% 104%,
      color-mix(in srgb, var(--acc) 32%, transparent),
      transparent 72%
    );
    opacity: 0;
    transition: opacity 0.55s var(--ease-settle);
  }

  /* Shared invited state: hovering/focusing the door OR the Learn more button.
     No lift/scale here — moving the window would drag the "world" seen through
     it along with it and break the illusion; the invitation is all light:
     deeper shadow, inner glow, outer ring, and the Learn more glyph filling
     with ink. All four live here so the :has() trigger is written once.
     Hover-capable pointers only: on touch a press goes straight through the
     door, and a sticky :hover would leave the outlines flared after the tap. */
  @media (hover: hover) {
    .we1-plate:has(
      .we1-door:hover,
      .we1-more:hover,
      .we1-door:focus-visible,
      .we1-more:focus-visible
    ) {
      & .we1-shade {
        filter: drop-shadow(
          0 30px 30px
            color-mix(
              in srgb,
              var(--acc) 34%,
              color-mix(in srgb, var(--color-ink) 45%, transparent)
            )
        );
      }

      & .we1-arch::after {
        opacity: 1;
      }

      /* Every gap widens by the same 3px, on every edge of every sub-shape */
      & .we1-ringp {
        --ro: 0.85;
        --ring-gap: 16px;
      }

      & .we1-more-glyph {
        background: var(--acc);
      }
    }
  }

  /* Ghost folio numeral behind the plate */
  .we1-no {
    font-size: clamp(6rem, 15vw, 11rem);
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in srgb, var(--acc) 40%, transparent);
    top: -0.35em;
    right: -0.08em;
    z-index: -1;
    transform: translateY(calc((0.5 - var(--par)) * 60px));
    will-change: transform;
  }

  .we1-flip .we1-no {
    right: auto;
    left: -0.08em;
  }

  .we1-stamp {
    top: 8%;
    right: -14px;
    padding: 10px 14px;
    border: 1.5px solid var(--acc);
    border-radius: 999px;
    color: var(--acc);
    background: color-mix(in srgb, var(--color-bone) 85%, transparent);
    transform: rotate(6deg);
    pointer-events: none;
  }

  .we1-flip .we1-stamp {
    right: auto;
    left: -14px;
    transform: rotate(-6deg);
  }

  /* ── Learn more: mono button with the edition's own figure as its glyph ── */
  .we1-more {
    color: var(--acc);
  }

  /* The window's mask at icon size; fills with ink under the shared invited
     state above */
  .we1-more-glyph {
    width: 13px;
    height: calc(13px / var(--gar, 1));
    background: color-mix(in srgb, var(--acc) 40%, transparent);
    -webkit-mask: var(--gm) center / 100% 100% no-repeat;
    mask: var(--gm) center / 100% 100% no-repeat;
    transition: background 0.3s var(--ease-settle);
  }

  /* ── The portal: an expanding clip mask over the (stationary) spread ── */
  /* Full-viewport layer painted like the spread (paper + wash) with a clone
     of the gallery column frozen at its landing position — the same scene the
     shaped window shows, so only the clip window ever moves.
     The clip itself (a multi-part path from workShapes.ts) is written inline
     per frame by the script's rAF driver — deliberately NOT a CSS transition:
     multi-shape paths aren't CSS-interpolable, and the old transition-based
     door was the source of the Chrome missed-transition snap and the
     unclipped-rectangle flashes. Keep clip-path out of the transition list. */
  .we1-portal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 45;
    background:
      radial-gradient(
        44% 36% at var(--wx, 78%) 6%,
        var(--pwash, transparent),
        transparent 70%
      ),
      var(--ppaper, var(--color-bone));
    transition: opacity 0.205s ease;
  }

  /* The flying column (mobile) rides the same rAF driver as the clip, so the
     two can never drift apart mid-door. */
  .we1-portal-col {
    position: absolute;
    left: var(--fx, 0px);
    top: var(--fy, 0px);
    width: var(--fw, 300px);
    transform-origin: 0 0;
    will-change: transform;
  }

  .we1-portal-on {
    display: block;
  }

  .we1-portal-fade {
    opacity: 0;
  }

  /* ── Closing: content dissolves over the shrinking portal ── */
  /* The spread's own fade lives with the spread (ProjectSpread.astro); what
     stays here is the portal's half of the same choreography. */
  /* Scrolled gallery: the portal's column starts hidden so the spread's
     scrolled images genuinely fade out with it... */
  .we1-portal-col-hide .we1-portal-col {
    opacity: 0;
  }

  /* ...then fades back in at the top of the column near the end */
  .we1-portal-col-in .we1-portal-col {
    opacity: 1;
    transition: opacity 0.21s ease; /* 30% of the door shrink */
  }

  @media (max-width: 1023px) {
    /* Every mobile figure is a wide variant (roughly 2:1), so the window
       gets more room than the old portrait arch did */
    .we1-arch-wrap {
      max-width: 480px;
    }

    .we1-arch,
    .we1-shade {
      -webkit-mask-image: var(--mask-m);
      mask-image: var(--mask-m);
    }

    .we1-arch {
      aspect-ratio: var(--ar-m, 0.84);
    }

    .we1-rings-d {
      display: none;
    }

    .we1-rings-m {
      display: block;
    }

    .we1-no {
      font-size: clamp(5rem, 22vw, 8rem);
      top: -0.3em;
    }

    .we1-plate {
      padding: clamp(64px, 9vh, 110px) 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .we1-plate {
      --in: 1 !important;
      --par: 0.5 !important;
    }

    .we1-portal {
      display: none !important;
    }

    .we1-shade,
    .we1-ringp,
    .we1-arch::after {
      transition: none !important;
    }
  }
</style>

<script>
  import {
    SHAPES,
    subsInBox,
    pathOf,
    lerpSubs,
    expandTargets,
    cubicBezier,
    type ShapeId,
    type Sub,
  } from "../lib/workShapes";
  import { smoothstep } from "../lib/easing";

  {
    const section = document.querySelector<HTMLElement>(".we1");
    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (section) {
      const spreads = Array.from(
        section.querySelectorAll<HTMLElement>("[data-spread]"),
      );
      const desktop = window.matchMedia("(min-width: 1024px)");

      const spreadFor = (i: number) =>
        spreads.find((s) => s.dataset.spread === String(i));
      // The full gallery column — the mobile hero also wears .we1-gallery, skip it
      const galleryFor = (spread: HTMLElement) =>
        spread.querySelector<HTMLElement>(".we1-gallery:not(.we1-ghero)");
      const heroFor = (spread: HTMLElement) =>
        spread.querySelector<HTMLElement>(".we1-ghero");
      // Both scroll containers: the spread itself (gallery) and the sticky
      // story column, which scrolls independently on desktop
      const resetScroll = (spread: HTMLElement) => {
        spread.scrollTop = 0;
        const story = spread.querySelector<HTMLElement>(".we1-story");
        if (story) story.scrollTop = 0;
      };

      const windows = Array.from(
        section.querySelectorAll<HTMLElement>("[data-plate]"),
      ).map((plate) => ({
        plate,
        i: Number(plate.dataset.plate),
        arch: plate.querySelector<HTMLElement>(".we1-arch"),
        view: plate.querySelector<HTMLElement>("[data-view]"),
        replica: plate.querySelector<HTMLElement>("[data-view] .we1-gallery"),
      }));

      // ── Waking the window's content ──
      // The replica's images are not decoration inside the window, they *are*
      // the window — the whole room the door looks onto. They still ship as
      // loading="lazy", and that is the one thing a browser cannot decide here:
      // the scene is a 100vw x 100dvh box that the driver re-translates every
      // frame, seen through a masked, overflow-clipped 440px hole. Whether an
      // image "intersects the viewport" in that arrangement depends on which
      // rect the engine samples — the laid-out one, which sits nowhere near the
      // window, or the transformed one. Blink samples one and fetches them;
      // WebKit samples the other and never does, which is why the windows come
      // up as empty paper in Safari and fill in only once a reload finds the
      // bitmaps already in cache.
      //
      // So don't ask. Keep the deferral — nothing loads while the section is
      // still pages away — but hang it off a rule we can state: the plate is
      // within a viewport of the fold, therefore its window is about to be
      // looked through, therefore its images are needed. Clearing the attribute
      // resumes a deferred load in place, so this costs one property write per
      // window and never runs again.
      const asleep = new Map<HTMLElement, HTMLImageElement[]>();
      for (const w of windows) {
        const imgs = Array.from(
          w.view?.querySelectorAll<HTMLImageElement>('img[loading="lazy"]') ??
            [],
        );
        if (imgs.length) asleep.set(w.plate, imgs);
      }

      const wakeNearWindows = () => {
        if (!asleep.size) return;
        const vh = window.innerHeight;
        for (const [plate, imgs] of asleep) {
          const rect = plate.getBoundingClientRect();
          if (rect.bottom < -vh || rect.top > vh * 2) continue;
          for (const img of imgs) img.removeAttribute("loading");
          asleep.delete(plate);
        }
      };

      // Subscribed unconditionally: reduced motion has no driver of its own,
      // but the shared bus still fires on every native scroll, and the arch-
      // sized fallback window has the same clipped-image problem.
      (window as any).__onSmoothScrollTick(wakeNearWindows);
      wakeNearWindows();

      // ── The address bar ──
      // Every edition is a real prerendered page at /projects/<slug> (see
      // src/pages/projects/[slug].astro), printing this same spread — that is
      // what search engines index and what a reload of the URL lands on. What
      // stays client-side is the *walk* between them: the door needs the
      // window and the spread alive in one document, which no cross-document
      // navigation can give us. So opening a window is a history push and a
      // head swap, and the page itself never unloads — which is also why the
      // front page is still sitting at the same scroll position when the door
      // closes again.
      const slugs = windows.map((w) => w.plate.dataset.slug ?? "");
      const projectPath = (i: number) => `/projects/${slugs[i]}/`;
      const indexOfSlug = (slug: string) => slugs.indexOf(slug);
      const indexOfPath = (path: string) =>
        indexOfSlug(path.replace(/^\/projects\//, "").replace(/\/$/, ""));

      const meta = (sel: string) =>
        document.head.querySelector<HTMLMetaElement>(sel);
      const canonicalEl = document.head.querySelector<HTMLLinkElement>(
        'link[rel="canonical"]',
      );
      const descEl = meta('meta[name="description"]');
      const ogTitleEl = meta('meta[property="og:title"]');
      const ogDescEl = meta('meta[property="og:description"]');
      const ogUrlEl = meta('meta[property="og:url"]');

      // The front page's own head, captured before anything moves it
      const homeHead = {
        title: document.title,
        desc: descEl?.content ?? "",
        url: canonicalEl?.href ?? `${location.origin}/`,
      };

      const writeHead = (title: string, desc: string, url: string) => {
        document.title = title;
        if (descEl) descEl.content = desc;
        if (canonicalEl) canonicalEl.href = url;
        if (ogTitleEl) ogTitleEl.content = title;
        if (ogDescEl) ogDescEl.content = desc;
        if (ogUrlEl) ogUrlEl.content = url;
      };

      const setHead = (i: number) => {
        const d = windows[i].plate.dataset;
        writeHead(
          d.docTitle ?? homeHead.title,
          d.docDesc ?? homeHead.desc,
          `${location.origin}${projectPath(i)}`,
        );
      };

      const restoreHead = () =>
        writeHead(homeHead.title, homeHead.desc, homeHead.url);

      // ── The window: each arch looks through at its spread's gallery ──
      // The spread is a fixed overlay, so its gallery's rect at scrollTop 0 is
      // in viewport coordinates. The replica inside each arch is seated at
      // that rect (on measure), and the viewport-sized view around it is
      // translated by minus the arch's own viewport position every frame —
      // pinning the scene to the viewport while the arch sweeps over it.
      type GalRect = { left: number; top: number; width: number };
      // undefined = stale, retry when visible; null = windows off (mobile)
      const galRects: (GalRect | null | undefined)[] = [];

      // Run fn with the spread laid out (but invisible) so rects are measurable
      const measured = <T,>(spread: HTMLElement, fn: () => T): T => {
        const wasHidden = spread.hidden;
        if (wasHidden) {
          spread.style.visibility = "hidden";
          spread.hidden = false;
        }
        const out = fn();
        if (wasHidden) {
          spread.hidden = true;
          spread.style.visibility = "";
        }
        return out;
      };

      // An element's rect at scrollTop 0 — the spread is a fixed overlay, so
      // these are landing coordinates in viewport space. Zero width means we
      // measured before layout settled — retry later.
      const landingRect = (
        spread: HTMLElement,
        el: HTMLElement | null | undefined,
      ): GalRect | undefined => {
        if (!el) return undefined;
        const r = el.getBoundingClientRect();
        const rect = {
          left: r.left,
          top: r.top + spread.scrollTop,
          width: r.width,
        };
        return rect.width > 0 ? rect : undefined;
      };

      const galRectOf = (spread: HTMLElement): GalRect | undefined =>
        measured(spread, () => landingRect(spread, galleryFor(spread)));

      // Mobile door: the hero plate's image frame — where the flight lands.
      // Only left/top/width matter; height follows the image on both copies.
      const heroFrameOf = (spread: HTMLElement): GalRect | undefined =>
        measured(spread, () =>
          landingRect(
            spread,
            heroFor(spread)?.querySelector<HTMLElement>(".we1-gframe"),
          ),
        );

      // ...and the same plate's frame as rendered inside the arch — where the
      // flight starts (getBoundingClientRect folds in the drift transform)
      const replicaFrameFor = (i: number) =>
        section.querySelector<HTMLElement>(
          `[data-plate="${i}"] [data-view] .we1-gfig-lead .we1-gframe`,
        );

      const measureAll = () => {
        for (const w of windows) {
          const spread = spreadFor(w.i);
          galRects[w.i] = desktop.matches ? spread && galRectOf(spread) : null;
          if (!w.view || !w.replica) continue;
          const g = galRects[w.i];
          if (g) {
            w.replica.style.left = `${g.left}px`;
            w.replica.style.top = `${g.top}px`;
            w.replica.style.width = `${g.width}px`;
          } else {
            w.replica.style.left = "";
            w.replica.style.top = "";
            w.replica.style.width = "";
            w.view.style.transform = "";
          }
        }
      };

      if (!reducedMotion) {
        section.classList.add("we1-js");
        let measureQueued = false;

        const remeasureSoon = () => {
          if (measureQueued) return;
          measureQueued = true;
          requestAnimationFrame(() => {
            measureQueued = false;
            measureAll();
            update();
          });
        };

        function update() {
          const vh = window.innerHeight;
          // Fade distance at each edge — a plate eases in over the bottom
          // 50% of the viewport, then eases out over the top 35% as it exits.
          const enterSpan = vh * 0.5;
          const exitSpan = vh * 0.35;

          // Batched into read → write → read → write phases across all plates:
          // interleaving them per plate would force a fresh style/layout pass
          // for every read after a write.
          const plateRects = windows.map((w) =>
            w.plate.getBoundingClientRect(),
          );

          windows.forEach((w, k) => {
            const rect = plateRects[k];
            // Not laid out (display: none) — nothing to drive
            if (!rect.height) return;
            // Entering: 0 at the bottom edge → 1 once settled enterSpan in.
            // Exiting: measured from the top edge — 1 while settled → 0 as
            // the plate's bottom clears the top, over exitSpan.
            const enter = Math.min(1, Math.max(0, (vh - rect.top) / enterSpan));
            const exit = Math.min(1, Math.max(0, rect.bottom / exitSpan));
            const eased = smoothstep(Math.min(enter, exit));
            const par = Math.min(
              1,
              Math.max(0, (vh - rect.top) / (vh + rect.height)),
            );
            w.plate.style.setProperty("--in", eased.toFixed(3));
            w.plate.style.setProperty("--par", par.toFixed(3));
          });

          // Read after --in lands so each arch rect already carries this
          // frame's entry transform — the scene must not trail the arch
          const archRects = windows.map((w, k) => {
            if (!plateRects[k].height || !w.view || !w.arch) return null;
            const g = galRects[w.i];
            if (g === undefined) {
              // Became measurable after an earlier stale measurement
              if (desktop.matches) remeasureSoon();
              return null;
            }
            return g ? w.arch.getBoundingClientRect() : null;
          });

          windows.forEach((w, k) => {
            const a = archRects[k];
            if (!a || !w.view) return;
            const t = `translate(${(-a.left).toFixed(2)}px, ${(-a.top).toFixed(2)}px)`;
            if (w.view.style.transform !== t) w.view.style.transform = t;
          });
        }

        // Same-frame under the smooth-scroll engine's tick; the shared bus
        // (Layout head shim) also covers native scroll and reduced motion.
        // Page-lifetime, so the unsubscribe is discarded.
        (window as any).__onSmoothScrollTick(update);

        let resizeRaf = 0;
        const onResize = () => {
          cancelAnimationFrame(resizeRaf);
          resizeRaf = requestAnimationFrame(() => {
            measureAll();
            update();
          });
        };

        window.addEventListener("resize", onResize, { passive: true });
        measureAll();
        update();
      }

      // ── Walk-through-the-door open/close ──
      const portal = section.querySelector<HTMLElement>("[data-portal]");
      const portalCol = portal?.querySelector<HTMLElement>("[data-portal-col]");

      const OPEN_MS = 700;
      const SWAP_MS = 205;
      // Close choreography, scaled to the door shrink (OPEN_MS): content
      // fades over the first 60%; a scrolled gallery's images fade back in
      // starting at 80%, over 30%. Keep the CSS durations in sync
      // (.we1-spread-out, .we1-portal-col-in).
      const CLOSE_FADE_MS = Math.round(OPEN_MS * 0.6);
      const COL_IN_AT_MS = Math.round(OPEN_MS * 0.8);
      const COL_IN_MS = Math.round(OPEN_MS * 0.3);

      let openIndex = -1;
      let busy = false;
      let lastTrigger: HTMLElement | null = null;
      let detachSpreadScroll: (() => void) | null = null;
      const timers = new Set<ReturnType<typeof setTimeout>>();

      const attachScroll = (spread: HTMLElement) => {
        detachSpreadScroll?.();
        detachSpreadScroll =
          (window as any).__attachSmoothScroll?.(spread) ?? null;
      };

      const detachScroll = () => {
        detachSpreadScroll?.();
        detachSpreadScroll = null;
      };

      const later = (fn: () => void, ms: number) => {
        const id = setTimeout(() => {
          timers.delete(id);
          fn();
        }, ms);
        timers.add(id);
      };

      const clearTimers = () => {
        for (const id of timers) clearTimeout(id);
        timers.clear();
      };

      // Where the page sat when the door opened. Every viewport-space rect
      // the door animates between (arch, replica frame, landing rects)
      // assumes the page behind the overlay is still exactly there.
      let lockedY = 0;
      let prevScrollRestoration: History["scrollRestoration"] | null = null;

      const lock = (on: boolean) => {
        const html = document.documentElement;
        if (on) {
          lockedY = window.scrollY;
          // history.back() (the close path) makes the browser restore the
          // window scroll of the previous entry on its own async schedule.
          // On desktop the wheel engine owns scroll so the saved position
          // always matches; on mobile scrolling is native and the entry's
          // saved position can be stale — the restore then yanks the page
          // (and the arch with it) out from under the portal mid-door. The
          // door owns the page position while open; restoration returns on
          // unlock.
          prevScrollRestoration = history.scrollRestoration;
          history.scrollRestoration = "manual";
          // Killing the scrollbar widens the viewport and shifts the centered
          // layout under the fixed overlay — which is why the closing door
          // used to land a few pixels off its window and snap on unlock.
          // Reserve the gutter so the page never moves.
          const gutter = window.innerWidth - html.clientWidth;
          html.style.overflow = "hidden";
          html.style.paddingRight = gutter > 0 ? `${gutter}px` : "";
        } else {
          repinPage();
          html.style.overflow = "";
          html.style.paddingRight = "";
          if (prevScrollRestoration != null) {
            history.scrollRestoration = prevScrollRestoration;
            prevScrollRestoration = null;
          }
        }
        // The smooth-scroll engine drives window.scrollTo itself, so it must be
        // frozen alongside overflow (see smooth-scroll.ts hard lock)
        (window as any).__smoothScrollLock?.(on);
      };

      // On mobile the lock is only overflow: hidden — native scrolling means
      // the page behind the overlay can still move (URL-bar chrome, scroll
      // restoration, overscroll quirks), unlike desktop where the frozen
      // wheel engine pins it absolutely. If it drifted, the arch is no
      // longer where the door's geometry says it is — the close would then
      // animate toward an off-screen figure. Re-assert the locked position
      // before trusting any measurement; a no-op when nothing moved.
      const repinPage = () => {
        if (window.scrollY !== lockedY) window.scrollTo(0, lockedY);
      };

      const archFor = (i: number) =>
        section.querySelector<HTMLElement>(`[data-plate="${i}"] .we1-arch`);

      const shapeOf = (i: number): ShapeId =>
        (section.querySelector<HTMLElement>(`[data-plate="${i}"]`)?.dataset
          .shape ?? "diamond") as ShapeId;

      // The window's figure seated at its live on-screen rect, in viewport
      // coordinates — the closed end of the door animation
      const figureAt = (i: number, rect: DOMRect): Sub[] => {
        const variant =
          SHAPES[shapeOf(i)][desktop.matches ? "desktop" : "mobile"];
        return subsInBox(variant, rect.width, rect.height, rect.left, rect.top);
      };

      // ── The door driver ──
      // The clip is written inline every frame as a path() — the figures are
      // multi-part shapes CSS can't interpolate, and driving it here (first
      // frame set before the portal is ever displayed) also retires the two
      // old failure modes: Chrome missing the display-flip transition and
      // snapping, and flashes of the unclipped rectangle.
      const doorEase = cubicBezier(0.77, 0, 0.175, 1);
      let doorRaf = 0;

      const stopDoor = () => {
        if (doorRaf) cancelAnimationFrame(doorRaf);
        doorRaf = 0;
      };

      const setClip = (subs: Sub[]) => {
        if (portal) portal.style.clipPath = `path("${pathOf(subs)}")`;
      };

      // Mobile flight state: the transform that lays the column's plate over
      // the frame seen inside the window ({0,0,1} = seated at its landing rect)
      type FlyState = { x: number; y: number; s: number };
      const FLY_HOME: FlyState = { x: 0, y: 0, s: 1 };

      const flyState = (from: DOMRect, to: GalRect): FlyState => ({
        x: from.left - to.left,
        y: from.top - to.top,
        s: from.width / to.width,
      });

      const flyCss = (f: FlyState) =>
        f.x === 0 && f.y === 0 && f.s === 1
          ? ""
          : `translate(${f.x.toFixed(2)}px, ${f.y.toFixed(2)}px) scale(${f.s.toFixed(4)})`;

      const animateDoor = (
        from: Sub[],
        to: Sub[],
        fly: { from: FlyState; to: FlyState } | null,
      ) => {
        stopDoor();
        // Paint the closed end synchronously so the portal never shows a frame
        // without its clip
        setClip(from);
        if (fly && portalCol) portalCol.style.transform = flyCss(fly.from);
        const t0 = performance.now();
        const frame = (now: number) => {
          doorRaf = 0;
          const p = Math.min(1, (now - t0) / OPEN_MS);
          const e = doorEase(p);
          setClip(lerpSubs(from, to, e));
          if (fly && portalCol) {
            portalCol.style.transform = flyCss({
              x: fly.from.x + (fly.to.x - fly.from.x) * e,
              y: fly.from.y + (fly.to.y - fly.from.y) * e,
              s: fly.from.s + (fly.to.s - fly.from.s) * e,
            });
          }
          if (p < 1) doorRaf = requestAnimationFrame(frame);
        };
        doorRaf = requestAnimationFrame(frame);
      };

      const setColRect = (g: GalRect) => {
        if (!portal) return;
        portal.style.setProperty("--fx", `${g.left}px`);
        portal.style.setProperty("--fy", `${g.top}px`);
        portal.style.setProperty("--fw", `${g.width}px`);
      };

      // The portal's cast: desktop clones the whole gallery column (the
      // stationary scene the arch window shows), mobile just the hero plate.
      // A fresh clone's images have no decoded bitmap yet, and the gallery's
      // decoding="async"/loading="lazy" let the browser paint that first frame
      // without them — one blank frame over the copy already on screen, which
      // is the flicker at the start of both the open and the close. Eager +
      // sync decoding starts the fetch at once, but hints alone can't make
      // the first frame wait (the mobile hero sits in a hidden spread, so its
      // images may never have been fetched at all) — whenPortalReady below is
      // what actually holds the door until the bitmaps are paint-ready.
      const fillPortal = (source: HTMLElement | null) => {
        if (!portalCol || !source) return;
        const clone = source.cloneNode(true) as HTMLElement;
        for (const img of clone.querySelectorAll("img")) {
          img.loading = "eager";
          img.decoding = "sync";
        }
        portalCol.replaceChildren(clone);
      };

      const dressPortal = (spread: HTMLElement) => {
        if (!portal) return;
        const cs = getComputedStyle(spread);
        portal.style.setProperty(
          "--pwash",
          cs.getPropertyValue("--wash") || "transparent",
        );
        // An empty custom property substitutes as nothing, not as the var()
        // fallback — so name the bone default outright
        portal.style.setProperty(
          "--ppaper",
          cs.getPropertyValue("--paper") || "var(--color-bone)",
        );
        portal.style.setProperty(
          "--wx",
          spread.classList.contains("we1-spread-flip") ? "22%" : "78%",
        );
      };

      // Nothing may hand visibility to the portal — no class flips, no door
      // frames — until every cloned image can paint. img.decode() settles
      // once the bitmap is ready (fetching first if the source never loaded);
      // the race cap keeps a broken image from wedging the door shut, and the
      // generation counter drops the callback if an interrupt reset the
      // portal while we waited, so a snap-close can't be overpainted by a
      // stale open.
      let doorGen = 0;
      const whenPortalReady = (fn: () => void) => {
        const gen = ++doorGen;
        const imgs = portalCol
          ? Array.from(portalCol.querySelectorAll("img"))
          : [];
        Promise.race([
          Promise.allSettled(imgs.map((img) => img.decode())),
          new Promise((r) => setTimeout(r, 150)),
        ]).then(() => {
          if (gen === doorGen) fn();
        });
      };

      const resetPortal = () => {
        stopDoor();
        doorGen++;
        portal?.classList.remove(
          "we1-portal-on",
          "we1-portal-fade",
          "we1-portal-col-hide",
          "we1-portal-col-in",
        );
        portal?.style.removeProperty("clip-path");
        if (portalCol) portalCol.style.transform = "";
      };

      const open = (i: number, trigger: HTMLElement, push = true) => {
        if (busy || openIndex >= 0) return;
        const spread = spreadFor(i);
        const arch = archFor(i);
        if (!spread || !arch) return;

        // Mobile door: no pinned scene to walk into — the plate itself steps
        // through instead. Measured up front so a failed measure can fall
        // back to the snap path below.
        const mobile = !desktop.matches;
        const archFrame = mobile
          ? replicaFrameFor(i)?.getBoundingClientRect()
          : undefined;
        const heroFrame = mobile ? heroFrameOf(spread) : undefined;
        const hero = mobile ? heroFor(spread) : null;

        openIndex = i;
        lastTrigger = trigger;
        lock(true);
        // push is false when the browser put us here (the forward button):
        // the entry already exists, and adding a second one would take two
        // presses of Back to leave the same window.
        if (push) history.pushState({ we1: i }, "", projectPath(i));
        setHead(i);

        if (
          reducedMotion ||
          !portal ||
          !portalCol ||
          (mobile && !(archFrame && heroFrame && hero))
        ) {
          spread.hidden = false;
          resetScroll(spread);
          spread.classList.add("is-in");
          attachScroll(spread);
          spread.focus({ preventScroll: true });
          return;
        }

        busy = true;

        if (mobile) {
          // The hero clone is seated at its landing frame; the door driver
          // starts it transformed back over the window's plate and flies it
          // home as the mask opens
          fillPortal(hero!);
          dressPortal(spread);
          setColRect(heroFrame!);
        } else {
          // The gallery's landing rect (measured with the spread laid out but
          // invisible) — the portal freezes the whole column there
          const g = galRectOf(spread) ?? { left: 0, top: 0, width: 100 };
          fillPortal(galleryFor(spread));
          dressPortal(spread);
          setColRect(g);
        }
        const closed = figureAt(i, arch.getBoundingClientRect());
        // Scroll is already locked, so the rects measured above hold still
        // across the (usually sub-frame) wait for the clone's bitmaps
        whenPortalReady(() => {
          repinPage();
          animateDoor(
            closed,
            expandTargets(
              shapeOf(i),
              closed,
              window.innerWidth,
              window.innerHeight,
            ),
            mobile
              ? { from: flyState(archFrame!, heroFrame!), to: FLY_HOME }
              : null,
          );
          portal.classList.add("we1-portal-on");

          later(() => {
            spread.hidden = false;
            resetScroll(spread);
            attachScroll(spread);
            requestAnimationFrame(() => {
              requestAnimationFrame(() => spread.classList.add("is-in"));
            });
            portal.classList.add("we1-portal-fade");
            later(() => {
              resetPortal();
              busy = false;
              spread.focus({ preventScroll: true });
            }, SWAP_MS);
          }, OPEN_MS);
        });
      };

      const close = () => {
        if (openIndex < 0) return;
        const i = openIndex;
        openIndex = -1;
        restoreHead();
        const spread = spreadFor(i);
        const arch = archFor(i);

        const finish = () => {
          detachScroll();
          if (spread) {
            spread.classList.remove(
              "is-in",
              "we1-spread-close",
              "we1-spread-out",
              "we1-hero-off",
            );
            resetScroll(spread);
            spread.hidden = true;
          }
          lastTrigger?.focus({ preventScroll: true });
        };

        // If native mobile scrolling moved the locked page while the spread
        // was open, put it back before measuring — the arch must be where
        // it was when the door opened, or the close animates toward a
        // figure that is no longer on screen. Invisible: the page is fully
        // covered by the spread at this point.
        repinPage();

        // Mobile door: the reverse flight, measured up front like open
        const mobile = !desktop.matches;
        const canFly = mobile && !reducedMotion && !busy && !!spread;
        const archFrame = canFly
          ? replicaFrameFor(i)?.getBoundingClientRect()
          : undefined;
        const heroFrame = canFly && spread ? heroFrameOf(spread) : undefined;
        const hero = canFly && spread ? heroFor(spread) : null;

        // Mid-open interrupt or reduced motion: snap closed
        if (
          reducedMotion ||
          busy ||
          !portal ||
          !portalCol ||
          !arch ||
          !spread ||
          (mobile && !(archFrame && heroFrame && hero))
        ) {
          clearTimers();
          resetPortal();
          busy = false;
          finish();
          lock(false);
          return;
        }

        busy = true;
        // Portal scene is the scrollTop-0 state (what the shaped window
        // shows); landingRect compensates if the spread was scrolled. If the
        // content was scrolled, the portal's copy fades out with the spread
        // (its column starts hidden) and fades back in near the end of the
        // flight; if not, the identical copy keeps the images steady under
        // the fade.
        const scrolled = spread.scrollTop > 1;
        if (mobile) {
          fillPortal(hero!);
          dressPortal(spread);
          setColRect(heroFrame!);
        } else {
          const g = galRectOf(spread) ?? { left: 0, top: 0, width: 100 };
          fillPortal(galleryFor(spread));
          dressPortal(spread);
          setColRect(g);
        }
        // The figure at the window's live rect is the landing state; the
        // final rAF frame paints exactly this, so the reveal underneath can't
        // be offset from it
        const closed = figureAt(i, arch.getBoundingClientRect());
        // The spread stays fully visible and interactive-looking across the
        // wait — the handoff (hero-off, spread-out, the portal itself) must
        // land in one frame, and only once the clone can actually paint
        whenPortalReady(() => {
          // The browser's scroll restoration can land during the wait —
          // re-pin so the page matches the geometry captured above
          repinPage();
          portal.classList.add("we1-portal-on");
          portal.classList.toggle("we1-portal-col-hide", scrolled);
          spread.classList.add("we1-spread-close");
          // Unscrolled mobile close: the flying clone takes over for the
          // spread's hero, whose own copy must vanish instantly beneath it
          if (mobile) spread.classList.toggle("we1-hero-off", !scrolled);
          // Same frame: the door starts shrinking and the content starts fading
          animateDoor(
            expandTargets(
              shapeOf(i),
              closed,
              window.innerWidth,
              window.innerHeight,
            ),
            closed,
            mobile
              ? { from: FLY_HOME, to: flyState(archFrame!, heroFrame!) }
              : null,
          );
          spread.classList.add("we1-spread-out");

          later(finish, CLOSE_FADE_MS);
          if (scrolled)
            later(
              () => portal.classList.add("we1-portal-col-in"),
              COL_IN_AT_MS,
            );
          later(
            () => {
              resetPortal();
              lock(false);
              busy = false;
            },
            scrolled ? COL_IN_AT_MS + COL_IN_MS : OPEN_MS,
          );
        });
      };

      const requestClose = () => {
        if (openIndex < 0 || busy) return;
        if (history.state && history.state.we1 != null) {
          history.back();
        } else {
          close();
        }
      };

      section.addEventListener("click", (e) => {
        const target = e.target as HTMLElement;
        const opener = target.closest<HTMLElement>("[data-open]");
        if (opener?.dataset.open != null) {
          // Both openers are real <a> elements pointing at the edition's page.
          // Leave every browser-native way of following one alone — modified
          // clicks, middle clicks, anything already handled — and intercept
          // only the plain left click, which walks through the window instead
          // of navigating away from the page the window is cut into.
          if (
            e.defaultPrevented ||
            e.button !== 0 ||
            e.metaKey ||
            e.ctrlKey ||
            e.shiftKey ||
            e.altKey
          )
            return;
          e.preventDefault();
          open(Number(opener.dataset.open), opener);
          return;
        }
        if (target.closest("[data-close]")) requestClose();
      });

      window.addEventListener("popstate", () => {
        // The URL is the state of record: Back off an edition closes its door,
        // Forward onto one opens it again. (Edition-to-edition is unreachable
        // — nothing links one spread to another — so a differing index while
        // one is open can only mean "leave this one".)
        const want = indexOfPath(location.pathname);
        if (want === openIndex) return;
        if (openIndex >= 0) {
          close();
          return;
        }
        if (want >= 0) {
          const door = section.querySelector<HTMLElement>(
            `[data-plate="${want}"] .we1-door`,
          );
          if (door) open(want, door, false);
        }
      });

      window.addEventListener("keydown", (e) => {
        if (e.key === "Escape") requestClose();
      });

      // ── Arriving from an edition's own page ──
      // A cold visitor — a search result, a shared link — never walked through
      // the window, so leaving /projects/<slug> is a real navigation to
      // /#from-<slug>. The front page then builds the far end of that walk
      // backwards: seat the window this edition is read through in the middle
      // of the viewport, and run the door *closed* from full screen down into
      // it, so the visitor lands on the front page already looking at the
      // window they just came out of.
      //
      // The seam a page load would otherwise show is covered by the curtain
      // (index.astro raises it in <head>, before first paint, painted this
      // edition's own paper and wash). The portal takes over from it in the
      // same frame with the same paint, so the hand-off has nothing to see.
      const htmlEl = document.documentElement;
      const dropCurtain = () => htmlEl.removeAttribute("data-we1-arrive");
      // The curtain also took scroll restoration off the browser so a reload
      // couldn't yank the page out from under the door.
      const releaseRestoration = () => {
        history.scrollRestoration = "auto";
      };

      // Seat the window in the middle of the viewport — where the door will
      // come to rest, and where the visitor should find themselves standing
      // once it has.
      //
      // It takes more than one pass. A plate carries an entry transform driven
      // by how far into the viewport it has scrolled (--in, worth up to 70px
      // of lift), so the rect measured from up the page is not the rect the
      // window will occupy once we have scrolled to it: the first jump lands
      // 70px out, and correcting it is what the second pass is for. Three is
      // the ceiling, not the expectation — the loop exits the moment the
      // window is within half a pixel of centre, and a plate near the end of
      // the document simply runs out of scroll and stops early.
      const centerOn = (arch: HTMLElement) => {
        for (let pass = 0; pass < 3; pass++) {
          const r = arch.getBoundingClientRect();
          const off = r.top + r.height / 2 - window.innerHeight / 2;
          if (Math.abs(off) < 0.5) break;
          const max = htmlEl.scrollHeight - window.innerHeight;
          const y = Math.max(0, Math.min(max, window.scrollY + off));
          if (y === window.scrollY) break;
          window.scrollTo(0, y);
          // Synchronous, before the next pass reads a rect back: --in is
          // written by the same update that counter-translates the pinned
          // scene behind each window, and neither may be a frame stale.
          (window as any).__flushScrollBus?.();
        }
      };

      const arrive = (i: number) => {
        const spread = spreadFor(i);
        const arch = archFor(i);
        if (!spread || !arch) {
          dropCurtain();
          releaseRestoration();
          return;
        }

        if (!reducedMotion) measureAll();
        centerOn(arch);

        const mobile = !desktop.matches;
        const archFrame = mobile
          ? replicaFrameFor(i)?.getBoundingClientRect()
          : undefined;
        const heroFrame = mobile ? heroFrameOf(spread) : undefined;
        const hero = mobile ? heroFor(spread) : null;

        if (
          reducedMotion ||
          !portal ||
          !portalCol ||
          (mobile && !(archFrame && heroFrame && hero))
        ) {
          dropCurtain();
          releaseRestoration();
          return;
        }

        busy = true;
        lock(true);

        if (mobile) {
          fillPortal(hero!);
          dressPortal(spread);
          setColRect(heroFrame!);
        } else {
          fillPortal(galleryFor(spread));
          dressPortal(spread);
          setColRect(galRectOf(spread) ?? { left: 0, top: 0, width: 100 });
        }

        // The gallery resolves in over the last third of the door rather than
        // being there from the first frame. A visitor can leave the story from
        // anywhere in it, so there is no scroll position those images could
        // honestly continue from — paper alone carries the hand-off, and the
        // column fades up only as the door converges on the window that is
        // already showing it. (Same treatment the close gives a spread that
        // was scrolled; see we1-portal-col-hide.)
        portal.classList.add("we1-portal-col-hide");

        const closed = figureAt(i, arch.getBoundingClientRect());
        whenPortalReady(() => {
          repinPage();
          portal.classList.add("we1-portal-on");
          animateDoor(
            expandTargets(
              shapeOf(i),
              closed,
              window.innerWidth,
              window.innerHeight,
            ),
            closed,
            mobile
              ? { from: FLY_HOME, to: flyState(archFrame!, heroFrame!) }
              : null,
          );
          // animateDoor painted the full-screen end of the clip synchronously
          // above, so the portal is already showing exactly what the curtain
          // is showing — this frame is where one becomes the other.
          dropCurtain();

          later(() => portal.classList.add("we1-portal-col-in"), COL_IN_AT_MS);
          later(() => {
            resetPortal();
            lock(false);
            // After the unlock, which restores whatever the curtain left set
            releaseRestoration();
            busy = false;
          }, COL_IN_AT_MS + COL_IN_MS);
        });
      };

      const arriveSlug = /^#from-(.+)$/.exec(location.hash);
      const arriveAt = arriveSlug
        ? indexOfSlug(decodeURIComponent(arriveSlug[1]))
        : -1;
      if (arriveAt >= 0) {
        history.replaceState({}, "", location.pathname + location.search);
        // Let the faces land before measuring. An arch's position is the sum
        // of every block above it, and a late-swapping font moves all of them
        // — measure too early and the door closes onto where the window used
        // to be. Capped, so a face that never arrives can't strand the curtain.
        const fonts = (document as any).fonts?.ready ?? Promise.resolve();
        Promise.race([fonts, new Promise((r) => setTimeout(r, 250))]).then(() =>
          requestAnimationFrame(() => arrive(arriveAt)),
        );
      }
    }
  }
</script>
