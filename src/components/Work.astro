---
// "The Chronometer": a strata pile, re-machined to tolerance.
// Same sticky slabs, same cover mechanic, same one-mineral-per-build logic —
// but the minerals are fired down to enamel (sage, iris, rose) and the
// instrument wall keeps only two pieces, both watch-grade: a buried dial
// with machined ticks and a 3px arc whose bead rides the tip as you scroll,
// and a 4px plumb thread down the left gutter. Color never fills a surface;
// it is inlaid — a hairline, a tick, a jewel. The porcelain does the rest.
const projects = [
  {
    index: "01",
    title: "Dispatch",
    tech: "Astro · TypeScript · AI pipelines",
    fact: "writes itself every morning",
    description:
      "The last 24 hours of tech news, compressed into a 10 minute read. Two decoupled AI pipelines research, triage, and write it; GitHub Actions runs the whole thing while I sleep.",
    image: "/photos/dispatch.webp",
    alt: "Dispatch project screenshot",
    stack: ["Astro", "TypeScript", "OpenAI API", "Tailwind", "Vercel"],
    websiteUrl: "https://dispatch.dominicclerici.com/",
    githubUrl: "https://github.com/DominicClerici/dispatch",
  },
  {
    index: "02",
    title: "Meridian",
    tech: "Vanilla TypeScript · Extensions",
    fact: "0 npm dependencies",
    description:
      "A new-tab extension for Chrome and Firefox with zero npm dependencies. Eleven feature modules, a reactive storage layer, and a recommendation engine that never lets data leave the browser.",
    image: "/photos/meridian.webp",
    alt: "Meridian project screenshot",
    stack: ["TypeScript", "esbuild", "Chrome APIs", "Firefox Add-ons"],
    websiteUrl: "https://meridian.dominicclerici.com/",
    githubUrl: "https://github.com/DominicClerici/meridian",
  },
  {
    index: "03",
    title: "Fuzzbox",
    tech: "Next.js · React Native",
    fact: "design system: Neon Riff",
    featured: true,
    description:
      "The companion I wished I had when learning guitar. Place notes on an interactive fretboard and it explains the chord you found — the intervals, the theory, why it sounds the way it does.",
    image: "/photos/fuzzbox.webp",
    alt: "Fuzzbox project screenshot",
    stack: ["TypeScript", "Next.js", "React Native", "Prisma", "PostgreSQL"],
    websiteUrl: "https://fuzzbox.dominicclerici.com/",
    githubUrl: null,
  },
];

// Stair offset per layer — mirrored by STICK_TOP/STICK_STEP in the script
const STICK_TOP = 88;
const STICK_STEP = 26;
---

<section id="work" class="wc3 relative" aria-label="Selected work">
  <!-- Stage: header and pile share one relative box so the chronometer wall
       spans both and the dial is never clipped at the header seam -->
  <div class="relative">
    <div class="max-w-[1524px] mx-auto px-6 lg:px-12 pt-[clamp(96px,14vh,180px)] relative z-[2]">
      <!-- Porcelain fade over the header: masks the dial's top, then clears
           as the header scrolls away before the pile goes sticky -->
      <span class="wc3-headfade absolute inset-y-0 block" aria-hidden="true"></span>
      <div class="flex items-center justify-between gap-4 mb-10 lg:mb-14 relative">
        <div class="flex items-center gap-4">
          <span class="wc3-pill font-mono text-[13px] leading-none tracking-[-0.02em] text-ink/60 rounded-full px-3.5 py-2">
            03&hairsp;/&hairsp;04
          </span>
          <span class="font-mono text-[13px] leading-none tracking-[-0.02em] uppercase text-ink/60">
            Selected Work
          </span>
        </div>
        <a
          href="https://github.com/DominicClerici"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex font-mono text-[13px] leading-none tracking-[-0.02em] text-ink/45 hover:text-ink transition-colors duration-200"
        >
          more on github&nbsp;&nearr;
        </a>
      </div>

      <p
        class="font-display font-normal text-ink leading-[1.2] tracking-[-0.006em] max-w-[880px] text-[clamp(1.625rem,calc(1.625rem+(100vw-27.5rem)*0.02),2.625rem)] mb-4 lg:mb-6 relative"
      >
        Three builds, machined to fit&nbsp;&mdash;
        <span class="text-ink/55">the dial keeps the count.</span>
      </p>
    </div>

    <!-- The sticky pile over the chronometer wall — every breakpoint. data-zone
         is the wall's positioning + sticky context, so it pins with the pile —
         never earlier — while the dial still rises up behind the header above it -->
    <div class="relative" data-zone>
      <!-- Chronometer wall: no top clip, so the dial reads as a whole disk
           rising behind the header instead of a hard cut line. Its off-screen
           right edge is contained by the global body { overflow-x: hidden } -->
      <div class="absolute inset-0 block pointer-events-none z-0" aria-hidden="true">
      <div class="sticky top-0 h-screen">
        <span class="wc3-wash wc3-wash-0 absolute inset-0"></span>
        <span class="wc3-wash wc3-wash-1 absolute inset-0"></span>
        <span class="wc3-wash wc3-wash-2 absolute inset-0"></span>

        <div class="wc3-dial absolute rounded-full">
          <span class="wc3-ticks absolute rounded-full"></span>
          <span class="wc3-ring absolute rounded-full"></span>
          <span class="wc3-arc wc3-arc-0 absolute rounded-full"></span>
          <span class="wc3-arc wc3-arc-1 absolute rounded-full"></span>
          <span class="wc3-arc wc3-arc-2 absolute rounded-full"></span>
          <span class="wc3-hand absolute rounded-full">
            <span class="wc3-bead absolute rounded-full">
              <i class="wc3-bd wc3-bd-0"></i>
              <i class="wc3-bd wc3-bd-1"></i>
              <i class="wc3-bd wc3-bd-2"></i>
            </span>
          </span>
        </div>

        <div class="wc3-plumb absolute rounded-full">
          <span class="wc3-plumb-fill absolute"></span>
          {
            projects.map((_, i) => (
              <span
                class={`wc3-plumb-dot wc3-pd-${i} absolute rounded-full`}
                style={`top: ${(((i + 0.5) / projects.length) * 100).toFixed(2)}%;`}
              />
            ))
          }
        </div>

        <!-- Chapter gauges in the bottom-right: three vertical grooves,
             left → middle → right, each filling during its own build -->
        <div class="wc3-gauges absolute flex items-end gap-3">
          {
            projects.map((project, i) => (
              <div class="flex flex-col items-center gap-2.5">
                <span class="wc3-groove relative block rounded-full">
                  <span class={`wc3-gfill wc3-gf-${i} absolute rounded-full`} />
                </span>
                <span class="wc3-engraved font-mono text-[10px] leading-none tracking-[0.08em]">{project.index}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <div class="block max-w-[1360px] mx-auto px-6 sm:px-10 lg:px-16 xl:px-20 pb-24 relative z-[1]" data-pile>
      {
        projects.map((project, i) => (
          <div class="wc3-layer" data-layer={i}>
            <article
              class="wc3-card relative rounded-[24px] lg:rounded-[32px] p-5 sm:p-7 lg:p-8 xl:p-10 overflow-hidden"
              data-card={i}
              style={`--en: var(--e${i}); --eng: var(--g${i}); top: ${STICK_TOP + i * STICK_STEP}px;`}
            >
              <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] gap-7 lg:gap-14 items-center">
                <div class={`order-2 ${i % 2 === 1 ? "lg:order-2" : "lg:order-1"}`}>
                  <span class="wc3-tick block" aria-hidden="true" />
                  <div class="flex items-center gap-3 flex-wrap mt-5">
                    <h3 class="font-display font-normal leading-[0.98] tracking-[-0.02em] text-ink text-[clamp(1.75rem,calc(1.75rem+(100vw-27.5rem)*0.014),2.5rem)] lg:text-[clamp(2rem,2.6vw,2.75rem)]">
                      {project.title}
                    </h3>
                    {project.featured && (
                      <span class="wc3-feat font-mono text-[11px] leading-none tracking-[-0.02em] uppercase text-ink/70 rounded-full px-3 py-2 inline-flex items-center gap-1.5">
                        <i class="wc3-feat-dot" aria-hidden="true" />
                        featured
                      </span>
                    )}
                  </div>
                  <p class="font-mono text-[12px] leading-none tracking-[-0.02em] uppercase text-ink/45 mt-4">
                    {project.tech}
                    <span class="text-ink/30 normal-case">&nbsp;&middot;&nbsp;{project.fact}</span>
                  </p>
                  <p class="font-display text-[15px] leading-[1.6] text-ink/60 max-w-[460px] mt-6">
                    {project.description}
                  </p>

                  <div class="flex flex-wrap gap-2.5 mt-7">
                    {project.stack.map((item) => (
                      <span class="wc3-chip font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/60 rounded-full px-3.5 py-2.5">
                        {item}
                      </span>
                    ))}
                  </div>

                  <div class="flex items-center gap-4 mt-9 max-w-[460px]">
                    <a
                      href={project.websiteUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="wc3-btn font-mono text-[13px] tracking-[-0.008em] text-ink rounded-[14px] h-11 px-5 inline-flex items-center"
                    >
                      Visit site
                    </a>
                    {project.githubUrl && (
                      <a
                        href={project.githubUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="font-mono text-[13px] tracking-[-0.008em] text-ink/55 h-11 px-2 inline-flex items-center hover:text-ink transition-colors duration-200"
                      >
                        GitHub
                      </a>
                    )}
                    <a
                      href={project.websiteUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`Open ${project.title} in a new tab`}
                      class="wc3-btn wc3-btn-go w-11 h-11 rounded-[14px] inline-flex items-center justify-center ml-auto"
                    >
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                        <path
                          d="M2 12 12 2M4.5 2H12v7.5"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>
                    </a>
                  </div>
                </div>

                <div class={`wc3-well wc3-wp-${i} order-1 ${i % 2 === 1 ? "lg:order-1" : "lg:order-2"} rounded-[16px] lg:rounded-[22px] p-2.5 lg:p-4`}>
                  <img
                    src={project.image}
                    srcset={`${project.image} 1x, ${project.image.replace(".webp", "-2x.webp")} 2x`}
                    alt={project.alt}
                    class="w-full aspect-[16/9] object-cover object-top rounded-[10px] lg:rounded-[12px]"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </div>

              <span class="wc3-veil absolute inset-0 rounded-[inherit]" aria-hidden="true" />
            </article>
          </div>
        ))
      }
    </div>
  </div>
  </div>

  <p
    class="max-w-[1524px] mx-auto px-6 lg:px-12 pb-12 font-mono text-[12px] leading-none tracking-[-0.02em] text-ink/35 text-right"
  >
    calibration record: sage, iris, rose &mdash; all within tolerance
  </p>
</section>

<style>
  /* Cool porcelain, enamel inlays. --w0/--w1/--w2 are per-build blend
     weights and --p is total pile progress, both set from scroll. Defaults
     read as "Dispatch seated, nothing scrolled" so the section renders
     sane without JS. Cards carry their own --en (solid) / --eng (gradient)
     enamel via inline style. */
  .wc3 {
    --por: #eaedf1;
    --por-dark: rgba(151, 163, 180, 0.5);
    --por-darker: rgba(151, 163, 180, 0.68);
    --por-light: rgba(255, 255, 255, 0.95);
    /* Fired enamels: 0 dispatch sage, 1 meridian iris, 2 fuzzbox rose */
    --e0: #8aa55f;
    --e1: #7f89d4;
    --e2: #c778a8;
    --g0: linear-gradient(120deg, #b0c688, #8aa55f);
    --g1: linear-gradient(120deg, #8d97dd, #a595d6);
    --g2: linear-gradient(120deg, #d38ab7, #8fa9d6);
    background: var(--por);
  }

  .wc3-pill {
    box-shadow:
      inset 3px 3px 6px var(--por-dark),
      inset -3px -3px 6px var(--por-light);
  }

  /* ── Layers (V1/V4's pile, verbatim) ── */
  .wc3-layer {
    min-height: 100vh;
    display: flex;
    align-items: flex-start;
  }

  .wc3-card {
    position: sticky;
    width: 100%;
    background: var(--por);
    box-shadow:
      16px 16px 40px var(--por-dark),
      -16px -16px 40px var(--por-light);
    /* --cover is the incoming card's proximity field (0 far → 1 seated),
       smoothstepped in the script. As the next card nears, the seated one
       is repelled: lifted up and shrunk from its top edge so a gap opens
       between them instead of a flush stack. */
    transform: translateY(calc(var(--cover, 0) * -64px)) scale(calc(1 - var(--cover, 0) * 0.05));
    transform-origin: 50% 0;
    will-change: transform;
  }

  .wc3-veil {
    background: var(--por);
    opacity: calc(var(--cover, 0) * 0.5);
    pointer-events: none;
  }

  /* ── Ambient washes: one whisper of enamel behind the seated card ── */
  .wc3-wash-0 {
    background: radial-gradient(58% 46% at 50% 56%, rgba(138, 165, 95, 0.17), transparent 72%);
    opacity: var(--w0, 1);
  }

  .wc3-wash-1 {
    background: radial-gradient(58% 46% at 50% 56%, rgba(127, 137, 212, 0.17), transparent 72%);
    opacity: var(--w1, 0);
  }

  .wc3-wash-2 {
    background:
      radial-gradient(46% 40% at 40% 58%, rgba(211, 138, 183, 0.14), transparent 70%),
      radial-gradient(46% 40% at 64% 50%, rgba(143, 169, 214, 0.14), transparent 70%);
    opacity: var(--w2, 0);
  }

  /* ── The chronometer: V1's buried dial machined down to a tick band,
     a 3px arc, and a bead that rides the arc tip with total scroll ── */
  .wc3-dial {
    --dial: 78vmin;
    width: var(--dial);
    height: var(--dial);
    top: calc(var(--dial) * -0.32);
    right: calc(var(--dial) * -0.32);
    background: var(--por);
    box-shadow:
      inset 7px 7px 20px var(--por-darker),
      inset -7px -7px 20px var(--por-light);
  }

  /* Porcelain fade filling the header box: opaque over the pill and title,
     dissolving to clear where the pile meets the header so the dial reads
     unclipped. It scrolls off with the header before the pile goes sticky. */
  .wc3-headfade {
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    background: linear-gradient(to bottom, var(--por) 45%, transparent);
  }

  .wc3-ticks {
    inset: 4.5vmin;
    background: repeating-conic-gradient(rgba(34, 47, 48, 0.18) 0deg 0.5deg, transparent 0.5deg 6deg);
    -webkit-mask: radial-gradient(closest-side, transparent calc(100% - 12px), #000 calc(100% - 11px));
    mask: radial-gradient(closest-side, transparent calc(100% - 12px), #000 calc(100% - 11px));
    opacity: 0.55;
  }

  /* The groove the arc runs in */
  .wc3-ring {
    inset: 8vmin;
    background: rgba(151, 163, 180, 0.32);
    -webkit-mask: radial-gradient(closest-side, transparent calc(100% - 3px), #000 calc(100% - 2px));
    mask: radial-gradient(closest-side, transparent calc(100% - 3px), #000 calc(100% - 2px));
  }

  .wc3-arc {
    inset: 8vmin;
    -webkit-mask: radial-gradient(closest-side, transparent calc(100% - 3px), #000 calc(100% - 2px));
    mask: radial-gradient(closest-side, transparent calc(100% - 3px), #000 calc(100% - 2px));
  }

  .wc3-arc-0 {
    background: conic-gradient(
      from 135deg,
      var(--e0) 0deg,
      var(--e0) calc(var(--p, 0) * 300deg),
      transparent calc(var(--p, 0) * 300deg)
    );
    opacity: var(--w0, 1);
  }

  .wc3-arc-1 {
    background: conic-gradient(
      from 135deg,
      var(--e1) 0deg,
      var(--e1) calc(var(--p, 0) * 300deg),
      transparent calc(var(--p, 0) * 300deg)
    );
    opacity: var(--w1, 0);
  }

  .wc3-arc-2 {
    background: conic-gradient(
      from 135deg,
      var(--e2) 0deg,
      var(--e2) calc(var(--p, 0) * 300deg),
      transparent calc(var(--p, 0) * 300deg)
    );
    opacity: var(--w2, 0);
  }

  /* The hand: a rotating carrier whose bead sits exactly on the arc's
     radius, so it tracks the tip of the sweep */
  .wc3-hand {
    inset: 8vmin;
    transform: rotate(calc(135deg + var(--p, 0) * 300deg));
    will-change: transform;
  }

  .wc3-bead {
    left: 50%;
    top: 0;
    width: 12px;
    height: 12px;
    transform: translate(-50%, -50%) translateY(1.5px);
    background: var(--por);
    box-shadow:
      2px 2px 5px var(--por-darker),
      -2px -2px 5px var(--por-light);
  }

  .wc3-bd {
    position: absolute;
    inset: 2.5px;
    border-radius: 999px;
  }

  .wc3-bd-0 {
    background: var(--e0);
    opacity: var(--w0, 1);
  }

  .wc3-bd-1 {
    background: var(--e1);
    opacity: var(--w1, 0);
  }

  .wc3-bd-2 {
    background: var(--e2);
    opacity: var(--w2, 0);
  }

  /* ── The plumb thread: a 4px core sample down the left gutter ── */
  .wc3-plumb {
    left: max(16px, calc((100vw - 1524px) / 2 + 16px));
    top: 18vh;
    width: 4px;
    height: 64vh;
    background: var(--por);
    box-shadow:
      inset 1.5px 1.5px 3px var(--por-darker),
      inset -1.5px -1.5px 3px var(--por-light);
  }

  .wc3-plumb-fill {
    inset: 1px;
    border-radius: 999px;
    background: linear-gradient(to bottom, var(--e0), var(--e1) 50%, var(--e2));
    clip-path: inset(0 0 calc((1 - var(--p, 0)) * 100%) 0 round 999px);
    opacity: 0.9;
  }

  .wc3-plumb-dot {
    left: 50%;
    width: 10px;
    height: 10px;
    transform: translate(-50%, -50%);
    background: var(--por);
    box-shadow:
      inset 1.5px 1.5px 3px var(--por-darker),
      inset -1.5px -1.5px 3px var(--por-light);
  }

  .wc3-plumb-dot::after {
    content: "";
    position: absolute;
    inset: 2.5px;
    border-radius: 999px;
  }

  .wc3-pd-0::after {
    background: var(--e0);
    opacity: var(--w0, 1);
  }

  .wc3-pd-1::after {
    background: var(--e1);
    opacity: var(--w1, 0);
  }

  .wc3-pd-2::after {
    background: var(--e2);
    opacity: var(--w2, 0);
  }

  /* ── Chapter gauges: three vertical grooves in the bottom-right, each
     filling bottom-up only during its own build's stretch of the scroll ── */
  .wc3-gauges {
    right: max(48px, calc((100vw - 1524px) / 2 + 48px));
    bottom: 40px;
  }

  .wc3-groove {
    width: 8px;
    height: 120px;
    background: var(--por);
    box-shadow:
      inset 2px 2px 4px var(--por-darker),
      inset -2px -2px 4px var(--por-light);
  }

  .wc3-gfill {
    left: 2px;
    right: 2px;
    bottom: 2px;
  }

  .wc3-gf-0 {
    height: calc(4px + (100% - 8px) * var(--f0, 0));
    background: var(--e0);
  }

  .wc3-gf-1 {
    height: calc(4px + (100% - 8px) * var(--f1, 0));
    background: var(--e1);
  }

  .wc3-gf-2 {
    height: calc(4px + (100% - 8px) * var(--f2, 0));
    background: var(--e2);
  }

  .wc3-engraved {
    color: rgba(34, 47, 48, 0.42);
    text-shadow: 1px 1px 0 rgba(255, 255, 255, 0.85);
  }

  /* ── Phone tuning: same instruments, sized to sit in the narrow gutters
     that frame the inset cards rather than in the desktop margins ── */
  @media (max-width: 1023px) {
    .wc3-dial {
      --dial: 92vmin;
    }

    .wc3-plumb {
      top: 14vh;
      height: 64vh;
    }

    .wc3-gauges {
      right: 14px;
      bottom: 18px;
      gap: 7px;
    }

    .wc3-groove {
      width: 7px;
      height: 80px;
    }
  }

  /* The one place the build's enamel touches the card body */
  .wc3-tick {
    width: 44px;
    height: 3px;
    border-radius: 999px;
    background: var(--eng, var(--g0));
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.7);
  }

  /* Image wells: barely pooled with the build's enamel */
  .wc3-well {
    box-shadow:
      inset 8px 8px 18px var(--por-dark),
      inset -8px -8px 18px var(--por-light);
  }

  .wc3-wp-0 {
    background:
      radial-gradient(120% 90% at 12% 8%, rgba(138, 165, 95, 0.2), transparent 55%),
      var(--por);
  }

  .wc3-wp-1 {
    background:
      radial-gradient(120% 90% at 12% 8%, rgba(127, 137, 212, 0.18), transparent 55%),
      var(--por);
  }

  .wc3-wp-2 {
    background:
      radial-gradient(110% 85% at 12% 8%, rgba(211, 138, 183, 0.16), transparent 55%),
      radial-gradient(110% 85% at 88% 92%, rgba(143, 169, 214, 0.16), transparent 55%),
      var(--por);
  }

  .wc3-well img {
    box-shadow: 0 10px 26px -14px rgba(34, 47, 48, 0.4);
  }

  /* ── Fittings ── */
  .wc3-feat {
    box-shadow:
      inset 3px 3px 7px var(--por-dark),
      inset -3px -3px 7px var(--por-light);
  }

  .wc3-feat-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--eng, var(--g2));
  }

  .wc3-chip {
    box-shadow:
      inset 3px 3px 7px var(--por-dark),
      inset -3px -3px 7px var(--por-light);
  }

  .wc3-btn {
    background: var(--por);
    box-shadow:
      6px 6px 14px var(--por-dark),
      -6px -6px 14px var(--por-light);
    transition:
      box-shadow 0.2s ease,
      transform 0.2s ease,
      color 0.2s ease;
  }

  .wc3-btn:hover {
    transform: translateY(-1px);
  }

  .wc3-btn:active {
    transform: translateY(0);
    box-shadow:
      inset 4px 4px 10px var(--por-dark),
      inset -4px -4px 10px var(--por-light);
  }

  .wc3-btn:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 3px;
  }

  /* The go button's arrow wears the build's enamel; ink on hover */
  .wc3-btn-go {
    color: var(--en, var(--color-ink));
  }

  .wc3-btn-go:hover {
    color: var(--color-ink);
  }
</style>

<script>
  {
    const section = document.querySelector<HTMLElement>(".wc3");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (section && !reducedMotion) {
      const zone = section.querySelector<HTMLElement>("[data-zone]");
      const cards = Array.from(section.querySelectorAll<HTMLElement>("[data-card]"));

      // Must track the inline sticky tops: 88px base, 26px stair
      const STICK_TOP = 88;
      const STICK_STEP = 26;

      let ticking = false;

      const update = () => {
        ticking = false;
        if (!zone) return;
        const rect = zone.getBoundingClientRect();
        // Hidden variant panel (display: none) — no pile height, nothing to drive
        if (!rect.height) return;

        // Total pile progress + per-build blend weights for the instruments
        const range = rect.height - window.innerHeight;
        if (range > 0) {
          const p = Math.min(1, Math.max(0, -rect.top / range));
          const s = p * (cards.length - 1);
          section.style.setProperty("--p", p.toFixed(4));
          for (let i = 0; i < cards.length; i++) {
            section.style.setProperty(`--w${i}`, Math.max(0, 1 - Math.abs(s - i)).toFixed(3));
            section.style.setProperty(`--f${i}`, Math.min(1, Math.max(0, p * cards.length - i)).toFixed(3));
          }
        }

        // i's cover is driven by how far card i+1 has climbed toward its
        // own sticky seat; the last card is never covered. The raw ramp is
        // smoothstepped so the outgoing card eases out — slow start as the
        // next one approaches, accelerating through the middle, settling at
        // the seat — a magnetic repel rather than a hard bump.
        for (let i = 0; i < cards.length - 1; i++) {
          const next = cards[i + 1].getBoundingClientRect();
          const seat = STICK_TOP + (i + 1) * STICK_STEP;
          const t = Math.min(1, Math.max(0, 1 - (next.top - seat) / (window.innerHeight - seat)));
          const cover = t * t * (3 - 2 * t);
          cards[i].style.setProperty("--cover", cover.toFixed(3));
        }
      };

      const onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      };

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
      update();
    }
  }
</script>
